// KPI Dashboard – Datenmodell
// Modelliert Leads, Kontaktversuche, Umsätze und Kosten pro Kunde.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Eigener Sales-Prozess von Performance Growth — separater Airtable-Base
// "Deal-Pipeline". Spiegel der Airtable-Records in der DB, damit Kanban /
// KPI / Activity-Timeline ohne Airtable-Round-Trip funktionieren.
model Deal {
  id         String    @id @default(cuid())
  airtableId String?   @unique
  name       String?
  company    String?
  email      String?
  phone      String?
  // Deal-Wert in EUR. Nullable, weil frische Leads den Wert oft noch
  // nicht hinterlegt haben.
  value      Decimal?  @db.Decimal(12, 2)
  // Aktueller Bearbeitungsstatus aus Airtable (Single-Select-Text). Wird
  // im Kanban als Spalten-Zuordnung verwendet (siehe SALES_PIPELINE_PHASES
  // in src/lib/sales.ts).
  status     String?
  // Sales-Rep / Owner (Text oder Email — flexibel, wie's aus Airtable kommt).
  owner      String?
  source     String?
  // Verkauftes Produkt / Paket. String aus Airtable-Spalte
  // (typischerweise Single-Select oder freier Text).
  product    String?
  // Erwartetes oder tatsächliches Abschluss-Datum.
  closeDate  DateTime?
  // Gesetzt sobald der Deal auf "Gewonnen" steht — für Win-Rate-Berechnung.
  wonAt      DateTime?
  // Gesetzt sobald der Deal auf "Verloren" steht.
  lostAt     DateTime?
  lostReason String?
  notes      String?
  // Frei editierbares Feld „Testcharge" (Detailansicht). Spiegelt das
  // gleichnamige Airtable-Feld; freier Text.
  testCharge String?
  // Vom Admin manuell „geschlossen" — verschwindet aus dem aktiven CRM-Kanban,
  // zählt aber weiter in die Sales-Statistiken (Win-Rate, Erreichbarkeit …).
  archived   Boolean   @default(false)
  // Voller Airtable-Record-Snapshot für die Detail-Ansicht. Erspart einen
  // zweiten Airtable-Call beim Öffnen des Modals.
  rawFields  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  activities DealActivity[]
  offers     Offer[]

  @@index([status])
  @@index([owner])
  @@index([wonAt])
  @@index([createdAt])
}

// Activity-Timeline: Notizen, Anrufe, Mails, Termine, automatische
// Status-Change-Einträge. Wohnt nur in der DB — Airtable kennt das
// Konzept (noch) nicht.
model DealActivity {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // "note" | "call" | "email" | "meeting" | "status_change"
  kind         String
  title        String
  body         String?
  // Optionaler Planungs-Zeitpunkt für zukünftige Aktivitäten
  // (Wiedervorlage, Termin, Folge-Anruf …). Wenn gesetzt, zeigt die
  // CRM-Kanban-Card die nächste anstehende Aktivität statt des letzten
  // Updates. createdAt bleibt der reine Anlage-Zeitpunkt.
  scheduledFor DateTime?
  // Abgehakt/erledigt am. Gesetzt = die Aktivität fällt aus „Heute"/„Kommende"
  // (nur noch in der Historie sichtbar).
  completedAt  DateTime?
  // Zusatzdaten je Kind (z. B. {fromStatus, toStatus} bei status_change).
  metadata     Json?
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@index([dealId, scheduledFor])
}

model Customer {
  id                  String    @id @default(cuid())
  name                String    @unique
  createdAt           DateTime  @default(now())
  // Stripe-Kunde für Abrechnung (Rechnungen, Zahlungsart, Abo)
  stripeCustomerId    String?   @unique
  // Paket: "software" = Betreuung + Software, "service" = nur Betreuung
  // (Leads per E-Mail, Kundenbereich nur mit Leads und Zahlen)
  plan                String    @default("software")
  // Vertreter (Ausschließlichkeit) oder Makler – bestimmt die Standard-Provisionssätze
  vermittlerTyp       String    @default("vertreter")
  // Eigene Provisionssätze je Produkt (Kundenbereich → Konto → Meine Provisionen),
  // geprüft über lib/provision.parseCustomRates; null = Standard
  provisionRates      Json?
  // Kunde hat seine Provisionen geprüft (auch ohne Abweichung vom Standard) – Einrichtungsschritt erledigt
  provisionCheckedAt  DateTime?
  // Kein aktueller Bezug mehr (aus Airtable) → in Listen ausgeblendet, Historie bleibt
  archived            Boolean   @default(false)
  // Jeder neue Lead zusätzlich per E-Mail an den Kunden (Kundenbereich → Konto)
  leadEmail           Boolean   @default(true)
  // Zahlungsverzug: seit wann eine Rechnung offen/fehlgeschlagen ist, Warnung verschickt
  paymentOverdueSince DateTime?
  paymentWarnedAt     DateTime?

  // ─── Media-Buyer-Daten (aus Airtable-Buyer-Tabelle) ─────────────────
  // Lead-Ziele, Preise und Startdaten je Produkt liegen seit dem Product-/
  // CustomerProduct-Refactor (Option B) NICHT mehr als hardcoded Spalten hier,
  // sondern produkt-agnostisch in CustomerProduct (eine Zeile pro Kunde ×
  // Produkt). So skalieren neue Produkte ohne Schema-Migration.
  //
  // Region des Kunden (z.B. "Berlin"). Bestimmt, in welchen regionsbasierten
  // Pool (z. B. Kinderwunsch) die Leads/Ziele dieses Kunden fallen, wenn die
  // CustomerProduct-Zeile selbst keine eigene Region trägt.
  region String?

  // ─── Retainer-Modell (aus Airtable „Kunden") ─────────────────────────
  // Gesetzt = Kunde zahlt Retainer + eigenes Werbebudget statt Lead-Preis.
  // Im Kunden-Dashboard: Lead-Kosten = Werbespend (eigenes Konto) + Retainer
  // (tagesanteilig ab retainerStart). Taucht NICHT als Agentur-Kosten auf.
  retainerMonthly Decimal?  @db.Decimal(12, 2)
  retainerStart   DateTime?
  // Letzter Tag mit Retainer (inklusive), von Hand in Kundenakte → Abrechnung; null = läuft
  retainerEnd     DateTime?
  // Eigenes Meta-Werbekonto des Kunden (nur Ziffern, ohne „act_").
  metaAdAccountId String?
  // Facebook-Seite des Kunden für Lead-Ads (Kampagnen-Agenten); sonst aus LeadSource.pageId
  metaPageId      String?

  leads            Lead[]
  garantieFaelle   GarantieFall[]
  revenues         Revenue[]
  costs            Cost[]
  users            User[]
  customerProducts CustomerProduct[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  onboarding               Onboarding?
  feedback                 CustomerFeedback[]
  pauses                   CustomerPause[]
  absences                 UserAbsence[]
  whatsAppFees             WhatsAppFeeCharge[]
  leadSubscriptions        LeadSubscription[]
  // Modul „Bestandskunden-Kampagnen“ (Zusatzmodul; Testkunden kostenlos)
  existingCustomersEnabled Boolean                   @default(false)
  // ─── Preise: Berater-Plätze, Zahlweise, Bestandskunden-Modul (seit 11.11.2026) ───
  // Inklusive Logins laut Angebot; null = keine Platz-Abrechnung (Alt-Verträge, individuell)
  seatsIncluded            Int?
  // Preis je weiterem Login und Monat (netto), aus dem Angebot eingefroren
  seatMonthly              Decimal?                  @db.Decimal(10, 2)
  // Zurzeit im Stripe-Abo berechnete weitere Logins (Menge der Platz-Position)
  seatsBilled              Int                       @default(0)
  // "month" | "year" (jährlich im Voraus, Jahresbetrag = (12 − Freimonate) × Monatspreis)
  billingInterval          String                    @default("month")
  // Gebuchtes Bestandskunden-Modul: Monatspreis netto; null = nicht gebucht
  bestandMonthly           Decimal?                  @db.Decimal(10, 2)
  // Bestandsschutz: nutzte das Modul schon vor der Preisliste, bleibt kostenlos freigeschaltet
  bestandGrandfathered     Boolean                   @default(false)
  // Kunde hat das Modul im Konto angefragt (Admin „Heute“)
  bestandRequestedAt       DateTime?
  // Modul zum Ende des Abrechnungszeitraums gekündigt: Zugang bis hier, danach schaltet der Cron ab
  bestandCancelAt          DateTime?
  // Kampagnen-Nachrichten je Monat inklusive; null = Standard aus der Preisliste
  bestandMessageQuota      Int?
  // ─── Zusatzmodul „Empfehlungen & Bewertungen“ (seit 12.11.2026) ───
  // Freigeschaltet (Zugang); Abrechnung über empfehlungMonthly bzw. Testphase
  empfehlungEnabled        Boolean                   @default(false)
  // Berechneter Monatspreis netto; null = (noch) nicht berechnet (Testphase, kostenlos)
  empfehlungMonthly        Decimal?                  @db.Decimal(10, 2)
  // Testphase bis hier (gesetzt = Testphase wurde genutzt); danach automatisch kostenpflichtig
  empfehlungTrialEndsAt    DateTime?
  empfehlungTrialReminded  DateTime?
  // Vom Admin kostenlos freigeschaltet (keine Berechnung)
  empfehlungFree           Boolean                   @default(false)
  // Gekündigt: Zugang bis hier, danach schaltet der Cron ab
  empfehlungCancelAt       DateTime?
  // Seit wann aktiv: nur Abschlüsse ab hier lösen Anfragen aus
  empfehlungSince          DateTime?
  // Weggeklickte Hinweise auf Zusatzmodule (Schlüssel je Stelle)
  moduleHintsDismissed     String[]                  @default([])
  // Neue Oberfläche des Kundenbereichs (Vertreter-A); pro Kunde im Admin einschaltbar.
  newUi                    Boolean                   @default(false)
  existingCustomers        ExistingCustomer[]
  manualRevenues           ManualRevenue[]
  campaigns                CustomerCampaign[]
  leadSources              LeadSource[]
  salesContact             SalesContact?
  whatsAppAccount          WhatsAppAccount?
  calendarConnection       CalendarConnection?
  agentConfig              AgentConfig?
  calendarLeadTimes        CalendarLeadTimes[]
  calendarBlocks           CalendarBlock[]
  conversations            Conversation[]
  appointments             Appointment[]
  messageTemplates         MessageTemplate[]
  consentOptIns            ConsentOptIn[]
  adSpend                  CustomerAdSpend[]
  budgets                  CustomerBudget[]
  budgetChanges            BudgetChange[]
  productBookings          ProductBooking[]
  // „Kollegen empfehlen“ (B2B-Empfehlungsprogramm, lib/kollegen.ts)
  referralCode             ReferralCode?
  colleagueReferrals       ColleagueReferral[]
  referralNudges           ReferralNudge[]
  reviewSettings           ReviewSettings?
  reviewRequests           ReviewRequest[]
  referralLinks            ReferralLink[]
  googleBusiness           GoogleBusinessConnection?
  googleReviews            GoogleReview[]
  // Kampagnen-Agenten (lib/kampagnen)
  campaignRuns             CampaignRun[]
  // Monatsberichte (lib/monatsbericht): je Kunde abschaltbar
  monthlyReportsOff        Boolean                   @default(false)
  monthlyReports           MonthlyReport[]
  campaignWishes           CampaignWish[]
  campaignHealth           CampaignHealth[]
  mailTemplates            MailTemplate[]
}

// Tagesbudget je Produkt (Kundenbereich → Konto → Werbebudget). Ohne Eintrag gilt das
// angenommene Angebot (Offer.products). Je Produkt gilt der jüngste Eintrag mit validFrom ≤ jetzt.
model CustomerBudget {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     String
  dailyBudget Decimal  @db.Decimal(10, 2)
  validFrom   DateTime
  changeId    String?
  createdAt   DateTime @default(now())

  @@index([customerId, validFrom])
}

// Budgetänderung durch den Kunden: Protokoll, Preisstufe und Stand der Stripe-Anpassung.
model BudgetChange {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String?
  // [{ product, from, to }] in €/Tag
  changes           Json
  effectiveFrom     DateTime
  monthlyBudgetFrom Int
  monthlyBudgetTo   Int
  // Monatspreis Betreuung + Software (netto) vorher/nachher; null = individuell/kein Listenpreis
  feeFrom           Decimal?  @db.Decimal(10, 2)
  feeTo             Decimal?  @db.Decimal(10, 2)
  tierChange        Boolean   @default(false)
  // Kunde hat den neuen Monatspreis bestätigt (Pflicht bei Stufenwechsel)
  acknowledged      Boolean   @default(false)
  // applied = übernommen | pending = Anfrage an uns (über Listenpreis) | rejected
  status            String    @default("applied")
  // Warum Anfrage bzw. Preis von Hand: individual_budget | individual_terms | annual | no_offer_price
  reason            String?
  // Stripe: none (kein Preiswechsel) | scheduled (ab effectiveFrom) | done | manual (Admin-Aufgabe) | error
  stripeStatus      String    @default("none")
  stripeNote        String?
  // Meta: none (nicht nötig/aus) | scheduled (ab effectiveFrom) | done | manual (Admin-Aufgabe) | error
  metaStatus        String    @default("none")
  metaNote          String?
  // Monatspreis im Abo geändert (Abrechnung ab dem nächsten Abrechnungsmonat)
  feeAppliedAt      DateTime?
  note              String?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([stripeStatus, effectiveFrom])
}

// Weiteres Produkt (Sparte/Kampagne) selbst buchen (Kundenbereich → Konto → Produkte).
// Das Budget zählt erst ab „Gestartet“ (Admin): dann entsteht der CustomerBudget-Eintrag.
model ProductBooking {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String?
  // Katalog-Schlüssel (ProductCatalogItem.key bzw. Standardkatalog) und Produktname wie im Budget
  catalogKey        String
  product           String
  dailyBudget       Decimal   @db.Decimal(10, 2)
  // Startwunsch des Kunden (null = so bald wie möglich)
  startWish         DateTime?
  // requested = Anfrage (über individualFrom) | setup = in Einrichtung | live | rejected | ended
  status            String    @default("setup")
  monthlyBudgetFrom Int
  monthlyBudgetTo   Int
  // Monatspreis Betreuung + Software (netto) vorher/nachher; null = individuell
  feeFrom           Decimal?  @db.Decimal(10, 2)
  feeTo             Decimal?  @db.Decimal(10, 2)
  setupFee          Decimal   @db.Decimal(10, 2)
  tierChange        Boolean   @default(false)
  acknowledged      Boolean   @default(false)
  // list = Listenpreis, automatisch | individual = Preis von Hand (Aufgabe) | fixed = Paket ohne Staffel
  pricing           String    @default("list")
  reason            String?
  // Einrichtungsgebühr: none | added | manual | removed | error
  setupStatus       String    @default("none")
  setupItemId       String?
  // Monatspreis im Abo (beim Start): none | pending | done | manual | error | reverted
  feeStatus         String    @default("none")
  stripeNote        String?
  note              String?
  decidedBy         String?
  startedAt         DateTime?
  rejectedAt        DateTime?
  endRequestedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

// Katalog buchbarer Produkte (Admin → Einstellungen → Produkte). Ohne Zeile gilt der Standard
// aus lib/produkt-buchen-shared.ts (DEFAULT_CATALOG).
model ProductCatalogItem {
  key       String   @id
  name      String
  benefit   String
  proven    Boolean  @default(false)
  enabled   Boolean  @default(false)
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Tagesspend aus dem EIGENEN Werbekonto eines Kunden (Retainer-Modell).
// Bewusst getrennt von Cost: das ist Geld des Kunden, keine Agentur-Kosten.
model CustomerAdSpend {
  id         String   @id @default(cuid())
  customerId String
  accountId  String
  date       DateTime // Tag, 12:00 UTC
  amount     Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, accountId, date])
  @@index([customerId, date])
}

// Produkt-Katalog. Gespiegelt aus der Airtable-"Produkte"-Tabelle —
// erlaubt beliebig viele Produkte ohne Code-Änderung. PRODUCTS in
// src/lib/products.ts liest dynamisch hieraus, sobald die UI auf den
// neuen Pfad umgestellt ist.
//
// poolKind bestimmt, wie der Media-Buyer Pools daraus baut:
//   "product"  → ein Pool je Produkt über alle Kunden
//                (Sterbegeld, Kindersparpläne, …)
//   "region"   → ein Pool je Region (Kinderwunsch)
model Product {
  id          String   @id @default(cuid())
  airtableId  String?  @unique
  name        String   @unique // canonical name, matched gegen Lead.source
  slug        String?  @unique // optional kürze form für URLs/IDs
  displayName String? // optional UI-Override (sonst = name)
  // Zusätzliche Keyword-Aliase für das Cost-Matching (kommagetrennt). Ein
  // Kampagnen-Name wird diesem Produkt zugeordnet, wenn er Name, Slug ODER
  // eines dieser Aliase als Teilstring enthält (case-insensitive, ≥3 Zeichen).
  // Gepflegt in Airtable (Produkte-Tabelle, Feld „Keywords"/„Aliase").
  keywords    String?
  poolKind    String   @default("product") // "product" | "region"
  // Sortierreihenfolge im Dashboard (asc); null = ans Ende.
  sortOrder   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerProducts CustomerProduct[]
}

// Kunden-Produkt-Bezug-Spiegel. Ein Eintrag pro (Kunde × Produkt) mit
// Ziel/Preis/Start. Löst die hardcoded leadGoalWechsel/etc.-Spalten
// auf Customer ab.
model CustomerProduct {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Lead-Ziel pro Monat. null = kein Ziel definiert.
  leadGoal         Int?
  // Preis pro Lead in EUR (Netto).
  leadPrice        Decimal?  @db.Decimal(12, 2)
  // Startdatum (Mid-Month-Onboarding-Pro-Rate).
  startDate        DateTime?
  // Test-Bezug: das volle Lead-Ziel wird über testDurationDays ausgeliefert und
  // NICHT anteilig auf den Restmonat gekürzt (Live-Bezüge schon). testMode true
  // ODER testDurationDays>0 ⇒ Testmodus.
  testMode         Boolean   @default(false)
  testDurationDays Int?
  // Region (nur für poolKind="region" relevant, z. B. Kinderwunsch-Stadt).
  region           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
}

// Ein Liefer-Pool = eine Meta-Kampagne, in die die Nachfrage mehrerer Kunden
// fließt. Zwei Arten:
//   kind = "product" → PKV, eine Kampagne pro Produkt (Wechsel/Neugeschäft),
//                       Pool-Ziel = Summe der Kunden-Ziele dieses Produkts.
//   kind = "region"  → Kinderwunsch, eine Kampagne pro Region,
//                       Pool-Ziel = Summe der KiWu-Ziele der Kunden der Region.
// Pools werden beim Lauf/Anzeigen automatisch aus den Kundendaten abgeleitet
// und hier per key upserted; gepflegt werden nur die Steuer-Einstellungen.
model DeliveryPool {
  id      String  @id @default(cuid())
  key     String  @unique // "product:Wechsel" | "product:Neugeschäft" | "region:Berlin"
  label   String
  kind    String // "product" | "region"
  // Produkt-Quelle (Lead.source) dieses Pools: "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  product String
  // Nur bei kind=region gesetzt.
  region  String?

  // Steuer-Einstellungen (admin-gepflegt):
  autopilot               Boolean  @default(false)
  maxDailyBudget          Decimal? @db.Decimal(12, 2)
  // Override für das Meta-Kampagnen-Matching. null = abgeleitet (Produkt bzw. Region).
  campaignKeyword         String?
  // Outbrain-Kampagnen-Match (analog zu campaignKeyword für Meta). null = kein
  // Outbrain-Channel in diesem Pool.
  outbrainCampaignKeyword String?
  // TikTok-Kampagnen-Match.
  tiktokCampaignKeyword   String?
  // Google-Ads-Kampagnen-Match.
  googleCampaignKeyword   String?
  // Per-Channel-Max-Budgets in EUR. maxDailyBudget gilt für Meta; ohne
  // outbrain-/tiktok-/googleMaxDailyBudget greift der Env-Default.
  outbrainMaxDailyBudget  Decimal? @db.Decimal(12, 2)
  tiktokMaxDailyBudget    Decimal? @db.Decimal(12, 2)
  googleMaxDailyBudget    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit-Log des automatischen Media Buyers. Ein Eintrag pro Pool und Lauf,
// auch wenn keine Änderung nötig war (action = "none") — so ist transparent,
// was der Bot wann gesehen und entschieden hat.
model MediaBuyerAction {
  id           String   @id @default(cuid())
  poolKey      String
  poolLabel    String
  // "increase" | "decrease" | "pause" | "activate" | "boost" | "none"
  action       String
  reason       String
  // Pacing-Kennzahlen zum Zeitpunkt der Entscheidung.
  leadsMtd     Int
  leadsGoal    Int
  projected    Int
  daysElapsed  Int
  daysTotal    Int
  // Budget in EUR (Summe über die gematchten Kampagnen). null wenn nicht
  // ermittelbar oder keine Budget-Änderung.
  prevBudget   Decimal? @db.Decimal(12, 2)
  newBudget    Decimal? @db.Decimal(12, 2)
  // Welche Meta-Kampagnen betroffen waren (Namen, kommagetrennt).
  campaigns    String?
  // true wenn der Lauf nur simuliert wurde (dryRun) und nichts an Meta ging.
  dryRun       Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([poolKey, createdAt])
  @@index([createdAt])
}

model Lead {
  id                   String            @id @default(cuid())
  airtableId           String?           @unique
  source               String?
  customerId           String
  name                 String?
  // Kontakt aus Airtable (Telefon normalisiert wie WhatsApp `from`, z. B.
  // 4915112345678) — für die Zuordnung WhatsApp-Konversation/Buchung ↔ Lead.
  phone                String?
  email                String?
  // Snapshot der produktspezifischen Formularangaben (Label/Wert-Liste aus
  // lib/lead-fields) — Kontext für den WhatsApp-Bot.
  formData             Json?
  // WhatsApp-Erstanschreiben (Outreach-Job): Zeitpunkt + Ergebnis
  // (sent | skipped_booked | skipped_contact | no_template | failed: …).
  outreachAt           DateTime?
  outreachStatus       String?
  // „Nur Betreuung“: Lead per E-Mail an den Kunden zugestellt
  emailedAt            DateTime?
  // Meta-Lead-ID (leadgen_id) bei direkt eingegangenen Leads – gegen Dubletten
  externalId           String?           @unique
  // Zuständiger Berater (Team-Kunden); leer = Inhaber/alle
  assignedUserId       String?
  assignedUser         User?             @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // Rückrufliste: „Nicht erreicht" geklickt → bis dahin ausgeblendet.
  callbackSnoozedUntil DateTime?
  // Wiedervorlage: „Ruf mich in 1 Woche an", Angebot nachfassen … erscheint
  // am Fälligkeitstag auf „Heute".
  followUpAt           DateTime?
  followUpNote         String?
  // Notizen des Beraters (bei Airtable-Leads zusätzlich dort gespiegelt)
  notes                String?
  // rec-ID des Kunden-Produkt-Bezug-Records, an dem dieser Lead in Airtable
  // hängt. Wird beim Storno gebraucht, um die zugelassenen Stornogründe
  // (Linked-Records vom Bezug zur Stornogründe-Tabelle) nachzuschlagen.
  bezugAirtableId      String?
  createdAt            DateTime          @default(now())
  firstContactAt       DateTime?
  closedAt             DateTime?
  reached              Boolean           @default(false)
  contactAttempts      Int               @default(0)
  status               String?
  // Letzte Statusänderung (DB-Trigger, greift für App, Bot und Sync) – „seit X Tagen in der Phase“
  statusChangedAt      DateTime          @default(now())
  // Werbekanal, der den Lead generiert hat (aus Airtable-Spalte „Source").
  // Werte: "Meta" | "Outbrain" | null (= unbekannt). Wird in Channel-KPIs
  // und im Media-Buyer-Steuerlauf verwendet, um CPL pro Kanal zu berechnen.
  adChannel            String?
  acquisitionCost      Decimal           @default(0) @db.Decimal(12, 2)
  // Abschlusswert in EUR — vom Buyer beim Drop auf "Abschluss" in der
  // Pipeline-Ansicht eingegeben (oder im Lead-Detail editierbar). Wird
  // optional nach Airtable in eine Abschlusswert-Spalte gespiegelt; getrennt
  // von Revenue.amount (das ist der Lead-Einkaufspreis).
  closeValue           Decimal?          @db.Decimal(12, 2)
  // Nach dem Abschluss: Police fertig gemacht (Ole, 13.11.2026)
  policyDoneAt         DateTime?
  // ─── Pay-per-Lead (eigene Funnels, an Käufer verkauft) ─────────────────
  subscriptionId       String?
  subscription         LeadSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId              String?
  order                LeadOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deliveredAt          DateTime?
  // Storno beim Pay-per-Lead: requested → approved | rejected | review (Prüfung durch Admin)
  stornoState          String?
  stornoReason         String?
  // Grund bei „Disqualifiziert“ (lib/lead-quality.ts), z. B. falsche_nummer
  disqualifyReason     String?
  stornoNote           String?
  stornoRequestedAt    DateTime?
  stornoDecidedAt      DateTime?
  // Gutschrift für genehmigten Storno (EUR) und wann sie auf eine Rechnung kam
  creditAmount         Decimal?          @db.Decimal(10, 2)
  creditedAt           DateTime?
  // DSGVO-Löschung (Art. 17): personenbezogene Felder geleert, Zeile bleibt
  // für Abrechnung und Statistik. Der Airtable-Sync überschreibt sie nicht mehr.
  erasedAt             DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  revenues Revenue[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  conversations Conversation[]
  appointments  Appointment[]
  sequences     LeadSequence[]
  history       LeadHistory[]
  files         LeadFile[]

  // Modul „Empfehlungen & Bewertungen“: Anfrage nach dem Abschluss (je Lead eine)
  reviewRequest     ReviewRequest? @relation("ReviewRequestLead")
  // Persönlicher Empfehlungslink dieses Kontakts (als Empfehlender)
  ownReferralLink   ReferralLink?  @relation("ReferralLinkLead")
  // Lead kam über den Empfehlungslink eines Kunden
  referralLinkId    String?
  referralLink      ReferralLink?  @relation("ReferredLeads", fields: [referralLinkId], references: [id], onDelete: SetNull)
  // Dank an den Empfehlenden verschickt (einmal, sobald dieser Lead abgeschlossen ist)
  referralThankedAt DateTime?
  // Empfohlene Person erlaubt, dass der Empfehlende eine Rückmeldung bekommt (Empfehlungsseite)
  referralStatusConsent Boolean @default(false)
  // Letzte Rückmeldung an den Empfehlenden: gemeldet | termin
  referralNotifiedStage String?
  // Dankeschön an den Empfehlenden für diese Empfehlung: offen | erledigt | entfaellt
  referralRewardStatus  String?
  referralRewardDueAt   DateTime?
  referralRewardDoneAt  DateTime?
  // Bewertungs-Wächter: Google-Bewertungen, die diesem Kontakt zugeordnet sind
  googleReviews     GoogleReview[]

  @@index([customerId, createdAt])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([customerId, phone])
  @@index([subscriptionId, deliveredAt])
  @@index([stornoState])
}

model Revenue {
  id         String   @id @default(cuid())
  customerId String
  leadId     String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  // Storno-Flag: true wenn der Lead in Airtable den Status „Storniert" hat.
  // Stornierte Revenues bleiben mit Betrag erhalten (für die Storno-Kachel),
  // werden aber aus allen Umsatz-/Marge-Aggregationen ausgefiltert.
  cancelled  Boolean  @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([occurredAt])
}

// Kosten:
// kind = LEAD  → direkte Lead-/Akquisekosten (fließen in "Gewinn vor weiteren Kosten")
// kind = OTHER → weitere Betriebskosten (fließen in "Gewinn nach weiteren Kosten")
enum CostKind {
  LEAD
  OTHER
}

model Cost {
  id         String   @id @default(cuid())
  customerId String?
  kind       CostKind
  // Produkt-Zuordnung (z. B. "Wechsel", "Neugeschäft") für LEAD-Kosten aus Meta.
  // null für OTHER-Kosten oder LEAD-Kosten ohne erkennbares Produkt.
  product    String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  note       String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([kind, occurredAt])
  @@index([kind, product, occurredAt])
}

// Kampagnen, deren Spend KEINEM Produkt zugeordnet werden konnte (kein
// passendes Keyword/Slug/Alias). Wird beim Channel-Sync pro Channel komplett
// neu geschrieben (Aggregat über den Sync-Zeitraum, eine Zeile je Kampagne).
// Dient der Transparenz im Admin: zeigt, welcher Ad-Spend NICHT in die
// Berechnung einfließt — und damit, wo ein Keyword fehlt.
model UnmatchedCampaign {
  id       String   @id @default(cuid())
  // "Meta" | "Outbrain" | "TikTok" | "Google"
  channel  String
  campaign String
  spend    Decimal  @db.Decimal(12, 2)
  syncedAt DateTime @default(now())

  @@index([channel])
}

// Web-Push-Subscriptions für PWA-Benachrichtigungen. userId = null nur für
// Legacy-Subscriptions vor der Auth (werden behandelt als Admin).
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  ADMIN
  BUYER
}

// Auth-Accounts. Admins sehen das ganze Dashboard, Buyer nur die eigene
// Customer-Sicht (customerId verknüpft, NULL für Admins).
model User {
  id                 String           @id @default(cuid())
  // Einführungsvideo auf „Heute“ angesehen oder weggeklickt (Ole, 13.11.2026)
  introVideoSeenAt   DateTime?
  email              String           @unique
  passwordHash       String
  role               UserRole
  customerId         String?
  createdAt          DateTime         @default(now())
  lastLoginAt        DateTime?
  // Zwei-Faktor-Login (TOTP), vor allem für Admins: Schlüssel verschlüsselt,
  // aktiv ab totpEnabledAt; Notfall-Codes nur als SHA-256-Hash.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  totpBackupCodes    String[]         @default([])
  // Sitzungsversion: +1 beendet alle Sitzungen (Passwort-/2FA-Änderung,
  // „Überall abmelden“, Kundenwechsel). Steht als „sv“ im Sitzungs-Cookie.
  sessionVersion     Int              @default(0)
  // Neuigkeiten (Kundenbereich): zuletzt gelesen – Einträge danach zählen als ungelesen
  updatesSeenAt      DateTime?
  // Team (Großkunden): owner = Inhaber (sieht alles), advisor = Berater (nur eigene Leads)
  teamRole           String           @default("owner")
  displayName        String?
  // Bekommt bei der Verteilung neue Leads
  receivesLeads      Boolean          @default(true)
  lastLeadAssignedAt DateTime?
  // Admins: neue Oberfläche (Admin-A) testen; Standard aus
  adminNewUi         Boolean          @default(true)
  adminDismissals    AdminDismissal[]
  assignedLeads      Lead[]           @relation("LeadAssignee")
  advisorCalendar    AdvisorCalendar?
  mailConnection     MailConnection?
  // E-Mail-Signatur (Ole, 14.11.2026): kommt automatisch unter E-Mails an Leads
  mailSignature      String?
  linkedInConnection LinkedInConnection?

  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resetTokens    PasswordResetToken[]
  dealActivities DealActivity[]

  // Konversationen, in denen dieser Agent das Gespräch übernommen hat.
  assignedConversations Conversation[]

  // Abwesenheiten (Urlaub, Krankheit …) und Vertretungen
  absences      UserAbsence[] @relation("UserAbsences")
  substituteFor UserAbsence[] @relation("AbsenceSubstitute")
  deviceTokens  DeviceToken[]
  appHandoffs   AppHandoff[]

  @@index([customerId])
}

// Einmalige Tokens für Passwort-Reset. Nur der SHA-256-Hash wird gespeichert
// — der eigentliche Token landet nur als URL-Parameter in der Reset-Email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Monatsziele für das Admin-Cockpit. Ein Eintrag pro Monat
// (monthKey = "YYYY-MM"). Alle Goal-Felder sind optional — wenn null,
// wird das Ziel im UI als "nicht gesetzt" angezeigt.
model MonthlyGoal {
  id             String   @id @default(cuid())
  monthKey       String // "YYYY-MM"
  // Produkt-Dimension: "" = Gesamt, sonst "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  // Lead-Ziele kommen je Produkt aus Airtable (nicht hier); gespeichert werden
  // hier Abschluss-/Umsatz-/Marge-Ziele. Gesamt-Werte (Leads/Abschlüsse/Umsatz)
  // sind die Summe der Produkte; nur die Gesamt-Marge wird eigenständig gesetzt.
  product        String   @default("")
  leadsGoal      Int?
  // Abschlussquote-Ziel (Abschlüsse / Leads), 0..1. Qualitätskennzahl wie die
  // Marge — wird je Produkt und gesamt eigenständig gesetzt (nicht summiert).
  closedRateGoal Decimal? @db.Decimal(5, 4)
  revenueGoal    Decimal? @db.Decimal(12, 2)
  marginGoal     Decimal? @db.Decimal(5, 4) // 0..1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthKey, product])
}

// Eine Anfrage des Admins per Telegram, neue Meta-Ad-Creatives zu generieren.
// Bündelt mehrere Varianten (Headline + Body + Bild + CTA), die separat
// genehmigt werden können.
model CreativeRequest {
  id             String   @id @default(cuid())
  telegramChatId String // Telegram-Chat-ID des Anfragenden (kann negativ sein bei Gruppen)
  rawPrompt      String // Originaler Telegram-Text
  parsedIntent   Json // {count, campaign, tone, audience, …} von Claude
  status         String   @default("generating") // generating | partial | completed | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants CreativeVariant[]

  @@index([telegramChatId, createdAt])
}

// Eine konkrete Creative-Variante. Hat eigenen Approval-Status, weil der
// Admin pro Variante "Genehmigen" / "Ablehnen" / "Neu generieren" entscheidet.
model CreativeVariant {
  id             String    @id @default(cuid())
  requestId      String
  index          Int // 1..N innerhalb der Anfrage
  headline       String
  body           String
  cta            String // z.B. "Termin in 30 Sek"
  adText         String    @default("") // Facebook Primary-Text (über dem Bild), kann long-form sein
  fbHeadline     String    @default("") // Facebook Headline unter dem Bild (max ~40 Zeichen, unabhängig vom visuellen Hero)
  mechanic       String    @default("") // Konzept-Mechanic (z.B. UGC-Whiteboard, Comic-Illustration, Big-Number)
  imagePrompt    String // bei HTML-Pipeline: das volle HTML (Debug/Replay)
  imageUrl       String // public R2-URL
  // Video-Felder: gesetzt wenn kind="video". imageUrl kann dann ein
  // Standbild/Thumbnail enthalten (z. B. ersten Frame), videoUrl ist die R2-MP4.
  kind           String    @default("image") // "image" | "video"
  videoUrl       String?
  durationSec    Int?
  // Meta-Side: gesetzt wenn approved + zur Kampagne gepusht.
  metaCampaignId String?
  metaAdId       String?
  metaImageHash  String?
  status         String    @default("pending") // pending | approved | rejected | live | failed
  telegramMsgId  String? // Message-ID der Telegram-Nachricht mit dieser Variante
  errorMessage   String?
  createdAt      DateTime  @default(now())
  approvedAt     DateTime?

  request CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([telegramMsgId])
}

// ═══════════════════════════════════════════════════════════════════════
// WhatsApp-CRM (Phase 0) — eigene WhatsApp-Anbindung + KI-Vorqualifizierung
// + Terminierung, als Superchat-Ablösung. Multi-Tenant: alles hängt an
// Customer (customerId) und ist strikt pro Kunde isoliert. Token-/Key-Felder
// mit Suffix „Enc" werden VOR dem Persistieren app-seitig verschlüsselt
// (Envelope-Encryption/KMS) — nie Klartext in die DB. Siehe Projektplan
// „Sicherheit & DSGVO (Exit-Readiness)".
// ═══════════════════════════════════════════════════════════════════════

// WhatsApp-Business-Konto je Kunde (über 360dialog in der Überbrückungsphase).
model WhatsAppAccount {
  id                 String    @id @default(cuid())
  customerId         String    @unique
  provider           String    @default("360dialog") // 360dialog | meta_cloud (später)
  wabaId             String?
  phoneNumberId      String?
  phoneNumber        String?
  displayName        String?
  apiKeyEnc          String? // app-seitig verschlüsselter 360dialog-API-Key
  status             String    @default("pending") // pending | connected | disabled
  // Selbst verbunden über 360dialog Integrated Onboarding (Partner-API):
  // Client und Channel aus dem Redirect; der API-Key wird daraus erzeugt.
  dialog360ClientId  String?
  dialog360ChannelId String?
  // Vorlagen automatisch einreichen/nachziehen (lib/whatsapp/template-submit.ts):
  // letzter Abgleich mit 360dialog (gedrosselt im WhatsApp-Cron).
  templatesCheckedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([phoneNumberId])
}

// Google-Kalender-Anbindung je Kunde für die Terminbuchung (Telefon/Video).
// Kalender-Anbindung je Kunde: Google oder Microsoft (Outlook/Exchange).
// Tabellenname bleibt aus Kompatibilität „GoogleCalendarConnection".
model CalendarConnection {
  id              String    @id @default(cuid())
  customerId      String    @unique
  provider        String    @default("google") // google | microsoft
  accountEmail    String? // verbundenes Kalender-Konto (Anzeige)
  calendarId      String    @default("primary")
  accessTokenEnc  String? // app-seitig verschlüsselt
  refreshTokenEnc String? // app-seitig verschlüsselt
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending") // pending | connected | error
  // Öffentlicher, nicht erratbarer Slug für die Buchungsseite /book/<slug>
  // (z. B. als Custom-Scheduling-Link im Meta-Leadformular).
  bookingSlug     String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("GoogleCalendarConnection")
}

// Konfigurierbarer KI-Agent je Kunde (Aufgabe/Regeln, Wissen, Persönlichkeit).
model AgentConfig {
  id                       String    @id @default(cuid())
  customerId               String    @unique
  name                     String    @default("Assistent")
  systemPrompt             String    @default("")
  knowledge                String    @default("")
  personality              String    @default("")
  active                   Boolean   @default(false)
  // Automatisches WhatsApp-Erstanschreiben neuer Leads ohne Termin. Erst
  // aktivieren, wenn Einwilligung im Leadformular + freigegebene Vorlage da sind.
  outreachEnabled          Boolean   @default(false)
  // 0 = sofort beim Eingang (Speed to Lead). Höher nur, wenn der Lead erst selbst buchen soll.
  outreachDelayMin         Int       @default(0)
  // Automatisch nachfassen: feste Abfolgen nach „Nicht erreicht“, „Angebot gesendet“,
  // „Nicht erschienen“ (lib/lead-sequences.ts). Standard aus.
  followUpSequencesEnabled Boolean   @default(false)
  // Fester Video-Link für alle Video-Termine (z. B. persönlicher Webex-Raum).
  // Leer = Google Meet bzw. Microsoft Teams wird pro Termin erzeugt.
  videoRoomUrl             String?
  // Berater-Adresse (z. B. Allianz-Mail): bekommt jeden gebuchten Termin als
  // Kalendereinladung → landet direkt in seinem Firmenkalender (Outlook).
  advisorEmail             String?
  // Veröffentlichter Frei/Gebucht-Kalender (ICS-Link, verschlüsselt): belegte
  // Zeiten des Firmenkalenders fließen in die Terminvorschläge ein.
  availabilityIcsUrlEnc    String?
  // Allianz-Online-Kalender (öffentlicher Buchungsdienst der Vertreter-Seite):
  // aufgelöste Vertretung + Termin-Art als verschlüsseltes JSON
  // (lib/calendar/allianz-online.ts). Nur mit Zustimmung (allianzConsentAt).
  allianzCalendarEnc       String?
  allianzConsentAt         DateTime?
  // Letzter erfolgreicher Abruf, letzter Fehler (ohne Geheimnisse) und wann
  // zuletzt eine Admin-Aufgabe dazu angelegt wurde (gedrosselt).
  allianzLastOkAt          DateTime?
  allianzLastError         String?
  allianzAlertAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Ein Chat-Faden pro (Kunde × Kontakt-Telefonnummer). Hält den 24h-Fenster-
// Status und ob der KI-Bot aktiv ist oder ein Mensch übernommen hat.
model Conversation {
  id                   String    @id @default(cuid())
  customerId           String
  whatsAppAccountId    String?
  leadId               String?
  contactPhone         String
  contactName          String?
  contactEmail         String? // vom Lead im Chat genannt (für Kalender-Einladung)
  botActive            Boolean   @default(true)
  assignedUserId       String?
  // Vom KI-Bot gepflegte Qualifizierung (strukturiert, nicht nur als Notiz).
  qualified            Boolean   @default(false)
  qualificationSummary String?
  status               String    @default("open") // open | snoozed | done
  // „Braucht dich": Assistent hat übergeben (Frage, die er nicht klären kann,
  // Lead will den Berater sprechen) oder Lead schreibt in einem übernommenen
  // Chat. Wird beim Antworten des Beraters bzw. „Erledigt" zurückgesetzt.
  needsAttention       Boolean   @default(false)
  attentionReason      String?
  attentionAt          DateTime?
  windowExpiresAt      DateTime? // Ende des 24h-Service-Fensters
  lastMessageAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsAppAccount WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser    User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([customerId, contactPhone])
  @@index([customerId, status, lastMessageAt])
}

// Einzelne Nachricht in einer Konversation (ein- oder ausgehend).
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  direction       String // inbound | outbound
  kind            String   @default("text") // text | template | image | audio | document
  body            String?
  waMessageId     String?  @unique // WhatsApp-Message-ID (Idempotenz)
  status          String? // sent | delivered | read | failed (nur outbound)
  sentBy          String? // bot | agent | system (null = inbound)
  sentByUserId    String?
  // Meta-Preis je Nachricht (aus dem Status-Webhook „pricing“): Kategorie
  // marketing | utility | authentication | service und ob sie berechnet wird.
  // Beim Senden einer Vorlage vorbelegt mit der Vorlagen-Kategorie.
  pricingCategory String?
  billable        Boolean?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([billable, createdAt])
}

// Gebuchter Termin aus dem Bot-Flow (Telefon oder Videocall).
model Appointment {
  id              String    @id @default(cuid())
  customerId      String
  leadId          String?
  conversationId  String?
  mode            String // phone | video
  startsAt        DateTime
  endsAt          DateTime?
  calendarEventId String?
  meetUrl         String?
  status          String    @default("booked") // booked | cancelled | completed | no_show
  reminderSentAt  DateTime? // gesetzt, sobald die WhatsApp-Erinnerung raus ist
  // Empfehlungen: nach diesem Termin geprüft, ob der Empfehlungslink rausgeht (einmal je Termin)
  referralAskedAt DateTime?
  // Getrennte Einladung für den Berater (interne Infos), gleicher Termin.
  // calendarEventId = Einladung des Leads (kundenfreundlich, ohne Interna).
  advisorEventId  String?
  // In welchem Kalender der Termin liegt: Kunden-ID oder „user:<id>“ (Berater)
  calendarKey     String?
  // Geheimer Link für den Lead: /book/manage/<token> (absagen/verschieben).
  manageToken     String?   @unique
  cancelledAt     DateTime?
  // lead | advisor | team (Admin/Kunde im CRM) | system
  cancelledBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, startsAt])
}

// WhatsApp-Vorlage je Kunde (für Erstansprache / außerhalb des 24h-Fensters).
model MessageTemplate {
  id              String    @id @default(cuid())
  customerId      String
  name            String
  language        String    @default("de")
  // Wofür die Vorlage genutzt wird: outreach | booking_confirmation | reminder.
  // Parameter-Reihenfolge je Zweck siehe lib/whatsapp/templates.ts.
  purpose         String    @default("")
  category        String // utility | marketing | authentication
  status          String    @default("pending") // pending | approved | rejected | paused
  body            String
  // Von der App automatisch bei 360dialog/Meta eingereicht (statt von Hand angelegt).
  auto            Boolean   @default(false)
  submittedAt     DateTime?
  // Ablehnungsgrund von Meta (rejected_reason), z. B. INVALID_FORMAT
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name, language])
}

// Dokumentierte WhatsApp-/DSGVO-Einwilligung je (Kunde × Kontakt).
model ConsentOptIn {
  id           String    @id @default(cuid())
  customerId   String
  contactPhone String
  grantedAt    DateTime
  source       String? // funnel | import | manual
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, contactPhone])
}

// Nutzungsmessung im Kunden-CRM (pseudonym, ohne Lead-Inhalte): Seitenaufrufe,
// Aktionen, Fehler, Feedback. Grundlage für UX-Verbesserungen. Löschung nach
// 180 Tagen (Cron).
model UsageEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  customerId String
  userId     String?
  /// true = Admin in „Als Kunde ansehen" (nicht mitzählen)
  preview    Boolean  @default(false)
  type       String // page | action | error | feedback
  name       String // z. B. „/buyer/leads", „callback.not_reached", „toast.error"
  path       String?
  meta       Json?

  @@index([customerId, at])
  @@index([type, at])
}

// Angebot / Auftragsbestätigung aus dem Cold-CRM. Konditionen werden beim
// Erstellen eingefroren (Snapshot), damit ein angenommenes Angebot sich nie
// nachträglich ändert. Änderungen = neue Version (altes wird „superseded").
model Offer {
  id                      String        @id @default(cuid())
  // Altes Airtable-Deal-Board (wird abgelöst) oder Vertriebskontakt.
  dealId                  String?
  deal                    Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  salesContactId          String?
  salesContact            SalesContact? @relation(fields: [salesContactId], references: [id], onDelete: Cascade)
  // Fortlaufende Nummer, z. B. PG-2026-0007
  number                  String        @unique
  version                 Int           @default(1)
  // draft | sent | accepted | declined | superseded
  status                  String        @default("draft")
  // Geheimer Link für die öffentliche Angebotsseite
  token                   String        @unique
  // Empfänger
  contactName             String
  company                 String?
  email                   String?
  street                  String?
  zip                     String?
  city                    String?
  // Konditionen (netto, EUR)
  // "software" = Betreuung + Software, "service" = nur Betreuung (ohne Software)
  package                 String        @default("software")
  // Vertreter oder Makler: Makler bekommen die Vertrags-Garantie statt Break-even
  // und das Bestandskunden-Modul inklusive (seit 11.11.2026); geht bei Annahme an den Kunden
  vermittlerTyp           String        @default("vertreter")
  term                    String // "none" | "12m"
  products                Json // [{ name, dailyBudget }]
  setupFee                Decimal       @db.Decimal(10, 2)
  monthlyFee              Decimal       @db.Decimal(10, 2)
  softwareFee             Decimal       @db.Decimal(10, 2)
  introMonthlyFee         Decimal?      @db.Decimal(10, 2)
  introMonths             Int?
  specialTerms            String?
  startDate               DateTime?
  // Kunde wählt auf der Angebotsseite selbst (seit 11.11.2026): Laufzeit (nur ohne
  // Sonderpreis) und Startdatum. Bei Annahme werden term/setupFee/startDate überschrieben.
  customerChoosesTerm     Boolean       @default(false)
  customerChoosesStart    Boolean       @default(false)
  validUntil              DateTime
  // Annahme (Protokoll)
  sentAt                  DateTime?
  viewedAt                DateTime?
  acceptedAt              DateTime?
  acceptedName            String?
  acceptedIp              String?
  acceptedAgent           String?
  termsUrl                String?
  dpaUrl                  String?
  // Zusätze (seit 11.11.2026; null = Alt-Angebot ohne Platz-Abrechnung)
  // Logins gesamt (Inhaber + Berater) und davon inklusive
  seats                   Int?
  seatsIncluded           Int?
  // Preis je weiterem Login und Monat (netto)
  seatMonthly             Decimal?      @db.Decimal(10, 2)
  // Bestandskunden-Modul: Monatspreis netto; null = nicht gebucht
  bestandMonthly          Decimal?      @db.Decimal(10, 2)
  // Modul „Empfehlungen & Bewertungen“: Monatspreis netto; null = nicht gebucht
  empfehlungMonthly       Decimal?      @db.Decimal(10, 2)
  // Jährlich im Voraus: Jahresbetrag = (12 − annualFreeMonths) × Monatspreis inkl. Zusätze
  annualPrepay            Boolean       @default(false)
  annualFreeMonths        Int?
  // Zahlung (Stripe)
  stripeCustomerId        String?
  stripeCheckoutSessionId String?
  stripeSubscriptionId    String?       @unique
  // Abo-Zeitplan: Monatsgebühr startet erst am Startdatum (Setup sofort)
  stripeScheduleId        String?       @unique
  // none | pending | processing | paid | failed
  paymentStatus           String        @default("none")
  // Status des Stripe-Abos (active, past_due, canceled …)
  subscriptionStatus      String?
  paidAt                  DateTime?
  createdById             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([salesContactId])
  @@index([dealId])
  @@index([status])
}

// Verarbeitete Stripe-Webhook-Ereignisse (Idempotenz: jedes Ereignis nur einmal).
model StripeEvent {
  id         String   @id // evt_…
  type       String
  receivedAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════
// Vertrieb (ehemals „Cold CRM“): Akquise von Versicherungsagenturen –
// Kontakte, Aufgaben, Aktivitäten, Cold-Mail (Instantly), Termine (Calendly),
// Inbound-Leads. Übernommen aus dem separaten Cold-CRM (Nov. 2026).
// ════════════════════════════════════════════════════════════════════════

enum SalesStage {
  NEU
  NICHT_ERREICHT
  WIEDERVORLAGE
  INTERESSE
  TERMIN
  GEWONNEN
  SPAETER
  VERLOREN
  UNGUELTIG
}

// Kunden-Pipeline: alles nach der Zusage
enum SalesCustomerStage {
  VERTRAG // Zusage, Vertrag versendet
  ONBOARDING // unterschrieben, Setup (Produkte, Gebiet, Kampagnen)
  TEST // Testpaket / erste Leads
  AKTIV // laufender Kunde
  PAUSIERT
  GEKUENDIGT
}

enum SalesLossReason {
  KEIN_BEDARF // ausgelastet, braucht keine Kunden
  HAT_ANBIETER // kauft schon Leads / arbeitet mit Agentur
  UEBER_ALLIANZ // macht das über die Allianz
  ZU_TEUER // Budget / Preis
  KEIN_INTERESSE
  SONSTIGES
}

enum SalesActivityType {
  ANRUF
  EMAIL
  NOTIZ
  STATUS
  COLD_MAIL
  LINKEDIN
  TERMIN
  IMPORT
}

enum SalesTaskType {
  ANRUF
  NACHFASSEN
  UNTERLAGEN
  TERMIN
  SONSTIGES
}

model SalesContact {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  /// Weitere E-Mail-Adressen (z. B. nach Zusammenführen); werden bei Calendly, Instantly und Inbound mit erkannt
  altEmails            String[]  @default([])
  phone                String?
  fax                  String?
  street               String?
  zip                  String?
  city                 String?
  ratingValue          Float?
  ratingCount          Int?
  openingHours         String?
  url                  String?
  description          String?
  // Adresse aus dem Impressum ergänzt (einmal automatisch versucht)
  addressEnrichTriedAt DateTime?
  addressEnrichedAt    DateTime?
  // Maximal anreichern (Website + Google, lib/vertrieb/contact-enrich.ts)
  webEnrichAt          DateTime? // Website/Agenturseite ausgewertet (Öffnungszeiten, Social, Inhaber, Versicherer)
  googleCheckedAt      DateTime? // Google Places zuletzt abgefragt (alle 90 Tage)
  phoneMailCheckedAt   DateTime? // Telefonnummer aus E-Mail-Signaturen gesucht (lib/vertrieb/signature-phone.ts)
  googlePlaceId        String?
  googleMapsUrl        String?
  businessStatus       String? // Google: OPERATIONAL | CLOSED_TEMPORARILY | CLOSED_PERMANENTLY
  insurer              String? // Versicherer bzw. „Makler“ (aus Website/E-Mail)
  /// Quellen und Zeitpunkte der automatischen Ergänzung: { website?: {at,url,fields}, google?: {at,placeId,fields} }
  enrichment           Json?

  // Ansprechpartner & Zusatzinfos (aus der Instantly-Mailingliste)
  salutation     String?
  firstName      String?
  lastName       String?
  leaderNames    String? // alle Inhaber/Geschäftsführer, kommagetrennt
  agencyType     String? // GENERAL / HAUPT
  teamSize       Int?
  potentialScore Int?
  facebookUrl    String?
  instagramUrl   String?
  xingUrl        String?
  linkedinUrl    String?

  // LinkedIn-Outreach (Waalaxy)
  linkedinStatus      String? // ANFRAGE_GESENDET, VERNETZT, NACHRICHT_GESENDET, GEANTWORTET
  linkedinRequestAt   DateTime?
  linkedinConnectedAt DateTime?
  linkedinMessageAt   DateTime?
  linkedinReplyAt     DateTime?
  linkedinList        String? // Waalaxy-Liste / Kampagne
  linkedinTags        String?

  stage         SalesStage       @default(NEU)
  lossReason    SalesLossReason?
  competitor    String? // z.B. LEAD.NOW, Terminadler, Alkaio
  callAttempts  Int              @default(0)
  lastContactAt DateTime?
  legacyStatus  String? // Original-Status aus der Cold-Calling-Liste

  // Kunde (gesetzt ab Stufe Gewonnen)
  customerStage      SalesCustomerStage?
  products           String? // z.B. "PKV, TKV, Leben"
  monthlyValue       Int? // € pro Monat
  contractStart      DateTime?
  customerSince      DateTime?
  customerSource     String? // Akquise-Kanal: COLD_CALL, COLD_MAIL, LINKEDIN, META_ADS, EMPFEHLUNG, INBOUND, NETZWERK, SONSTIGES
  customerSourceNote String? // z.B. "Kampagne Allianz Okt" oder "Empfehlung von Hr. Müller"
  // Kundenkonto in der Plattform (ab Onboarding)
  customerId         String?             @unique
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers             Offer[]
  activities         SalesActivity[]
  tasks              SalesTask[]
  campaigns          SalesCampaignLead[]
  emails             SalesEmail[]
  linkedinEvents     SalesLinkedInEvent[]
  meetings           SalesMeeting[]
  inboundLeads       SalesInboundLead[]
  // Über „Kollegen empfehlen“ von einem Kunden empfohlen
  colleagueReferrals ColleagueReferral[]

  @@index([altEmails], type: Gin)
  @@index([stage])
  @@index([customerStage])
  @@index([linkedinStatus])
  @@index([zip])
  @@index([city])
}

model SalesActivity {
  id         String            @id @default(cuid())
  contactId  String
  contact    SalesContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       SalesActivityType
  outcome    String?
  note       String?
  occurredAt DateTime          @default(now())

  @@index([contactId, occurredAt])
}

model SalesTask {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  type      SalesTaskType @default(SONSTIGES)
  note      String?
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([doneAt, dueAt])
  @@index([contactId])
}

model SalesCampaign {
  id          String              @id @default(cuid())
  instantlyId String?             @unique
  name        String              @unique
  /// Anderes Thema (z. B. Pflege): Ereignisse und Leads dieser Kampagne kommen nicht ins CRM
  ignored     Boolean             @default(false)
  createdAt   DateTime            @default(now())
  leads       SalesCampaignLead[]
}

// Ein Kontakt in einer Instantly-Kampagne.
model SalesCampaignLead {
  id           String        @id @default(cuid())
  contactId    String
  contact      SalesContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       String? // Aktiv, Pausiert, Abgeschlossen, Bounced, Abgemeldet, Übersprungen, Noch nicht kontaktiert
  sentAt       DateTime? // erste/letzte bekannte Mail
  openCount    Int           @default(0)
  replyCount   Int           @default(0)
  clickCount   Int           @default(0)
  lastOpenAt   DateTime?
  lastReplyAt  DateTime?
  bounced      Boolean       @default(false)
  unsubscribed Boolean       @default(false)
  interest     String? // Instantly-Interessenstatus
  updatedAt    DateTime      @updatedAt

  @@unique([contactId, campaignId])
  @@index([campaignId])
}

// E-Mails aus Instantly (v.a. Antworten auf Cold Mails)
model SalesEmail {
  id          String       @id @default(cuid())
  instantlyId String?      @unique
  contactId   String
  contact     SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign    String?
  direction   String       @default("IN") // IN = Antwort vom Kontakt, OUT = von uns
  subject     String?
  text        String?
  html        String?
  fromEmail   String?
  threadId    String?
  isAutoReply Boolean      @default(false)
  sentiment   String? // POSITIV, NEGATIV, NEUTRAL
  sentAt      DateTime
  createdAt   DateTime     @default(now())

  @@index([contactId, sentAt])
}

// Rohdaten aus Waalaxy (Webhook), auch nicht zugeordnete – zum Nachvollziehen
model SalesLinkedInEvent {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // webhook | csv
  name      String?
  company   String?
  url       String?
  status    String?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// Termine aus Calendly (gebucht über Calendly → Google Calendar)
model SalesMeeting {
  id            String       @id @default(cuid())
  contactId     String
  contact       SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calendlyUri   String?      @unique // Invitee-URI
  eventUri      String?
  title         String
  startAt       DateTime
  endAt         DateTime?
  location      String?
  joinUrl       String?
  status        String       @default("GEPLANT") // GEPLANT, ABGESAGT, VERSCHOBEN
  cancelReason  String?
  canceledBy    String?
  rescheduleUrl String?
  cancelUrl     String?
  answers       String? // Fragen & Antworten aus dem Buchungsformular
  utmSource     String?
  inviteeName   String?
  inviteeEmail  String?
  taskId        String?
  /// Aufgabe „Wie lief der Termin?“ nach Terminende (lib/vertrieb/termin-review.ts)
  reviewTaskId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contactId])
  @@index([startAt])
}

// Eingehende Leads (Meta Lead Ads über Zapier/Make, Landingpage-Formulare …)
model SalesInboundLead {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // META_ADS, INBOUND, …
  name      String?
  email     String?
  phone     String?
  campaign  String?
  ad        String?
  form      String?
  answers   String?
  created   Boolean       @default(false) // neuer Kontakt angelegt?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([contactId])
}

// ─── Onboarding (ab Vertragsannahme) ───────────────────────────────────
// Ein Datensatz je Kunde. Die Checkliste ergibt sich aus diesen Zeitstempeln
// plus Kalender-/WhatsApp-Verbindung und erstem Login des Kunden.
model Onboarding {
  id                 String    @id @default(cuid())
  // Kunde nutzt die App ohne Handy/Mitteilungen – Schritt „App aufs Handy“ übersprungen
  appSkippedAt       DateTime?
  customerId         String    @unique
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId            String?   @unique
  salesContactId     String?
  // "software" | "service"
  package            String    @default("software")
  // running | live | cancelled
  status             String    @default("running")
  startDate          DateTime?
  welcomeSentAt      DateTime?
  // Kickoff-Termin (über das eigene Buchungstool)
  kickoffAt          DateTime?
  // Fragebogen im Kundenbereich
  questionnaire      Json?
  questionnaireAt    DateTime?
  // Partnerzugriff auf Meta-Werbekonto und Seite erteilt
  metaAccessAt       DateTime?
  // Pflichtangaben (Impressum) von der Agentur-Website
  websiteInfo        Json?
  websiteCheckedAt   DateTime?
  campaignReadyAt    DateTime?
  testLeadAt         DateTime?
  liveAt             DateTime?
  lastReminderAt     DateTime?
  // Push an Admin, wenn der Kunde lange nichts erledigt
  staleNotifiedAt    DateTime?
  // Aufgabe „Jahresvertrag anbieten“ (Tag 90) angelegt
  upsellTaskAt       DateTime?
  // 15-Minuten-Hilfetermin (Google-Kalender des Teams)
  helpCallAt         DateTime?
  helpCallEventId    String?
  helpCallUrl        String?
  // Selbst-Einrichtung: letzte Prüfung des Meta-Zugriffs (Werbekonto, Seite, Leads) und Partner-Anfrage
  metaCheck          Json?
  metaCheckedAt      DateTime?
  metaRequestedAt    DateTime?
  // Einwilligung zur Kontaktaufnahme (WhatsApp/Telefon) im eigenen Leadformular: Kunde bzw. Admin bestätigt
  consentAt          DateTime?
  consentConfirmedAt DateTime?
  // Erinnerungen der Selbst-Einrichtung (Tag 1/3/7): {"1": ISO, "3": ISO, "7": ISO}
  setupReminders     Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

// Kurzes Kunden-Feedback per Mail (Tag 7: Start, Tag 30: Monatsbericht).
// Antwort per Klick ohne Login über den geheimen Token.
model CustomerFeedback {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // day7 (Smileys 1–5) | day30, day90, day180 … (Weiterempfehlung 0–10, NPS)
  kind       String
  token      String    @unique
  // day7: 1–5, sonst 0–10
  score      Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?

  @@unique([customerId, kind])
}

// Pause / Urlaub eines Kunden: Anzeigen stoppen, Abrechnung auf die
// Software-Gebühr reduzieren (bei „Nur Betreuung“ 0 €), danach automatisch
// wieder starten. Geplant vom Kunden selbst oder vom Admin.
model CustomerPause {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  // leer = bis auf Widerruf
  endsAt            DateTime?
  // planned | active | ended | cancelled
  status            String    @default("planned")
  reason            String?
  // customer | admin
  createdBy         String    @default("customer")
  // customer = Pause/Urlaub (mit Abrechnung), dunning = Zahlungsverzug (nur Anzeigen)
  kind              String    @default("customer")
  // Von uns pausierte Meta-Kampagnen (werden beim Fortsetzen reaktiviert)
  pausedCampaignIds Json?
  adsNote           String?
  billingNote       String?
  appliedAt         DateTime?
  resumedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
  @@index([status, startsAt])
}

// „Ich bin abwesend“: Abwesenheit eines Logins in ganzen Tagen (Berliner
// Zeit). startsAt = Beginn des ersten Tags, endsAt = Beginn des Tags NACH dem
// letzten Tag (exklusiv). Solange sie läuft: keine neuen Leads, keine Termine
// bei dieser Person. Grund nur als Kategorie, keine Gesundheitsangaben.
model UserAbsence {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserAbsences", fields: [userId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  // urlaub | krank | sonstiges
  kind             String    @default("urlaub")
  // Vertretung (Kollege im Team), optional
  substituteUserId String?
  substitute       User?     @relation("AbsenceSubstitute", fields: [substituteUserId], references: [id], onDelete: SetNull)
  createdById      String?
  // Verschobene/übertragene Aufgaben zum Rückgängigmachen:
  // [{ leadId, followUpAt, callbackSnoozedUntil, assignedUserId }]
  movedTasks       Json?
  // Vorzeitig beendet
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId, endsAt])
  @@index([userId, endsAt])
}

// Direkter Lead-Eingang (Meta-Webhook oder Zapier-Webhook): welches
// Meta-Leadformular gehört zu welchem Kunden und Produkt.
model LeadSource {
  id              String    @id @default(cuid())
  formId          String    @unique
  pageId          String?
  formName        String?
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt-Key wie Lead.source (z. B. „Privatschutz“, „Wechsel“)
  productKey      String
  // Pay-per-Lead: Preis je Lead (netto) → Umsatz in der App; sonst leer
  leadPrice       Decimal?  @db.Decimal(12, 2)
  // Optional: Airtable-Bezug für die erlaubten Stornogründe
  bezugAirtableId String?
  // Fragen des Formulars (key → Beschriftung) für lesbare Formularangaben
  questionLabels  Json?
  active          Boolean   @default(true)
  lastLeadAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// Leads aus Formularen ohne Zuordnung: warten hier, bis das Formular einem
// Kunden zugeordnet wird – nichts geht verloren.
model UnassignedLead {
  id         String    @id @default(cuid())
  externalId String?   @unique
  formId     String?
  pageId     String?
  via        String // meta | zapier
  payload    Json
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([formId, resolvedAt])
}

// Eigener Kalender eines Beraters (Team-Kunden). Kunden-Kalender des Inhabers
// bleibt CalendarConnection; die Kalender-Funktionen unterscheiden über den
// Schlüssel „user:<userId>“.
model AdvisorCalendar {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  provider        String    @default("google")
  accountEmail    String?
  calendarId      String    @default("primary")
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// Lebenszeichen der Hintergrund-Jobs (Cron, Sync) für die Überwachung (/api/status).
model SystemHeartbeat {
  key  String   @id // "cron" | "sync"
  at   DateTime
  ok   Boolean  @default(true)
  note String?
}

// Öffentliche Statusseite (/status): ein Messpunkt je Cron-Lauf (alle 5 Min.)
// mit dem Zustand jeder Komponente ("ok" | "degraded" | "down"). Aufbewahrung 90 Tage.
model StatusSample {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  app      String
  leads    String
  whatsapp String
  calendar String
  payments String
  jobs     String

  @@index([at])
}

// Manuelle Störungsmeldungen für die Statusseite (Admin → Einstellungen → Status & Meldungen).
model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  message    String?
  level      String    @default("degraded") // "degraded" | "down" | "info"
  component  String? // app | leads | whatsapp | calendar | payments | jobs; leer = allgemein
  startsAt   DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([resolvedAt, startsAt])
}

// Änderungsprotokoll: wer hat wann was Wichtiges geändert (Logins, Zugänge,
// Team, Pausen, Angebote, Exporte, Einstellungen). Aufbewahrung 1 Jahr.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  actorRole  String? // ADMIN | BUYER | system | lead
  action     String // z. B. "login", "team.invite", "pause.plan"
  entity     String? // z. B. "User", "Lead", "Customer"
  entityId   String?
  customerId String?
  details    Json?

  @@index([at])
  @@index([customerId, at])
  @@index([action, at])
}

// WhatsApp-Gebühren von Meta, monatlich an den Kunden weiterberechnet
// (AGB: nach tatsächlichem Verbrauch). Ein Eintrag je Kunde und Monat.
model WhatsAppFeeCharge {
  id                  String   @id @default(cuid())
  customerId          String
  month               String // "2026-11"
  // { marketing: 12, utility: 3, authentication: 0 }
  counts              Json
  amount              Decimal  @db.Decimal(10, 2)
  // Stripe-Rechnungsposten (hängt an der nächsten Abo-Rechnung); leer = von Hand abrechnen
  stripeInvoiceItemId String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, month])
}

// ─── Pay-per-Lead ────────────────────────────────────────────────────────
// Bezug: ein Käufer kauft Leads eines Produkts (Pool) zu einem Preis, mit
// Filtern. Ersetzt den Airtable-„Kunden-Produkt-Bezug“.
model LeadSubscription {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt/Pool wie Lead.source, z. B. „PKV-Tarifoptimierung“
  productKey          String
  label               String?
  active              Boolean   @default(true)
  // live | test (Test: Vorrang bis testQuantity, verteilt über testDays)
  status              String    @default("live")
  testQuantity        Int?
  testDays            Int?
  // Kontingent ohne Bestellung (von Hand gepflegt): month | once; week = Bestellungen im Kundenbereich
  period              String    @default("week")
  goal                Int?
  startDate           DateTime?
  price               Decimal   @db.Decimal(10, 2)
  // Filter
  plzRanges           String? // "80000-85999|67300-67499|12345"
  acceptWeak          Boolean   @default(true)
  // Beitragsgrenze für „schwach“ (Standard 700 €), Beamte sind immer schwach
  weakThreshold       Int?
  acceptCivilServants Boolean   @default(true)
  onlyWeak            Boolean   @default(false)
  scoreFloor          Int?
  insurerInclude      String[]  @default([])
  insurerExclude      String[]  @default([])
  // weitere Regeln: "feld=Wert1,Wert2|feld2=…" (Lead wird ausgeschlossen, wenn ein Wert passt)
  excludeRules        String?
  // Storno
  stornoDays          Int?
  stornoReasons       String[]  @default([])
  // true = jede Reklamation im Fenster sofort anerkennen (auch „Sonstiges“ und
  // hohe Quote), sonst gehen diese in die Prüfung durch den Admin
  stornoAutoApprove   Boolean   @default(false)
  // Auslieferung: app (Kundenbereich, Push, E-Mail) | email (nur E-Mail) | webhook
  delivery            String    @default("app")
  deliveryEmail       String?
  // E-Mail-Vorlage für Systeme, die die Mail auslesen (z. B. „Feld: Wert“ je
  // Zeile). Platzhalter {vorname}, {nachname}, {plz} … siehe lib/ppl/delivery.
  emailSubject        String?
  emailTemplate       String?
  webhookUrl          String?
  // standard (JSON mit lead/answers, Secret im Header) | convexa (FirstName, LastName …)
  webhookFormat       String    @default("standard")
  webhookSecretEnc    String?
  airtableId          String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders LeadOrder[]
  leads  Lead[]
  areas  SubscriptionArea[]

  @@index([productKey, active])
  @@index([customerId])
}

// Gebiet eines Bezugs (z. B. Heinrich von Kleist): eigene PLZ-Bereiche und
// eigene Menge je Zeitraum. Leads aus dem Gebiet gehen bis 100 % der Menge
// bevorzugt an diesen Bezug (vor Bezügen ohne Gebiet), danach normale Verteilung.
model SubscriptionArea {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   LeadSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  label          String?
  plzRanges      String // "80000-85999|67300-67499|12345"
  quantity       Int
  // week | month; leer = wie der Bezug (Wochenbestellung → week, sonst month)
  period         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([subscriptionId])
}

// Bestellung für einen Zeitraum (meist Woche Mo–So), im Voraus bezahlt.
model LeadOrder {
  id              String           @id @default(cuid())
  subscriptionId  String
  subscription    LeadSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  quantity        Int
  amount          Decimal          @db.Decimal(10, 2)
  // open (Rechnung offen) | paid | processing (Lastschrift läuft) | failed | cancelled
  status          String           @default("open")
  // Folgewoche automatisch gleich bestellen
  autoRenew       Boolean          @default(true)
  stripeInvoiceId String?          @unique
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  leads Lead[]

  @@unique([subscriptionId, periodStart])
  @@index([status, periodStart])
}

// Eingang eines Pool-Leads (vor der Verteilung): Dubletten-Historie,
// geparkte Leads (kein freies Kontingent) und Prüfergebnis.
model PoolLead {
  id           String    @id @default(cuid())
  externalId   String?   @unique
  productKey   String
  via          String // perspective | meta | webhook
  name         String?
  phone        String?
  email        String?
  plz          String?
  insurer      String?
  contribution Int?
  civilServant Boolean   @default(false)
  weak         Boolean   @default(false)
  smsVerified  Boolean   @default(false)
  score        Int?
  answers      Json?
  // delivered | duplicate | invalid | parked
  status       String
  reason       String?
  leadId       String?   @unique
  // Gebiet, über das der Lead ausgeliefert wurde (Vorrang-Kontingent)
  areaId       String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@index([areaId, deliveredAt])
  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@index([status, productKey])
}

// ─── Bestandskunden (Import aus dem Versicherer-System) + Kampagnen ─────────
// Gesundheitsangaben werden nie importiert. Einwilligung für WhatsApp/E-Mail
// liegt laut Versicherer (Allianz) vor; dokumentiert mit Importdatum.
model ExistingCustomer {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalNo     String? // Kundennummer im Versicherer-System
  firstName      String?
  lastName       String?
  phone          String? // normalisiert wie WhatsApp (4915…)
  email          String?
  birthday       DateTime?
  street         String?
  zip            String?
  city           String?
  // Sparten, z. B. ["KFZ", "Haftpflicht"] – für Segmente und den Assistenten
  lines          String[]  @default([])
  // nächster Ablauf/Hauptfälligkeit (z. B. KFZ) für Anlass „Wechsel/Ablauf“
  nextRenewal    DateTime?
  consentAt      DateTime? // „Einwilligung laut Versicherer“ (Importdatum)
  consentNote    String?
  optOutAt       DateTime? // „Stopp“ → keine Kampagnen mehr
  lastCampaignAt DateTime?
  importId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contracts    ExistingContract[]
  recipients   CampaignRecipient[]
  referralLink ReferralLink?

  @@unique([customerId, externalNo])
  @@index([customerId, phone])
  @@index([customerId, email])
}

model ExistingContract {
  id                 String           @id @default(cuid())
  existingCustomerId String
  existingCustomer   ExistingCustomer @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  line               String // normalisierte Sparte (KFZ, Hausrat, …)
  product            String? // Originalbezeichnung
  startDate          DateTime?
  renewalDate        DateTime?

  @@index([existingCustomerId])
}

model CustomerCampaign {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  // cross_sell | review | birthday | renewal
  occasion    String
  // Segment, z. B. { has: ["KFZ"], lacks: ["Hausrat"] } oder { birthdayDays: 30 }
  segment     Json
  // Thema für die Vorlage (z. B. „Hausrat“), Parameter {{2}}
  topic       String?
  dailyLimit  Int       @default(150)
  // draft | running | paused | done
  status      String    @default("draft")
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([customerId, status])
}

model CampaignRecipient {
  id                 String           @id @default(cuid())
  campaignId         String
  campaign           CustomerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  existingCustomerId String
  existingCustomer   ExistingCustomer @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  // queued | sent | replied | failed | skipped
  status             String           @default("queued")
  reason             String?
  sentAt             DateTime?
  repliedAt          DateTime?
  conversationId     String?
  leadId             String?

  @@unique([campaignId, existingCustomerId])
  @@index([campaignId, status])
}

// Nachfass-Abfolge je Lead (lib/lead-sequences.ts): feste Schritte (WhatsApp /
// Anruf-Aufgabe) mit Tagesabstand, vom 5-Minuten-Cron abgearbeitet. Stoppt bei
// Antwort, Termin, Abschluss/Kein Interesse, Reklamation, Löschung, „Stopp“.
model LeadSequence {
  id         String    @id @default(cuid())
  leadId     String
  customerId String
  // not_reached | offer | no_show
  kind       String
  // Index des nächsten Schritts
  step       Int       @default(0)
  nextAt     DateTime?
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  stopReason String?
  // Verlauf ohne Inhalte: [{ at, step, action, result, detail }]
  log        Json      @default("[]")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([stoppedAt, nextAt])
  @@index([leadId])
}

// „Heute“ der Admin-Oberfläche: Punkte, die ein Admin abgehakt oder auf später
// gelegt hat (Schlüssel wie in lib/admin-heute.ts). Bis `until` ausgeblendet,
// danach erscheinen sie wieder, falls das Problem noch besteht.
model AdminDismissal {
  id        String   @id @default(cuid())
  userId    String
  key       String
  until     DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, until])
}

// Laufende Kosten für die Zahlen-Seite (Tools, eigene Werbung …), vom Admin
// gepflegt. Zweck: ppl / software (direkte Kosten → Marge des Stroms),
// akquise (Kundengewinnung → CAC) oder betrieb (weder Marge noch CAC).
model RecurringCost {
  id            String    @id @default(cuid())
  name          String
  monthlyAmount Decimal   @db.Decimal(10, 2)
  purpose       String    @default("ppl")
  startsAt      DateTime
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Von Hand nachgetragene Einmal-Umsätze (Admin → Zahlen), z. B. Einrichtungsgebühren
// aus der Zeit vor den Online-Angeboten. Fließen als Strom „setup“ ins Umsatzbuch,
// nie in den MRR. kind: "setup" (Einrichtung) | "other" (Sonstiges).
model ManualRevenue {
  id         String    @id @default(cuid())
  // Monat „YYYY-MM“ (Berliner Zeit)
  month      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Netto in EUR
  amount     Decimal   @db.Decimal(12, 2)
  kind       String    @default("setup")
  note       String?
  // E-Mail des Admins, der den Eintrag angelegt hat
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([month])
  @@index([customerId])
}

// Einstellungen der Zahlen-Seite (eine Zeile, id „default“).
model KpiSettings {
  id                   String   @id @default("default")
  // Kalkulatorische Gründerzeit im Vertrieb für „CAC mit Gründerzeit“
  founderHoursPerWeek  Int      @default(20)
  founderHourlyRate    Decimal  @default(60) @db.Decimal(8, 2)
  // Meta-Kampagnen der eigenen Kundengewinnung (kommagetrennt, enthält-Vergleich)
  acquisitionCampaigns String   @default("Allianz Lead Ads")
  // Freitexte fürs Investoren-Update
  updateChallenges     String?
  updateNext           String?
  // Letzter Monat der Pay-per-Lead-Pilotphase („YYYY-MM“), leer = läuft noch
  pplPilotEnd          String?
  updatedAt            DateTime @updatedAt
}

// Öffentlicher Break-even-Rechner (/rechner): Produkte mit Erfahrungswerten,
// Texte, Kontakt-Link und Garantien. Eine Zeile („default“), Inhalt als JSON,
// geprüft in lib/rechner.ts (parseRechnerConfig). Keine personenbezogenen Daten.
model RechnerConfig {
  id        String   @id @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}

// Infokarte auf der Login-Seite (eine Zeile, id „default“). Vom Admin unter
// Einstellungen → Login-Seite gepflegt; ohne Eintrag zeigt die Seite eine
// Standard-Karte. Das Bild liegt klein in der DB und wird öffentlich unter
// /api/login-info/image ausgeliefert (keine personenbezogenen Daten).
model LoginInfo {
  id        String   @id @default("default")
  enabled   Boolean  @default(true)
  badge     String?
  title     String
  text      String?
  linkText  String?
  linkUrl   String?
  image     Bytes?
  imageType String?
  updatedAt DateTime @updatedAt
}

// Garantiefälle (Lead-Garantie, Break-even-Garantie; AGB „Garantien“).
// Der tägliche Cron legt Fälle an bzw. aktualisiert offene; gutgeschrieben wird
// erst, wenn ein Admin „Gewähren“ klickt (lib/garantien-server.ts).
model GarantieFall {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // lead | breakeven
  art            String
  // Abrechnungsmonat, der kostenlos wird (YYYY-MM, Europe/Berlin)
  monat          String
  periodeVon     DateTime
  periodeBis     DateTime
  // Schnappschuss der Kennzahlen bei der letzten Prüfung
  kennzahlen     Json
  // offen | gewaehrt | abgelehnt
  status         String    @default("offen")
  grund          String?
  entschiedenVon String?
  entschiedenAm  DateTime?
  // Stripe-Gutschrift (Rechnungsposten-ID) und deren Nettobetrag
  stripeRef      String?
  betrag         Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([customerId, art, monat])
  @@index([status])
}

// Feste Zeiten, zu denen Leads Termine buchen dürfen (je Kalender-Schlüssel:
// customerId = Agentur-Kalender, user:<id> = Kalender eines Beraters).
// Ohne Zeile gilt Mo–Fr 10, 14 und 16 Uhr (lib/calendar/lead-times.ts).
model CalendarLeadTimes {
  calendarKey String   @id
  customerId  String
  // Wochentage 0 = So … 6 = Sa
  weekdays    Int[]
  // Uhrzeiten "HH:MM" (Berliner Zeit)
  times       String[]
  // Termindauer in Minuten (15/30/45/60) für Termine in diesem Kalender
  durationMin Int      @default(30)
  // Zeiten je Wochentag wie bei Calendly: { step, days: { "1": [["08:00","13:00"]] } }.
  // Gesetzt → gilt statt weekdays/times (die dann nur die Zusammenfassung sind).
  schedule    Json?
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// „Zeit blockieren": in diesem Zeitraum werden keine Termine vorgeschlagen
// oder gebucht (zählt als belegt).
model CalendarBlock {
  id          String   @id @default(cuid())
  customerId  String
  calendarKey String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([calendarKey, endsAt])
  @@index([customerId])
}

// ─── Bank & Karten: Ausgaben importieren und als Kosten zuordnen ─────────
// Verbindung über Enable Banking (PSD2, z. B. Commerzbank) – Zustimmung gilt
// höchstens ~180 Tage. sessionEnc: Session-ID verschlüsselt (ENCRYPTION_KEY).
// status: pending (Weiterleitung läuft) | active | expired | error | revoked
model BankConnection {
  id           String            @id @default(cuid())
  provider     String            @default("enablebanking")
  aspspName    String
  aspspCountry String            @default("DE")
  psuType      String            @default("business")
  // Schutz gegen fremde Callbacks: Zufallswert der Weiterleitung (nur gehasht)
  stateHash    String?           @unique
  sessionEnc   String?
  // [{ uid, name, iban (gekürzt) }]
  accounts     Json?
  validUntil   DateTime?
  status       String            @default("pending")
  lastSyncAt   DateTime?
  lastError    String?
  reminderAt   DateTime?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions BankTransaction[]
}

// Regel: Muster (Teil von Gegenpartei oder Verwendungszweck, ohne Groß-/Kleinschreibung)
// → Zweck (ppl|software|akquise|betrieb) oder ignorieren. vatIncluded: Betrag enthält 19 % USt → netto rechnen.
model CostRule {
  id               String            @id @default(cuid())
  pattern          String
  action           String // ppl | software | akquise | betrieb | ignore
  vatIncluded      Boolean           @default(false)
  /// nur in der Gegenpartei suchen (nicht im Verwendungszweck), z. B. eigener Name für Privat-Überweisungen
  counterpartyOnly Boolean           @default(false)
  label            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactions     BankTransaction[]

  @@unique([pattern])
}

// Einzelne Buchung (Konto oder Kreditkarte). amount: Ausgaben negativ (EUR, brutto).
// status: neu | zugeordnet | ignoriert. Zugeordnete Ausgaben fließen netto in die Zahlen-Seite.
model BankTransaction {
  id           String          @id @default(cuid())
  connectionId String?
  connection   BankConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  // Konto-Schlüssel: Enable-Banking-Konto-UID oder „csv:commerzbank“ / „csv:amex“
  accountKey   String
  externalId   String
  source       String // enablebanking | csv
  bookingDate  DateTime        @db.Date
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("EUR")
  counterparty String?
  purpose      String?
  status       String          @default("neu")
  costPurpose  String?
  vatIncluded  Boolean         @default(false)
  ruleId       String?
  rule         CostRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  note         String?
  assignedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([accountKey, externalId])
  @@index([status, bookingDate])
  @@index([bookingDate])
}

/// Geräte der App-Store-App (iOS/Android) für native Push-Benachrichtigungen
/// (APNs bzw. Firebase Cloud Messaging). Web-Push bleibt in PushSubscription.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  platform   String // ios | android
  token      String   @unique
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Einmal-Übergabe der Anmeldung aus der App in den System-Browser (z. B. für
/// Google-/Microsoft-Kalender verbinden, das Google in eingebetteten Ansichten
/// nicht erlaubt). Gültig 5 Minuten, nur einmal einlösbar.
model AppHandoff {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  next      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Pay-per-Lead-Eingang aus Airtable (alle Lead-Records, auch ohne Käufer):
// Grundlage für „Eingang“ und „von uns abgelehnt“ in der PPL-Auswertung,
// solange die Verteilung noch in Airtable/Zapier läuft. Kein Lead-Inhalt,
// nur Zeitpunkt, Produkt, Ergebnis und Grund.
model PplIntake {
  id         String   @id @default(cuid())
  airtableId String   @unique
  receivedAt DateTime
  // kanonischer Produktschlüssel wie Lead.source; null = ohne Produkt (z. B. Pflege-Check)
  productKey String?
  source     String?
  // geliefert | abgelehnt | offen
  outcome    String
  // Dublette | schwach | Beamter | Weitergabe abgelehnt | kein Abnehmer | wartet auf Zustimmung | in Bearbeitung
  reason     String?
  leadId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([receivedAt])
  @@index([productKey, receivedAt])
}

// ─── „Kollegen empfehlen“ (seit 15.11.2026) ─────────────────────────────
// Kunden (Vermittler) empfehlen performancegrowth an Kollegen (B2B). Der
// Empfohlene trägt sich auf /empfehlen/[code] selbst ein → Vertriebskontakt.
// Prämie für den Empfehler, sobald der Neukunde angenommen und die erste
// Rechnung bezahlt hat (lib/kollegen.ts).

// Persönlicher, stabiler Empfehlungscode je Kunde.
model ReferralCode {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       String   @unique
  createdAt  DateTime @default(now())
}

// Eine Empfehlung (Formular auf der Landingpage).
model ColleagueReferral {
  id              String        @id @default(cuid())
  referrerId      String
  referrer        Customer      @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  // Vertriebskontakt des Empfohlenen (neu angelegt oder bestehender bei Dublette)
  contactId       String?
  contact         SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Angaben des Empfohlenen (Löschfrist: 12 Monate ohne Abschluss, lib/kollegen.pruneReferrals)
  name            String?
  company         String?
  email           String?
  phone           String?
  consentAt       DateTime
  consentText     String
  // Kontakt war vorher schon im CRM (Dublette)
  existingContact Boolean       @default(false)
  // open | blocked (z. B. Selbstempfehlung, schon Kunde)
  status          String        @default("open")
  blockedReason   String?
  // Angebot angenommen (gesetzt bei Prämienprüfung)
  wonAt           DateTime?
  offerId         String?
  // none | processing | credited | manual | done_manual | skipped
  rewardStatus    String        @default("none")
  rewardAmount    Decimal?      @db.Decimal(10, 2)
  // Stripe-Rechnungsposten (negativer Betrag) der Gutschrift
  rewardRef       String?
  rewardNote      String?
  rewardedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([referrerId, createdAt])
  @@index([contactId])
  @@index([createdAt])
}

// Hinweis-Karte „Kollegen empfehlen“ im Kundenbereich: je Anlass höchstens einmal.
model ReferralNudge {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // garantie | abschluss5 | abschluss10 | feedback-day30 | feedback-day90
  key          String
  firstShownAt DateTime  @default(now())
  // weggeklickt, Link geteilt oder nach 14 Tagen abgelaufen
  closedAt     DateTime?

  @@unique([customerId, key])
}

// Einstellungen des Empfehlungsprogramms (eine Zeile, id „default“).
model ReferralSettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(true)
  // month = 1 Monat Betreuung (aktueller Monatspreis des Empfehlers) | fixed = fester Betrag
  rewardKind  String   @default("month")
  rewardFixed Decimal? @db.Decimal(10, 2)
  // none | setup_free (Einrichtung gratis) | custom (eigener Text)
  benefitKind String   @default("none")
  benefitText String?
  updatedAt   DateTime @updatedAt
}

// ─── Zusatzmodul „Empfehlungen & Bewertungen“ ────────────────────────────
// Einstellungen je Kunde (Vertreter). Texte gelten im offenen 24-h-Fenster;
// sonst sendet die App die bei Meta freigegebene Vorlage.
model ReviewSettings {
  id                 String   @id @default(cuid())
  customerId         String   @unique
  // Vertreter kann das Modul pausieren, ohne es zu kündigen
  active             Boolean  @default(true)
  // Link „Bewertung schreiben“ des Google-Unternehmensprofils
  googleReviewUrl    String?
  // Tage nach dem Abschluss: Zufriedenheitsfrage bzw. Bitte um Empfehlung
  reviewDelayDays    Int      @default(7)
  referralDelayDays  Int      @default(21)
  // Eigene Texte (null = Standard): Anfrage (direkter Draht + Google-Link),
  // Dank bei positiver Antwort, Antwort bei Kritik, Bitte um Empfehlung
  reviewText         String?
  thanksText         String?
  unhappyText        String?
  referralText       String?
  referralThanksText String?
  praiseReferralText String?
  // Playbook (14.11.2026): Empfehlungsangebot für die empfohlene Person.
  // none | ordner | kfz | luecke | custom (eigene Überschrift + Text, ohne Prämien)
  offerKind          String   @default("none")
  offerHeadline      String?
  offerText          String?
  // Bei Lob direkt den Empfehlungslink mitschicken (statt erst nach referralDelayDays)
  referralOnPraise   Boolean  @default(true)
  // Rückmeldung an Empfehlende (nur mit Einwilligung der empfohlenen Person)
  statusUpdates      Boolean  @default(true)
  // Aufgabe „Empfehlung nachfassen“ so viele Stunden nach „Empfehlungslink senden“ (0 = aus)
  followUpHours      Int      @default(48)
  // Dankeschön für Empfehlende (Tippgeber-Vergütung), standardmäßig aus. Nie für die empfohlene
  // Person und nie für einen eigenen Vertrag (§ 48b VAG). none | gutschein | spende
  rewardKind         String   @default("none")
  // Wert in Euro
  rewardAmount       Int?
  // Gutschein: Art (z. B. „Wunschgutschein“); Spende: Empfänger
  rewardNote         String?
  // termin = Termin mit der empfohlenen Person hat stattgefunden | abschluss = Abschluss
  rewardTrigger      String   @default("termin")
  // Vertreter hat bestätigt, dass er die Zulässigkeit geprüft hat
  rewardConfirmedAt  DateTime?
  // Nach einem stattgefundenen Termin mit einem Kunden (Abschluss/Bestandskunde) automatisch den
  // Empfehlungslink senden, höchstens alle 180 Tage je Kontakt. Standardmäßig aus.
  referralAfterAppointment Boolean @default(false)
  updatedAt          DateTime @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Je Abschluss eine Anfrage: dieselbe Nachricht an alle (erst direkter Draht zum
// Vertreter, dann Google-Link – kein Gating). Antworten wertet die KI aus:
// Kritik → Aufgabe „Kunde unzufrieden“ + keine Empfehlungsanfrage.
// status „off“ = Vertreter hat „Nicht anfragen“ gewählt (je Kontakt, nie automatisch).
model ReviewRequest {
  id             String    @id @default(cuid())
  customerId     String
  leadId         String    @unique
  // Geheimer Link für Google-Klick-Zählung und Empfehlungsseite
  token          String    @unique
  // scheduled | sent | answered | skipped | failed | off
  status         String    @default("scheduled")
  reviewDueAt    DateTime
  reviewSentAt   DateTime?
  // text (offenes Fenster) | template (freigegebene Vorlage)
  sendMode       String?
  conversationId String?
  // Erste Antwort auf die Anfrage: positive | negative | neutral (KI-Auswertung)
  sentiment      String?
  comment        String?
  answeredAt     DateTime?
  // Kritik geklärt (Vertreter hat „Geklärt“ gewählt)
  resolvedAt     DateTime?
  googleClicks   Int       @default(0)
  googleClickAt  DateTime?
  // waiting | sent | skipped | failed
  referralStatus String    @default("waiting")
  referralDueAt  DateTime?
  referralSentAt DateTime?
  referralViews  Int       @default(0)
  // Grund bei skipped/failed bzw. Hinweis (z. B. „Vorlage noch nicht freigegeben“)
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead      @relation("ReviewRequestLead", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, reviewDueAt])
  @@index([referralStatus, referralDueAt])
}

// Persönlicher Empfehlungslink je Kontakt (Lead mit Abschluss oder Bestandskunde).
// Seite /empfehlung/[token]: der Empfehlende teilt; /empfehlung/[token]/kontakt:
// die empfohlene Person trägt sich selbst ein (mit Einwilligung) → neuer Lead.
model ReferralLink {
  id                 String            @id @default(cuid())
  customerId         String
  token              String            @unique
  leadId             String?           @unique
  existingCustomerId String?           @unique
  views              Int               @default(0)
  lastSentAt         DateTime?
  // contact = Link eines Kontakts | general = allgemeiner Link des Vertreters (E-Mail-Signatur)
  kind               String            @default("contact")
  // Anlass des letzten Versands: schaden | ersparnis | jahresgespraech | termin (QR im Gespräch)
  lastOccasion       String?
  createdAt          DateTime          @default(now())
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead               Lead?             @relation("ReferralLinkLead", fields: [leadId], references: [id], onDelete: Cascade)
  existingCustomer   ExistingCustomer? @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  referredLeads      Lead[]            @relation("ReferredLeads")
  visits             ReferralVisit[]

  @@index([customerId])
}

// Einzelne Besucher der Kontaktseite einer Empfehlung (für den Trichter: Personen statt Klicks).
// visitorHash = gekürzter Hash aus Link, IP und Browser – keine IP im Klartext. Löschfrist 12 Monate.
model ReferralVisit {
  id          String       @id @default(cuid())
  linkId      String
  customerId  String
  visitorHash String
  createdAt   DateTime     @default(now())
  link        ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, visitorHash])
  @@index([customerId, createdAt])
}

// ─── Bewertungs-Wächter (Teil des Moduls „Empfehlungen & Bewertungen“) ───────
// Verbindung zum Google-Unternehmensprofil (Scope business.manage), eigene
// Verbindung neben dem Kalender, nur auf Wunsch. Tokens verschlüsselt.
model GoogleBusinessConnection {
  id              String    @id @default(cuid())
  customerId      String    @unique
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  // pending_location (Standort wählen) | connected | no_access (Google-API noch nicht freigeschaltet) | error
  status          String    @default("pending_location")
  // accounts/123 und locations/456 (Namen aus der Google-API)
  accountName     String?
  locationName    String?
  locationTitle   String?
  lastSyncAt      DateTime?
  lastError       String?
  // Stand beim ersten Abgleich: Entwicklung seit Modulstart
  startAverage    Float?
  startCount      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Google-Bewertung (nur ID, Sterne, Text, Name, Zeitpunkt; Löschfrist 2 Jahre).
// Antworten werden nur nach Klick des Vertreters veröffentlicht.
model GoogleReview {
  id             String    @id @default(cuid())
  customerId     String
  // Name der Bewertung in der Google-API (accounts/…/locations/…/reviews/…)
  googleName     String    @unique
  stars          Int
  text           String?
  reviewerName   String?
  reviewedAt     DateTime
  replyText      String?
  repliedAt      DateTime?
  // KI-Vorschlag (bearbeitbar, nie automatisch veröffentlicht)
  suggestedReply String?
  leadId         String?
  // Push/Aufgabe genau einmal
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, reviewedAt])
}

// Einmalige Ankündigungen an Kunden (z. B. neues Zusatzmodul), vom Admin ausgelöst.
model ModuleAnnouncement {
  id        String   @id @default(cuid())
  key       String   @unique
  sentAt    DateTime @default(now())
  sentCount Int      @default(0)
  sentBy    String?
}

// Google-Places-Anfragen je Tag (Kostenbremse GOOGLE_PLACES_MAX_PER_DAY)
model PlacesUsage {
  day   String @id // YYYY-MM-DD (UTC)
  count Int    @default(0)
}

// Kampagnen-Agenten (lib/kampagnen): ein Lauf = ein Durchgang des KI-Teams für
// eine Meta-Lead-Kampagne eines Kunden. Ergebnisse je Agent als JSON, Meta-IDs in
// „built“ (idempotentes Anlegen; alles PAUSED, veröffentlicht wird von Hand).
model CampaignRun {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           String
  wish              String?
  // queued | running | review | building | built | blocked | failed | cancelled
  status            String    @default("queued")
  // Nach grüner/gelber Prüfung direkt pausiert bei Meta anlegen (1 Klick)
  autoBuild         Boolean   @default(true)
  // Schritte je Agent: [{ key, status, startedAt, finishedAt, error, tokensIn, tokensOut }]
  steps             Json
  context           Json?
  plan              Json?
  angles            Json?
  copies            Json?
  creatives         Json?
  form              Json?
  review            Json?
  // Bei Meta angelegte Objekte (campaignId, adSetIds, formId, imageHashes, creativeIds, adIds)
  built             Json?
  // neu = komplette Kampagne | auffrischung = neue Anzeigen in bestehender Anzeigengruppe
  kind              String    @default("neu")
  // Auslöser: manuell | produkt (Produkt gebucht/Angebot) | auffrischung (Cron)
  trigger           String    @default("manuell")
  // Auffrischung: Ursprungslauf, Meta-Kampagne und -Anzeigengruppe, erkannte müde Anzeigen
  sourceRunId       String?
  refreshCampaignId String?
  refreshAdSetId    String?
  fatigue           Json?
  error             String?
  // KI-Kosten grob in US-Cent und Tokens
  costCents         Int       @default(0)
  tokensIn          Int       @default(0)
  tokensOut         Int       @default(0)
  // Verarbeitung läuft gerade (Schutz vor Doppelverarbeitung durch Cron)
  lockedAt          DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  finishedAt        DateTime?

  @@index([customerId, createdAt])
  @@index([status])
  @@index([refreshCampaignId, createdAt])
}

// Kampagnen-Automatik (Ole, 13.11.2026): Schalter und Schwellen (eine Zeile, id „default“).
model CampaignAutomationSettings {
  id                  String   @id @default("default")
  // Budgetänderung automatisch bei Meta umsetzen (sonst Aufgabe „Meta-Budget …“)
  budgetSync          Boolean  @default(true)
  // Produkt gebucht / Angebot angenommen → Kampagnen-Lauf automatisch starten
  autoLaunch          Boolean  @default(true)
  // Wöchentlich müde Anzeigen erkennen und neue (pausierte) Anzeigen erstellen
  refresh             Boolean  @default(true)
  refreshMaxFrequency Float    @default(3)
  // CTR mindestens 30 % unter den ersten 7 Tagen
  refreshCtrDrop      Float    @default(0.3)
  // Leadpreis mindestens 40 % über dem Kampagnenschnitt
  refreshCplRise      Float    @default(0.4)
  // Mindestausgaben je Anzeige (14 Tage), bevor der Leadpreis zählt
  refreshMinSpendEur  Float    @default(50)
  updatedAt           DateTime @updatedAt
}

// Gewünschter Kampagnen-Lauf (Produkt gebucht / Angebot angenommen), der startet,
// sobald die Voraussetzungen erfüllt sind (Cron prüft offene Wünsche).
model CampaignWish {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product       String
  // produkt | angebot
  source        String
  // waiting | started | done | failed | cancelled
  status        String    @default("waiting")
  // [{ key, message }] – was zuletzt fehlte
  problems      Json?
  runId         String?
  // Aufgabe für Ole (fehlende Voraussetzungen bzw. Fehlschlag)
  taskId        String?
  bookingId     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([customerId, product])
}

// Gesundheitsprüfung je Kunden-Kampagne (Creative-Auffrischung): wann zuletzt geprüft/aufgefrischt.
model CampaignHealth {
  campaignId    String    @id
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lastCheckedAt DateTime?
  lastRefreshAt DateTime?
  // Ergebnis der letzten Prüfung (müde Anzeigen mit Gründen)
  lastResult    Json?
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
}

// ─── Monatsberichte (seit 17.11.2026) ─────────────────────────────────────
// Ein Bericht je Kunde und Monat (Vormonat). Einstufung gut/mittel/schwach ist intern
// (nie für Kunden sichtbar). Nur „gut“ darf automatisch raus (wenn eingeschaltet);
// mittel/schwach bleiben Entwurf, Ole entscheidet (senden, bearbeiten, anrufen, aussetzen).
model MonthlyReport {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // YYYY-MM des berichteten Monats
  month       String
  // gut | mittel | schwach
  rating      String
  // ok | unsicher (zu wenige Ergebnisse eingetragen)
  dataQuality String    @default("ok")
  // Begründungen der Einstufung (intern)
  reasons     Json?
  // Kennzahlen Monat + Vormonat, Maßnahmen (Grundlage für Text und Prüfung)
  metrics     Json
  subject     String
  // Absätze als Liste
  body        Json
  // Ergebnis der Prüfung: { ok, issues[] }
  check       Json?
  // draft | sent | skipped | call
  status      String    @default("draft")
  sentAt      DateTime?
  decidedBy   String?
  costCents   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, month])
  @@index([month, status])
}

// Einstellungen Monatsberichte (eine Zeile, id „default“).
model ReportSettings {
  id                 String   @id @default("default")
  // gut-Berichte automatisch senden (Standard aus: Ole sieht im ersten Monat alles zuerst)
  autoSendGood       Boolean  @default(false)
  senderName         String?
  // Schwellen in % bzw. Anzahl
  goodLeadsPct       Int      @default(85)
  weakLeadsPct       Int      @default(60)
  weakCplPct         Int      @default(150)
  weakNoMeetingLeads Int      @default(15)
  minResultPct       Int      @default(50)
  minActiveDays      Int      @default(14)
  // Ziel-Leadpreis (€); leer = aus dem Rechner (Katze)
  targetCpl          Decimal? @db.Decimal(10, 2)
  // Terminlink für „kurzes Gespräch“; leer = Kundenbereich
  bookingUrl         String?
  updatedAt          DateTime @updatedAt
}

// Selbst-Einrichtung (eine Zeile, id „default“): unsere Business-ID für den Meta-Partnerzugriff
// und je Einrichtungsschritt eine Video-URL (Loom/YouTube), die der Kunde eingebettet sieht.
model SetupSettings {
  id         String   @id @default("default")
  businessId String?
  // {"metaAccess": "https://www.loom.com/share/…", "whatsapp": "…", …}
  videos     Json?
  updatedAt  DateTime @updatedAt
}

// Neuigkeiten im Kundenbereich (/buyer/neuigkeiten): was wir verbessert haben.
// publishedAt = null → Entwurf (für Kunden unsichtbar).
model ProductUpdate {
  id          String    @id @default(cuid())
  title       String
  // Kurzer Text, Absätze und **fett** wie bei der Sondervereinbarung im Angebot
  body        String
  // neu | verbessert | behoben
  kind        String    @default("neu")
  // alle | software (Betreuung + Software) | betreuung (Nur Betreuung)
  audience    String    @default("alle")
  publishedAt DateTime?
  pushedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

/// Vertriebsunterlagen (Ole, 13.11.2026): aktuelle Makler- und Vertreter-Präsentation als PPTX und PDF.
/// Je Zielgruppe und Format genau eine Datei; ein neuer Upload ersetzt die alte.
model SalesPresentation {
  id           String   @id @default(cuid())
  audience     String // "makler" | "vertreter"
  format       String // "pdf" | "pptx"
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedAt   DateTime @default(now())
  uploadedById String?

  @@unique([audience, format])
}

// Verlauf eines Leads im Kundenbereich (Ole, 13.11.2026): gepostete Notizen und Ereignisse
// (Anruf, Status, Wiedervorlage, Abschluss, Police). Gelöscht mit dem Lead (Art. 17).
model LeadHistory {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String
  // notiz | anruf | status | wiedervorlage | abschluss | police | dokument | email
  kind       String
  text       String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

// Dokumente am Lead (Ole, 13.11.2026): z. B. das Angebot, das der Vermittler geschickt hat,
// oder die Police. Gespeichert in der Datenbank, gelöscht mit dem Lead (Art. 17).
model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId   String
  // angebot | police | sonstiges
  kind         String
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([leadId])
}

// Eigenes Postfach eines Logins (Ole, 13.11.2026): E-Mails an Leads aus der App, gesendet über
// Google (Gmail), Microsoft (Outlook/365) oder SMTP. Zugangsdaten verschlüsselt.
model MailConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  // google | microsoft | smtp
  provider        String
  email           String
  fromName        String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassEnc     String?
  // ok | error
  status          String    @default("ok")
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// E-Mail-Vorlagen eines Kunden (Platzhalter {vorname}, {name}, {produkt}, {meinname}).
model MailTemplate {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// LinkedIn: persönliches Profil (Ole, 14.11.2026). KI-Entwürfe nach Reichweite,
// Freigabe per Klick, Veröffentlichen zur geplanten Uhrzeit (docs/linkedin.md).
model LinkedInConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // urn:li:person:{sub}
  personUrn      String
  name           String?
  accessTokenEnc String
  expiresAt      DateTime
  // gewährte Berechtigungen (z. B. „openid profile w_member_social r_member_postAnalytics“)
  scopes         String   @default("")
  // ok | error
  status         String   @default("ok")
  lastError      String?
  // Erinnerung „neu verbinden“ (einmal je Ablauf)
  remindedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Einstellungen (eine Zeile, id „default“)
model LinkedInSettings {
  id          String   @id @default("default")
  postsPerDay Int      @default(5)
  // Uhrzeiten (deutsche Zeit), kommagetrennt
  slots       String   @default("07:30,09:30,12:00,15:00,18:00")
  weekdays    Boolean  @default(true)
  // Über mich, Zielgruppe, Themen, Tonfall – Grundlage für die Entwürfe
  about       String   @default("")
  autoDrafts  Boolean  @default(true)
  // Zielgruppe (ICP): optimiert wird auf Reichweite in dieser Gruppe, nicht auf Reichweite insgesamt
  icp         String   @default("Versicherungsvermittler in Deutschland: Ausschließlichkeitsvertreter (z. B. Allianz-Agenturen), Mehrfachagenten und Makler, die mehr Neukunden wollen. Sie verkaufen z. B. Tierkrankenversicherung, Privatschutz und PKV. Wir verkaufen ihnen Leadgenerierung über Meta-Werbung plus unsere Software mit WhatsApp-Assistent, der Leads qualifiziert und Termine bucht.")
  // Produkt-Schwerpunkt der Posts (Ole, 14.11.2026: Hauptprodukt TKV, PKV nur als Optimierung nach §204 VVG)
  focus       String   @default("Hauptprodukt ist die Tierkrankenversicherung (Katze und Hund): Die meisten Posts drehen sich darum (Leads, Abschlüsse, Cross-Selling aus TKV-Kunden). PKV nur selten und dann ausschließlich als PKV-Optimierung nach §204 VVG (Tarifwechsel beim eigenen Versicherer), nie als PKV-Neugeschäft. Andere Sparten nur am Rand.")
  // Begriffe, an denen die Zielgruppe in den LinkedIn-Zuschauerdaten erkannt wird (Branche, Beruf)
  icpKeywords String   @default("versicherung, insurance, makler, broker, vermittler, agentur, generalvertret, hauptvertret, finanzberat, financial advisor, allianz, ergo, axa, signal iduna, debeka, hallesche, gothaer")
  // Anteil der Zielgruppe an allen Zuschauern (aus dem Profil-Export), Ersatz, wenn je Post nichts vorliegt
  accountIcpShare Float?
  // Trust-Material von Ole (z. B. freigegebene Kundenstimmen, Erfolge) – nur das darf als Fakt/Zitat in Posts
  trustNotes  String   @default("")
  // Vorlauf: so viele Posting-Tage im Voraus hält die Automatik mit Entwürfen gefüllt (Ole, 14.11.2026)
  planDays    Int      @default(1)
  // Uhrzeit (deutsche Zeit), ab der die Entwürfe für den nächsten Tag geschrieben werden
  draftHour   Int      @default(17)
  lastImportAt DateTime?
  // Sperre gegen doppeltes Schreiben (Cron alle 5 Minuten, ein Lauf dauert ca. 1–2 Minuten)
  draftingAt  DateTime?
  updatedAt   DateTime @updatedAt
}

model LinkedInPost {
  id             String    @id @default(cuid())
  // entwurf | freigegeben | sendet | veroeffentlicht | verworfen | fehler | importiert
  status         String
  text           String    @default("")
  // Thema in wenigen Worten und was der Post testen soll
  idea           String?
  hypothesis     String?
  // Tag (YYYY-MM-DD, deutsche Zeit), für den der Entwurf geschrieben wurde
  draftDate      String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  // urn:li:share:… (aus der App) bzw. urn:li:activity:… (aus dem Export)
  postUrn        String?   @unique
  url            String?
  impressions    Int?
  membersReached Int?
  reactions      Int?
  comments       Int?
  reposts        Int?
  engagements    Int?
  metricsAt      DateTime?
  // Quelle der Zahlen: api | export | hand
  metricsSource  String?
  // Anteil der Zielgruppe an den Zuschauern dieses Posts (0–1, aus dem Post-Export)
  icpShare       Float?
  // Text-Grafik (Kernaussage groß auf Blau, ohne Illustration), wenn kein Foto/KI-Bild
  graphic        String?
  useGraphic     Boolean   @default(false)
  // Foto aus der Fotoablage oder KI-Bild (optional); bei Löschung bleibt der Post ohne Bild
  photoId        String?
  photo          LinkedInPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([draftDate])
}

// Fotos von Ole für seine Posts (Ole, 14.11.2026). Beschreibung schreibt die KI beim Hochladen.
model LinkedInPhoto {
  id          String         @id @default(cuid())
  fileName    String
  contentType String
  size        Int
  data        Bytes
  description String         @default("")
  // true = KI-Bild zu einem Entwurf (nicht in der Fotoablage gezeigt)
  generated   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  posts       LinkedInPost[]
}
