// KPI Dashboard – Datenmodell
// Modelliert Leads, Kontaktversuche, Umsätze und Kosten pro Kunde.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Eigener Sales-Prozess von Performance Growth — separater Airtable-Base
// "Deal-Pipeline". Spiegel der Airtable-Records in der DB, damit Kanban /
// KPI / Activity-Timeline ohne Airtable-Round-Trip funktionieren.
model Deal {
  id         String    @id @default(cuid())
  airtableId String?   @unique
  name       String?
  company    String?
  email      String?
  phone      String?
  // Deal-Wert in EUR. Nullable, weil frische Leads den Wert oft noch
  // nicht hinterlegt haben.
  value      Decimal?  @db.Decimal(12, 2)
  // Aktueller Bearbeitungsstatus aus Airtable (Single-Select-Text). Wird
  // im Kanban als Spalten-Zuordnung verwendet (siehe SALES_PIPELINE_PHASES
  // in src/lib/sales.ts).
  status     String?
  // Sales-Rep / Owner (Text oder Email — flexibel, wie's aus Airtable kommt).
  owner      String?
  source     String?
  // Verkauftes Produkt / Paket. String aus Airtable-Spalte
  // (typischerweise Single-Select oder freier Text).
  product    String?
  // Erwartetes oder tatsächliches Abschluss-Datum.
  closeDate  DateTime?
  // Gesetzt sobald der Deal auf "Gewonnen" steht — für Win-Rate-Berechnung.
  wonAt      DateTime?
  // Gesetzt sobald der Deal auf "Verloren" steht.
  lostAt     DateTime?
  lostReason String?
  notes      String?
  // Frei editierbares Feld „Testcharge" (Detailansicht). Spiegelt das
  // gleichnamige Airtable-Feld; freier Text.
  testCharge String?
  // Vom Admin manuell „geschlossen" — verschwindet aus dem aktiven CRM-Kanban,
  // zählt aber weiter in die Sales-Statistiken (Win-Rate, Erreichbarkeit …).
  archived   Boolean   @default(false)
  // Voller Airtable-Record-Snapshot für die Detail-Ansicht. Erspart einen
  // zweiten Airtable-Call beim Öffnen des Modals.
  rawFields  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  activities DealActivity[]
  offers     Offer[]

  @@index([status])
  @@index([owner])
  @@index([wonAt])
  @@index([createdAt])
}

// Activity-Timeline: Notizen, Anrufe, Mails, Termine, automatische
// Status-Change-Einträge. Wohnt nur in der DB — Airtable kennt das
// Konzept (noch) nicht.
model DealActivity {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // "note" | "call" | "email" | "meeting" | "status_change"
  kind         String
  title        String
  body         String?
  // Optionaler Planungs-Zeitpunkt für zukünftige Aktivitäten
  // (Wiedervorlage, Termin, Folge-Anruf …). Wenn gesetzt, zeigt die
  // CRM-Kanban-Card die nächste anstehende Aktivität statt des letzten
  // Updates. createdAt bleibt der reine Anlage-Zeitpunkt.
  scheduledFor DateTime?
  // Abgehakt/erledigt am. Gesetzt = die Aktivität fällt aus „Heute"/„Kommende"
  // (nur noch in der Historie sichtbar).
  completedAt  DateTime?
  // Zusatzdaten je Kind (z. B. {fromStatus, toStatus} bei status_change).
  metadata     Json?
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@index([dealId, scheduledFor])
}

model Customer {
  id                   String    @id @default(cuid())
  name                 String    @unique
  createdAt            DateTime  @default(now())
  // Testkunde (Ole, 15.11.2026): aus einem Testangebot ohne Zahlung; zählt nicht in Admin-Zahlen,
  // Buchungen, Stornoquote, Monatsbericht und Platz-Abrechnung, im Admin mit Abzeichen „Test“, löschbar.
  isTest               Boolean   @default(false)
  // Pilot (Ole, 20.11.2026): echter Kunde, kostenlos bis zu diesem Tag (einschließlich). Kein Testkunde, zählt in
  // allen Kennzahlen. Solange er läuft: keine automatische Abrechnung der Verkäufer-Plätze; Aufgaben 7 Tage vorher
  // und am Ende (lib/pilot-server.ts). Ein schon laufendes Stripe-Abo bleibt unberührt (Hinweis im Admin).
  pilotBis             DateTime?
  // E-Mail-Funktionen aus (Ole, 15.11.2026): „Meine Gesellschaft erlaubt das nicht“ in der Einrichtung.
  // Blendet E-Mail-Knopf, E-Mail-Fenster, Vorlagen-Hinweise und den E-Mail-Kanal bei Bestandskampagnen aus;
  // wieder einschaltbar unter Einstellungen → E-Mail-Postfach.
  mailFeaturesOff      Boolean   @default(false)
  // Stripe-Kunde für Abrechnung (Rechnungen, Zahlungsart, Abo)
  stripeCustomerId     String?   @unique
  // Paket: "software" = Betreuung + Software, "service" = nur Betreuung
  // (Leads per E-Mail, Kundenbereich nur mit Leads und Zahlen)
  plan                 String    @default("software")
  // Status nach § 34d GewO: "vertreter" (Ausschließlichkeit), "mehrfachvertreter" oder "makler"; bestimmt die
  // Standard-Provisionssätze (Mehrfachvertreter rechnen wie Vertreter) und die Erstinformation (lib/erstinformation.ts)
  vermittlerTyp        String    @default("vertreter")
  // Registerprüfung für Pay-per-Lead (Ole, 20.11.2026; docs/recht/ust-leadverkauf-2026-11-19.md): vor der ersten Lieferung
  // im Vermittlerregister geprüft. Nur mit Status vertreter/makler, gültiger Registernummer und Prüfdatum sind Leads
  // steuerfrei nach § 4 Nr. 11 UStG (lib/ppl/steuer.ts); sonst 19 %. Unabhängig von vermittlerTyp (Selbstauskunft).
  // Registernummer (D-XXXX-XXXXX-XX) laut Vermittlerregister
  vermittlerRegisterNr     String?
  // vertreter (§ 34d Abs. 1 oder gebunden Abs. 7) | makler | keiner (auch Versicherungsberater, Händler); null = nicht geprüft
  vermittlerRegisterStatus String?
  vermittlerGeprueftAt     DateTime?
  // E-Mail des Admins, der geprüft hat
  vermittlerGeprueftVon    String?
  // Angaben für die öffentliche Partnerliste der Funnels (Ole, 20.11.2026, docs/recht/pkv-funnel.md L2): rechtlicher
  // Empfänger der Leads, wenn er vom Kontonamen abweicht (z. B. Vertriebspartner eines Maklers). Unabhängig von der
  // Registerprüfung oben (Umsatzsteuer).
  // Admin liest mit (Ole, 21.11.2026): Push an Admins bei neuem Lead, gebuchtem Termin und Abschluss (erste Kunden).
  adminMitlesen            Boolean   @default(true)
  partnerFirma             String?
  partnerAnschrift         String?
  partnerRegisterNr        String?
  // Bestellkonto (Ole, 22.11.2026): Hauptkunde, der für dieses Konto (seinen Vertriebspartner) die Wochenbestellungen
  // aufgibt und bezahlt (Zahlungsart, Rechnung und Registerprüfung für die Umsatzsteuer am Hauptkunden). Der Partner
  // bekommt die Leads in seinem Konto, bestellt aber nicht selbst. Hauptkunde mit Login landet auf /bestellung.
  bestelltUeberId          String?
  bestelltUeber            Customer?  @relation("Bestellkonto", fields: [bestelltUeberId], references: [id], onDelete: SetNull)
  bestellPartner           Customer[] @relation("Bestellkonto")
  // Maklervollmacht (Ole, 18.11.2026, nur Makler): wer schickt sie den Kunden? app | eigene; null = noch nicht entschieden
  // (Frage in der Einrichtung und als Hinweis auf „Heute“, änderbar unter Einstellungen → Assistent)
  vollmachtVersand     String?
  // Eigene Provisionssätze je Produkt (Kundenbereich → Konto → Meine Provisionen),
  // geprüft über lib/provision.parseCustomRates; null = Standard
  provisionRates       Json?
  // Eigene Produkte (Sparte „Sonstiges“) mit Standardsätzen: [{ name, rateAbschluss, rateBestand }] (lib/eigene-produkte.ts)
  customProducts       Json?
  // Eigene Stornoquote pro Jahr für alle Prognosen (Anteil 0–0,5; null = Standard 10 %, lib/provision.STORNO_PRO_JAHR).
  // Je Produkt optional in provisionRates (storno).
  stornoQuote          Decimal?  @db.Decimal(5, 4)
  // Kunde hat seine Provisionen geprüft (auch ohne Abweichung vom Standard) – Einrichtungsschritt erledigt
  provisionCheckedAt   DateTime?
  // Kein aktueller Bezug mehr (aus Airtable) → in Listen ausgeblendet, Historie bleibt
  archived             Boolean   @default(false)
  // Jeder neue Lead zusätzlich per E-Mail an den Kunden (Kundenbereich → Konto)
  leadEmail            Boolean   @default(true)
  // Zahlungsverzug: seit wann eine Rechnung offen/fehlgeschlagen ist, Warnung verschickt
  paymentOverdueSince  DateTime?
  paymentWarnedAt      DateTime?
  // Überweisung (Ole, 17.11.2026, lib/ueberweisung.ts): erlaubt (aus dem Angebot übernommen, in der Kundenakte
  // änderbar), Zahlungsziel in Tagen und ob der Kunde tatsächlich per Rechnung/Überweisung zahlt
  allowBankTransfer    Boolean   @default(false)
  bankTransferDays     Int       @default(14)
  zahltPerUeberweisung Boolean   @default(false)
  // Mahnwesen (lib/mahnwesen.ts): Stopp je Kunde (z. B. Absprache), mit Grund und Zeitpunkt
  mahnStopp            Boolean   @default(false)
  mahnStoppGrund       String?
  mahnStoppAt          DateTime?

  // ─── Media-Buyer-Daten (aus Airtable-Buyer-Tabelle) ─────────────────
  // Lead-Ziele, Preise und Startdaten je Produkt liegen seit dem Product-/
  // CustomerProduct-Refactor (Option B) NICHT mehr als hardcoded Spalten hier,
  // sondern produkt-agnostisch in CustomerProduct (eine Zeile pro Kunde ×
  // Produkt). So skalieren neue Produkte ohne Schema-Migration.
  //
  // Region des Kunden (z.B. "Berlin"). Bestimmt, in welchen regionsbasierten
  // Pool (z. B. Kinderwunsch) die Leads/Ziele dieses Kunden fallen, wenn die
  // CustomerProduct-Zeile selbst keine eigene Region trägt.
  region String?

  // ─── Retainer-Modell (aus Airtable „Kunden") ─────────────────────────
  // Gesetzt = Kunde zahlt Retainer + eigenes Werbebudget statt Lead-Preis.
  // Im Kunden-Dashboard: Lead-Kosten = Werbespend (eigenes Konto) + Retainer
  // (tagesanteilig ab retainerStart). Taucht NICHT als Agentur-Kosten auf.
  retainerMonthly       Decimal?                 @db.Decimal(12, 2)
  retainerStart         DateTime?
  // Letzter Tag mit Retainer (inklusive), von Hand in Kundenakte → Abrechnung; null = läuft
  retainerEnd           DateTime?
  // „Vertrag hier kündigen“ im Kundenbereich (Konto & Rechnungen, 15.11.2026): Eingang der Kündigung, letzter
  // Vertragstag laut AGB (lib/vertrag-laufzeit.cancelDate), wer gekündigt hat und optionaler Grund. Ole setzt danach
  // retainerEnd und beendet das Stripe-Abo zum Termin (Aufgabe in „Heute“).
  cancelRequestedAt     DateTime?
  cancelEffectiveAt     DateTime?
  cancelRequestedBy     String?
  cancelReason          String?
  // ─── Ruhendes Konto nach Vertragsende (Ole, 15.11.2026, lib/ruhend.ts) ───
  // Nach Vertragsende ruht das Konto: kein Zugang außer Export und Reaktivierung, keine Verarbeitung außer
  // Speicherung (Crons, Assistent, Kampagnen, Abgleiche aus). Gesetzt vom täglichen Cron am Tag nach dem Vertragsende.
  dormantSince          DateTime?
  // Gewählte Aufbewahrung nach Vertragsende: "24m" (Standard) | "3m" | "sofort"; null = noch nicht gekündigt
  retentionChoice       String?
  // Ab hier ist die endgültige Löschung fällig (Ende des Vertragstags + gewählte Monate, Berliner Zeit)
  deleteAfter           DateTime?
  // Erinnerungen 30 und 7 Tage vor der Löschung (je einmal; beim Ändern der Aufbewahrung zurückgesetzt)
  retentionReminder30At DateTime?
  retentionReminder7At  DateTime?
  // Endgültig gelöscht (Leads anonymisiert, Logins und Inhalte weg; Abrechnungsdaten bleiben)
  dataDeletedAt         DateTime?
  lifecycleEvents       CustomerLifecycleEvent[]
  // ─── Halteangebote beim Kündigen (Ole, 15.11.2026, lib/halteangebote-server.ts) ───
  // Nach angenommenem Rabatt: Vertrag läuft mindestens bis Ende dieses Tags (Berlin); frühere Kündigung wirkt erst dann
  retentionCommitUntil  DateTime?
  // Rückkehrangebot per E-Mail 30 Tage nach Vertragsende verschickt (einmal je Kunde, lib/ruhend.ts)
  winbackOfferAt        DateTime?
  retentionOffers       RetentionOffer[]
  // Eigenes Meta-Werbekonto des Kunden (nur Ziffern, ohne „act_").
  metaAdAccountId       String?
  // Facebook-Seite des Kunden für Lead-Ads (Kampagnen-Agenten); sonst aus LeadSource.pageId
  metaPageId            String?
  // ─── Rückmeldung an Meta (Conversions API für CRM, „Conversion Leads“; Ole, 15.11.2026, lib/capi) ───
  // Stufen der Meta-Leads (Lead, Erreicht, Termin vereinbart, Abschluss) an das Dataset senden; Standard an,
  // nur der Inhaber schaltet (Einstellungen → Rückmeldung an Meta). Testkunden senden nie.
  capiEnabled           Boolean                  @default(true)
  // Meta-Dataset (Pixel-ID) für die Rückmeldung; automatisch aus act_<metaAdAccountId>/adspixels (erstes) oder im Admin gesetzt
  metaDatasetId         String?
  // "auto" | "admin" (von Hand gesetzt, wird nicht automatisch überschrieben)
  metaDatasetSource     String?
  // Letzter automatischer Suchversuch und dessen Problem (z. B. kein Dataset, kein Zugriff), Tokens geschwärzt
  metaDatasetCheckedAt  DateTime?
  metaDatasetError      String?
  capiEvents            CapiEvent[]

  leads            Lead[]
  garantieFaelle   GarantieFall[]
  revenues         Revenue[]
  costs            Cost[]
  users            User[]
  customerProducts CustomerProduct[]
  adSpendDaily     AdSpendDaily[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  onboarding                     Onboarding?
  mahnfaelle                     Mahnfall[]
  feedback                       CustomerFeedback[]
  pauses                         CustomerPause[]
  absences                       UserAbsence[]
  whatsAppFees                   WhatsAppFeeCharge[]
  leadSubscriptions              LeadSubscription[]
  // Modul „Bestandskunden-Kampagnen“ (Zusatzmodul; Testkunden kostenlos)
  existingCustomersEnabled       Boolean                   @default(false)
  // Bestandskunden-Modul im Kundenbereich sichtbar, auch ohne Buchung (Ole testet, 15.11.2026; Admin → Abrechnung).
  // Solange BESTAND_MODULE_AVAILABLE aus ist, sehen das Modul nur Kunden mit diesem Schalter oder aktivem Modul.
  bestandSichtbar                Boolean                   @default(false)
  // ─── Preise: Berater-Plätze, Zahlweise, Bestandskunden-Modul (seit 11.11.2026) ───
  // Inklusive Logins laut Angebot; null = keine Platz-Abrechnung (Alt-Verträge, individuell)
  seatsIncluded                  Int?
  // Preis je weiterem Login und Monat (netto), aus dem Angebot eingefroren
  seatMonthly                    Decimal?                  @db.Decimal(10, 2)
  // Zurzeit im Stripe-Abo berechnete weitere Logins (Menge der Platz-Position)
  seatsBilled                    Int                       @default(0)
  // "month" | "year" (jährlich im Voraus, Jahresbetrag = (12 − Freimonate) × Monatspreis)
  // | "halfyear" (6 Monate im Voraus bei 6 Monaten Laufzeit, Betrag = (6 − Freimonate) × Monatspreis; Ole 18.11.2026)
  billingInterval                String                    @default("month")
  // Geschenkte Monate je Vorauszahlungszeitraum, eingefroren bei Annahme bzw. beim Umstellen der Zahlweise
  // (Jahreszahlung bis 18.11.2026: 2, seitdem 3; 6 Monate: 1). null = monatlich bzw. heutiger Standard (offer-pricing.ts)
  prepayFreeMonths               Int?
  // Vorauszahlung (halbjährlich/jährlich): Erinnerung 30 Tage vor Ende verschickt für den Zeitraum, der an diesem
  // Tag endet (lib/vorauszahlung-erinnerung.ts, gegen Doppelversand)
  prepayReminderFor              DateTime?
  // Abrechnungstag aus dem Angebot (lib/abrechnungstag.ts): Tag im Monat (null = wie Start) und erster
  // Abrechnungstag. Laufzeit und Abrechnungsmonate zählen ab billingStart, Leads und Kampagne ab dem Start.
  billingDay                     Int?
  billingStart                   DateTime?
  // Gebuchtes Bestandskunden-Modul: Monatspreis netto; null = nicht gebucht
  bestandMonthly                 Decimal?                  @db.Decimal(10, 2)
  // Bestandsschutz: nutzte das Modul schon vor der Preisliste, bleibt kostenlos freigeschaltet
  bestandGrandfathered           Boolean                   @default(false)
  // Kunde hat das Modul im Konto angefragt (Admin „Heute“)
  bestandRequestedAt             DateTime?
  // Modul zum Ende des Abrechnungszeitraums gekündigt: Zugang bis hier, danach schaltet der Cron ab
  bestandCancelAt                DateTime?
  // Kampagnen-Nachrichten je Monat inklusive; null = Standard aus der Preisliste
  bestandMessageQuota            Int?
  // Bestandskunden-Modul gratis bis (Empfehlungsprämie); Hinweis 2 Wochen vorher (bestandFreeReminded)
  bestandFreeUntil               DateTime?
  bestandFreeReminded            DateTime?
  // Zusatzpakete automatisch nachbuchen (500er-Pakete) bis höchstens so viele € netto je Monat; null = aus (Standard)
  bestandAutoTopUpMax            Int?
  bestandPacks                   BestandMessagePack[]
  existingImports                ExistingCustomerImport[]
  // ─── Bestandskampagnen: Einwilligung je Kanal und E-Mail (Ole, 14.11.2026) ───
  // Bestätigung zu § 7 Abs. 3 UWG: Adressen aus Vertragsabschlüssen, Hinweis auf Widerspruch bei Erhebung. Ohne sie gehen ohne Einwilligung keine Mails raus.
  bestandUwgConfirmedAt          DateTime?
  bestandUwgConfirmedById        String?
  // Bestätigung beim ersten Kampagnenstart: Nutzung der Kundendaten im Rahmen des Vertretervertrags bzw. der Befugnisse.
  // Seit 15.11.2026 für gebundene Vertreter schon vor dem ersten Import, mit Textversion (lib/bestand/befugnis.ts)
  bestandAgentConfirmedAt        DateTime?
  bestandAgentConfirmedById      String?
  bestandAgentConfirmedVersion   String?
  // Sparten, die der Ausschließlichkeitsvertreter anbietet (Vorschläge „Lücke schließen“ nur dafür); leer = aus dem Bestand
  bestandSparten                 String[]                  @default([])
  // Pflichtangaben/Impressum unter jeder Kampagnen-Mail (vorbefüllt aus dem Impressum der Website)
  bestandMailImprint             String?
  // Hinweis „Einwilligungen aus dem pauschalen Import prüfen“ bestätigt
  bestandLegacyConsentReviewedAt DateTime?
  bestandConsentLogs             BestandConsentLog[]
  bestandOptOuts                 BestandOptOut[]
  // Ansprache der Bestandskunden in allen Texten an sie (Kampagnen, Geburtstag, Einwilligung, Abmeldung, Mails):
  // "sie" | "du", entscheidet der Vermittler (Ole, 18.11.2026). Getrennt von leadAddress (Leads).
  bestandAddress                 String                    @default("sie")
  // ─── Zusatzmodul „Empfehlungen & Bewertungen“ (seit 12.11.2026) ───
  // Freigeschaltet (Zugang); Abrechnung über empfehlungMonthly bzw. Testphase
  empfehlungEnabled              Boolean                   @default(false)
  // Berechneter Monatspreis netto; null = (noch) nicht berechnet (Testphase, kostenlos)
  empfehlungMonthly              Decimal?                  @db.Decimal(10, 2)
  // Testphase bis hier (gesetzt = Testphase wurde genutzt); danach automatisch kostenpflichtig
  empfehlungTrialEndsAt          DateTime?
  empfehlungTrialReminded        DateTime?
  // Vom Admin kostenlos freigeschaltet (keine Berechnung)
  empfehlungFree                 Boolean                   @default(false)
  // Gekündigt: Zugang bis hier, danach schaltet der Cron ab
  empfehlungCancelAt             DateTime?
  // Seit wann aktiv: nur Abschlüsse ab hier lösen Anfragen aus
  empfehlungSince                DateTime?
  // Weggeklickte Hinweise auf Zusatzmodule (Schlüssel je Stelle)
  moduleHintsDismissed           String[]                  @default([])
  // Cross-Selling Teil C (Ole, 16.11.2026): Vorsorge-Themen, die die Terminvorbereitung nicht vorschlagen soll
  // (pkv | bu | risikoleben | pflege), z. B. Vertreter ohne PKV-Angebot. Leer = alle an.
  vorsorgeThemenAus              String[]                  @default([])
  // Erinnerung „Weiteres Produkt anbieten?“ 3 Wochen nach dem ersten Abschluss (Cross-Selling, Standard an)
  crossSellReminder              Boolean                   @default(true)
  // Aufgabe „Police da und erste Zahlung erfolgt?“ 2 Wochen nach dem ersten Abschluss (Standard an)
  policeReminder                 Boolean                   @default(true)
  // Weggeklickte Tipps der Karte „So holen Sie mehr raus“ (/buyer/zahlen): { tippSchlüssel: ISO-Datum }, je 30 Tage
  zahlenTipsDismissed            Json?
  // Neue Oberfläche des Kundenbereichs (Vertreter-A); pro Kunde im Admin einschaltbar.
  newUi                          Boolean                   @default(false)
  // Ansprache von Leads und Kunden in allen Texten (E-Mail, WhatsApp-Assistent, Vorlagen, Termin-Nachrichten): "sie" | "du" (Ole, 14.11.2026)
  leadAddress                    String                    @default("sie")
  // Du/Sie gegenüber dem Vermittler selbst (unserem Kunden): Begrüßung, persönliche Mails, Push (Ole, 18.11.2026).
  // Aus dem angenommenen Angebot (Offer.mailDu), im Admin änderbar; null = unbekannt, dann Sie (lib/vermittler-ansprache.ts).
  // Nicht verwechseln mit leadAddress (Ansprache der Leads). Die Oberfläche bleibt in Sie-Form.
  vermittlerDu                   Boolean?
  // Policen per WhatsApp, Kranken/BU/Leben je Vermittler (Rechtsprüfung A5, Ole 18.11.2026): an, wenn der Vermittler
  // der AVV-Ergänzung (b) zugestimmt hat (Karte unter Einstellungen) UND seine Datenschutzhinweis-URL hinterlegt ist
  // (lib/policen/regeln.ts gesundheitFreigegeben). Intern/Test (Oles eigenes Konto, Testkunden): sofort an.
  policenIntern               Boolean   @default(false)
  policenAvvZugestimmtAt      DateTime?
  policenAvvVersion           String?
  policenAvvUserId            String?
  // „Später“ auf der Freischaltkarte (Heute, Terminvorbereitung); ab 3 nur noch unter Einstellungen
  policenAvvSpaeter           Int       @default(0)
  policenDatenschutzUrl       String?
  // Branding für Präsentationen (Ole, 15.11.2026): Logo von der Agentur-/Makler-Webseite oder hochgeladen,
  // vom Kunden bestätigt („darf ich verwenden“)
  brandLogo                      Bytes?
  brandLogoType                  String?
  brandLogoSource                String?
  brandLogoConfirmedAt           DateTime?
  // Stand der Standard-E-Mail-Vorlagen (lib/mail/vorlagen.ts VORLAGEN_STAND): neue Standards beim nächsten Laden ergänzen
  mailVorlagenStand              Int                       @default(0)
  // E-Mails in der Customer Journey (Ole, 17.11.2026, docs/plan-mail-vorlagen.md, lib/mail/ablauf.ts): Stufe je Vorlage
  // (auto | tipp | aus), BCC-Kopie (an, Adresse; null = eigene) und wann „Ja, Mails in meinem Namen senden“ bestätigt
  // wurde. null = Voreinstellungen laut Plan, BCC aus.
  mailAblauf                     Json?
  existingCustomers              ExistingCustomer[]
  whatsAppErrorAlerts            WhatsAppErrorAlert[]
  manualRevenues                 ManualRevenue[]
  campaigns                      CustomerCampaign[]
  leadSources                    LeadSource[]
  salesContact                   SalesContact?
  whatsAppAccount                WhatsAppAccount?
  calendarConnection             CalendarConnection?
  agentConfig                    AgentConfig?
  calendarLeadTimes              CalendarLeadTimes[]
  calendarBlocks                 CalendarBlock[]
  kalenderWeiterleitungen        KalenderWeiterleitung[]
  conversations                  Conversation[]            @relation("ConversationCustomer")
  whatsAppAppContacts            WhatsAppAppContact[]
  /// Support-Chats (Support-Nummer), die diesem Kunden zugeordnet sind (lib/whatsapp/support-contacts.ts)
  supportConversations           Conversation[]            @relation("ConversationLinkedCustomer")
  /// Kündigungsabsichten aus dem Anti-Churn-Flow (lib/anti-churn-server.ts)
  churnIntents                   ChurnIntent[]
  appointments                   Appointment[]
  messageTemplates               MessageTemplate[]
  consentOptIns                  ConsentOptIn[]
  adSpend                        CustomerAdSpend[]
  budgets                        CustomerBudget[]
  budgetChanges                  BudgetChange[]
  productBookings                ProductBooking[]
  // „Kollegen empfehlen“ (B2B-Empfehlungsprogramm, lib/kollegen.ts)
  referralCode                   ReferralCode?
  colleagueReferrals             ColleagueReferral[]
  referralNudges                 ReferralNudge[]
  reviewSettings                 ReviewSettings?
  reviewRequests                 ReviewRequest[]
  referralLinks                  ReferralLink[]
  googleBusiness                 GoogleBusinessConnection?
  googleReviews                  GoogleReview[]
  // Kampagnen-Agenten (lib/kampagnen)
  campaignRuns                   CampaignRun[]
  // Monatsberichte (lib/monatsbericht): je Kunde abschaltbar
  monthlyReportsOff              Boolean                   @default(false)
  monthlyReports                 MonthlyReport[]
  campaignWishes                 CampaignWish[]
  campaignHealth                 CampaignHealth[]
  mailTemplates                  MailTemplate[]
  // Automatische Optimierung je Werbekonto (lib/optimierung, seit 18.11.2026)
  optimizationAccount            OptimizationAccount?
  optimizationMeasures           OptimizationMeasure[]
  // Erstinformation nach § 15 VersVermV (Registernummer, PDF oder Link, öffentliche Adresse)
  erstinformation                Erstinformation?
  // Tarifkatalog (Terminvorbereitung, Ole 15.11.2026): Gesellschaft(en) des Vertreters bzw. bevorzugte des Maklers
  // (Schlüssel wie data/tarifkatalog/<gesellschaft>); leer = aus Erstinformation bzw. Name abgeleitet
  tarifGesellschaften            String[]                  @default([])
  // Makler (§ 60 Abs. 1, 2 VVG): eigener Hinweis auf die Marktauswahl in der Präsentation, NULL = Standard
  // „Verglichen wurden Tarife von {gesellschaften}.“ (lib/praesentation.ts, Einstellungen → Präsentation)
  maklerMarkthinweis             String?
  eigeneTarife                   EigenerTarif[]
  tarifVorschlaege               TarifVorschlag[]
  beraterMerkmale                BeraterMerkmale[]
  maklervollmachten              Maklervollmacht[]
  // Beratungsdokumentation als Angebot (Paket B, Ole 18.11.2026, lib/beratungsdoku-server.ts): Schalter je Vermittler,
  // Standard aus. Zeitpunkt des letzten Einschaltens für die Nutzungsmessung (Admin Betreuen › Qualität & Nutzung).
  beratungsdokuAn                Boolean                   @default(false)
  beratungsdokuAnAt              DateTime?
  // Frage „Beratungsdokumentation vorbereiten?“ beantwortet (Einrichtung, einmal nach dem ersten Termin-Ergebnis oder
  // der Schalter selbst, Ole 18.11.2026). Gesetzt = nie wieder fragen.
  beratungsdokuGefragtAt         DateTime?
  beratungsdokus                 Beratungsdoku[]
  praesentationEreignisse        PraesentationEreignis[]
}

// Tagesbudget je Produkt (Kundenbereich → Konto → Werbebudget). Ohne Eintrag gilt das
// angenommene Angebot (Offer.products). Je Produkt gilt der jüngste Eintrag mit validFrom ≤ jetzt.
model CustomerBudget {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     String
  dailyBudget Decimal  @db.Decimal(10, 2)
  validFrom   DateTime
  changeId    String?
  createdAt   DateTime @default(now())

  @@index([customerId, validFrom])
}

// Budgetänderung durch den Kunden: Protokoll, Preisstufe und Stand der Stripe-Anpassung.
model BudgetChange {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String?
  // [{ product, from, to }] in €/Tag
  changes           Json
  effectiveFrom     DateTime
  monthlyBudgetFrom Int
  monthlyBudgetTo   Int
  // Monatspreis Betreuung + Software (netto) vorher/nachher; null = individuell/kein Listenpreis
  feeFrom           Decimal?  @db.Decimal(10, 2)
  feeTo             Decimal?  @db.Decimal(10, 2)
  tierChange        Boolean   @default(false)
  // Kunde hat den neuen Monatspreis bestätigt (Pflicht bei Stufenwechsel)
  acknowledged      Boolean   @default(false)
  // applied = übernommen | pending = Anfrage an uns (über Listenpreis) | rejected
  status            String    @default("applied")
  // Warum Anfrage bzw. Preis von Hand: individual_budget | individual_terms | annual | no_offer_price
  reason            String?
  // Stripe: none (kein Preiswechsel) | scheduled (ab effectiveFrom) | done | manual (Admin-Aufgabe) | error
  stripeStatus      String    @default("none")
  stripeNote        String?
  // Meta: none (nicht nötig/aus) | scheduled (ab effectiveFrom) | done | manual (Admin-Aufgabe) | error
  metaStatus        String    @default("none")
  metaNote          String?
  // Monatspreis im Abo geändert (Abrechnung ab dem nächsten Abrechnungsmonat)
  feeAppliedAt      DateTime?
  note              String?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([stripeStatus, effectiveFrom])
}

// Weiteres Produkt (Sparte/Kampagne) selbst buchen (Kundenbereich → Konto → Produkte).
// Das Budget zählt erst ab „Gestartet“ (Admin): dann entsteht der CustomerBudget-Eintrag.
model ProductBooking {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String?
  // Katalog-Schlüssel (ProductCatalogItem.key bzw. Standardkatalog) und Produktname wie im Budget
  catalogKey        String
  product           String
  dailyBudget       Decimal   @db.Decimal(10, 2)
  // Startwunsch des Kunden (null = so bald wie möglich)
  startWish         DateTime?
  // requested = Anfrage (über individualFrom) | setup = in Einrichtung | live | rejected | ended
  status            String    @default("setup")
  monthlyBudgetFrom Int
  monthlyBudgetTo   Int
  // Monatspreis Betreuung + Software (netto) vorher/nachher; null = individuell
  feeFrom           Decimal?  @db.Decimal(10, 2)
  feeTo             Decimal?  @db.Decimal(10, 2)
  setupFee          Decimal   @db.Decimal(10, 2)
  tierChange        Boolean   @default(false)
  acknowledged      Boolean   @default(false)
  // list = Listenpreis, automatisch | individual = Preis von Hand (Aufgabe) | fixed = Paket ohne Staffel
  pricing           String    @default("list")
  reason            String?
  // Einrichtungsgebühr: none | added | manual | removed | error
  setupStatus       String    @default("none")
  setupItemId       String?
  // Monatspreis im Abo (beim Start): none | pending | done | manual | error | reverted
  feeStatus         String    @default("none")
  stripeNote        String?
  note              String?
  decidedBy         String?
  startedAt         DateTime?
  rejectedAt        DateTime?
  endRequestedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

// Katalog buchbarer Produkte (Admin → Einstellungen → Produkte). Ohne Zeile gilt der Standard
// aus lib/produkt-buchen-shared.ts (DEFAULT_CATALOG).
model ProductCatalogItem {
  key       String   @id
  name      String
  benefit   String
  proven    Boolean  @default(false)
  enabled   Boolean  @default(false)
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Tagesspend aus dem EIGENEN Werbekonto eines Kunden (Retainer-Modell).
// Bewusst getrennt von Cost: das ist Geld des Kunden, keine Agentur-Kosten.
// Meta-Kosten je Anzeige und Tag (Ole, 17.11.2026, lib/anzeige-kosten.ts): Insights level=ad, täglicher Abgleich
// der letzten Tage, beim ersten Lauf bis 90 Tage zurück, nie vor dem Startdatum des Kunden. customerId leer =
// Agentur-/Pool-Kampagne ohne eindeutigen Kunden. Damit werden Kosten pro Termin/Abschluss je Anzeige rechenbar.
model AdSpendDaily {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Werbekonto (nur Ziffern, ohne „act_“)
  adAccountId  String
  campaignId   String?
  campaignName String?
  adSetId      String?
  adSetName    String?
  adId         String
  adName       String?
  // Tag, 12:00 UTC (wie CustomerAdSpend)
  date         DateTime
  spend        Decimal   @db.Decimal(12, 2)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  // Leads laut Meta (actions lead/leadgen_grouped)
  metaLeads    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([adAccountId, adId, date])
  @@index([customerId, date])
  @@index([campaignId, date])
  @@index([adSetId])
  @@index([adId])
}

model CustomerAdSpend {
  id         String   @id @default(cuid())
  customerId String
  accountId  String
  date       DateTime // Tag, 12:00 UTC
  amount     Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, accountId, date])
  @@index([customerId, date])
}

// Produkt-Katalog. Gespiegelt aus der Airtable-"Produkte"-Tabelle —
// erlaubt beliebig viele Produkte ohne Code-Änderung. PRODUCTS in
// src/lib/products.ts liest dynamisch hieraus, sobald die UI auf den
// neuen Pfad umgestellt ist.
//
// poolKind bestimmt, wie der Media-Buyer Pools daraus baut:
//   "product"  → ein Pool je Produkt über alle Kunden
//                (Sterbegeld, Kindersparpläne, …)
//   "region"   → ein Pool je Region (Kinderwunsch)
model Product {
  id          String   @id @default(cuid())
  airtableId  String?  @unique
  name        String   @unique // canonical name, matched gegen Lead.source
  slug        String?  @unique // optional kürze form für URLs/IDs
  displayName String? // optional UI-Override (sonst = name)
  // Zusätzliche Keyword-Aliase für das Cost-Matching (kommagetrennt). Ein
  // Kampagnen-Name wird diesem Produkt zugeordnet, wenn er Name, Slug ODER
  // eines dieser Aliase als Teilstring enthält (case-insensitive, ≥3 Zeichen).
  // Gepflegt in Airtable (Produkte-Tabelle, Feld „Keywords"/„Aliase").
  keywords    String?
  poolKind    String   @default("product") // "product" | "region"
  // Sortierreihenfolge im Dashboard (asc); null = ans Ende.
  sortOrder   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerProducts CustomerProduct[]
}

// Kunden-Produkt-Bezug-Spiegel. Ein Eintrag pro (Kunde × Produkt) mit
// Ziel/Preis/Start. Löst die hardcoded leadGoalWechsel/etc.-Spalten
// auf Customer ab.
model CustomerProduct {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Lead-Ziel pro Monat. null = kein Ziel definiert.
  leadGoal         Int?
  // Preis pro Lead in EUR (Netto).
  leadPrice        Decimal?  @db.Decimal(12, 2)
  // Startdatum (Mid-Month-Onboarding-Pro-Rate).
  startDate        DateTime?
  // Test-Bezug: das volle Lead-Ziel wird über testDurationDays ausgeliefert und
  // NICHT anteilig auf den Restmonat gekürzt (Live-Bezüge schon). testMode true
  // ODER testDurationDays>0 ⇒ Testmodus.
  testMode         Boolean   @default(false)
  testDurationDays Int?
  // Region (nur für poolKind="region" relevant, z. B. Kinderwunsch-Stadt).
  region           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
}

// Ein Liefer-Pool = eine Meta-Kampagne, in die die Nachfrage mehrerer Kunden
// fließt. Zwei Arten:
//   kind = "product" → PKV, eine Kampagne pro Produkt (Wechsel/Neugeschäft),
//                       Pool-Ziel = Summe der Kunden-Ziele dieses Produkts.
//   kind = "region"  → Kinderwunsch, eine Kampagne pro Region,
//                       Pool-Ziel = Summe der KiWu-Ziele der Kunden der Region.
// Pools werden beim Lauf/Anzeigen automatisch aus den Kundendaten abgeleitet
// und hier per key upserted; gepflegt werden nur die Steuer-Einstellungen.
model DeliveryPool {
  id      String  @id @default(cuid())
  key     String  @unique // "product:Wechsel" | "product:Neugeschäft" | "region:Berlin"
  label   String
  kind    String // "product" | "region"
  // Produkt-Quelle (Lead.source) dieses Pools: "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  product String
  // Nur bei kind=region gesetzt.
  region  String?

  // Steuer-Einstellungen (admin-gepflegt):
  autopilot               Boolean  @default(false)
  maxDailyBudget          Decimal? @db.Decimal(12, 2)
  // Override für das Meta-Kampagnen-Matching. null = abgeleitet (Produkt bzw. Region).
  campaignKeyword         String?
  // Outbrain-Kampagnen-Match (analog zu campaignKeyword für Meta). null = kein
  // Outbrain-Channel in diesem Pool.
  outbrainCampaignKeyword String?
  // TikTok-Kampagnen-Match.
  tiktokCampaignKeyword   String?
  // Google-Ads-Kampagnen-Match.
  googleCampaignKeyword   String?
  // Per-Channel-Max-Budgets in EUR. maxDailyBudget gilt für Meta; ohne
  // outbrain-/tiktok-/googleMaxDailyBudget greift der Env-Default.
  outbrainMaxDailyBudget  Decimal? @db.Decimal(12, 2)
  tiktokMaxDailyBudget    Decimal? @db.Decimal(12, 2)
  googleMaxDailyBudget    Decimal? @db.Decimal(12, 2)
  // Höchstpreis je Lead (EUR). null = Env MEDIA_BUYER_MAX_CPL bzw. Break-even
  // aus Lead-Preis × (1 − Stornoquote), siehe lib/media-buyer-preisgrenze.ts.
  maxCpl                  Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit-Log des automatischen Media Buyers. Ein Eintrag pro Pool und Lauf,
// auch wenn keine Änderung nötig war (action = "none") — so ist transparent,
// was der Bot wann gesehen und entschieden hat.
model MediaBuyerAction {
  id           String   @id @default(cuid())
  poolKey      String
  poolLabel    String
  // "increase" | "decrease" | "pause" | "activate" | "boost" | "none"
  action       String
  reason       String
  // Pacing-Kennzahlen zum Zeitpunkt der Entscheidung.
  leadsMtd     Int
  leadsGoal    Int
  projected    Int
  daysElapsed  Int
  daysTotal    Int
  // Budget in EUR (Summe über die gematchten Kampagnen). null wenn nicht
  // ermittelbar oder keine Budget-Änderung.
  prevBudget   Decimal? @db.Decimal(12, 2)
  newBudget    Decimal? @db.Decimal(12, 2)
  // Welche Meta-Kampagnen betroffen waren (Namen, kommagetrennt).
  campaigns    String?
  // true wenn der Lauf nur simuliert wurde (dryRun) und nichts an Meta ging.
  dryRun       Boolean  @default(false)
  errorMessage String?
  // Meta-Lernphase zum Zeitpunkt der Entscheidung: "LEARNING" | "SUCCESS" |
  // "FAIL" („Learning limited") | "UNKNOWN"; null = kein Meta im Pool.
  learningStatus String?
  // Letzte wesentliche Änderung (Meta last_sig_edit_ts bzw. eigene Budgetänderung).
  learningSince  DateTime?
  // Vom Buyer pausierte Kampagnen ("meta:<id>,outbrain:<id>"): nur diese
  // werden später wieder reaktiviert, von Hand pausierte nie.
  pausedCampaignIds String?
  // Höchstpreis je Lead zum Zeitpunkt der Entscheidung und ob der 7-Tage-CPL
  // darüber lag (Abbruchregel: mehrere Läufe in Folge → Push).
  maxCpl         Decimal? @db.Decimal(12, 2)
  cplOverMax     Boolean  @default(false)
  // Zielquelle dieser Entscheidung: "software" (Bezüge/Bestellungen) | "airtable";
  // null = vor der Umstellung (Airtable). Für den Schonlauf beim Quellenwechsel.
  goalSource     String?
  // Regionen-Rechnung (nur regionale Bezüge offen): Empfehlungstext und ob die
  // Kosten je verwertbarem Lead über dem Break-even lagen (Push höchstens 1x/Tag).
  regionNote          String?
  regionOverBreakEven Boolean  @default(false)
  // Kunden unter 95 % ihres Ziels bei erreichter Pool-Summe (Namen, kommagetrennt).
  customersBehind     String?
  createdAt    DateTime @default(now())

  @@index([poolKey, createdAt])
  @@index([createdAt])
}

model Lead {
  id                   String            @id @default(cuid())
  airtableId           String?           @unique
  source               String?
  customerId           String
  name                 String?
  // Kontakt aus Airtable (Telefon normalisiert wie WhatsApp `from`, z. B.
  // 4915112345678) — für die Zuordnung WhatsApp-Konversation/Buchung ↔ Lead.
  phone                String?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits          String?
  phoneDigitsRev       String?
  email                String?
  /// Weitere E-Mail-Adressen (Ole, 17.11.2026): nennt der Lead im Chat eine neue Adresse (update_email), bleibt die
  /// bisherige hier erhalten. Kleingeschrieben, ohne Dubletten, ohne die Haupt-E-Mail (lib/lead-emails.ts)
  weitereEmails        String[]          @default([])
  // Snapshot der produktspezifischen Formularangaben (Label/Wert-Liste aus
  // lib/lead-fields) — Kontext für den WhatsApp-Bot.
  formData             Json?
  // Einwilligung aus dem Meta-Leadformular (custom_disclaimer_responses, lib/einwilligung-leadformular.ts):
  // "ja" (Häkchen gesetzt) | "nein" (Hinweis da, Häkchen fehlt: kein WhatsApp) | null (Formular ohne Hinweis, unbekannt)
  waConsent            String?
  // Nachweis: { at, formId, textVersion, text, responses: [{ key, checked }] }
  consentData          Json?
  // Korrekturen der Stammdaten im Kontakt (lib/lead-stammdaten.ts, Ole 14.11.2026): Anrede, Vor-/Nachname,
  // Adresse. Ab contactEditedAt überschreibt der Airtable-Abgleich Name, Telefon und E-Mail nicht mehr.
  contactOverrides     Json?
  contactEditedAt      DateTime?
  // Bestehende Verträge laut Lead (Komplettcheck im WhatsApp-Assistenten, Ole 17.11.2026, lib/whatsapp/vorvertraege.ts):
  // { at, liste: [{ sparte, gesellschaft?, fuer?, tarif? }], keine? }. Nur Sparte, Gesellschaft, Tarifname und Person, nie Gesundheitsangaben.
  vorvertraege         Json?
  // WhatsApp-Erstanschreiben (Outreach-Job): Zeitpunkt + Ergebnis
  // (sent | skipped_booked | skipped_contact | no_template | failed: …).
  outreachAt           DateTime?
  outreachStatus       String?
  // Kein WhatsApp (Ole, 15.11.2026, lib/whatsapp/kein-whatsapp.ts): Die erste Nachricht kam mit „nicht per WhatsApp
  // erreichbar“ zurück (Meta 131026). Assistent und WhatsApp-Nachfassen aus, Lead oben auf der Anrufliste.
  // waUnavailableMailAt: die einmalige E-Mail mit Terminlink an den Lead ist raus.
  waUnavailableAt      DateTime?
  waUnavailableMailAt  DateTime?
  // „Nur Betreuung“: Lead per E-Mail an den Kunden zugestellt
  emailedAt            DateTime?
  // Meta-Lead-ID (leadgen_id) bei direkt eingegangenen Leads – gegen Dubletten
  externalId           String?           @unique
  // Zuständiger Berater (Team-Kunden); leer = Inhaber/alle
  assignedUserId       String?
  assignedUser         User?             @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // Rückrufliste: „Nicht erreicht" geklickt → bis dahin ausgeblendet.
  callbackSnoozedUntil DateTime?
  // Wiedervorlage: „Ruf mich in 1 Woche an", Angebot nachfassen … erscheint
  // am Fälligkeitstag auf „Heute".
  followUpAt           DateTime?
  followUpNote         String?
  // Rückruf mit Uhrzeit als Kalender-Eintrag beim Berater (lib/calendar/rueckruf.ts)
  rueckrufEventId      String?
  rueckrufEventKey     String?
  // Notizen des Beraters (bei Airtable-Leads zusätzlich dort gespiegelt)
  notes                String?
  // rec-ID des Kunden-Produkt-Bezug-Records, an dem dieser Lead in Airtable
  // hängt. Wird beim Storno gebraucht, um die zugelassenen Stornogründe
  // (Linked-Records vom Bezug zur Stornogründe-Tabelle) nachzuschlagen.
  bezugAirtableId      String?
  createdAt            DateTime          @default(now())
  firstContactAt       DateTime?
  closedAt             DateTime?
  reached              Boolean           @default(false)
  contactAttempts      Int               @default(0)
  status               String?
  // Letzte Statusänderung (DB-Trigger, greift für App, Bot und Sync) – „seit X Tagen in der Phase“
  statusChangedAt      DateTime          @default(now())
  // Werbekanal, der den Lead generiert hat (aus Airtable-Spalte „Source").
  // Werte: "Meta" | "Outbrain" | null (= unbekannt). Wird in Channel-KPIs
  // und im Media-Buyer-Steuerlauf verwendet, um CPL pro Kanal zu berechnen.
  adChannel            String?
  // Anzeige, aus der der Lead kam (Ole, 17.11.2026, lib/anzeige.ts): Plattform (fb, ig …), Formular, Kampagne,
  // Anzeigengruppe und Anzeige (IDs und Namen). Aus dem Meta-Lead-Abruf, Zapier oder dem Perspective-Funnel (UTM);
  // die Rückfüllung (lib/anzeige-rueckfuellung.ts) setzt nur leere Felder, nur für Leads ab dem Startdatum des Kunden.
  adPlatform           String?
  adFormId             String?
  adCampaignId         String?
  adCampaignName       String?
  adSetId              String?
  adSetName            String?
  adId                 String?
  adName               String?
  acquisitionCost      Decimal           @default(0) @db.Decimal(12, 2)
  // Abschlusswert in EUR — vom Buyer beim Drop auf "Abschluss" in der
  // Pipeline-Ansicht eingegeben (oder im Lead-Detail editierbar). Wird
  // optional nach Airtable in eine Abschlusswert-Spalte gespiegelt; getrennt
  // von Revenue.amount (das ist der Lead-Einkaufspreis).
  closeValue           Decimal?          @db.Decimal(12, 2)
  // Nach dem Abschluss: Police fertig gemacht (Ole, 13.11.2026)
  policyDoneAt         DateTime?
  // ─── Pay-per-Lead (eigene Funnels, an Käufer verkauft) ─────────────────
  subscriptionId       String?
  subscription         LeadSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId              String?
  order                LeadOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deliveredAt          DateTime?
  // Storno beim Pay-per-Lead: requested → approved | rejected | review (Prüfung durch Admin)
  stornoState          String?
  /// Lead-ID bei Heinrich von Kleist (HvK-Abrechnung, lib/ppl/hvk-abrechnung.ts): nur sicher zugeordnete, nie überschrieben
  hvkLeadId            String?           @unique
  stornoReason         String?
  // Grund bei „Disqualifiziert“ (lib/lead-quality.ts), z. B. falsche_nummer
  disqualifyReason     String?
  // Verloren mit Grund (lib/lead-lost.ts, Ole 14.11.2026): Grund, Begründung, Zeitpunkt und ob der Lead
  // vorzeitig aufgegeben wurde (nie erreicht, unter 6 Anrufversuchen, Warnung übergangen)
  lostReason           String?
  lostNote             String?
  lostAt               DateTime?
  lostEarly            Boolean           @default(false)
  // Dokumentierte Anrufversuche „nicht erreicht“ (je 30 Minuten einer, lib/call-attempts.ts) und Anrufplan
  callAttempts         Int               @default(0)
  lastCallAttemptAt    DateTime?
  callPlanStartedAt    DateTime?
  // Anrufplan automatisch gestartet: 30 Min. nach dem Erstanschreiben ohne Antwort (Ole, 17.11.2026, lib/anruf-ausloeser.ts)
  autoCallAt           DateTime?
  // „Alle pausieren“ unter „Nächste Nachrichten“ am Kontakt (Paket P6, lib/nachrichtenplan-aktionen.ts): solange gesetzt,
  // warten Nachfass-Abfolgen und Termin-Erinnerungen an den Lead; „Fortsetzen“ rückt die Abfolgen um die Pause nach
  nachrichtenPausiertAt DateTime?
  // „Später melden“ (Ole, 18.11.2026): Pause bis zu diesem Tag, danach setzt der WhatsApp-Cron fort (NULL = bis „Fortsetzen“)
  nachrichtenPausiertBis DateTime?
  // Rückruf wünschen (Link in der Nachfass-Mail zum Angebot, Minimalseite /rueckruf/<token>, Ausbau in P5)
  rueckrufToken        String?           @unique
  rueckrufGewuenschtAt DateTime?
  // Telefonate sauber erfassen (lib/telefonat.ts, Ole 15.11.2026): „Anrufen“ in der App getippt, Ergebnis noch offen.
  // Solange gesetzt (höchstens 3 Stunden), pausiert der WhatsApp-Assistent für diesen Lead (keine Fragen, kein Nachfassen).
  callStartedAt        DateTime?
  // Erinnerung „Was ist bei … rausgekommen?“ (Push) für diesen Anruf schon gesendet
  callReminderAt       DateTime?
  // Bedarf aus dem Telefonat (gleiche Punkte wie Conversation.qualificationData) und wie vollständig er besprochen
  // wurde: komplett | teilweise | nein. Liegt zusätzlich in der Konversation, damit Assistent und Vorbereitung ihn kennen.
  needData             Json?
  needState            String?
  needAt               DateTime?
  // Assistent fragt die offenen Punkte nach dem Telefonat per WhatsApp ab (ab diesem Zeitpunkt, einmal; Cron)
  openQuestionsAt      DateTime?
  stornoNote           String?
  stornoRequestedAt    DateTime?
  stornoDecidedAt      DateTime?
  // Gutschrift für genehmigten Storno (EUR) und wann sie auf eine Rechnung kam (nur Bezüge mit alten Bedingungen,
  // LeadSubscription.stornoErsatz = false)
  creditAmount         Decimal?          @db.Decimal(10, 2)
  creditedAt           DateTime?
  // Nachlieferung statt Gutschrift (Ole, 24.11.2026, lib/ppl/storno.ts): anerkannte Reklamation schuldet einen
  // kostenlosen Ersatzlead. ersatzFuerId am Ersatzlead zeigt auf den reklamierten Lead (je Reklamation genau einer).
  ersatzGeschuldet     Boolean           @default(false)
  ersatzFuerId         String?           @unique
  ersatzFuer           Lead?             @relation("LeadErsatz", fields: [ersatzFuerId], references: [id], onDelete: SetNull)
  ersatz               Lead?             @relation("LeadErsatz")
  // DSGVO-Löschung (Art. 17): personenbezogene Felder geleert, Zeile bleibt
  // für Abrechnung und Statistik. Der Airtable-Sync überschreibt sie nicht mehr.
  erasedAt             DateTime?
  // Testlead (Ole, 16.11.2026, Admin → Kunde → Leads → „Testlead schicken“, lib/testlead.ts): läuft durch den echten
  // Ablauf (Push, Erstanschreiben, Assistent, Termin), zählt aber nirgends (Zahlen, Kosten pro Lead, Monatsbericht,
  // Garantien, Kontingente, Umsatz, Meta-Rückmeldung). Abzeichen „Test“, löschbar.
  isTest               Boolean           @default(false)
  // Antwortadresse ohne Postfach (Paket M2, lib/mail/antwort-adresse.ts): <kurzname>.<antwortCode>@antwort.dein-beratungstermin.de.
  // 8 Zeichen base32 aus HMAC(AUTH_SECRET, Lead-ID), beim ersten Versand gesetzt, bei der Löschung geleert.
  antwortCode          String?           @unique
  // Mail-Strecke für Leads ohne WhatsApp (Ole, 18.11.2026, lib/mail-strecke)
  mailStrecke          LeadMailStrecke?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  revenues Revenue[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  conversations       Conversation[]
  appointments        Appointment[]
  sequences           LeadSequence[]
  history             LeadHistory[]
  // Erneut eingetragen (lib/lead-erneut.ts): weitere Formular-Einsendungen derselben Person beim selben Kunden
  reentries           LeadReentry[]
  files               LeadFile[]
  // Unterlagen vom Lead per WhatsApp (Policen vor dem Termin, lib/policen)
  documents           LeadDocument[]
  policenAuszuege     PolicenAuszug[]
  // Ausgehende E-Mails an den Lead (Verlauf mit Zustellstatus, lib/mail/kontakt-mail.ts)
  mails               ContactMail[]
  // Automatische Vorlagen-Mails: Idempotenz je Vorlage und Anlass, höchstens eine je Tag (lib/mail/vorlagen-mail.ts)
  mailVersand         LeadMailVersand[]
  // Eingegangene Antworten per E-Mail (Paket M2, lib/mail/eingang.ts): nur Ablauf, Inhalt steht in ContactMail
  mailEingaenge       MailEingang[]
  // Verträge (Abschlüsse) dieses Leads: der erste aus closedAt/closeValue, dazu Cross-Selling (lib/vertraege.ts)
  contracts           LeadContract[]
  // Erinnerung „Weiteres Produkt anbieten?“ angelegt (einmal je Lead)
  crossSellRemindedAt DateTime?
  // Aufgaben nach dem Abschluss, die auf die Wiedervorlage warten (lib/lead-aufgaben.ts, P7): keine verdrängt die andere
  tasks               LeadTask[]
  // Abschluss erkennen (P4, Ole 17.11.2026, lib/abschluss-server.ts): Vorabend-Push „Hat Frau Becker abgeschlossen?“
  // zuletzt gesendet (je Lead höchstens einmal am Tag) und der Lead hat im Chat gesagt, er habe abgeschlossen (Werkzeug
  // schon_abgeschlossen: Vermittler benachrichtigt, Nachfassen gestoppt, Abschluss trägt nur der Vermittler ein)
  abschlussFrageAt    DateTime?
  abschlussGemeldetAt DateTime?
  // Aufgabe „Police da und erste Zahlung erfolgt?“ gestellt (einmal je Lead)
  policeRemindedAt    DateTime?
  // Kunde mit Abschluss im Bestand (ExistingCustomer.leadId)
  bestandKunde        ExistingCustomer? @relation("BestandAusLead")

  // Modul „Empfehlungen & Bewertungen“: Anfrage nach dem Abschluss (je Lead eine)
  reviewRequest         ReviewRequest?    @relation("ReviewRequestLead")
  // Persönlicher Empfehlungslink dieses Kontakts (als Empfehlender)
  ownReferralLink       ReferralLink?     @relation("ReferralLinkLead")
  // Lead kam über den Empfehlungslink eines Kunden
  referralLinkId        String?
  referralLink          ReferralLink?     @relation("ReferredLeads", fields: [referralLinkId], references: [id], onDelete: SetNull)
  // Dank an den Empfehlenden verschickt (einmal, sobald dieser Lead abgeschlossen ist)
  referralThankedAt     DateTime?
  // Empfohlene Person erlaubt, dass der Empfehlende eine Rückmeldung bekommt (Empfehlungsseite)
  referralStatusConsent Boolean           @default(false)
  // Letzte Rückmeldung an den Empfehlenden: gemeldet | termin
  referralNotifiedStage String?
  // Dankeschön an den Empfehlenden für diese Empfehlung: offen | erledigt | entfaellt | jahresgrenze (15 € je
  // Empfehler und Kalenderjahr erreicht, § 48b VAG). Betrag in € beim Vormerken (zählt für die Jahresgrenze)
  referralRewardStatus  String?
  referralRewardDueAt   DateTime?
  referralRewardDoneAt  DateTime?
  referralRewardAmount  Int?
  // Einwilligung in die Nachfrage nach dem Abschluss mit Bewertungs- und Empfehlungsbitte (Anwalts-Memo 15.11.2026):
  // ohne sie geht keine automatische Nachfrage und keine geplante Bitte um Empfehlung raus. Quelle: vermittler
  // (im Gespräch eingeholt und in der App bestätigt); Text = bestätigter Wortlaut (lib/empfehlung/shared.FEEDBACK_CONSENT_TEXT)
  feedbackConsentAt     DateTime?
  feedbackConsentSource String?
  feedbackConsentText   String?
  // „STOPP“ auf die Nachfrage bzw. Bitte: keine weiteren Nachfragen, Bewertungs- oder Empfehlungsbitten
  feedbackOptOutAt      DateTime?
  // Bewertungs-Wächter: Google-Bewertungen, die diesem Kontakt zugeordnet sind
  googleReviews         GoogleReview[]
  // Rückmeldung an Meta (lib/capi): Stufen dieses Leads im Postausgang
  capiEvents            CapiEvent[]
  maklervollmachten     Maklervollmacht[]
  beratungsdokus        Beratungsdoku[]

  @@index([customerId, createdAt])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([customerId, phone])
  @@index([subscriptionId, deliveredAt])
  @@index([stornoState])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
  @@index([callStartedAt])
  @@index([openQuestionsAt])
  @@index([adFormId])
  @@index([adCampaignId])
  @@index([adSetId])
  @@index([adId])
  @@index([nachrichtenPausiertBis])
}

model Revenue {
  id         String   @id @default(cuid())
  customerId String
  leadId     String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  // Storno-Flag: true wenn der Lead in Airtable den Status „Storniert" hat.
  // Stornierte Revenues bleiben mit Betrag erhalten (für die Storno-Kachel),
  // werden aber aus allen Umsatz-/Marge-Aggregationen ausgefiltert.
  cancelled  Boolean  @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([occurredAt])
}

// Kosten:
// kind = LEAD  → direkte Lead-/Akquisekosten (fließen in "Gewinn vor weiteren Kosten")
// kind = OTHER → weitere Betriebskosten (fließen in "Gewinn nach weiteren Kosten")
enum CostKind {
  LEAD
  OTHER
}

model Cost {
  id         String   @id @default(cuid())
  customerId String?
  kind       CostKind
  // Produkt-Zuordnung (z. B. "Wechsel", "Neugeschäft") für LEAD-Kosten aus Meta.
  // null für OTHER-Kosten oder LEAD-Kosten ohne erkennbares Produkt.
  product    String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  note       String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([kind, occurredAt])
  @@index([kind, product, occurredAt])
}

// Kampagnen, deren Spend KEINEM Produkt zugeordnet werden konnte (kein
// passendes Keyword/Slug/Alias). Wird beim Channel-Sync pro Channel komplett
// neu geschrieben (Aggregat über den Sync-Zeitraum, eine Zeile je Kampagne).
// Dient der Transparenz im Admin: zeigt, welcher Ad-Spend NICHT in die
// Berechnung einfließt — und damit, wo ein Keyword fehlt.
model UnmatchedCampaign {
  id       String   @id @default(cuid())
  // "Meta" | "Outbrain" | "TikTok" | "Google"
  channel  String
  campaign String
  spend    Decimal  @db.Decimal(12, 2)
  syncedAt DateTime @default(now())

  @@index([channel])
}

// Web-Push-Subscriptions für PWA-Benachrichtigungen. userId = null nur für
// Legacy-Subscriptions vor der Auth (werden behandelt als Admin).
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  ADMIN
  BUYER
}

// Auth-Accounts. Admins sehen das ganze Dashboard, Buyer nur die eigene
// Customer-Sicht (customerId verknüpft, NULL für Admins).
model User {
  id                         String              @id @default(cuid())
  // Einführungsvideo auf „Heute“ angesehen oder weggeklickt (Ole, 13.11.2026)
  introVideoSeenAt           DateTime?
  // Nutzungsanalyse (Sentry Session Replay, maskiert) nur mit Einwilligung: ja | nein, Zeitpunkt, Textversion
  analyseEinwilligung        String?
  analyseEinwilligungAt      DateTime?
  analyseEinwilligungVersion String?
  email                      String              @unique
  passwordHash               String
  role                       UserRole
  customerId                 String?
  createdAt                  DateTime            @default(now())
  lastLoginAt                DateTime?
  // Zwei-Faktor-Login (TOTP), vor allem für Admins: Schlüssel verschlüsselt,
  // aktiv ab totpEnabledAt; Notfall-Codes nur als SHA-256-Hash.
  totpSecretEnc              String?
  totpEnabledAt              DateTime?
  totpBackupCodes            String[]            @default([])
  // Sitzungsversion: +1 beendet alle Sitzungen (Passwort-/2FA-Änderung,
  // „Überall abmelden“, Kundenwechsel). Steht als „sv“ im Sitzungs-Cookie.
  sessionVersion             Int                 @default(0)
  // Neuigkeiten (Kundenbereich): zuletzt gelesen – Einträge danach zählen als ungelesen
  updatesSeenAt              DateTime?
  // Admin → Zahlen → Buchungen zuletzt geöffnet (Hinweis „neue Buchungen“ auf Heute)
  buchungenSeenAt            DateTime?
  // Team (Großkunden): owner = Inhaber (sieht alles), advisor = Berater (nur eigene Leads)
  teamRole                   String              @default("owner")
  displayName                String?
  // Bekommt bei der Verteilung neue Leads
  receivesLeads              Boolean             @default(true)
  lastLeadAssignedAt         DateTime?
  // Zuletzt einen Lead zugewiesen bekommen (Verteilung, Zuteilen, Terminbuchung).
  // Platz-Abrechnung (lib/seats.ts): wer heute Leads bekam, zählt heute als aktiver Verkäufer.
  leadReceivedAt             DateTime?
  // Früher: neue Admin-Oberfläche an/aus. Nicht mehr genutzt (alle Admins fest auf der neuen, 18.11.)
  adminNewUi                 Boolean             @default(true)
  // /buyer/zahlen, Karte Gewinn: „Inkl. Bestand“ statt „Nur jetzt“ (Wahl je Login)
  gewinnMitBestand           Boolean             @default(true)
  adminDismissals            AdminDismissal[]
  assignedLeads              Lead[]              @relation("LeadAssignee")
  advisorCalendar            AdvisorCalendar?
  mailConnection             MailConnection?
  // E-Mail-Signatur (Ole, 14.11.2026): kommt automatisch unter E-Mails an Leads
  mailSignature              String?
  // Tägliche Erinnerung um 8 Uhr: Leads ohne nächsten Schritt (lib/next-step-reminder.ts); Tag des letzten Laufs (Berlin)
  nextStepReminder           Boolean             @default(true)
  nextStepReminderDay        String?
  linkedInConnection         LinkedInConnection?

  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resetTokens    PasswordResetToken[]
  dealActivities DealActivity[]

  // Konversationen, in denen dieser Agent das Gespräch übernommen hat.
  assignedConversations Conversation[]

  // Abwesenheiten (Urlaub, Krankheit …) und Vertretungen
  absences            UserAbsence[]        @relation("UserAbsences")
  substituteFor       UserAbsence[]        @relation("AbsenceSubstitute")
  deviceTokens        DeviceToken[]
  appHandoffs         AppHandoff[]
  emailChangeRequests EmailChangeRequest[]
  adminUsageEvents    AdminUsageEvent[]

  @@index([customerId])
}

// Einmalige Tokens für Passwort-Reset. Nur der SHA-256-Hash wird gespeichert
// — der eigentliche Token landet nur als URL-Parameter in der Reset-Email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Monatsziele für das Admin-Cockpit. Ein Eintrag pro Monat
// (monthKey = "YYYY-MM"). Alle Goal-Felder sind optional — wenn null,
// wird das Ziel im UI als "nicht gesetzt" angezeigt.
model MonthlyGoal {
  id             String   @id @default(cuid())
  monthKey       String // "YYYY-MM"
  // Produkt-Dimension: "" = Gesamt, sonst "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  // Lead-Ziele kommen je Produkt aus Airtable (nicht hier); gespeichert werden
  // hier Abschluss-/Umsatz-/Marge-Ziele. Gesamt-Werte (Leads/Abschlüsse/Umsatz)
  // sind die Summe der Produkte; nur die Gesamt-Marge wird eigenständig gesetzt.
  product        String   @default("")
  leadsGoal      Int?
  // Abschlussquote-Ziel (Abschlüsse / Leads), 0..1. Qualitätskennzahl wie die
  // Marge — wird je Produkt und gesamt eigenständig gesetzt (nicht summiert).
  closedRateGoal Decimal? @db.Decimal(5, 4)
  revenueGoal    Decimal? @db.Decimal(12, 2)
  marginGoal     Decimal? @db.Decimal(5, 4) // 0..1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthKey, product])
}

// Eine Anfrage des Admins per Telegram, neue Meta-Ad-Creatives zu generieren.
// Bündelt mehrere Varianten (Headline + Body + Bild + CTA), die separat
// genehmigt werden können.
model CreativeRequest {
  id             String   @id @default(cuid())
  telegramChatId String // Telegram-Chat-ID des Anfragenden (kann negativ sein bei Gruppen)
  rawPrompt      String // Originaler Telegram-Text
  parsedIntent   Json // {count, campaign, tone, audience, …} von Claude
  status         String   @default("generating") // generating | partial | completed | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants CreativeVariant[]

  @@index([telegramChatId, createdAt])
}

// Eine konkrete Creative-Variante. Hat eigenen Approval-Status, weil der
// Admin pro Variante "Genehmigen" / "Ablehnen" / "Neu generieren" entscheidet.
model CreativeVariant {
  id             String    @id @default(cuid())
  requestId      String
  index          Int // 1..N innerhalb der Anfrage
  headline       String
  body           String
  cta            String // z.B. "Termin in 30 Sek"
  adText         String    @default("") // Facebook Primary-Text (über dem Bild), kann long-form sein
  fbHeadline     String    @default("") // Facebook Headline unter dem Bild (max ~40 Zeichen, unabhängig vom visuellen Hero)
  mechanic       String    @default("") // Konzept-Mechanic (z.B. UGC-Whiteboard, Comic-Illustration, Big-Number)
  imagePrompt    String // bei HTML-Pipeline: das volle HTML (Debug/Replay)
  imageUrl       String // public R2-URL
  // Video-Felder: gesetzt wenn kind="video". imageUrl kann dann ein
  // Standbild/Thumbnail enthalten (z. B. ersten Frame), videoUrl ist die R2-MP4.
  kind           String    @default("image") // "image" | "video"
  videoUrl       String?
  durationSec    Int?
  // Meta-Side: gesetzt wenn approved + zur Kampagne gepusht.
  metaCampaignId String?
  metaAdId       String?
  metaImageHash  String?
  status         String    @default("pending") // pending | approved | rejected | live | failed
  telegramMsgId  String? // Message-ID der Telegram-Nachricht mit dieser Variante
  errorMessage   String?
  createdAt      DateTime  @default(now())
  approvedAt     DateTime?

  request CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([telegramMsgId])
}

// ═══════════════════════════════════════════════════════════════════════
// WhatsApp-CRM (Phase 0) — eigene WhatsApp-Anbindung + KI-Vorqualifizierung
// + Terminierung, als Superchat-Ablösung. Multi-Tenant: alles hängt an
// Customer (customerId) und ist strikt pro Kunde isoliert. Token-/Key-Felder
// mit Suffix „Enc" werden VOR dem Persistieren app-seitig verschlüsselt
// (Envelope-Encryption/KMS) — nie Klartext in die DB. Siehe Projektplan
// „Sicherheit & DSGVO (Exit-Readiness)".
// ═══════════════════════════════════════════════════════════════════════

// WhatsApp-Business-Konto je Kunde (über 360dialog in der Überbrückungsphase).
model WhatsAppAccount {
  id                 String    @id @default(cuid())
  customerId         String    @unique
  provider           String    @default("360dialog") // 360dialog | meta_cloud (später)
  wabaId             String?
  phoneNumberId      String?
  phoneNumber        String?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits        String?
  phoneDigitsRev     String?
  displayName        String?
  apiKeyEnc          String? // app-seitig verschlüsselter 360dialog-API-Key
  status             String    @default("pending") // pending | connected | disabled
  // Selbst verbunden über 360dialog Integrated Onboarding (Partner-API):
  // Client und Channel aus dem Redirect; der API-Key wird daraus erzeugt.
  dialog360ClientId  String?
  dialog360ChannelId String?
  /// Einladung an eine andere E-Mail als den Login (Ole, 20.11.2026: Firmen-Postfach filtert die Mail von 360dialog)
  dialog360InviteEmail String?
  // Vorlagen automatisch einreichen/nachziehen (lib/whatsapp/template-submit.ts):
  // letzter Abgleich mit 360dialog (gedrosselt im WhatsApp-Cron).
  templatesCheckedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([phoneNumberId])
}

// Google-Kalender-Anbindung je Kunde für die Terminbuchung (Telefon/Video).
// Kalender-Anbindung je Kunde: Google oder Microsoft (Outlook/Exchange).
// Tabellenname bleibt aus Kompatibilität „GoogleCalendarConnection".
model CalendarConnection {
  id              String    @id @default(cuid())
  customerId      String    @unique
  provider        String    @default("google") // google | microsoft
  accountEmail    String? // verbundenes Kalender-Konto (Anzeige)
  calendarId      String    @default("primary")
  accessTokenEnc  String? // app-seitig verschlüsselt
  refreshTokenEnc String? // app-seitig verschlüsselt
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending") // pending | connected | error
  // Öffentlicher, nicht erratbarer Slug für die Buchungsseite /book/<slug>
  // (z. B. als Custom-Scheduling-Link im Meta-Leadformular).
  bookingSlug     String?   @unique
  // Frühere Kurznamen der Buchungsseite: leiten auf bookingSlug weiter (lib/calendar/buchungslink.ts)
  bookingSlugAlt  String[]  @default([])
  // Weitere Google-Kalender, die nur für „belegt“ zählen (freigegebene Kalender, z. B. alter Kalender nach Kontowechsel;
  // Ole, 18.11.2026). Kalender-ID bzw. Adresse wie in Google, abgefragt per freeBusy mit.
  busyCalendarIds String[]  @default([])
  // Davon zuletzt nicht abrufbar (z. B. Tippfehler → notFound); werden übersprungen, Hinweis in den Einstellungen
  // (Ole, 18.11.2026). Leer = alle lesbar.
  busyCalendarErrors String[] @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("GoogleCalendarConnection")
}

// Konfigurierbarer KI-Agent je Kunde (Aufgabe/Regeln, Wissen, Persönlichkeit).
model AgentConfig {
  id                       String    @id @default(cuid())
  customerId               String    @unique
  name                     String    @default("Assistent")
  systemPrompt             String    @default("")
  knowledge                String    @default("")
  personality              String    @default("")
  active                   Boolean   @default(false)
  // Automatisches WhatsApp-Erstanschreiben neuer Leads ohne Termin. Erst
  // aktivieren, wenn Einwilligung im Leadformular + freigegebene Vorlage da sind.
  outreachEnabled          Boolean   @default(false)
  // 0 = sofort beim Eingang (Speed to Lead). Höher nur, wenn der Lead erst selbst buchen soll.
  outreachDelayMin         Int       @default(0)
  // Automatisch nachfassen: feste Abfolgen nach „Nicht erreicht“, „Angebot gesendet“,
  // „Nicht erschienen“ (lib/lead-sequences.ts). Standard aus.
  followUpSequencesEnabled Boolean   @default(true) // Standard an für neue Kunden (Ole, 15.11.2026)
  // Assistent auch für neue Kontakte (Ole, 16.11.2026): Standard aus. Aus = der Assistent antwortet nur Chats, die
  // einem Lead aus der Pipeline gehören (lib/whatsapp/nur-leads.ts). Kontakte aus der WhatsApp-Business-App
  // (Coexistence, WhatsAppAppContact) gelten nie als neu.
  newContactsBot           Boolean   @default(false)
  // Terminart (Ole, 17.11.2026): Der Assistent bietet nur Videotermine an, Telefon nur, wenn der Lead Video ablehnt.
  // Standard an; der Vermittler schaltet es unter Mein Kalender aus.
  videoOnly                Boolean   @default(true)
  // Terminarten (Ole, 18.11.2026): Termine immer per Video. Nur wenn der Lead ausdrücklich etwas anderes wünscht, darf
  // der Assistent Telefon bzw. einen Termin vor Ort in der Agentur anbieten, und nur wenn hier freigegeben (Standard aus).
  allowPhone               Boolean   @default(false)
  allowOnsite              Boolean   @default(false)
  // Fester Video-Link für alle Video-Termine (z. B. persönlicher Webex-Raum).
  // Leer = Google Meet bzw. Microsoft Teams wird pro Termin erzeugt.
  videoRoomUrl             String?
  // Berater-Adresse (z. B. Allianz-Mail): bekommt jeden gebuchten Termin als
  // Kalendereinladung → landet direkt in seinem Firmenkalender (Outlook).
  advisorEmail             String?
  // Veröffentlichter Frei/Gebucht-Kalender (ICS-Link, verschlüsselt): belegte
  // Zeiten des Firmenkalenders fließen in die Terminvorschläge ein.
  availabilityIcsUrlEnc    String?
  // Allianz-Online-Kalender (öffentlicher Buchungsdienst der Vertreter-Seite):
  // aufgelöste Vertretung + Termin-Art als verschlüsseltes JSON
  // (lib/calendar/allianz-online.ts). Nur mit Zustimmung (allianzConsentAt).
  allianzCalendarEnc       String?
  allianzConsentAt         DateTime?
  // Letzter erfolgreicher Abruf, letzter Fehler (ohne Geheimnisse) und wann
  // zuletzt eine Admin-Aufgabe dazu angelegt wurde (gedrosselt).
  allianzLastOkAt          DateTime?
  allianzLastError         String?
  allianzAlertAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Ein Chat-Faden pro (Kunde × Kontakt-Telefonnummer). Hält den 24h-Fenster-
// Status und ob der KI-Bot aktiv ist oder ein Mensch übernommen hat.
// Coexistence (Ole, 16.11.2026): Nummern, mit denen der Kunde in seiner WhatsApp-Business-App schon einen Chat
// hatte (Webhook „history“) bzw. die dort als Kontakt gespeichert sind („smb_app_state_sync“). Nur die Nummer, kein
// Verlauf, kein Name. Dient allein dazu, dass der Assistent diese Kontakte nie anschreibt (lib/whatsapp/nur-leads.ts).
model WhatsAppAppContact {
  id         String   @id @default(cuid())
  customerId String
  phone      String
  source     String // history | contact
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, phone])
}

model Conversation {
  id                   String    @id @default(cuid())
  customerId           String
  whatsAppAccountId    String?
  leadId               String?
  contactPhone         String
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits          String?
  phoneDigitsRev       String?
  contactName          String?
  contactEmail         String? // vom Lead im Chat genannt (für Kalender-Einladung)
  botActive            Boolean   @default(true)
  assignedUserId       String?
  // Vom KI-Bot gepflegte Qualifizierung (strukturiert, nicht nur als Notiz).
  qualified            Boolean   @default(false)
  qualificationSummary String?
  // Dieselben Angaben strukturiert (lib/whatsapp/qualification.ts), z. B.
  // { lebenssituation, interesse, vorhanden, kinder, wunsch }; null bei Altfällen.
  qualificationData    Json?
  status               String    @default("open") // open | snoozed | done
  // „Braucht dich": Assistent hat übergeben (Frage, die er nicht klären kann,
  // Lead will den Berater sprechen) oder Lead schreibt in einem übernommenen
  // Chat. Wird beim Antworten des Beraters bzw. „Erledigt" zurückgesetzt.
  needsAttention       Boolean   @default(false)
  attentionReason      String?
  attentionAt          DateTime?
  windowExpiresAt      DateTime? // Ende des 24h-Service-Fensters
  lastMessageAt        DateTime?
  // „STOPP“ per WhatsApp (lib/whatsapp/stopp.ts): ab hier keine Nachrichten mehr an diese Nummer (Assistent,
  // Erstanschreiben, Nachfassen, Erinnerungen, Kampagnen). Schreibt der Kontakt später selbst wieder, wird es aufgehoben.
  optedOutAt           DateTime?
  // Nur Support-Nummer (Ole, 15.11.2026): Zuordnung des Gegenübers zu Vertriebskontakt bzw. Kunde,
  // daraus „Kunde“ oder „Interessent“ (lib/whatsapp/support-contacts.ts). Manuell gesetzt bleibt sie stehen.
  salesContactId       String?
  linkedCustomerId     String?
  contactLinkManual    Boolean   @default(false)
  contactMatchedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer        Customer         @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  salesContact    SalesContact?    @relation(fields: [salesContactId], references: [id], onDelete: SetNull)
  linkedCustomer  Customer?        @relation("ConversationLinkedCustomer", fields: [linkedCustomerId], references: [id], onDelete: SetNull)
  whatsAppAccount WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser    User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([customerId, contactPhone])
  @@index([customerId, status, lastMessageAt])
  @@index([salesContactId])
  @@index([linkedCustomerId])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

// Einzelne Nachricht in einer Konversation (ein- oder ausgehend).
model Message {
  id              String    @id @default(cuid())
  conversationId  String
  direction       String // inbound | outbound
  kind            String    @default("text") // text | template | image | audio | document
  body            String?
  waMessageId     String?   @unique // WhatsApp-Message-ID (Idempotenz)
  status          String? // sent | delivered | read | failed (nur outbound)
  sentBy          String? // bot | agent | system (null = inbound)
  sentByUserId    String?
  // Meta-Preis je Nachricht (aus dem Status-Webhook „pricing“): Kategorie
  // marketing | utility | authentication | service und ob sie berechnet wird.
  // Beim Senden einer Vorlage vorbelegt mit der Vorlagen-Kategorie.
  pricingCategory String?
  billable        Boolean?
  // Systemnachricht (sendWhatsAppNotice): Zweck der Vorlage und A/B-Fassung (a | b), nur beim Versand als Vorlage
  // gesetzt (lib/whatsapp/ab-test.ts misst darüber die Antwortquote je Fassung).
  purpose         String?
  variant         String?
  // Zustellfehler aus dem Status-Webhook (statuses[].errors[0]): Meta-Fehlercode und Titel, nur bei status "failed"
  // (lib/whatsapp/zustellfehler.ts, z. B. 131026 „Message undeliverable“ = Nummer nicht per WhatsApp erreichbar)
  errorCode       Int?
  errorTitle      String?
  // SMS-Ersatz (lib/sms/ersatz.ts): WhatsApp-Terminnachricht im Vertrieb nicht zugestellt, derselbe Text per SMS
  smsAt           DateTime?
  smsStatus       String?
  createdAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([billable, createdAt])
  @@index([purpose, createdAt])
  // Live-Aktualisierung der Admin-Chats: jüngste Nachricht über alle Chats (lib/live.ts)
  @@index([createdAt])
}

// Admin-Alarm zu WhatsApp-Zustellfehlern, die nicht „kein WhatsApp“ bedeuten (Zahlung, Vorlage, Limits …):
// höchstens einer je Kunde, Fehlercode und Tag (Berlin), count zählt weitere Fehler desselben Tages.
model WhatsAppErrorAlert {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       Int
  day        String // YYYY-MM-DD (Europe/Berlin)
  title      String?
  count      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, code, day])
  @@index([createdAt])
}

// Gebuchter Termin aus dem Bot-Flow (Telefon oder Videocall).
model Appointment {
  id                    String    @id @default(cuid())
  customerId            String
  leadId                String?
  conversationId        String?
  mode                  String // phone | video | onsite
  // Ort bei Terminen vor Ort (Agentur-Adresse zum Zeitpunkt der Buchung, Ole 18.11.2026)
  ort                   String?
  startsAt              DateTime
  endsAt                DateTime?
  calendarEventId       String?
  meetUrl               String?
  status                String    @default("booked") // booked | cancelled | completed | no_show
  reminderSentAt        DateTime? // gesetzt, sobald die WhatsApp-Erinnerung raus ist
  soonReminderSentAt    DateTime? // „Gleich ist es so weit, passt alles?“ etwa 1 Std. vorher (Ole, 15.11.2026)
  // Show-up-Paket (Ole, 17.11.2026, lib/showup.ts): 15 Min. vorher mit Link (nur Video)
  startReminderSentAt   DateTime?
  // Lead hat „Bitte verschieben“ gewählt: keine weiteren Erinnerungen zu dieser Zeit
  rescheduleRequestedAt DateTime?
  // Anwesenheit (erschienen | fehlt | nicht_erschienen), gesetzt vom Vermittler (Push-Blatt, Heute, Termin)
  attendance            String?
  attendanceAt          DateTime?
  // Push „Ist … da?“ zum Terminbeginn bzw. „Ist … noch gekommen?“ nach dem Termin (je einmal)
  startPushAt           DateTime?
  afterPushAt           DateTime?
  // Vom Vermittler übersprungene Erinnerungen (Paket P6): vortag | vortag_mail | stunde | gleich
  erinnerungenUebersprungen String[] @default([])
  // Komplettcheck = Ja: auf 45 Min. verlängert („verlaengert“) bzw. Hinweis an den Vermittler („hinweis“)
  verlaengerung         String?
  verlaengerungAt       DateTime?
  // Lead hat per Knopf „Ja, passt“ bestätigt (Erinnerung am Vortag bzw. kurz vorher)
  confirmedAt        DateTime?
  // Einladung mit Kalendereintrag an den Lead (Ole, 17.11.2026, lib/calendar/einladung.ts): genau einmal, gesendet am
  // und an welche Adresse; Änderungen danach als Aktualisierung (gleiche UID, einladungSeq + 1). Bei Buchung im
  // WhatsApp-Assistenten ausstehend (einladungAusstehend = Buchungszeit), bis Adresse und Komplettcheck feststehen bzw.
  // der Lead nicht mehr antwortet (WhatsApp 30 Min., kurzfristig 5 Min., spätestens 60 Min. vor Beginn,
  // lib/whatsapp/einladung-rueckfall.ts)
  einladungAt          DateTime?
  einladungAn          String?
  einladungSeq         Int       @default(0)
  einladungAusstehend  DateTime?
  // Merkfeld je Termin und Adresse (Ole, 19.11.2026): an diese Adressen (klein geschrieben) ging die Einladung schon,
  // „wa:<Beginn>“ = Link zum Eintragen per WhatsApp (ohne Adresse). Nie zweimal dieselbe Einladung an dieselbe Adresse.
  einladungAdressen    String[]  @default([])
  // Wie gebucht (Ole, 18.11.2026, E1 Mail-Strecke, Kennzahl Anteil Termin über die Mail-Strecke):
  // bot | booking_page | advisor | mail_strecke; null = vor diesem Feld gebucht
  bookedVia            String?
  // Komplettcheck nach der Buchung (Ole, 17.11.2026): true = Lead möchte, dass der Berater im Termin auch kurz schaut,
  // ob er insgesamt gut abgesichert ist; false = nein; null = nicht gefragt bzw. offen
  komplettcheck         Boolean?
  // Terminvorbereitung (Angebot gerechnet) vom Berater abgehakt (Ole, 15.11.2026)
  preparedAt            DateTime?
  preparedById          String?
  // Angebote zum Termin (ausgelesen bzw. eingetragen, vom Berater bestätigt), für die Präsentation (Ole, 15.11.2026)
  offersJson            Json?
  offersConfirmedAt     DateTime?
  // Neue Terminvorbereitung (Ole, 15.11.2026): Tarifauswahl je Sparte aus dem Tarifkatalog (lib/tarifauswahl.ts);
  // daraus entsteht offersJson. null = noch nicht bearbeitet (dann gelten ältere Angebote in offersJson).
  tarifauswahl          Json?
  // „Noch klären im Termin“: abgehakte Punkte (Text)
  klaerenErledigt    String[]  @default([])
  shareToken         String?   @unique // Kundenlink zur Präsentation (nur Stand, ohne Sprechzettel), /beratung/<token>
  shareExpiresAt     DateTime? // Link läuft nach 14 Tagen ab
  // Angebot nach dem Termin (Paket P3, Ole 17.11.2026, lib/angebot-senden.ts): abgelegt (PDF unter Dokumente am Kontakt),
  // gesendet über die App bzw. vom Vermittler selbst gesendet; Versand: app | selbst; Kanäle z. B. „whatsapp,email“.
  // angebotToken: geheimer Link /ihr-angebot/<token> auf das PDF (LeadFile angebotDateiId).
  angebotAbgelegtAt  DateTime?
  angebotGesendetAt  DateTime?
  angebotVersand     String?
  angebotKanaele     String?
  angebotDateiId     String?
  angebotToken       String?   @unique
  // Empfehlungen: nach diesem Termin geprüft, ob der Empfehlungslink rausgeht (einmal je Termin)
  referralAskedAt       DateTime?
  // Getrennte Einladung für den Berater (interne Infos), gleicher Termin.
  // calendarEventId = Einladung des Leads (kundenfreundlich, ohne Interna).
  advisorEventId        String?
  // In welchem Kalender der Termin liegt: Kunden-ID oder „user:<id>“ (Berater)
  calendarKey           String?
  // Geheimer Link für den Lead: /book/manage/<token> (absagen/verschieben).
  manageToken           String?   @unique
  cancelledAt           DateTime?
  // lead | advisor | team (Admin/Kunde im CRM) | system
  cancelledBy           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  praesentationEreignisse PraesentationEreignis[]

  @@index([customerId, startsAt])
  @@index([einladungAusstehend])
}

// WhatsApp-Vorlage je Kunde (für Erstansprache / außerhalb des 24h-Fensters).
model MessageTemplate {
  id              String    @id @default(cuid())
  customerId      String
  name            String
  language        String    @default("de")
  // Wofür die Vorlage genutzt wird: outreach | booking_confirmation | reminder.
  // Parameter-Reihenfolge je Zweck siehe lib/whatsapp/templates.ts.
  purpose         String    @default("")
  category        String // utility | marketing | authentication
  status          String    @default("pending") // pending | approved | rejected | paused
  body            String
  // Von der App automatisch bei 360dialog/Meta eingereicht (statt von Hand angelegt).
  auto            Boolean   @default(false)
  submittedAt     DateTime?
  // Ablehnungsgrund von Meta (rejected_reason), z. B. INVALID_FORMAT
  rejectionReason String?
  // Kopfzeile: „DOCUMENT“ = PDF der Erstinformation im Kopf (beim Senden als Link mitgegeben), null = ohne
  headerFormat    String?
  // Schnellantwort-Knöpfe wie eingereicht (Liste der Knopftexte); null = keine bzw. unbekannt (ältere Vorlagen)
  buttons         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name, language])
}

// Dokumentierte WhatsApp-/DSGVO-Einwilligung je (Kunde × Kontakt).
model ConsentOptIn {
  id           String    @id @default(cuid())
  customerId   String
  contactPhone String
  grantedAt    DateTime
  source       String? // funnel | import | manual
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, contactPhone])
}

// Nutzungsmessung im Kunden-CRM (pseudonym, ohne Lead-Inhalte): Seitenaufrufe,
// Aktionen, Fehler, Feedback. Grundlage für UX-Verbesserungen. Löschung nach
// 180 Tagen (Cron).
model UsageEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  customerId String
  userId     String?
  /// true = Admin in „Als Kunde ansehen" (nicht mitzählen)
  preview    Boolean  @default(false)
  type       String // page | action | error | feedback
  name       String // z. B. „/buyer/leads", „callback.not_reached", „toast.error"
  path       String?
  meta       Json?

  @@index([customerId, at])
  @@index([type, at])
}

// Nutzungsmessung im Admin (Ole, 18.11.2026; docs/ux/admin-neu/nutzungs-audit-2026-11-17.md): Seitenaufrufe
// (normalisierter Pfad, IDs als :id) und Klicks auf Elemente mit data-funktion (Inventar-ID). Nur eingeloggte
// Admins, keine Inhalte, keine Lead-/Kundendaten. Auswertung nur als Zahlen (Diagnose q=admin-nutzung).
// Löschung nach 180 Tagen (pruneAdminNutzung, Cron 03:00 UTC) und mit dem Login (Kaskade).
model AdminUsageEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  adminUserId String
  /// seite | funktion
  art         String
  /// Seite: normalisierter Pfad (/admin/neu/kunden/:id); Funktion: ID aus funktionsinventar.json
  schluessel  String
  /// alt | neu
  oberflaeche String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([at])
  @@index([art, at])
  @@index([adminUserId, at])
}

// Angebot / Auftragsbestätigung aus dem Cold-CRM. Konditionen werden beim
// Erstellen eingefroren (Snapshot), damit ein angenommenes Angebot sich nie
// nachträglich ändert. Änderungen = neue Version (altes wird „superseded").
model Offer {
  id                      String        @id @default(cuid())
  // Testangebot (Ole, 15.11.2026): 0 €, Annahme ohne Stripe, legt einen Testkunden an
  isTest                  Boolean       @default(false)
  // Altes Airtable-Deal-Board (wird abgelöst) oder Vertriebskontakt.
  dealId                  String?
  deal                    Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  salesContactId          String?
  salesContact            SalesContact? @relation(fields: [salesContactId], references: [id], onDelete: Cascade)
  // Fortlaufende Nummer, z. B. PG-2026-0007
  number                  String        @unique
  version                 Int           @default(1)
  // draft | sent | accepted | declined | superseded
  status                  String        @default("draft")
  // Geheimer Link für die öffentliche Angebotsseite
  token                   String        @unique
  // Empfänger
  contactName             String
  company                 String?
  email                   String?
  street                  String?
  zip                     String?
  city                    String?
  // Konditionen (netto, EUR)
  // "software" = Betreuung + Software, "service" = nur Betreuung (ohne Software)
  package                 String        @default("software")
  // Vertreter oder Makler: Makler bekommen die Vertrags-Garantie statt Break-even
  // und das Bestandskunden-Modul inklusive (seit 11.11.2026); geht bei Annahme an den Kunden
  vermittlerTyp           String        @default("vertreter")
  term                    String // "none" | "3m" | "6m" | "12m"
  products                Json // [{ name, dailyBudget }]
  setupFee                Decimal       @db.Decimal(10, 2)
  monthlyFee              Decimal       @db.Decimal(10, 2)
  softwareFee             Decimal       @db.Decimal(10, 2)
  introMonthlyFee         Decimal?      @db.Decimal(10, 2)
  introMonths             Int?
  specialTerms            String?
  startDate               DateTime?
  // Abrechnungstag (Ole, 18.11.2026, lib/abrechnungstag.ts): Tag im Monat (1 bis 28), an dem abgebucht wird;
  // null = wie der Starttag. billingFreeStart: Zeit vom Start bis zum ersten Abrechnungstag kostenlos
  // („kostenloser Start“), sonst anteilig mit der ersten Abbuchung.
  billingDay              Int?
  billingFreeStart        Boolean       @default(false)
  // Zahlung nachträglich (Ole, 19.11.2026, Sonderkondition): Vergütung jeweils nachträglich für den abgelaufenen
  // Leistungsmonat, erste Abbuchung Start + 1 Monat (gleicher Tag), auch nach der Mindestlaufzeit; die letzte Zahlung folgt
  // nach Vertragsende. Nur monatlich (nicht mit Vorauszahlung, Abrechnungstag oder kostenlosem Start), Start am 1. bis 28.
  paymentInArrears        Boolean       @default(false)
  // Kunde wählt auf der Angebotsseite selbst (seit 11.11.2026): Laufzeit (nur ohne
  // Sonderpreis) und Startdatum. Bei Annahme werden term/setupFee/startDate überschrieben.
  customerChoosesTerm     Boolean       @default(false)
  customerChoosesStart    Boolean       @default(false)
  // Kunde wählt Produkte und Tagesbudget je Produkt (Ole, 19.11.2026; nur Listenpreis, Paket mit Software, ohne Startpreis).
  // Bei Annahme werden products/monthlyFee mit der Wahl überschrieben (Staffel, lib/offer-pricing.ts resolveProduktWahl).
  customerChoosesProducts Boolean       @default(false)
  // „Ihre erste Woche“ (Ole, 20.11.2026, nur Paket ppl_software; lib/ppl/erste-woche.ts): Lead-Produkt wie
  // LeadSubscription.productKey, Bezeichnung, Preis je Lead netto und Anzahl (vorausgewählt, bei Annahme gewählt, ab 5).
  // null = ohne erste Woche. Bei der Annahme: Registernummer des Kunden und „Jede Woche wiederholen“; danach legt das
  // Onboarding Bezug und erste Wochenbestellung an (abgebucht erst nach Registerprüfung und mit Zahlungsart).
  pplProductKey           String?
  pplLabel                String?
  pplPrice                Decimal?      @db.Decimal(10, 2)
  pplQuantity             Int?
  pplAutoRenew            Boolean       @default(true)
  pplRegisterNr           String?
  // Variante (Ole, 20.11.2026, nur Paket ppl_software; lib/ppl/kundenkonto.ts): null/"pool" = Leads aus unserem Pool
  // (bisher), "kundenkonto" = Kampagnen im eigenen Meta-Werbekonto des Kunden, Abrechnung wöchentlich je Lead
  // abzüglich seiner Meta-Kosten. pplProdukte: [{ name, preis (Endpreis brutto je Lead, Obergrenze), menge (Startmenge) }].
  pplModell               String?
  pplProdukte             Json?
  validUntil              DateTime
  // Annahme (Protokoll)
  sentAt                  DateTime?
  viewedAt                DateTime?
  acceptedAt              DateTime?
  acceptedName            String?
  acceptedIp              String?
  acceptedAgent           String?
  // Bei der Annahme angegeben (Anwalts-Memo, 15.11.2026): Firma, USt-IdNr. (freiwillig), Bestätigung
  // „Ich handle als Unternehmer (§ 14 BGB)“ (Pflicht) und, bei Startpreis, das Häkchen zum Übergang in den regulären Preis
  acceptedCompany         String?
  acceptedVatId           String?
  acceptedAsBusiness      Boolean       @default(false)
  acceptedPriceStep       Boolean       @default(false)
  termsUrl                String?
  dpaUrl                  String?
  // Zusätze (seit 11.11.2026; null = Alt-Angebot ohne Platz-Abrechnung)
  // Logins gesamt (Inhaber + Berater) und davon inklusive
  seats                   Int?
  seatsIncluded           Int?
  // Preis je weiterem Login und Monat (netto)
  seatMonthly             Decimal?      @db.Decimal(10, 2)
  // Bestandskunden-Modul: Monatspreis netto; null = nicht gebucht
  bestandMonthly          Decimal?      @db.Decimal(10, 2)
  // Modul „Empfehlungen & Bewertungen“: Monatspreis netto; null = nicht gebucht
  empfehlungMonthly       Decimal?      @db.Decimal(10, 2)
  // Vorauszahlung (Name historisch „annual“): mit 12 Monaten jährlich, Betrag = (12 − annualFreeMonths) × Monatspreis;
  // mit 6 Monaten (seit 18.11.2026) 6 Monate im Voraus, Betrag = (6 − annualFreeMonths) × Monatspreis. Der Zeitraum
  // folgt aus term (lib/offer-pricing.ts VORAUSZAHLUNG), annualFreeMonths = geschenkte Monate je Zeitraum.
  annualPrepay            Boolean       @default(false)
  annualFreeMonths        Int?
  // Vorauszahlung angeboten (Ole, 18.11.2026): Kunde wählt bei der Annahme monatlich oder im Voraus
  // (nur mit 6 oder 12 Monaten). Vor der Annahme ist annualPrepay die Vorauswahl (neu: monatlich), danach die Wahl.
  annualChoice            Boolean       @default(false)
  // Vorauszahlung mit Annahme fällig (Ole, 19.11.2026): gesetzt bei der Annahme mit Vorauszahlung. Dann gehen Setup und
  // Vorauszahlung des ersten Zeitraums (Leistungszeitraum ab Start) sofort auf eine Rechnung, das Stripe-Abo beginnt
  // erst mit der Verlängerung (lib/billing.ts). false = Annahme vor dem 19.11.2026: Vorauszahlung zum Start.
  prepayAtAcceptance      Boolean       @default(false)
  // Empfehlungsrabatt auf die Einrichtung (Kollegen empfehlen, seit 14.11.2026):
  // setupListFee = Listenpreis der Einrichtung vor Rabatt (für die gewählte Laufzeit),
  // setupDiscount = vereinbarter Rabatt (netto, wird bei der Laufzeitwahl neu angewendet),
  // setupFee bleibt der zu zahlende Betrag (Listenpreis minus Rabatt, nie unter 0).
  setupListFee            Decimal?      @db.Decimal(10, 2)
  setupDiscount           Decimal?      @db.Decimal(10, 2)
  // Zeile im Angebot, z. B. „Empfehlungsrabatt (empfohlen von Max Muster)“
  setupDiscountLabel      String?
  // Abschlussbonus (Ole, 16.11.2026): Nachlass auf die Einrichtung, wenn Annahme UND Setup-Zahlung bis zur Frist
  // passieren (Standard: Versandtag 23:59 Uhr Berlin). Null = kein Bonus. abschlussBonusBis überschreibt die Frist.
  abschlussBonus          Decimal?      @db.Decimal(10, 2)
  abschlussBonusBis       DateTime?
  // Tatsächlich abgezogen (Checkout mit Bonus bezahlt bzw. Lastschrift erteilt)
  abschlussBonusGewaehrt  Decimal?      @db.Decimal(10, 2)
  // ColleagueReferral, aus der der Rabatt stammt
  referralId              String?
  // Zahlung (Stripe)
  stripeCustomerId        String?
  stripeCheckoutSessionId String?
  stripeSubscriptionId    String?       @unique
  // Abo-Zeitplan: Monatsgebühr startet erst am Startdatum (Setup sofort)
  stripeScheduleId        String?       @unique
  // none | pending | processing | paid | failed
  paymentStatus           String        @default("none")
  // Status des Stripe-Abos (active, past_due, canceled …)
  subscriptionStatus      String?
  paidAt                  DateTime?
  // Zahlungserinnerung (Ole, 16.11.2026): angenommen, aber Zahlung noch nicht eingerichtet.
  // paymentReminderAt = vom Kunden (Angebotsseite) oder Admin gewählter Tag der ersten Erinnerung
  // (12:00 UTC des Berliner Tages wie startDate); null = Standardplan ab Annahme.
  // Plan: lib/angebot-zahlungserinnerung.ts, Versand im WhatsApp-Cron.
  paymentReminderAt       DateTime?
  // „Ich zahle später“ auf der Angebotsseite nur, wenn Ole es am Angebot erlaubt hat (Standard aus)
  allowPayLater           Boolean       @default(false)
  // Versendete Erinnerungen (je Stufe höchstens eine) und Zeitpunkt der letzten
  paymentReminderCount    Int           @default(0)
  paymentReminderLastAt   DateTime?
  // Aufgabe „Zahlung offen“ im Vertriebskontakt angelegt bzw. Push an die Admins (7 Tage danach) gesendet
  paymentReminderTaskAt   DateTime?
  paymentReminderPushAt   DateTime?
  // Anrede in Kundenmails zum Angebot (gemerkt beim Versand der Angebotsmail, im Admin änderbar)
  mailDu                  Boolean       @default(false)
  // Bitte um den Entscheidungs-Call weglassen (Ole, 18.11.2026): gilt für Angebotsmail, Angebotsseite und Zahlungserinnerung
  ohneEntscheidungsCall   Boolean       @default(false)
  // Startdatum wurde verschoben, weil erst nach dem Start gezahlt wurde: ursprünglicher Start
  startShiftedFrom        DateTime?
  // Überweisung nur auf Anfrage (Ole, 17.11.2026, lib/ueberweisung.ts): Ole schaltet sie je Angebot frei
  // (Standard aus). Dann zusätzlich „Per Überweisung zahlen“: Rechnung mit Zahlungsziel über die
  // Stripe-Banküberweisung (virtuelle IBAN je Kunde). Geht beim Onboarding an den Kunden über.
  allowBankTransfer       Boolean       @default(false)
  bankTransferDays        Int           @default(14)
  // Gewählte Zahlweise bei der Einrichtung: null (Stripe Checkout) | "ueberweisung"
  zahlweise               String?
  // Setup-Rechnung (Überweisung) und virtuelle IBAN zur Anzeige auf der Angebotsseite
  stripeSetupInvoiceId    String?
  ueberweisungIban        String?
  // Als abgelehnt markiert (Ole, 18.11.2026, lib/vertrieb/angebot-ablehnen.ts): Zeitpunkt, Grund (Verlustgründe des
  // Vertriebs), optionale Notiz und der Status davor (für „Wieder öffnen“, solange validUntil in der Zukunft liegt)
  declinedAt              DateTime?
  declineReason           SalesLossReason?
  declineNote             String?
  declinedPrevStatus      String?
  // Erinnerung vor Ablauf des Abschlussbonus (Ole, 18.11.2026, lib/vertrieb/bonus-erinnerung.ts), nur verschickte
  // Angebote: je Schritt der Zeitpunkt (höchstens einmal). Mail am Tag vor Ablauf, Mail und Push am letzten Tag (9 Uhr),
  // WhatsApp am letzten Tag (13 Uhr, nur mit „WhatsApp erlaubt“); bonusWhatsAppStatus = Ergebnis (sent, no_template …)
  bonusMailVorabAt        DateTime?
  bonusMailLetzterAt      DateTime?
  bonusPushAt             DateTime?
  bonusWhatsAppAt         DateTime?
  bonusWhatsAppStatus     String?
  createdById             String?
  // Stichtag für die Garantien (Ole, 23.11.2026): Erstellungsdatum der ersten Version desselben Angebots. Neue Versionen
  // eines Angebots von vor GUARANTEES_UNTIL behalten so ihre Garantien (lib/garantien.ts garantieDatum).
  garantieStichtag        DateTime?
  // Leadangebote (Nur Leads, Pay-per-Lead + Software), vor der Nachlieferung angenommen (Ole, 24.11.2026): zeigen weiter
  // die alten Bedingungen (Gutschrift bzw. Erstattung, volle AGB). Nur per Migration gesetzt, neue Angebote false.
  leadAltBedingungen      Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([salesContactId])
  @@index([dealId])
  @@index([status])
}

// Verarbeitete Stripe-Webhook-Ereignisse (Idempotenz: jedes Ereignis nur einmal).
model StripeEvent {
  id         String   @id // evt_…
  type       String
  receivedAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════
// Vertrieb (ehemals „Cold CRM“): Akquise von Versicherungsagenturen –
// Kontakte, Aufgaben, Aktivitäten, Cold-Mail (Instantly), Termine (Calendly),
// Inbound-Leads. Übernommen aus dem separaten Cold-CRM (Nov. 2026).
// ════════════════════════════════════════════════════════════════════════

enum SalesStage {
  NEU
  NICHT_ERREICHT
  WIEDERVORLAGE
  INTERESSE
  TERMIN
  GEWONNEN
  SPAETER
  VERLOREN
  UNGUELTIG
}

// Kunden-Pipeline: alles nach der Zusage
enum SalesCustomerStage {
  VERTRAG // Zusage, Vertrag versendet
  ONBOARDING // unterschrieben, Setup (Produkte, Gebiet, Kampagnen)
  TEST // Testpaket / erste Leads
  AKTIV // laufender Kunde
  PAUSIERT
  GEKUENDIGT
}

enum SalesLossReason {
  KEIN_BEDARF // ausgelastet, braucht keine Kunden
  HAT_ANBIETER // kauft schon Leads / arbeitet mit Agentur
  UEBER_ALLIANZ // macht das über die Allianz
  ZU_TEUER // Budget / Preis
  KEIN_INTERESSE
  SONSTIGES
}

enum SalesActivityType {
  ANRUF
  EMAIL
  NOTIZ
  STATUS
  COLD_MAIL
  LINKEDIN
  TERMIN
  IMPORT
}

enum SalesTaskType {
  ANRUF
  NACHFASSEN
  UNTERLAGEN
  TERMIN
  SONSTIGES
}

model SalesContact {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  /// Weitere E-Mail-Adressen (z. B. nach Zusammenführen); werden bei Calendly, Instantly und Inbound mit erkannt
  altEmails            String[]  @default([])
  /// Automatisch erkannte Kontaktdaten (lib/vertrieb/kontaktdaten-server.ts): Herkunft weiterer E-Mails
  /// { emails: { "<adresse>": { source, at } }, removed: [von Hand entfernte Adressen/Nummern] }
  detectedData         Json?
  phone                String?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits          String?
  phoneDigitsRev       String?
  street               String?
  zip                  String?
  city                 String?
  ratingValue          Float?
  ratingCount          Int?
  openingHours         String?
  url                  String?
  description          String?
  // Adresse aus dem Impressum ergänzt (einmal automatisch versucht)
  addressEnrichTriedAt DateTime?
  addressEnrichedAt    DateTime?
  // Maximal anreichern (Website + Google, lib/vertrieb/contact-enrich.ts)
  webEnrichAt          DateTime? // Website/Agenturseite ausgewertet (Öffnungszeiten, Social, Inhaber, Versicherer)
  googleCheckedAt      DateTime? // Google Places zuletzt abgefragt (alle 90 Tage)
  phoneMailCheckedAt   DateTime? // Telefonnummer aus E-Mail-Signaturen gesucht (lib/vertrieb/signature-phone.ts)
  googlePlaceId        String?
  googleMapsUrl        String?
  businessStatus       String? // Google: OPERATIONAL | CLOSED_TEMPORARILY | CLOSED_PERMANENTLY
  insurer              String? // Versicherer bzw. „Makler“ (aus Website/E-Mail)
  /// Quellen und Zeitpunkte der automatischen Ergänzung: { website?: {at,url,fields}, google?: {at,placeId,fields} }
  enrichment           Json?

  // Ansprechpartner & Zusatzinfos (aus der Instantly-Mailingliste)
  salutation     String?
  firstName      String?
  lastName       String?
  leaderNames    String? // alle Inhaber/Geschäftsführer, kommagetrennt
  agencyType     String? // GENERAL / HAUPT
  teamSize       Int?
  potentialScore Int?
  facebookUrl    String?
  instagramUrl   String?
  xingUrl        String?
  linkedinUrl    String?

  // LinkedIn-Outreach (Waalaxy)
  linkedinStatus      String? // ANFRAGE_GESENDET, VERNETZT, NACHRICHT_GESENDET, GEANTWORTET
  linkedinRequestAt   DateTime?
  linkedinConnectedAt DateTime?
  linkedinMessageAt   DateTime?
  linkedinReplyAt     DateTime?
  linkedinList        String? // Waalaxy-Liste / Kampagne
  linkedinTags        String?

  stage         SalesStage       @default(NEU)
  lossReason    SalesLossReason?
  competitor    String? // z.B. LEAD.NOW, Terminadler, Alkaio
  callAttempts  Int              @default(0)
  lastContactAt DateTime?
  legacyStatus  String? // Original-Status aus der Cold-Calling-Liste

  // Kunde (gesetzt ab Stufe Gewonnen)
  customerStage      SalesCustomerStage?
  products           String? // z.B. "PKV, TKV, Leben"
  monthlyValue       Int? // € pro Monat
  contractStart      DateTime?
  customerSince      DateTime?
  customerSource     String? // Akquise-Kanal: COLD_CALL, COLD_MAIL, LINKEDIN, META_ADS, EMPFEHLUNG, INBOUND, NETZWERK, SONSTIGES
  customerSourceNote String? // z.B. "Kampagne Allianz Okt" oder "Empfehlung von Hr. Müller"
  /// „WhatsApp erlaubt“ (Ole, 18.11.2026, lib/vertrieb/bonus-erinnerung-server.ts): null = automatisch (Terminbestätigung
  /// bzw. -erinnerung per WhatsApp bekommen oder selbst per WhatsApp geschrieben), true/false = von Hand in der Kontaktakte
  whatsappErlaubt    Boolean?
  whatsappErlaubtAt  DateTime?
  /// „Nie kontaktieren“ (Ole, 19.11.2026, lib/vertrieb/nie-kontaktieren-server.ts): gesetzt = keine Nachricht mehr aus
  /// der App (Später-Follow-up, Erinnerungen, WhatsApp), in Instantly gestoppt und auf der Blocklist. Automatisch bei
  /// Austragungs- oder Widerspruchswunsch und Datenschutzfragen in Antworten, bei Abmeldung in Instantly, sonst von Hand.
  nieKontaktierenAt       DateTime?
  /// austragen | widerspruch | datenschutz | bounce_hart | manuell
  nieKontaktierenGrund    String?
  /// In Instantly erledigt (Blocklist-Eintrag, Interessenstatus „kein Interesse“ in allen Kampagnen). NULL bei gesetztem
  /// Merkmal = noch offen: der Instantly-Cron (alle 15 Minuten) wiederholt, bis es klappt
  instantlyGesperrtAt     DateTime?
  instantlySperreVersuche Int                 @default(0)
  instantlySperreFehler   String?
  /// Auf Verlangen gelöscht (Art. 17 DSGVO, Ole 19.11.2026, lib/vertrieb/art17.ts): Hülle ohne Personenbezug mit
  /// Sperrvermerk. Name „Gelöscht auf Verlangen (Art. 17 DSGVO)“, E-Mail geloescht-<id>@art17.invalid
  art17GeloeschtAt        DateTime?
  /// SHA-256 der früheren Adressen (klein geschrieben, ohne Leerzeichen): Importe, Uploads und Antworten erkennen die
  /// Adresse wieder, ohne sie im Klartext zu speichern (lib/vertrieb/sperrliste.ts)
  sperrHashes             String[]            @default([])
  // Kundenkonto in der Plattform (ab Onboarding)
  customerId         String?             @unique
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers               Offer[]
  activities           SalesActivity[]
  tasks                SalesTask[]
  campaigns            SalesCampaignLead[]
  emails               SalesEmail[]
  followups            SalesFollowup[]
  linkedinEvents       SalesLinkedInEvent[]
  meetings             SalesMeeting[]
  inboundLeads         SalesInboundLead[]
  /// Chats auf der Support-Nummer mit diesem Kontakt (lib/whatsapp/support-contacts.ts)
  supportConversations Conversation[]
  // Über „Kollegen empfehlen“ von einem Kunden empfohlen
  colleagueReferrals   ColleagueReferral[]
  /// Links zur Vertriebspräsentation (/praesentation/<token>, 14 Tage)
  presentationLinks    SalesPresentationLink[]
  /// Weitere Telefonnummern (aus Buchungen, E-Mail-Signaturen, Formularen), die Hauptnummer bleibt `phone`
  phones               SalesContactPhone[]

  @@index([altEmails], type: Gin)
  @@index([sperrHashes], type: Gin)
  @@index([stage])
  @@index([nieKontaktierenAt])
  @@index([customerStage])
  @@index([linkedinStatus])
  @@index([zip])
  @@index([city])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

// Weitere Telefonnummern eines Vertriebskontakts (Ole, 16.11.2026): automatisch erkannt aus Buchungen,
// E-Mail-Signaturen, Formularen und Instantly (lib/vertrieb/kontaktdaten-server.ts). Die Hauptnummer bleibt
// SalesContact.phone und wird nie überschrieben.
model SalesContactPhone {
  id             String       @id @default(cuid())
  contactId      String
  contact        SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// E.164, z. B. +491711234567 (Schreibweise egal, Dubletten über diese Form)
  phone          String
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits    String?
  phoneDigitsRev String?
  /// MOBIL | FESTNETZ
  kind           String       @default("FESTNETZ")
  /// BUCHUNG | CALENDLY | MAIL | FORMULAR | INSTANTLY | VERLAUF (aus dem Verlauf) | ZUSAMMENGEFUEHRT | HAUPT (frühere Hauptnummer) | MANUELL
  source         String
  /// Zeitpunkt der Quelle (Buchung, Mail), sonst Erkennungszeitpunkt
  detectedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([contactId, phone])
  @@index([phone])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

model SalesActivity {
  id         String            @id @default(cuid())
  contactId  String
  contact    SalesContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       SalesActivityType
  outcome    String?
  note       String?
  occurredAt DateTime          @default(now())

  @@index([contactId, occurredAt])
}

// Vorlagen für E-Mails aus der Kontaktakte im Vertrieb (Ole, 23.11.2026, lib/vertrieb/crm-vorlagen.ts).
// Platzhalter {anrede}, {vorname}, {nachname}, {firma}, {angebotslink}, {ole}. bodyDu = Du-Fassung (leer: wie body).
// Gesendet wird über das verbundene Postfach des Admins (AdminMailbox, purpose „crm:<userId>“).
model SalesMailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String
  bodyDu    String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesTask {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  type      SalesTaskType @default(SONSTIGES)
  note      String?
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([doneAt, dueAt])
  @@index([contactId])
}

model SalesCampaign {
  id          String              @id @default(cuid())
  instantlyId String?             @unique
  name        String              @unique
  /// Anderes Thema (z. B. Pflege): Ereignisse und Leads dieser Kampagne kommen nicht ins CRM
  ignored     Boolean             @default(false)
  createdAt   DateTime            @default(now())
  leads       SalesCampaignLead[]
}

// Ein Kontakt in einer Instantly-Kampagne.
model SalesCampaignLead {
  id           String        @id @default(cuid())
  contactId    String
  contact      SalesContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       String? // Aktiv, Pausiert, Abgeschlossen, Bounced, Abgemeldet, Übersprungen, Noch nicht kontaktiert
  sentAt       DateTime? // erste/letzte bekannte Mail
  openCount    Int           @default(0)
  replyCount   Int           @default(0)
  clickCount   Int           @default(0)
  lastOpenAt   DateTime?
  lastReplyAt  DateTime?
  bounced      Boolean       @default(false)
  unsubscribed Boolean       @default(false)
  interest     String? // Instantly-Interessenstatus
  updatedAt    DateTime      @updatedAt

  @@unique([contactId, campaignId])
  @@index([campaignId])
}

// E-Mails aus Instantly (v.a. Antworten auf Cold Mails)
model SalesEmail {
  id              String            @id @default(cuid())
  instantlyId     String?           @unique
  contactId       String
  contact         SalesContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign        String?
  direction       String            @default("IN") // IN = Antwort vom Kontakt, OUT = von uns
  subject         String?
  text            String?
  html            String?
  fromEmail       String?
  threadId        String?
  /// Unser Instantly-Postfach, das die Mail empfangen bzw. gesendet hat (Antwort im selben Thread)
  eaccount        String?
  isAutoReply     Boolean           @default(false)
  sentiment       String? // POSITIV, NEGATIV, NEUTRAL, SPAETER (Später-Interesse)
  /// Kategorie „Datenschutz/Recht“ (Ole, 19.11.2026, lib/vertrieb/datenschutz-recht.ts): auskunft | loeschung |
  /// widerspruch | abmahnung. Gesetzt = Einordnung „Datenschutz/Recht“ statt positiv/neutral, Fall im Nachweisprotokoll
  rechtsArt       String?
  sentAt          DateTime
  createdAt       DateTime          @default(now())
  /// Telefonnummern der Signatur in SalesEmailPhone eingetragen (lib/telefonsuche-server.ts), null = noch offen
  phonesIndexedAt DateTime?
  phones          SalesEmailPhone[]

  @@index([contactId, sentAt])
}

// Telefonnummern aus der Signatur eingehender Vertriebsmails (Ole, 16.11.2026, lib/telefonsuche-server.ts):
// nur eigener Teil und Signatur des Absenders (lib/vertrieb/kontaktdaten.ts extractMailPhones), nie zitierter Verlauf.
// Für die Suche: die Nummer findet den Kontakt der Mail, auch wenn sie (noch) nicht am Kontakt steht.
model SalesEmailPhone {
  id             String     @id @default(cuid())
  emailId        String
  email          SalesEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  /// E.164, z. B. +4915258142143
  phone          String
  /// MOBIL | FESTNETZ
  kind           String     @default("FESTNETZ")
  phoneDigits    String
  phoneDigitsRev String
  createdAt      DateTime   @default(now())

  @@unique([emailId, phone])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

// Später-Follow-up (lib/vertrieb/followup.ts): Kontakt hat „gerne später“ geantwortet
// oder „Später wieder“ bekommen. Zwei Mails als Antwort im selben Instantly-Thread,
// danach Aufgabe „Wieder melden“.
model SalesFollowup {
  id           String       @id @default(cuid())
  contactId    String
  contact      SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// = contactId, solange das Follow-up läuft (höchstens eines je Kontakt), sonst NULL
  activeFor    String?      @unique
  status       String       @default("GEPLANT") // FREIGABE (wartet auf Freigabe), GEPLANT, FERTIG, GESTOPPT
  step         Int          @default(0) // 0 = noch nichts gesendet, 1 = Mail 1 gesendet, 2 = Mail 2 gesendet
  source       String // ANTWORT (Später-Antwort), AUSGANG (Ergebnis „Später wieder“), BESTAND (nachträglich eingeplant)
  /// Geplanter Zeitpunkt für Mail 1
  dueAt        DateTime
  /// Nächster Schritt (Mail 1, Mail 2 oder Aufgabe nach Mail 2)
  nextAt       DateTime
  /// Erkannter Zeitpunkt aus der Antwort, z. B. „ab März“
  timing       String?
  /// Die Später-Antwort (SalesEmail), auf die im Thread geantwortet wird
  replyEmailId String?
  subject      String?
  body1        String?
  body2        String?
  textSource   String? // KI, VORLAGE, MANUELL
  mail1SentAt  DateTime?
  mail2SentAt  DateTime?
  /// Sperre gegen Doppelversand (gesetzt während des Sendens)
  sendingAt    DateTime?
  attempts     Int          @default(0)
  lastError    String?
  stoppedAt    DateTime?
  stopReason   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, nextAt])
  @@index([contactId])
}

// Einstellungen Später-Follow-ups (eine Zeile, id „default“)
model SalesFollowupSettings {
  id         String    @id @default("default")
  enabled    Boolean   @default(true)
  /// Höchstens so viele Follow-up-Mails je Tag und Postfach
  perDay     Int       @default(15)
  /// Texte per KI aus Originalmail und Antwort (sonst feste Vorlage)
  useAi      Boolean   @default(true)
  /// Buchungslink für den kurzen Termin (leer = ohne Link)
  bookingUrl String?
  /// Kurzer Bezug auf das Angebot (für KI und Vorlage)
  pitch      String    @default("Wir sorgen über Meta-Werbung für planbare Kundenanfragen in Ihrer Region. Ein WhatsApp-Assistent meldet sich sofort bei jeder Anfrage und vereinbart Termine für Sie.")
  /// Bestehende Später-Kontakte einmalig eingeplant (wartet auf Freigabe)
  backfillAt DateTime?
  /// Signatur unter jeder Follow-up-Mail (Instantly gibt die Postfach-Signatur nicht heraus); leer = Gruß und Name
  signature  String?
  updatedAt  DateTime  @updatedAt
}

// Rohdaten aus Waalaxy (Webhook), auch nicht zugeordnete – zum Nachvollziehen
model SalesLinkedInEvent {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // webhook | csv
  name      String?
  company   String?
  url       String?
  status    String?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// Termine aus Calendly (gebucht über Calendly → Google Calendar)
model SalesMeeting {
  id                 String            @id @default(cuid())
  contactId          String
  contact            SalesContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calendlyUri        String?           @unique // Invitee-URI
  eventUri           String?
  title              String
  startAt            DateTime
  endAt              DateTime?
  location           String?
  joinUrl            String?
  status             String            @default("GEPLANT") // GEPLANT, ABGESAGT, VERSCHOBEN
  cancelReason       String?
  canceledBy         String?
  rescheduleUrl      String?
  cancelUrl          String?
  answers            String? // Fragen & Antworten aus dem Buchungsformular
  utmSource          String?
  inviteeName        String?
  inviteeEmail       String?
  taskId             String?
  /// Aufgabe „Wie lief der Termin?“ nach Terminende (lib/vertrieb/termin-review.ts)
  reviewTaskId       String?
  /// Nachfrage 15 Minuten nach Terminende geprüft (Push gesendet oder Ergebnis schon da), damit es sie nur einmal gibt
  reviewCheckedAt    DateTime?
  /// WhatsApp-Terminbestätigung von der Support-Nummer (lib/vertrieb/termin-whatsapp.ts):
  /// sent | no_phone | no_account | no_template | opted_out | failed | past
  waConfirmStatus    String?
  waConfirmAt        DateTime?
  waConfirmError     String?
  // ─── Eigene Buchungsseite /termin (lib/vertrieb/buchung.ts), parallel zu Calendly ───
  /// Termintyp der eigenen Buchungsseite (null = Calendly oder von Hand)
  bookingTypeId      String?
  bookingType        SalesBookingType? @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)
  /// Geheimer Link zum Verschieben/Absagen (/termin/verwalten/<token>)
  manageToken        String?           @unique
  /// Kalender-Schlüssel, in dem der Termin liegt (z. B. cust_pg_vertrieb), und Event-ID dort
  calendarKey        String?
  calendarEventId    String?
  inviteePhone       String?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits        String?
  phoneDigitsRev     String?
  consentAt          DateTime?
  consentText        String?
  /// Erinnerungen der eigenen Buchungsseite: 24 Stunden und 1 Stunde vorher
  reminderSentAt     DateTime?
  soonReminderSentAt DateTime?
  /// Beim Verschieben: der ursprüngliche Termin
  rescheduledFromId  String?
  /// WhatsApp-Erinnerungen von der Support-Nummer (auch Calendly): 24 Stunden und 1 Stunde vorher
  waReminderAt       DateTime?
  waSoonAt           DateTime?
  /// Ergebnis je Erinnerung (sent | opted_out | gesperrt | no_phone | kurzfristig | failed …), letzter Fehler und
  /// Versuche: bei einem Sendefehler wird die Markierung zurückgesetzt, der nächste Cron-Lauf versucht es erneut
  /// (höchstens 3 Versuche, nur solange der Termin im Fenster liegt)
  waReminderStatus   String?
  waReminderError    String?
  waReminderTries    Int               @default(0)
  waSoonStatus       String?
  waSoonError        String?
  waSoonTries        Int               @default(0)
  /// Danke-Seite nach der Buchung (nur mit Buchungs-Token): Vorbereitungsvideo angesehen, Demo geöffnet
  videoWatchedAt     DateTime?
  demoOpenedAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([contactId])
  @@index([startAt])
  @@index([calendarKey, startAt])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

/// Termintyp der eigenen Buchungsseite für Vertriebstermine (/termin, ersetzt später Calendly).
/// Kalender, Zeiten je Wochentag und Blocker liegen am internen Mandanten cust_pg_vertrieb
/// (CalendarConnection, CalendarLeadTimes); mehrere calendarKeys = später Round-Robin.
model SalesBookingType {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  /// Kurzer Satz unter dem Titel auf der Buchungsseite
  subtitle          String?
  /// Eigener Satz in Bestätigung (Seite und E-Mail)
  confirmText       String?
  /// Nach der Buchung Danke-Seite mit Vorbereitungsvideo und Demo (/termin/danke/<token>)
  thanksPage        Boolean        @default(false)
  durationMin       Int            @default(45)
  /// video | phone
  mode              String         @default("video")
  /// Puffer vor und nach jedem Termin (Minuten)
  bufferMin         Int            @default(15)
  /// Vorlauf: frühester Termin ab jetzt (Minuten)
  noticeMin         Int            @default(240)
  /// Veraltet, ersetzt durch bookingWindowDays (Migration 20261118705340)
  horizonDays       Int            @default(21)
  /// Öffentlich buchbar: nur die nächsten N Tage ab heute (rollierend, heute zählt mit). Admins buchen ohne Grenze.
  bookingWindowDays Int            @default(7)
  /// Fester Videolink, falls der Kalender keinen Meet- bzw. Teams-Link erzeugt
  videoUrl          String?
  /// Kalender, in denen gebucht wird (Reihenfolge = Vorrang, mehrere = später Round-Robin)
  calendarKeys      String[]       @default([])
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  meetings          SalesMeeting[]
}

// Eingehende Leads (Meta Lead Ads über Zapier/Make, Landingpage-Formulare …)
model SalesInboundLead {
  id         String        @id @default(cuid())
  contactId  String?
  contact    SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source     String // META_ADS, INBOUND, …
  name       String?
  email      String?
  phone      String?
  campaign   String?
  ad         String?
  form       String?
  answers    String?
  created    Boolean       @default(false) // neuer Kontakt angelegt?
  payload    Json
  /// Meta-Lead-ID (leadgen_id): Dublettenschutz, wenn derselbe Lead direkt (Meta-Webhook) und über den Zap kommt
  externalId String?       @unique
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([contactId])
  @@index([source, createdAt])
}

/// Meta-Leadformular, das dem Vertrieb gehört (Oles eigene Vermittler-Leads, Ole 18.11.2026): Leads dieses
/// Formulars gehen über /api/meta/leadgen direkt in den Vertrieb (lib/vertrieb/inbound.ts) statt zu einem Kunden.
/// Zuordnung im Admin unter Liefern → Lead-Eingang („Vertrieb (eigene Vermittler-Leads)“).
model VertriebLeadForm {
  id         String    @id @default(cuid())
  formId     String    @unique
  pageId     String?
  formName   String?
  active     Boolean   @default(true)
  lastLeadAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── Onboarding (ab Vertragsannahme) ───────────────────────────────────
// Ein Datensatz je Kunde. Die Checkliste ergibt sich aus diesen Zeitstempeln
// plus Kalender-/WhatsApp-Verbindung und erstem Login des Kunden.
model Onboarding {
  id                 String    @id @default(cuid())
  // Kunde nutzt die App ohne Handy/Mitteilungen – Schritt „App aufs Handy“ übersprungen
  appSkippedAt       DateTime?
  // Übersprungene Schritte mit Grund (Ole, 15.11.2026), z. B. { calendar: { at, reason: "gesellschaft" } }
  stepSkips          Json?
  customerId         String    @unique
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId            String?   @unique
  salesContactId     String?
  // "software" | "service"
  package            String    @default("software")
  // running | live | cancelled
  status             String    @default("running")
  startDate          DateTime?
  welcomeSentAt      DateTime?
  // Kickoff-Termin (über das eigene Buchungstool)
  kickoffAt          DateTime?
  // Fragebogen im Kundenbereich
  questionnaire      Json?
  questionnaireAt    DateTime?
  // Partnerzugriff auf Meta-Werbekonto und Seite erteilt
  metaAccessAt       DateTime?
  // Pflichtangaben (Impressum) von der Agentur-Website
  websiteInfo        Json?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits        String?
  phoneDigitsRev     String?
  websiteCheckedAt   DateTime?
  campaignReadyAt    DateTime?
  testLeadAt         DateTime?
  liveAt             DateTime?
  lastReminderAt     DateTime?
  // Push an Admin, wenn der Kunde lange nichts erledigt
  staleNotifiedAt    DateTime?
  // Aufgabe „Jahresvertrag anbieten“ (Tag 90) angelegt
  upsellTaskAt       DateTime?
  // 15-Minuten-Hilfetermin (Google-Kalender des Teams)
  helpCallAt         DateTime?
  helpCallEventId    String?
  helpCallUrl        String?
  // Selbst-Einrichtung: letzte Prüfung des Meta-Zugriffs (Werbekonto, Seite, Leads) und Partner-Anfrage
  metaCheck          Json?
  metaCheckedAt      DateTime?
  metaRequestedAt    DateTime?
  // Einwilligung zur Kontaktaufnahme (WhatsApp/Telefon) im eigenen Leadformular: Kunde bzw. Admin bestätigt
  consentAt          DateTime?
  consentConfirmedAt DateTime?
  // Erinnerungen der Selbst-Einrichtung (Tag 1/3/7): {"1": ISO, "3": ISO, "7": ISO}
  setupReminders     Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

// Kurzes Kunden-Feedback per Mail (Tag 7: Start, Tag 30: Monatsbericht).
// Antwort per Klick ohne Login über den geheimen Token.
model CustomerFeedback {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // day7 (Smileys 1–5) | day30, day90, day180 … (Weiterempfehlung 0–10, NPS)
  kind       String
  token      String    @unique
  // day7: 1–5, sonst 0–10
  score      Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?

  @@unique([customerId, kind])
}

// Pause / Urlaub eines Kunden: Anzeigen stoppen, Abrechnung auf die
// Software-Gebühr reduzieren (bei „Nur Betreuung“ 0 €), danach automatisch
// wieder starten. Geplant vom Kunden selbst oder vom Admin.
model CustomerPause {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  // leer = bis auf Widerruf
  endsAt            DateTime?
  // planned | active | ended | cancelled
  status            String    @default("planned")
  reason            String?
  // customer | admin
  createdBy         String    @default("customer")
  // customer = Pause/Urlaub (mit Abrechnung), dunning = Zahlungsverzug (nur Anzeigen)
  kind              String    @default("customer")
  // Halteangebot „Pause ohne Kosten“ (lib/halteangebote-server.ts): ganze Abrechnung ruht (Stripe pause_collection)
  free              Boolean   @default(false)
  // Von uns pausierte Meta-Kampagnen (werden beim Fortsetzen reaktiviert)
  pausedCampaignIds Json?
  adsNote           String?
  billingNote       String?
  appliedAt         DateTime?
  resumedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
  @@index([status, startsAt])
}

// „Ich bin abwesend“: Abwesenheit eines Logins in ganzen Tagen (Berliner
// Zeit). startsAt = Beginn des ersten Tags, endsAt = Beginn des Tags NACH dem
// letzten Tag (exklusiv). Solange sie läuft: keine neuen Leads, keine Termine
// bei dieser Person. Grund nur als Kategorie, keine Gesundheitsangaben.
model UserAbsence {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserAbsences", fields: [userId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  // urlaub | krank | sonstiges
  kind             String    @default("urlaub")
  // Vertretung (Kollege im Team), optional
  substituteUserId String?
  substitute       User?     @relation("AbsenceSubstitute", fields: [substituteUserId], references: [id], onDelete: SetNull)
  createdById      String?
  // Verschobene/übertragene Aufgaben zum Rückgängigmachen:
  // [{ leadId, followUpAt, callbackSnoozedUntil, assignedUserId }]
  movedTasks       Json?
  // Vorzeitig beendet
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId, endsAt])
  @@index([userId, endsAt])
}

// Direkter Lead-Eingang (Meta-Webhook oder Zapier-Webhook): welches
// Meta-Leadformular gehört zu welchem Kunden und Produkt.
model LeadSource {
  id               String    @id @default(cuid())
  formId           String    @unique
  pageId           String?
  formName         String?
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt-Key wie Lead.source (z. B. „Privatschutz“, „Wechsel“)
  productKey       String
  // Pay-per-Lead: Preis je Lead (netto) → Umsatz in der App; sonst leer
  leadPrice        Decimal?  @db.Decimal(12, 2)
  // Optional: Airtable-Bezug für die erlaubten Stornogründe
  bezugAirtableId  String?
  // Fragen des Formulars (key → Beschriftung) für lesbare Formularangaben
  questionLabels   Json?
  // Einwilligungstext im Formular (von unseren Kampagnen-Agenten angelegt): Version und Wortlaut als Nachweis am Lead
  consentVersion   String?
  consentText      String?
  // Einwilligung beim letzten Lead: "ja" | "nein" | "ohne" (Formular ohne Häkchen → Warnung im Admin)
  lastConsentState String?
  active           Boolean   @default(true)
  lastLeadAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId])
}

// Leads aus Formularen ohne Zuordnung: warten hier, bis das Formular einem
// Kunden zugeordnet wird – nichts geht verloren.
model UnassignedLead {
  id         String    @id @default(cuid())
  externalId String?   @unique
  formId     String?
  pageId     String?
  via        String // meta | zapier
  payload    Json
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([formId, resolvedAt])
}

// Eigener Kalender eines Beraters (Team-Kunden). Kunden-Kalender des Inhabers
// bleibt CalendarConnection; die Kalender-Funktionen unterscheiden über den
// Schlüssel „user:<userId>“.
model AdvisorCalendar {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  provider        String    @default("google")
  accountEmail    String?
  calendarId      String    @default("primary")
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending")
  // Berater-App-Kalender (provider "app", 21.11.2026): Person im Allianz-Online-Kalender der Agentur (bookingtime-Ressource).
  // Belegt = eigene Termine + freie Slots dieser Person; Einladung per Mail an accountEmail (Standard: Login-Adresse).
  allianzResourceId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// Lebenszeichen der Hintergrund-Jobs (Cron, Sync) für die Überwachung (/api/status).
model SystemHeartbeat {
  key  String   @id // "cron" | "sync"
  at   DateTime
  ok   Boolean  @default(true)
  note String?
}

// Öffentliche Statusseite (/status): ein Messpunkt je Cron-Lauf (alle 5 Min.)
// mit dem Zustand jeder Komponente ("ok" | "degraded" | "down"). Aufbewahrung 90 Tage.
model StatusSample {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  app      String
  leads    String
  whatsapp String
  calendar String
  payments String
  jobs     String

  @@index([at])
}

// Manuelle Störungsmeldungen für die Statusseite (Admin → Einstellungen → Status & Meldungen).
model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  message    String?
  level      String    @default("degraded") // "degraded" | "down" | "info"
  component  String? // app | leads | whatsapp | calendar | payments | jobs; leer = allgemein
  startsAt   DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([resolvedAt, startsAt])
}

// Änderungsprotokoll: wer hat wann was Wichtiges geändert (Logins, Zugänge,
// Team, Pausen, Angebote, Exporte, Einstellungen). Aufbewahrung 1 Jahr.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  actorRole  String? // ADMIN | BUYER | system | lead
  action     String // z. B. "login", "team.invite", "pause.plan"
  entity     String? // z. B. "User", "Lead", "Customer"
  entityId   String?
  customerId String?
  details    Json?

  @@index([at])
  @@index([customerId, at])
  @@index([action, at])
}

// WhatsApp-Gebühren von Meta, monatlich an den Kunden weiterberechnet
// (AGB: nach tatsächlichem Verbrauch). Ein Eintrag je Kunde und Monat.
model WhatsAppFeeCharge {
  id                  String   @id @default(cuid())
  customerId          String
  month               String // "2026-11"
  // { marketing: 12, utility: 3, authentication: 0 }
  counts              Json
  amount              Decimal  @db.Decimal(10, 2)
  // Stripe-Rechnungsposten (hängt an der nächsten Abo-Rechnung); leer = von Hand abrechnen
  stripeInvoiceItemId String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, month])
}

// ─── Pay-per-Lead ────────────────────────────────────────────────────────
// Bezug: ein Käufer kauft Leads eines Produkts (Pool) zu einem Preis, mit
// Filtern. Ersetzt den Airtable-„Kunden-Produkt-Bezug“.
model LeadSubscription {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt/Pool wie Lead.source, z. B. „PKV-Tarifoptimierung“
  productKey          String
  label               String?
  active              Boolean   @default(true)
  // live | test (Test: Vorrang bis testQuantity, verteilt über testDays)
  status              String    @default("live")
  testQuantity        Int?
  testDays            Int?
  // Kontingent ohne Bestellung (von Hand gepflegt): month | once; week = Bestellungen im Kundenbereich
  period              String    @default("week")
  goal                Int?
  startDate           DateTime?
  // Preis je Lead immer netto (bei steuerpflichtigen Bruttopreisen netto = brutto / 1,19, z. B. 65 € → 54,62 €)
  price               Decimal   @db.Decimal(10, 2)
  // Umsatzsteuer (Ole, 20.11.2026): steuerfrei_4_11 | steuerpflichtig; null = Standard je Produkt (lib/ppl/steuer.ts).
  // Steuerfrei wird nur abgerechnet, wenn der Käufer als Vertreter/Makler geprüft ist; Kindersparplan immer 19 %.
  steuer              String?
  // Filter
  plzRanges           String? // "80000-85999|67300-67499|12345"
  acceptWeak          Boolean   @default(true)
  // Beitragsgrenze für „schwach“ (Standard 700 €), Beamte sind immer schwach
  weakThreshold       Int?
  acceptCivilServants Boolean   @default(true)
  onlyWeak            Boolean   @default(false)
  scoreFloor          Int?
  insurerInclude      String[]  @default([])
  insurerExclude      String[]  @default([])
  // weitere Regeln: "feld=Wert1,Wert2|feld2=…" (Lead wird ausgeschlossen, wenn ein Wert passt)
  excludeRules        String?
  // Storno
  stornoDays          Int?
  stornoReasons       String[]  @default([])
  // true = jede Reklamation im Fenster sofort anerkennen (auch „Sonstiges“ und
  // hohe Quote), sonst gehen diese in die Prüfung durch den Admin
  stornoAutoApprove   Boolean   @default(false)
  // Reklamation und offene Bestellungen (Ole, 24.11.2026: „wir liefern Leads immer nach und erstatten nichts“):
  // true = anerkannte Reklamation → kostenloser Ersatzlead, nicht gelieferte Reste bezahlter Wochenbestellungen werden
  // in den Folgewochen nachgeliefert. false = alte Bedingungen (Gutschrift auf die nächste Bestellung, nur laufende Woche);
  // alle bei Einführung bestehenden Bezüge stehen auf false (Migration 20261124150000_ppl_nachlieferung).
  stornoErsatz        Boolean   @default(true)
  // Auslieferung: app (Kundenbereich, Push, E-Mail) | email (nur E-Mail) | webhook
  delivery            String    @default("app")
  deliveryEmail       String?
  // E-Mail-Vorlage für Systeme, die die Mail auslesen (z. B. „Feld: Wert“ je
  // Zeile). Platzhalter {vorname}, {nachname}, {plz} … siehe lib/ppl/delivery.
  emailSubject        String?
  emailTemplate       String?
  // standard (lesbare Mail bzw. Vorlage aus emailTemplate) | maschinenlesbar (feste
  // „Feld: Wert“-Zeilen, JSON-Block und lead.json, z. B. für einen Make-Mailhook)
  emailFormat         String    @default("standard")
  // Einwilligungstext des Funnels (Wortlaut), steht in der maschinenlesbaren Mail
  consentText         String?
  // Slack-Nachricht je Lead (SLACK_PPL_WEBHOOK_URL); aus = für diesen Bezug stumm
  slackNotify         Boolean   @default(true)
  webhookUrl          String?
  // standard (JSON mit lead/answers, Secret im Header) | convexa (FirstName, LastName …)
  webhookFormat       String    @default("standard")
  webhookSecretEnc    String?
  airtableId          String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders LeadOrder[]
  leads  Lead[]
  areas  SubscriptionArea[]

  @@index([productKey, active])
  @@index([customerId])
}

// Gebiet eines Bezugs (z. B. Heinrich von Kleist): eigene PLZ-Bereiche und
// eigene Menge je Zeitraum. Leads aus dem Gebiet gehen bis 100 % der Menge
// bevorzugt an diesen Bezug (vor Bezügen ohne Gebiet), danach normale Verteilung.
model SubscriptionArea {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   LeadSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  label          String?
  plzRanges      String // "80000-85999|67300-67499|12345"
  quantity       Int
  // week | month; leer = wie der Bezug (Wochenbestellung → week, sonst month)
  period         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([subscriptionId])
}

// Bestellung für einen Zeitraum (meist Woche Mo–So), im Voraus bezahlt.
model LeadOrder {
  id              String           @id @default(cuid())
  subscriptionId  String
  subscription    LeadSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  quantity        Int
  amount          Decimal          @db.Decimal(10, 2)
  // open (Rechnung offen) | paid | processing (Lastschrift läuft) | failed | cancelled
  status          String           @default("open")
  // Folgewoche automatisch gleich bestellen
  autoRenew       Boolean          @default(true)
  stripeInvoiceId String?          @unique
  // Angewandte Umsatzsteuer bei der Bestellung: steuerfrei_4_11 | steuerpflichtig (null = vor 20.11.2026, 19 %)
  steuer          String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  leads Lead[]

  @@unique([subscriptionId, periodStart])
  @@index([status, periodStart])
}

// Eingang eines Pool-Leads (vor der Verteilung): Dubletten-Historie,
// geparkte Leads (kein freies Kontingent) und Prüfergebnis.
model PoolLead {
  id           String    @id @default(cuid())
  externalId   String?   @unique
  productKey   String
  via          String // perspective | meta | webhook
  name         String?
  phone        String?
  email        String?
  plz          String?
  insurer      String?
  contribution Int?
  civilServant Boolean   @default(false)
  weak         Boolean   @default(false)
  smsVerified  Boolean   @default(false)
  score        Int?
  answers      Json?
  // Anzeige/UTM aus dem Funnel ohne Personendaten ({ adPlatform, adCampaignName, … }, lib/anzeige.ts); geht bei der
  // Lieferung an den Lead
  adInfo       Json?
  // Einwilligungsnachweis aus dem eigenen Funnel (L3, § 7a UWG): { at, funnel, version, text, kanaele, knopf }
  // (lib/ppl/einwilligung-nachweis.ts); geht bei der Lieferung an Lead.consentData und an den Abnehmer
  consentData  Json?
  // delivered | duplicate | invalid | parked
  status       String
  reason       String?
  leadId       String?   @unique
  // Gebiet, über das der Lead ausgeliefert wurde (Vorrang-Kontingent)
  areaId       String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@index([areaId, deliveredAt])
  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@index([status, productKey])
}

// ─── Bestandskunden (Import aus dem Versicherer-System) + Kampagnen ─────────
// Gesundheitsangaben werden nie importiert. Einwilligung für WhatsApp/E-Mail
// liegt laut Versicherer (Allianz) vor; dokumentiert mit Importdatum.
model ExistingCustomer {
  id                       String    @id @default(cuid())
  customerId               String
  customer                 Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalNo               String? // Kundennummer im Versicherer-System
  firstName                String?
  lastName                 String?
  // Anrede (Herr | Frau | Divers) und Firma bei Gewerbekunden (Import 14.11.2026)
  salutation               String?
  company                  String?
  phone                    String? // normalisiert wie WhatsApp (4915…)
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits              String?
  phoneDigitsRev           String?
  email                    String?
  birthday                 DateTime?
  street                   String?
  zip                      String?
  city                     String?
  // Sparten, z. B. ["KFZ", "Haftpflicht"] – für Segmente und den Assistenten
  lines                    String[]  @default([])
  // nächster Ablauf/Hauptfälligkeit (z. B. KFZ) für Anlass „Wechsel/Ablauf“
  nextRenewal              DateTime?
  // Summe der Jahresbeiträge aktiver Verträge (für Sortierung und Beitragsvolumen); null = kein Beitrag bekannt
  premiumTotal             Decimal?  @db.Decimal(12, 2)
  consentAt                DateTime? // „Einwilligung laut Versicherer“ (Importdatum); seit 14.11.2026 nur noch Altangabe, maßgeblich sind die Felder je Kanal
  consentNote              String?
  optOutAt                 DateTime? // „Stopp“ bzw. Abmeldung für alle Kanäle → keine Kampagnen mehr
  // Vom Vermittler gesperrt („nicht mehr anschreiben“, Ole 18.11.2026): bleibt gespeichert, bekommt keine Kampagnen und
  // Glückwünsche, wieder entsperrbar (lib/bestand/kunde-verwalten.ts)
  blockedAt                DateTime?
  blockedById              String?
  // Einwilligung je Kanal (Ole, 14.11.2026): ja | nein | null = unbekannt. Quelle: import | versicherer_pauschal | formular | vermittler | lead
  emailConsent             String?
  emailConsentAt           DateTime?
  emailConsentSource       String?
  whatsappConsent          String?
  whatsappConsentAt        DateTime?
  whatsappConsentSource    String?
  // Abmeldung nur für E-Mail (Abmeldelink); optOutAt sperrt alle Kanäle
  emailOptOutAt            DateTime?
  // Nachweis § 7 Abs. 3 UWG (Anwalts-Memo, 15.11.2026): Bei Erhebung der E-Mail-Adresse auf das Widerspruchsrecht
  // hingewiesen? ja | nein | null = unbekannt. Ohne „ja“ gehen E-Mails nur mit Einwilligung raus.
  // Quelle: import (Spalte der Datei) | import_pauschal | bestand_pauschal | vermittler; Text = Wortlaut bzw. Quelle
  widerspruchHinweis       String?
  widerspruchHinweisAt     DateTime?
  widerspruchHinweisSource String?
  widerspruchHinweisText   String?
  lastCampaignAt           DateTime?
  // Kampagnen-WhatsApp kam mit „nicht per WhatsApp erreichbar“ zurück (Meta 131026): künftige Kampagnen nur noch per
  // E-Mail, soweit die E-Mail-Regeln es erlauben (lib/bestand/einwilligung.ts)
  waUnavailableAt          DateTime?
  // Import-Lauf, der den Datensatz angelegt hat (ExistingCustomerImport.id); Aktualisierungen ändern ihn nicht
  importId                 String?
  // Aus einem Lead mit Abschluss übernommen (lib/vertraege.syncLeadToBestand); der Import übernimmt den Eintrag
  leadId                   String?   @unique
  lead                     Lead?     @relation("BestandAusLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  contracts    ExistingContract[]
  recipients   CampaignRecipient[]
  mails        ContactMail[]
  referralLink ReferralLink?
  consentLogs  BestandConsentLog[]

  @@unique([customerId, externalNo])
  @@index([customerId, phone])
  @@index([customerId, email])
  @@index([importId])
  @@index([phoneDigits])
  @@index([phoneDigitsRev])
}

// Ein Import-Lauf (Datei hochgeladen und übernommen). Der letzte Lauf lässt sich rückgängig machen:
// Dann werden nur die Bestandskunden gelöscht, die dieser Lauf angelegt hat (ExistingCustomer.importId),
// außer bereits angeschriebenen oder gesperrten. Aktualisierte Kunden behalten den neuen Stand.
model ExistingCustomerImport {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById String?
  fileName    String?
  rows        Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  contracts   Int       @default(0)
  createdAt   DateTime  @default(now())
  undoneAt    DateTime?
  undoneById  String?
  // Beim Rückgängigmachen gelöscht bzw. behalten (schon angeschrieben oder gesperrt)
  removed     Int?
  kept        Int?

  @@index([customerId, createdAt])
}

model ExistingContract {
  id                 String           @id @default(cuid())
  existingCustomerId String
  existingCustomer   ExistingCustomer @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  line               String // normalisierte Sparte (KFZ, Hausrat, …)
  product            String? // Originalbezeichnung
  startDate          DateTime?
  renewalDate        DateTime?
  // Import 14.11.2026: Jahresbeitrag, Vertragsnummer, Versicherer, Status (aktiv | storniert | ruhend | unbekannt; null = nicht geliefert)
  annualPremium      Decimal?         @db.Decimal(12, 2)
  contractNo         String?
  insurer            String?
  status             String?
  // Spiegel eines Vertrags aus der App (LeadContract); null = aus dem Import
  leadContractId     String?          @unique
  leadContract       LeadContract?    @relation(fields: [leadContractId], references: [id], onDelete: Cascade)

  @@index([existingCustomerId])
}

model CustomerCampaign {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  // cross_sell | review | birthday | renewal
  occasion     String
  // Segment, z. B. { has: ["KFZ"], lacks: ["Hausrat"] } oder { birthdayDays: 30 }
  segment      Json
  // Thema für die Vorlage (z. B. „Hausrat“), Parameter {{2}}
  topic        String?
  dailyLimit   Int       @default(150)
  // draft | running | paused | done
  status       String    @default("draft")
  // Grund der Pause: kontingent (Kontingent aufgebraucht, läuft nach Paketkauf bzw. im nächsten Monat weiter); null = von Hand o. Ä.
  pausedReason String?
  createdById  String?
  // Kanal (Ole, 14.11.2026): whatsapp_first (WhatsApp bevorzugt, sonst E-Mail) | whatsapp | email
  channelMode  String    @default("whatsapp_first")
  // E-Mail-Fassung (null = Standardtext des Anlasses); Abmeldelink und Pflichtangaben kommen immer automatisch dazu
  mailSubject  String?
  mailBody     String?
  // Login, über dessen Postfach die Mails rausgehen (Standard: wer die Kampagne gestartet hat)
  senderUserId String?
  // Nachfassen (Paket 4, 20.11.2026): nach 5 Werktagen ohne Antwort genau eine Erinnerung (lib/bestand/nachfassen.ts).
  // Standard in der Datenbank aus (bestehende Kampagnen bekommen nichts nachträglich), neue Kampagnen setzen es beim Start.
  followUp     Boolean   @default(false)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([customerId, status])
}

model CampaignRecipient {
  id                 String              @id @default(cuid())
  campaignId         String
  campaign           CustomerCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  existingCustomerId String
  existingCustomer   ExistingCustomer    @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  // queued | sent | replied | failed | skipped
  status             String              @default("queued")
  reason             String?
  sentAt             DateTime?
  repliedAt          DateTime?
  conversationId     String?
  leadId             String?
  // Aus welchem Zusatzpaket die Nachricht bezahlt ist; null = Monatskontingent
  packId             String?
  pack               BestandMessagePack? @relation(fields: [packId], references: [id], onDelete: SetNull)
  // Kanal (whatsapp | email) und Rechtsgrundlage (einwilligung | uwg7_3), beim Planen gesetzt, beim Versand neu geprüft
  channel            String              @default("whatsapp")
  basis              String?
  // WhatsApp: Nachrichten-ID für Zustellstatus (delivered/read/failed aus dem Webhook)
  waMessageId        String?
  deliveredAt        DateTime?
  readAt             DateTime?
  // E-Mail: eigene Message-ID (Zuordnung von Antworten) und Unzustellbarkeit
  mailMessageId      String?
  bouncedAt          DateTime?
  // Abmeldung infolge dieser Kampagne („Stopp“ oder Abmeldelink)
  optOutAt           DateTime?
  // Nachfassen: Zeitpunkt und Kanal der einen Erinnerung. Gesetzt wird vor dem Versand per bedingtem Update
  // (nur wenn noch null), damit eine zweite Erinnerung technisch ausgeschlossen ist.
  followUpAt         DateTime?
  followUpChannel    String?

  @@unique([campaignId, existingCustomerId])
  @@index([campaignId, status])
  @@index([packId])
  @@index([waMessageId])
  @@index([mailMessageId])
}

// Protokoll der Einwilligungen je Bestandskunde und Kanal (Ole, 14.11.2026): Zeitpunkt, Text, Kanal, IP.
// action: angefragt | erteilt | bestaetigt | widerrufen | abgemeldet | gesetzt. Bei E-Mail Double-Opt-in:
// „erteilt“ mit tokenHash, „bestaetigt“ nach Klick auf den Bestätigungslink. Bleibt als Nachweis, auch wenn
// der Bestandskunde gelöscht wird (existingCustomerId wird null).
model BestandConsentLog {
  id                 String            @id @default(cuid())
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  existingCustomerId String?
  existingCustomer   ExistingCustomer? @relation(fields: [existingCustomerId], references: [id], onDelete: SetNull)
  // email | whatsapp
  channel            String
  action             String
  // formular | vermittler | import | abmeldelink | whatsapp_stopp | altdaten
  source             String?
  // Wortlaut der Einwilligung bzw. Hinweis
  text               String?
  // E-Mail-Adresse bzw. Telefonnummer zum Zeitpunkt
  address            String?
  ip                 String?
  userAgent          String?
  actorUserId        String?
  // Double-Opt-in: Hash des Bestätigungstokens (Klartext nur im Link)
  tokenHash          String?           @unique
  confirmedAt        DateTime?
  // Policen per WhatsApp (lib/policen): Lead, Version des Wortlauts, WhatsApp-ID der Knopf-Antwort
  leadId             String?
  version            String?
  waMessageId        String?
  createdAt          DateTime          @default(now())

  @@index([customerId, createdAt])
  @@index([existingCustomerId])
  @@index([leadId])
}

// Sperrliste je Vermittler (Ole, 14.11.2026): Abmeldungen wirken dauerhaft, auch nach erneutem Import oder wenn
// der Kunde neu angelegt wird. Gespeichert wird nur ein Hash der E-Mail-Adresse bzw. Telefonnummer.
// scope: email (nur E-Mail-Kampagnen) | all (alle Kanäle)
model BestandOptOut {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // email | phone
  kind       String
  hash       String
  scope      String
  createdAt  DateTime @default(now())

  @@unique([customerId, kind, hash])
}

// Zusatzpaket Kampagnen-Nachrichten im Bestandskunden-Modul (Ole, 14.11.2026): Einmalposten,
// sofort freigeschaltet, gültig 3 Monate. Verbrauch: erst das Monatskontingent, dann das älteste Paket.
// Betrag und Kaufdatum für Umsatz (Admin) und Kosten des Kunden (lib/bestand/packs.ts → bestandPackSpend).
model BestandMessagePack {
  id                  String   @id @default(cuid())
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages            Int
  // Netto in EUR
  amount              Decimal  @db.Decimal(10, 2)
  purchasedAt         DateTime @default(now())
  expiresAt           DateTime
  // kauf (Inhaber im Kundenbereich) | auto (automatisch nachgebucht)
  source              String   @default("kauf")
  createdById         String?
  // Stripe: Rechnungsposten (bzw. Rechnung bei Jahreszahlern); stripeStatus added | invoiced | failed
  stripeInvoiceItemId String?
  stripeInvoiceId     String?
  stripeStatus        String   @default("added")
  createdAt           DateTime @default(now())

  recipients CampaignRecipient[]

  @@index([customerId, expiresAt])
  @@index([purchasedAt])
}

// Nachfass-Abfolge je Lead (lib/lead-sequences.ts): feste Schritte (WhatsApp /
// Anruf-Aufgabe) mit Tagesabstand, vom 5-Minuten-Cron abgearbeitet. Stoppt bei
// Antwort, Termin, Abschluss/Kein Interesse, Reklamation, Löschung, „Stopp“.
model LeadSequence {
  id         String    @id @default(cuid())
  leadId     String
  customerId String
  // not_reached | offer | offer_selbst | offer_bedenkzeit | offer_selbst_bedenkzeit | no_show | silent | recall
  // | nicht_erreicht_mail | unterlagen (Begleit-Abfolgen, Pakete M4/M6)
  kind       String
  // Index des nächsten Schritts
  step       Int       @default(0)
  nextAt     DateTime?
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  stopReason String?
  // Verlauf ohne Inhalte: [{ at, step, action, result, detail }]
  log        Json      @default("[]")
  // Vorab-Check-Push an den Vermittler (Angebot, Paket P3): für diesen Schritt schon gesendet (je Schritt einmal)
  vorabCheckStep Int?
  // Bedenkzeit zum Angebot (Paket P5): Die Abfolge startet an diesem Tag neu, die Schritt-Tage zählen ab hier statt ab startedAt
  neustartAt DateTime?
  // Angaben für die Schritte (Paket M6): z. B. { fehlende: "• IBAN …" } für die Erinnerung „Unterlagen fehlen“
  daten      Json?
  // Vom Vermittler übersprungene Schritte (Paket P6, „Nächste Nachrichten“): werden ohne Versand weitergeschaltet
  uebersprungen Int[] @default([])

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([stoppedAt, nextAt])
  @@index([leadId])
}

// „Heute“ der Admin-Oberfläche: Punkte, die ein Admin abgehakt oder auf später
// gelegt hat (Schlüssel wie in lib/admin-heute.ts). Bis `until` ausgeblendet,
// danach erscheinen sie wieder, falls das Problem noch besteht.
// Aufgaben am Lead nach dem Abschluss (P7, Ole 17.11.2026, lib/lead-aufgaben.ts): „Police da?“, „Weiteres Produkt anbieten?“,
// später Willkommen, Unterlagen fehlen, Kündigung (M6). Heute zeigt je Lead eine Wiedervorlage (Lead.followUpAt); ist sie
// belegt, wartet die Aufgabe und rückt nach, sobald die Wiedervorlage erledigt ist. So verdrängt keine Aufgabe eine andere.
model LeadTask {
  id             String    @id @default(cuid())
  leadId         String
  customerId     String
  // police | cross_sell | (M6) willkommen | unterlagen_fehlen | kuendigung …
  kind           String
  // Text der Wiedervorlage
  note           String
  // frühestens ab dann
  dueAt          DateTime
  // wartet | aktiv | entfallen
  status         String    @default("wartet")
  // nur aktivieren, solange der Lead in dieser Phase ist (z. B. „Abschluss“); null = immer
  requiresStatus String?
  activatedAt    DateTime?
  endedReason    String?
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, kind])
  @@index([status, dueAt])
}

model AdminDismissal {
  id        String   @id @default(cuid())
  userId    String
  key       String
  until     DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, until])
}

// Laufende Kosten für die Zahlen-Seite (Tools, eigene Werbung …), vom Admin
// gepflegt. Zweck: ppl / software (direkte Kosten → Marge des Stroms),
// akquise (Kundengewinnung → CAC) oder betrieb (weder Marge noch CAC).
model RecurringCost {
  id            String    @id @default(cuid())
  name          String
  monthlyAmount Decimal   @db.Decimal(10, 2)
  purpose       String    @default("ppl")
  startsAt      DateTime
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Von Hand nachgetragene Einmal-Umsätze (Admin → Zahlen), z. B. Einrichtungsgebühren
// aus der Zeit vor den Online-Angeboten. Fließen als Strom „setup“ ins Umsatzbuch,
// nie in den MRR. kind: "setup" (Einrichtung) | "other" (Sonstiges).
model ManualRevenue {
  id         String    @id @default(cuid())
  // Monat „YYYY-MM“ (Berliner Zeit)
  month      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Netto in EUR
  amount     Decimal   @db.Decimal(12, 2)
  kind       String    @default("setup")
  note       String?
  // E-Mail des Admins, der den Eintrag angelegt hat
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([month])
  @@index([customerId])
}

// Einstellungen der Zahlen-Seite (eine Zeile, id „default“).
model KpiSettings {
  id                   String   @id @default("default")
  // Kalkulatorische Gründerzeit im Vertrieb für „CAC mit Gründerzeit“
  founderHoursPerWeek  Int      @default(20)
  founderHourlyRate    Decimal  @default(60) @db.Decimal(8, 2)
  // Meta-Kampagnen der eigenen Kundengewinnung (kommagetrennt, enthält-Vergleich)
  acquisitionCampaigns String   @default("Allianz Lead Ads")
  // Freitexte fürs Investoren-Update
  updateChallenges     String?
  updateNext           String?
  // Letzter Monat der Pay-per-Lead-Pilotphase („YYYY-MM“), leer = läuft noch
  pplPilotEnd          String?
  // Offene Chancen auf „Wachstum“ (lib/offene-chancen.ts): Standardquoten, solange ein Kunde weniger als 10
  // entschiedene Fälle je Stufe hat (Anteile, 0,4 = 40 %)
  chanceQuoteAngebot   Decimal  @default(0.4) @db.Decimal(4, 3)
  chanceQuoteTermin    Decimal  @default(0.25) @db.Decimal(4, 3)
  updatedAt            DateTime @updatedAt
}

// Öffentlicher Break-even-Rechner (/rechner): Produkte mit Erfahrungswerten,
// Texte, Kontakt-Link und Garantien. Eine Zeile („default“), Inhalt als JSON,
// geprüft in lib/rechner.ts (parseRechnerConfig). Keine personenbezogenen Daten.
model RechnerConfig {
  id        String   @id @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}

// Infokarte auf der Login-Seite (eine Zeile, id „default“). Abgelöst durch
// LoginCard (mehrere Karten, 18.11.); bleibt nur als Altbestand stehen. Das Bild liegt klein in der DB und wird öffentlich unter
// /api/login-info/image ausgeliefert (keine personenbezogenen Daten).
model LoginInfo {
  id        String   @id @default("default")
  enabled   Boolean  @default(true)
  badge     String?
  title     String
  text      String?
  linkText  String?
  linkUrl   String?
  image     Bytes?
  imageType String?
  updatedAt DateTime @updatedAt
}

// Infokarten auf der Login-Seite (Admin → Einstellungen → Login): mehrere
// Karten, an/aus und Reihenfolge (position). Bei jedem Aufruf der Login-Seite
// zeigt die Seite die nächste aktive Karte (Zähler im Cookie, lib/login-karten.ts).
// Bild: hochgeladen (image, öffentlich unter /api/login-info/image?id=…) oder
// eine Datei aus /public (imagePath, z. B. /login-karten/kollegen.webp).
model LoginCard {
  id        String   @id @default(cuid())
  // Fester Schlüssel für Karten, deren Text später aus Einstellungen kommen kann (z. B. „kollegen“)
  key       String?  @unique
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  badge     String?
  title     String
  text      String?
  linkText  String?
  linkUrl   String?
  image     Bytes?
  imageType String?
  imagePath String?
  // Klicks auf den Link der Karte (über /api/login-info/klick)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, position])
}

// Garantiefälle (Lead-Garantie, Break-even-Garantie; AGB „Garantien“).
// Der tägliche Cron legt Fälle an bzw. aktualisiert offene; gutgeschrieben wird
// erst, wenn ein Admin „Gewähren“ klickt (lib/garantien-server.ts).
model GarantieFall {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // lead | breakeven
  art            String
  // Abrechnungsmonat, der kostenlos wird (YYYY-MM, Europe/Berlin)
  monat          String
  periodeVon     DateTime
  periodeBis     DateTime
  // Schnappschuss der Kennzahlen bei der letzten Prüfung
  kennzahlen     Json
  // offen | gewaehrt | abgelehnt
  status         String    @default("offen")
  grund          String?
  entschiedenVon String?
  entschiedenAm  DateTime?
  // Stripe-Gutschrift (Rechnungsposten-ID) und deren Nettobetrag
  stripeRef      String?
  betrag         Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([customerId, art, monat])
  @@index([status])
}

// Feste Zeiten, zu denen Leads Termine buchen dürfen (je Kalender-Schlüssel:
// customerId = Agentur-Kalender, user:<id> = Kalender eines Beraters).
// Ohne Zeile gilt Mo–Fr 10, 14 und 16 Uhr (lib/calendar/lead-times.ts).
model CalendarLeadTimes {
  calendarKey String   @id
  customerId  String
  // Wochentage 0 = So … 6 = Sa
  weekdays    Int[]
  // Uhrzeiten "HH:MM" (Berliner Zeit)
  times       String[]
  // Termindauer in Minuten (15/30/45/60) für Termine in diesem Kalender
  durationMin Int      @default(30)
  // Zeiten je Wochentag wie bei Calendly: { step, days: { "1": [["08:00","13:00"]] } }.
  // Gesetzt → gilt statt weekdays/times (die dann nur die Zusammenfassung sind).
  schedule    Json?
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// „Zeit blockieren": in diesem Zeitraum werden keine Termine vorgeschlagen
// oder gebucht (zählt als belegt).
model CalendarBlock {
  id          String   @id @default(cuid())
  customerId  String
  calendarKey String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  // Herkunft (Ole, 21.11.2026, lib/calendar/termin-weiterleitung.ts): null = von Hand, „weitergeleitet“ = aus einer an
  // die persönliche Termin-Adresse weitergeleiteten Einladung. Dazu nur Hash der UID, SEQUENCE und bei Serien das
  // ursprüngliche Vorkommen (RECURRENCE-ID), damit Aktualisierung und Absage greifen. Kein Betreff, keine Teilnehmer.
  quelle      String?
  uidHash     String?
  sequence    Int?
  vorkommen   DateTime?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([calendarKey, endsAt])
  @@index([calendarKey, uidHash])
  @@index([customerId])
}

// Persönliche Termin-Adresse je Kalender (Ole, 21.11.2026, lib/calendar/termin-weiterleitung.ts):
// termine-<token>@antwort.dein-beratungstermin.de. Weitergeleitete Einladungen (.ics) blockieren die Zeit im
// App-Kalender. token: 20 Zeichen base32 (100 Bit, zufällig), nicht erratbar; neu vergeben = alte Adresse ungültig.
model KalenderWeiterleitung {
  calendarKey String   @id
  customerId  String
  token       String   @unique
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── Bank & Karten: Ausgaben importieren und als Kosten zuordnen ─────────
// Verbindung über Enable Banking (PSD2, z. B. Commerzbank) – Zustimmung gilt
// höchstens ~180 Tage. sessionEnc: Session-ID verschlüsselt (ENCRYPTION_KEY).
// status: pending (Weiterleitung läuft) | active | expired | error | revoked
model BankConnection {
  id           String            @id @default(cuid())
  provider     String            @default("enablebanking")
  aspspName    String
  aspspCountry String            @default("DE")
  psuType      String            @default("business")
  // Schutz gegen fremde Callbacks: Zufallswert der Weiterleitung (nur gehasht)
  stateHash    String?           @unique
  sessionEnc   String?
  // [{ uid, name, iban (gekürzt) }]
  accounts     Json?
  validUntil   DateTime?
  status       String            @default("pending")
  lastSyncAt   DateTime?
  lastError    String?
  reminderAt   DateTime?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions BankTransaction[]
}

// Regel: Muster (Teil von Gegenpartei oder Verwendungszweck, ohne Groß-/Kleinschreibung)
// → Zweck (ppl|software|akquise|betrieb) oder ignorieren. vatIncluded: Betrag enthält 19 % USt → netto rechnen.
model CostRule {
  id               String            @id @default(cuid())
  pattern          String
  action           String // ppl | software | akquise | betrieb | ignore
  vatIncluded      Boolean           @default(false)
  /// nur in der Gegenpartei suchen (nicht im Verwendungszweck), z. B. eigener Name für Privat-Überweisungen
  counterpartyOnly Boolean           @default(false)
  label            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactions     BankTransaction[]

  @@unique([pattern])
}

// Einzelne Buchung (Konto oder Kreditkarte). amount: Ausgaben negativ (EUR, brutto).
// status: neu | zugeordnet | ignoriert. Zugeordnete Ausgaben fließen netto in die Zahlen-Seite.
model BankTransaction {
  id                  String              @id @default(cuid())
  connectionId        String?
  connection          BankConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  // Konto-Schlüssel: Enable-Banking-Konto-UID oder „csv:commerzbank“ / „csv:amex“
  accountKey          String
  externalId          String
  source              String // enablebanking | csv
  bookingDate         DateTime            @db.Date
  amount              Decimal             @db.Decimal(12, 2)
  currency            String              @default("EUR")
  counterparty        String?
  purpose             String?
  status              String              @default("neu")
  costPurpose         String?
  vatIncluded         Boolean             @default(false)
  ruleId              String?
  rule                CostRule?           @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  note                String?
  assignedAt          DateTime?
  // Bankabgleich Mahnwesen: Eingang einem offenen Mahnfall zugeordnet (eindeutig) bzw. Vorschläge
  mahnfallId          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  zahlungsVorschlaege ZahlungsVorschlag[]
  beleg               Beleg?              @relation("BelegZahlung")
  /// Teilzahlung zu einem Beleg, der schon an einer anderen Abbuchung hängt (z. B. eine Rechnung in zwei Lastschriften,
  /// Ole 24.11.2026); gilt für „ohne Beleg“ als belegt
  belegTeilVonId      String?
  belegTeilVon        Beleg?              @relation("BelegTeilzahlungen", fields: [belegTeilVonId], references: [id], onDelete: SetNull)

  @@unique([accountKey, externalId])
  @@index([status, bookingDate])
  @@index([bookingDate])
  @@index([belegTeilVonId])
}

/// Geräte der App-Store-App (iOS/Android) für native Push-Benachrichtigungen
/// (APNs bzw. Firebase Cloud Messaging). Web-Push bleibt in PushSubscription.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  platform   String // ios | android
  token      String   @unique
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Einmal-Übergabe der Anmeldung aus der App in den System-Browser (z. B. für
/// Google-/Microsoft-Kalender verbinden, das Google in eingebetteten Ansichten
/// nicht erlaubt). Gültig 5 Minuten, nur einmal einlösbar.
model AppHandoff {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  next      String
  /// browser = App → System-Browser (api/app/handoff); app-sso:google|microsoft = Google/Microsoft-Login im System-Browser → App (api/app/login-handoff)
  purpose   String    @default("browser")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Pay-per-Lead-Eingang aus Airtable (alle Lead-Records, auch ohne Käufer):
// Grundlage für „Eingang“ und „von uns abgelehnt“ in der PPL-Auswertung,
// solange die Verteilung noch in Airtable/Zapier läuft. Kein Lead-Inhalt,
// nur Zeitpunkt, Produkt, Ergebnis und Grund.
model PplIntake {
  id         String   @id @default(cuid())
  airtableId String   @unique
  receivedAt DateTime
  // kanonischer Produktschlüssel wie Lead.source; null = ohne Produkt (z. B. Pflege-Check)
  productKey String?
  source     String?
  // geliefert | abgelehnt | offen
  outcome    String
  // Dublette | schwach | Beamter | Weitergabe abgelehnt | kein Abnehmer | wartet auf Zustimmung | in Bearbeitung
  reason     String?
  leadId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([receivedAt])
  @@index([productKey, receivedAt])
}

// ─── „Kollegen empfehlen“ (seit 15.11.2026) ─────────────────────────────
// Kunden (Vermittler) empfehlen performancegrowth an Kollegen (B2B). Der
// Empfohlene trägt sich auf /empfehlen/[code] selbst ein → Vertriebskontakt.
// Prämie für den Empfehler, sobald der Neukunde angenommen und die erste
// Rechnung bezahlt hat (lib/kollegen.ts).

// Persönlicher, stabiler Empfehlungscode je Kunde.
model ReferralCode {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       String   @unique
  createdAt  DateTime @default(now())
}

// Eine Empfehlung (Formular auf der Landingpage).
model ColleagueReferral {
  id              String        @id @default(cuid())
  referrerId      String
  referrer        Customer      @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  // Vertriebskontakt des Empfohlenen (neu angelegt oder bestehender bei Dublette)
  contactId       String?
  contact         SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Angaben des Empfohlenen (Löschfrist: 12 Monate ohne Abschluss, lib/kollegen.pruneReferrals)
  name            String?
  company         String?
  email           String?
  phone           String?
  consentAt       DateTime
  consentText     String
  // Kontakt war vorher schon im CRM (Dublette)
  existingContact Boolean       @default(false)
  // open | blocked (z. B. Selbstempfehlung, schon Kunde)
  status          String        @default("open")
  blockedReason   String?
  // Angebot angenommen (gesetzt bei Prämienprüfung)
  wonAt           DateTime?
  offerId         String?
  // none | processing | credited | manual | done_manual | skipped
  rewardStatus    String        @default("none")
  rewardAmount    Decimal?      @db.Decimal(10, 2)
  // Stripe-Rechnungsposten (negativer Betrag) der Gutschrift
  rewardRef       String?
  rewardNote      String?
  rewardedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([referrerId, createdAt])
  @@index([contactId])
  @@index([createdAt])
}

// Hinweis-Karte „Kollegen empfehlen“ im Kundenbereich: je Anlass höchstens einmal.
model ReferralNudge {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // garantie | abschluss5 | abschluss10 | feedback-day30 | feedback-day90
  key          String
  firstShownAt DateTime  @default(now())
  // weggeklickt, Link geteilt oder nach 14 Tagen abgelaufen
  closedAt     DateTime?

  @@unique([customerId, key])
}

// Einstellungen des Empfehlungsprogramms (eine Zeile, id „default“).
model ReferralSettings {
  id            String   @id @default("default")
  enabled       Boolean  @default(true)
  // month = 1 Monat Betreuung (aktueller Monatspreis des Empfehlers) | fixed = fester Betrag je Empfehlung
  // (Standard seit 15.11.2026: 300 € netto, im Code) | bestand = Bestandskunden-Modul gratis für rewardMonths Monate
  rewardKind    String   @default("month")
  rewardFixed   Decimal? @db.Decimal(10, 2)
  // Monate Bestandskunden-Modul gratis bei rewardKind bestand (Standard 3)
  rewardMonths  Int?
  // Hinweise „Kollegen empfehlen“ im Kundenbereich (nach Abschlüssen/Feedback); Standard aus (Ole, 14.11.2026)
  nudgesEnabled Boolean  @default(false)
  // none | setup_free (Einrichtung gratis) | setup_discount (Rabatt auf die Einrichtung, Betrag netto) | custom (eigener Text)
  benefitKind   String   @default("none")
  benefitText   String?
  // Betrag des Einrichtungsrabatts (netto) bei benefitKind setup_discount (Standard 500)
  benefitAmount Decimal? @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt
}

// ─── Zusatzmodul „Empfehlungen & Bewertungen“ ────────────────────────────
// Einstellungen je Kunde (Vertreter). Texte gelten im offenen 24-h-Fenster;
// sonst sendet die App die bei Meta freigegebene Vorlage.
model ReviewSettings {
  id                       String    @id @default(cuid())
  customerId               String    @unique
  // Vertreter kann das Modul pausieren, ohne es zu kündigen
  active                   Boolean   @default(true)
  // Link „Bewertung schreiben“ des Google-Unternehmensprofils
  googleReviewUrl          String?
  // Tage nach dem Abschluss: Zufriedenheitsfrage bzw. Bitte um Empfehlung
  reviewDelayDays          Int       @default(14)
  referralDelayDays        Int       @default(21)
  // Eigene Texte (null = Standard): Anfrage (direkter Draht + Google-Link),
  // Dank bei positiver Antwort, Antwort bei Kritik, Bitte um Empfehlung
  reviewText               String?
  thanksText               String?
  unhappyText              String?
  referralText             String?
  referralThanksText       String?
  praiseReferralText       String?
  // Playbook (14.11.2026): Empfehlungsangebot für die empfohlene Person.
  // none | ordner | kfz | luecke | custom (eigene Überschrift + Text, ohne Prämien)
  offerKind                String    @default("ordner")
  offerHeadline            String?
  offerText                String?
  // Bei Lob direkt den Empfehlungslink mitschicken (statt erst nach referralDelayDays)
  referralOnPraise         Boolean   @default(true)
  // Rückmeldung an Empfehlende (nur mit Einwilligung der empfohlenen Person)
  statusUpdates            Boolean   @default(true)
  // Aufgabe „Empfehlung nachfassen“ so viele Stunden nach „Empfehlungslink senden“ (0 = aus)
  followUpHours            Int       @default(48)
  // Dankeschön für Empfehlende (Tippgeber-Vergütung), standardmäßig aus. Nie für die empfohlene
  // Person und nie für einen eigenen Vertrag (§ 48b VAG). none | gutschein | spende
  rewardKind               String    @default("none")
  // Wert in Euro
  rewardAmount             Int?
  // Gutschein: Art (z. B. „Wunschgutschein“); Spende: Empfänger
  rewardNote               String?
  // termin = Termin mit der empfohlenen Person hat stattgefunden | abschluss = Abschluss
  rewardTrigger            String    @default("termin")
  // Vertreter hat bestätigt, dass er die Zulässigkeit geprüft hat
  rewardConfirmedAt        DateTime?
  // Nach einem stattgefundenen Termin mit einem Kunden (Abschluss/Bestandskunde) automatisch den
  // Empfehlungslink senden, höchstens alle 180 Tage je Kontakt. Standardmäßig aus.
  referralAfterAppointment Boolean   @default(false)
  updatedAt                DateTime  @updatedAt
  customer                 Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Je Abschluss eine Anfrage: dieselbe Nachricht an alle (erst direkter Draht zum
// Vertreter, dann Google-Link – kein Gating). Antworten wertet die KI aus:
// Kritik → Aufgabe „Kunde unzufrieden“ + keine Empfehlungsanfrage.
// status „off“ = Vertreter hat „Nicht anfragen“ gewählt (je Kontakt, nie automatisch).
model ReviewRequest {
  id             String    @id @default(cuid())
  customerId     String
  leadId         String    @unique
  // Geheimer Link für Google-Klick-Zählung und Empfehlungsseite
  token          String    @unique
  // scheduled | sent | answered | skipped | failed | off
  status         String    @default("scheduled")
  reviewDueAt    DateTime
  reviewSentAt   DateTime?
  // text (offenes Fenster) | template (freigegebene Vorlage)
  sendMode       String?
  conversationId String?
  // Erste Antwort auf die Anfrage: positive | negative | neutral (KI-Auswertung)
  sentiment      String?
  comment        String?
  answeredAt     DateTime?
  // Kritik geklärt (Vertreter hat „Geklärt“ gewählt)
  resolvedAt     DateTime?
  googleClicks   Int       @default(0)
  googleClickAt  DateTime?
  // waiting | sent | skipped | failed
  referralStatus String    @default("waiting")
  referralDueAt  DateTime?
  referralSentAt DateTime?
  referralViews  Int       @default(0)
  // Grund bei skipped/failed bzw. Hinweis (z. B. „Vorlage noch nicht freigegeben“)
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead      @relation("ReviewRequestLead", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, reviewDueAt])
  @@index([referralStatus, referralDueAt])
}

// Persönlicher Empfehlungslink je Kontakt (Lead mit Abschluss oder Bestandskunde).
// Seite /empfehlung/[token]: der Empfehlende teilt; /empfehlung/[token]/kontakt:
// die empfohlene Person trägt sich selbst ein (mit Einwilligung) → neuer Lead.
model ReferralLink {
  id                 String            @id @default(cuid())
  customerId         String
  token              String            @unique
  leadId             String?           @unique
  existingCustomerId String?           @unique
  views              Int               @default(0)
  lastSentAt         DateTime?
  // contact = Link eines Kontakts | general = allgemeiner Link des Vertreters (E-Mail-Signatur)
  kind               String            @default("contact")
  // Anlass des letzten Versands: schaden | ersparnis | jahresgespraech | termin (QR im Gespräch)
  lastOccasion       String?
  createdAt          DateTime          @default(now())
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead               Lead?             @relation("ReferralLinkLead", fields: [leadId], references: [id], onDelete: Cascade)
  existingCustomer   ExistingCustomer? @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  referredLeads      Lead[]            @relation("ReferredLeads")
  visits             ReferralVisit[]

  @@index([customerId])
}

// Einzelne Besucher der Kontaktseite einer Empfehlung (für den Trichter: Personen statt Klicks).
// visitorHash = gekürzter Hash aus Link, IP und Browser – keine IP im Klartext. Löschfrist 12 Monate.
model ReferralVisit {
  id          String       @id @default(cuid())
  linkId      String
  customerId  String
  visitorHash String
  createdAt   DateTime     @default(now())
  link        ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, visitorHash])
  @@index([customerId, createdAt])
}

// ─── Bewertungs-Wächter (Teil des Moduls „Empfehlungen & Bewertungen“) ───────
// Verbindung zum Google-Unternehmensprofil (Scope business.manage), eigene
// Verbindung neben dem Kalender, nur auf Wunsch. Tokens verschlüsselt.
model GoogleBusinessConnection {
  id              String    @id @default(cuid())
  customerId      String    @unique
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  // pending_location (Standort wählen) | connected | no_access (Google-API noch nicht freigeschaltet) | error
  status          String    @default("pending_location")
  // accounts/123 und locations/456 (Namen aus der Google-API)
  accountName     String?
  locationName    String?
  locationTitle   String?
  lastSyncAt      DateTime?
  lastError       String?
  // Stand beim ersten Abgleich: Entwicklung seit Modulstart
  startAverage    Float?
  startCount      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Google-Bewertung (nur ID, Sterne, Text, Name, Zeitpunkt; Löschfrist 2 Jahre).
// Antworten werden nur nach Klick des Vertreters veröffentlicht.
model GoogleReview {
  id             String    @id @default(cuid())
  customerId     String
  // Name der Bewertung in der Google-API (accounts/…/locations/…/reviews/…)
  googleName     String    @unique
  stars          Int
  text           String?
  reviewerName   String?
  reviewedAt     DateTime
  replyText      String?
  repliedAt      DateTime?
  // KI-Vorschlag (bearbeitbar, nie automatisch veröffentlicht)
  suggestedReply String?
  leadId         String?
  // Push/Aufgabe genau einmal
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, reviewedAt])
}

// Einmalige Ankündigungen an Kunden (z. B. neues Zusatzmodul), vom Admin ausgelöst.
model ModuleAnnouncement {
  id        String   @id @default(cuid())
  key       String   @unique
  sentAt    DateTime @default(now())
  sentCount Int      @default(0)
  sentBy    String?
}

// Google-Places-Anfragen je Tag (Kostenbremse GOOGLE_PLACES_MAX_PER_DAY)
model PlacesUsage {
  day   String @id // YYYY-MM-DD (UTC)
  count Int    @default(0)
}

// Kampagnen-Agenten (lib/kampagnen): ein Lauf = ein Durchgang des KI-Teams für
// eine Meta-Lead-Kampagne eines Kunden. Ergebnisse je Agent als JSON, Meta-IDs in
// „built“ (idempotentes Anlegen; alles PAUSED, veröffentlicht wird von Hand).
model CampaignRun {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           String
  wish              String?
  // queued | running | review | building | built | blocked | failed | cancelled
  status            String    @default("queued")
  // Nach grüner/gelber Prüfung direkt pausiert bei Meta anlegen (1 Klick)
  autoBuild         Boolean   @default(true)
  // Schritte je Agent: [{ key, status, startedAt, finishedAt, error, tokensIn, tokensOut }]
  steps             Json
  context           Json?
  plan              Json?
  angles            Json?
  copies            Json?
  creatives         Json?
  form              Json?
  review            Json?
  // Bei Meta angelegte Objekte (campaignId, adSetIds, formId, imageHashes, creativeIds, adIds)
  built             Json?
  // neu = komplette Kampagne | auffrischung = neue Anzeigen in bestehender Anzeigengruppe
  kind              String    @default("neu")
  // Auslöser: manuell | produkt (Produkt gebucht/Angebot) | auffrischung (Cron)
  trigger           String    @default("manuell")
  // Auffrischung: Ursprungslauf, Meta-Kampagne und -Anzeigengruppe, erkannte müde Anzeigen
  sourceRunId       String?
  refreshCampaignId String?
  refreshAdSetId    String?
  fatigue           Json?
  error             String?
  // KI-Kosten grob in US-Cent und Tokens
  costCents         Int       @default(0)
  tokensIn          Int       @default(0)
  tokensOut         Int       @default(0)
  // Verarbeitung läuft gerade (Schutz vor Doppelverarbeitung durch Cron)
  lockedAt          DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  finishedAt        DateTime?

  @@index([customerId, createdAt])
  @@index([status])
  @@index([refreshCampaignId, createdAt])
}

// Kampagnen-Automatik (Ole, 13.11.2026): Schalter und Schwellen (eine Zeile, id „default“).
model CampaignAutomationSettings {
  id                  String   @id @default("default")
  // Budgetänderung automatisch bei Meta umsetzen (sonst Aufgabe „Meta-Budget …“)
  budgetSync          Boolean  @default(true)
  // Produkt gebucht / Angebot angenommen → Kampagnen-Lauf automatisch starten
  autoLaunch          Boolean  @default(true)
  // Wöchentlich müde Anzeigen erkennen und neue (pausierte) Anzeigen erstellen
  refresh             Boolean  @default(true)
  refreshMaxFrequency Float    @default(3)
  // CTR mindestens 30 % unter den ersten 7 Tagen
  refreshCtrDrop      Float    @default(0.3)
  // Leadpreis mindestens 40 % über dem Kampagnenschnitt
  refreshCplRise      Float    @default(0.4)
  // Mindestausgaben je Anzeige (14 Tage), bevor der Leadpreis zählt
  refreshMinSpendEur  Float    @default(50)
  updatedAt           DateTime @updatedAt
}

// Gewünschter Kampagnen-Lauf (Produkt gebucht / Angebot angenommen), der startet,
// sobald die Voraussetzungen erfüllt sind (Cron prüft offene Wünsche).
model CampaignWish {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product       String
  // produkt | angebot
  source        String
  // waiting | started | done | failed | cancelled
  status        String    @default("waiting")
  // [{ key, message }] – was zuletzt fehlte
  problems      Json?
  runId         String?
  // Aufgabe für Ole (fehlende Voraussetzungen bzw. Fehlschlag)
  taskId        String?
  bookingId     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([customerId, product])
}

// Gesundheitsprüfung je Kunden-Kampagne (Creative-Auffrischung): wann zuletzt geprüft/aufgefrischt.
model CampaignHealth {
  campaignId    String    @id
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lastCheckedAt DateTime?
  lastRefreshAt DateTime?
  // Ergebnis der letzten Prüfung (müde Anzeigen mit Gründen)
  lastResult    Json?
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
}

// ─── Monatsberichte (seit 17.11.2026) ─────────────────────────────────────
// Ein Bericht je Kunde und Monat (Vormonat). Einstufung gut/mittel/schwach ist intern
// (nie für Kunden sichtbar). Nur „gut“ darf automatisch raus (wenn eingeschaltet);
// mittel/schwach bleiben Entwurf, Ole entscheidet (senden, bearbeiten, anrufen, aussetzen).
model MonthlyReport {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // YYYY-MM des berichteten Monats
  month       String
  // gut | mittel | schwach
  rating      String
  // ok | unsicher (zu wenige Ergebnisse eingetragen)
  dataQuality String    @default("ok")
  // Begründungen der Einstufung (intern)
  reasons     Json?
  // Kennzahlen Monat + Vormonat, Maßnahmen (Grundlage für Text und Prüfung)
  metrics     Json
  subject     String
  // Absätze als Liste
  body        Json
  // Ergebnis der Prüfung: { ok, issues[] }
  check       Json?
  // draft | sent | skipped | call
  status      String    @default("draft")
  sentAt      DateTime?
  decidedBy   String?
  costCents   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, month])
  @@index([month, status])
}

// Einstellungen Monatsberichte (eine Zeile, id „default“).
model ReportSettings {
  id                 String   @id @default("default")
  // gut-Berichte automatisch senden (Standard aus: Ole sieht im ersten Monat alles zuerst)
  autoSendGood       Boolean  @default(false)
  senderName         String?
  // Schwellen in % bzw. Anzahl
  goodLeadsPct       Int      @default(85)
  weakLeadsPct       Int      @default(60)
  weakCplPct         Int      @default(150)
  weakNoMeetingLeads Int      @default(15)
  minResultPct       Int      @default(50)
  minActiveDays      Int      @default(14)
  // Ziel-Leadpreis (€); leer = aus dem Rechner (Katze)
  targetCpl          Decimal? @db.Decimal(10, 2)
  // Terminlink für „kurzes Gespräch“; leer = Kundenbereich
  bookingUrl         String?
  updatedAt          DateTime @updatedAt
}

// Rechnungsangaben (eine Zeile, id „default“): USt-IdNr. bzw. Steuernummer für den Footer jeder
// Stripe-Rechnung (§ 14 Abs. 4 UStG). Leer = Zeile entfällt, Admin sieht eine Warnung.
model InvoiceSettings {
  id        String   @id @default("default")
  taxNumber String?
  updatedAt DateTime @updatedAt
}

// Beiträge rechnen (Pilot, Ole 16.11.2026, docs/preise-pilot.md): Schalter je Gesellschaft und Sparte, Standard aus.
// aktiv = Schlüssel „<gesellschaft>/<sparte>“ (z. B. „allianz/hausrat“). Eine Zeile, id „default“.
model PreisPilot {
  id        String   @id @default("default")
  aktiv     String[] @default([])
  updatedAt DateTime @updatedAt
}

// Selbst-Einrichtung (eine Zeile, id „default“): unsere Business-ID für den Meta-Partnerzugriff
// und je Einrichtungsschritt eine Video-URL (Loom/YouTube), die der Kunde eingebettet sieht.
model SetupSettings {
  id         String   @id @default("default")
  businessId String?
  // {"metaAccess": "https://www.loom.com/share/…", "whatsapp": "…", …}
  videos     Json?
  updatedAt  DateTime @updatedAt
}

// Neuigkeiten im Kundenbereich (/buyer/neuigkeiten): was wir verbessert haben.
// publishedAt = null → Entwurf (für Kunden unsichtbar).
model ProductUpdate {
  id          String    @id @default(cuid())
  title       String
  // Kurzer Text, Absätze und **fett** wie bei der Sondervereinbarung im Angebot
  body        String
  // neu | verbessert | behoben
  kind        String    @default("neu")
  // alle | software (Betreuung + Software) | betreuung (Nur Betreuung)
  audience    String    @default("alle")
  publishedAt DateTime?
  pushedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

/// Vertriebsunterlagen (Ole, 13.11.2026): aktuelle Makler- und Vertreter-Präsentation als PPTX und PDF.
/// Je Zielgruppe und Format genau eine Datei; ein neuer Upload ersetzt die alte.
model SalesPresentation {
  id           String   @id @default(cuid())
  audience     String // "makler" | "vertreter"
  format       String // "pdf" | "pptx"
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedAt   DateTime @default(now())
  uploadedById String?

  @@unique([audience, format])
}

/// Vertriebspräsentation zum Nachklicken (Ole, 15.11.2026): geheimer Link je Kontakt (/praesentation/<token>),
/// 14 Tage gültig, vom Admin beendbar. Ein neuer Link verlängert den aktiven (gleicher Token).
model SalesPresentationLink {
  id          String                  @id @default(cuid())
  contactId   String
  contact     SalesContact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token       String                  @unique
  // "vertreter" | "makler" (Fassung der Folien)
  audience    String                  @default("vertreter")
  expiresAt   DateTime
  endedAt     DateTime?
  createdById String?
  createdAt   DateTime                @default(now())
  views       SalesPresentationView[]

  @@index([contactId])
}

/// Aufrufe des Präsentationslinks (ohne IP oder Gerätedaten); Wiederholungen innerhalb von 30 Minuten zählen nicht.
model SalesPresentationView {
  id       String                @id @default(cuid())
  linkId   String
  link     SalesPresentationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewedAt DateTime              @default(now())

  @@index([linkId, viewedAt])
}

// Verlauf eines Leads im Kundenbereich (Ole, 13.11.2026): gepostete Notizen und Ereignisse
// (Anruf, Status, Wiedervorlage, Abschluss, Police). Gelöscht mit dem Lead (Art. 17).
model LeadHistory {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String
  // notiz | anruf | status | wiedervorlage | abschluss | police | dokument | email
  kind       String
  text       String
  userId     String?
  // E-Mail-Eintrag: Betreff, Text und Zustellstatus stehen in ContactMail
  mailId     String?      @unique
  mail       ContactMail? @relation(fields: [mailId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([leadId, createdAt])
}

// Erneut eingetragen (Ole, 16.11.2026, lib/lead-erneut.ts): Trägt sich dieselbe Person (gleiche Telefonnummer oder
// E-Mail) beim selben Kunden noch einmal ein, entsteht kein zweiter Lead. Je Einsendung eine Zeile: Meta-Lead-ID
// gegen doppelte Zustellung (Meta + Zapier), Formular, Produkt und Einwilligungsnachweis dieser Einsendung.
model LeadReentry {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId     String
  externalId     String?  @unique
  formId         String?
  productKey     String?
  consentData    Json?
  // Anzeige dieser Einsendung (jede kann aus einer anderen Anzeige kommen), wie am Lead (lib/anzeige.ts)
  adPlatform     String?
  adFormId       String?
  adCampaignId   String?
  adCampaignName String?
  adSetId        String?
  adSetName      String?
  adId           String?
  adName         String?
  createdAt      DateTime @default(now())

  @@index([leadId])
  @@index([customerId, createdAt])
  @@index([adCampaignId])
  @@index([adId])
}

// Ausgehende E-Mails an Leads und Bestandskunden (Ole, 15.11.2026): jede Mail (automatisch oder vom Vermittler)
// steht im Verlauf des Kontakts, mit Art, Empfänger, Betreff, Text und Zustellstatus. Bestandskunden ohne Lead
// haben nur existingCustomerId. Gelöscht mit Lead bzw. Bestandskunde (Art. 17, lib/erasure.ts).
model ContactMail {
  id                 String            @id @default(cuid())
  customerId         String
  leadId             String?
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  existingCustomerId String?
  existingCustomer   ExistingCustomer? @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  // terminbestaetigung | terminverschiebung | terminabsage | terminerinnerung | bestandskampagne | kein_whatsapp
  // | bewertungsbitte | einwilligung | manuell (lib/mail/kontakt-mail.ts MAIL_ARTEN)
  kind               String
  // Zusatz zur Art, z. B. Name der Kampagne
  label              String?
  automatic          Boolean           @default(true)
  recipient          String
  subject            String
  body               String
  // versendet | zugestellt | nicht_zustellbar | abgemeldet | nicht_versendet
  status             String            @default("versendet")
  reason             String?
  statusAt           DateTime?
  // resend | postfach; Message-ID zum Abgleich mit Zustell-Ereignissen (Resend-Webhook, Bounce, Abmeldung)
  provider           String?
  providerMessageId  String?
  userId             String?
  createdAt          DateTime          @default(now())
  history            LeadHistory?
  // ausgang | eingang (Paket M2: Antwort des Leads an die Antwortadresse; recipient = Absender, status „empfangen“)
  richtung           String            @default("ausgang")
  eingang            MailEingang?

  @@index([leadId, createdAt])
  @@index([existingCustomerId, createdAt])
  @@index([providerMessageId])
}

// Eingang an die Antwortadresse (Ole, 18.11.2026, Paket M2, lib/mail/eingang.ts): ein Eintrag je Resend-Ereignis
// „email.received“ (Idempotenz, Fortschritt, Diagnose). Keine Inhalte, keine Absenderadresse: Betreff und Text stehen nur
// in ContactMail (mit dem Lead gelöscht). anhaenge: Name, Größe, Typ, Resend-ID, weitergeleitet ja/nein (Download über
// die App holt eine frische Adresse bei Resend). Ohne Lead nach 90 Tagen gelöscht (pruneTransient).
model MailEingang {
  id               String       @id @default(cuid())
  resendEmailId    String       @unique
  customerId       String?
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactMailId    String?      @unique
  contactMail      ContactMail? @relation(fields: [contactMailId], references: [id], onDelete: SetNull)
  // code | absender | kunde | keine | termin (weitergeleitete Einladung, lib/calendar/termin-weiterleitung.ts)
  zuordnung        String       @default("keine")
  // in_arbeit | antwort | hinweis | termin | ignoriert | fehler
  ergebnis         String       @default("in_arbeit")
  // Kurzer Grund ohne Inhalte (z. B. „auto_antwort“, „schleife“, „absender_unbestaetigt“, „schalter_aus“)
  grund            String?
  anhaenge         Json?
  weitergeleitetAt DateTime?
  pushAt           DateTime?
  versuche         Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([customerId, createdAt])
  @@index([leadId])
  @@index([createdAt])
}

// Vorlagen-Mails an Leads (Ole, 17.11.2026, Paket M0, lib/mail/vorlagen-mail.ts): Reservierung vor dem Versand.
// Je Lead, Vorlage und Anlass höchstens eine Mail (unique); tagesSchluessel („<leadId>:<YYYY-MM-DD>“, Berlin) nur bei
// automatischen Mails ohne Pflicht, damit je Lead und Tag höchstens eine rausgeht. Scheitert der Versand, wird die
// Zeile gelöscht (später neuer Versuch möglich). Keine personenbezogenen Inhalte; gelöscht mit dem Lead.
model LeadMailVersand {
  id              String   @id @default(cuid())
  customerId      String
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // VorlageKey (lib/mail/vorlagen.ts)
  vorlage         String
  // Anlass, z. B. Termin-ID oder „anruf-2“
  anlass          String
  automatisch     Boolean  @default(true)
  // Berliner Kalendertag YYYY-MM-DD
  tag             String
  tagesSchluessel String?  @unique
  // reserviert | gesendet
  status          String   @default("reserviert")
  contactMailId   String?
  createdAt       DateTime @default(now())

  @@unique([leadId, vorlage, anlass])
  @@index([leadId, tag])
}

// Dokumente am Lead (Ole, 13.11.2026): z. B. das Angebot, das der Vermittler geschickt hat,
// oder die Police. Gespeichert in der Datenbank, gelöscht mit dem Lead (Art. 17).
model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId   String
  // angebot | police | sonstiges | beratungsdoku (Gesprächszusammenfassung als PDF, Paket M5)
  kind         String
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedById String?
  // Virenprüfung beim Hochladen (lib/sicherheit/virenpruefung.ts): sauber | ungeprueft; null = vor dem 18.11.2026.
  // Policen (kind = police) werden ungeprüft nicht angeboten, bis die Prüfung gelaufen ist.
  virenStatus  String?
  createdAt    DateTime @default(now())
  // Nur Beratungsdokumentation: bleibt beim Löschen des Leads bis zu diesem Zeitpunkt als Nachweis (VVG §§ 61, 62;
  // lib/lead-files.ts BERATUNGSDOKU_AUFBEWAHRUNG_JAHRE), danach löscht der Cron sie
  aufbewahrenBis DateTime?

  contracts LeadContract[]

  @@index([leadId])
  @@index([aufbewahrenBis])
}

// Unterlagen, die ein Lead per WhatsApp schickt (Ole, 17.11.2026, lib/policen): Fotos oder PDFs seiner Policen,
// damit sich der Vermittler vor dem Termin einlesen kann. Inhalt app-seitig verschlüsselt (AES-256-GCM, ENCRYPTION_KEY).
// Gesundheitsbezug (Kranken, BU, Leben, Pflege, Unfall): nur mit ausdrücklicher Einwilligung (Art. 9 Abs. 2 lit. a DSGVO,
// consentId → BestandConsentLog) und nur bei POLICEN_GESUNDHEIT_AN; nie ausgelesen. Gelöscht 30 Tage nach dem Termin
// ohne Abschluss, sofort bei Widerruf und mit dem Lead (Art. 17).
model LeadDocument {
  id               String    @id @default(cuid())
  customerId       String
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId   String?
  // Chat-Nachricht, mit der die Unterlage kam (Message.id)
  messageId        String?
  // gespeichert | wartet (Einwilligung ausstehend: nur die WhatsApp-Media-ID, kein Inhalt)
  status           String    @default("gespeichert")
  // WhatsApp-Media-ID, nur solange die Einwilligung aussteht
  waMediaId        String?
  mimeType         String
  fileName         String
  size             Int
  // Alte Ablage (bis 18.11.2026): verschlüsselt in der Datenbank (lib/encryption.ts encryptBytes). Neu: null.
  data             Bytes?
  // Neue Ablage (Rechtsprüfung A6): Schlüssel im privaten Policen-Bucket (lib/policen/ablage.ts), Inhalt mit dem
  // Schlüssel des Mandanten verschlüsselt. null solange status = wartet bzw. bei alten Unterlagen.
  storageKey       String?
  // Crypto-Shredding (Ole, 18.11.2026, lib/policen/ablage.ts Format 2): eigener Datenschlüssel der Datei, verpackt mit
  // dem Schlüssel des Mandanten (Base64). Mit dem Eintrag gelöscht = Datei nicht mehr lesbar. null bei Format 1.
  dateiSchluessel  String?
  // Virenprüfung (lib/sicherheit/virenpruefung.ts): sauber | ungeprueft (nicht angeboten, bis geprüft).
  // null = vor dem 18.11.2026 eingegangen. Dateien mit Befund werden nie gespeichert.
  virenStatus      String?
  // police | sonstig
  kind             String    @default("police")
  // Sparte laut Klassifikation, z. B. haftpflicht, hausrat, kfz, kranken, bu (lib/policen/regeln.ts SPARTEN)
  sparte           String?
  // Dokumentart aus der lokalen Texterkennung (lib/policen/texterkennung.ts): fahrzeugschein | kfz_police | police.
  // null = nicht erkannt bzw. nicht geprüft (ohne KI-Einwilligung). Der erkannte Text wird nie gespeichert.
  dokumentArt      String?
  gesundheitsbezug Boolean   @default(false)
  // Einwilligung (seit 18.11.2026 PolicenNachweis.id, vorher BestandConsentLog.id) und Zeitpunkt
  consentId        String?
  consentAt        DateTime?
  // Ausgelesene Vertragsdaten (nur Sachversicherungen): Gesellschaft, Sparte, Beitrag, Zahlweise, Summe, SB, Ablauf
  extracted        Json?
  extractedAt      DateTime?
  // Geplante Löschung (Cron: 30 Tage nach dem Termin ohne Abschluss, 90 Tage nach dem Abschluss)
  deleteAfter      DateTime?
  // Erinnerung an den Vermittler „In die Kundenakte übernehmen“ (14 Tage vor der Löschung nach Abschluss)
  erinnertAt       DateTime?
  // „Beratungsdokumentation behalten“ (Vermittler): keine automatische Löschung; Zeitpunkt, Login und Vermerk
  behaltenAt       DateTime?
  behaltenVonId    String?
  behaltenVermerk  String?
  createdAt        DateTime  @default(now())
  auszug           PolicenAuszug?

  @@index([leadId])
  @@index([customerId])
  @@index([status, createdAt])
}

// Policen auslesen (Ole, 18.11.2026, lib/policen/auslesen): Vertragsfelder einer Unterlage vom Kunden für das
// Vergleichsblatt in der Terminvorbereitung. Nur feste Vertragsfelder (Whitelist, keine Gesundheitsangaben, kein
// Freitext), Versicherungsnummer nur maskiert. Kein Prompt, keine Rohantwort. Wird mit der Unterlage gelöscht
// (Cascade: Löschfrist, Widerruf, Art. 17); bleibt nur, was der Vermittler ausdrücklich in den Bestand übernimmt
// (ExistingContract). Eigene Tabelle ohne Anbindung an Statistik oder Benchmarks.
model PolicenAuszug {
  id                 String       @id @default(cuid())
  customerId         String
  leadId             String
  lead               Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  documentId         String       @unique
  document           LeadDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // laeuft | ausgelesen | sparte_offen | sparte_abweichend | gesperrt | limit | fehler | leer
  status             String
  // Sparte für das Auslesen (lib/policen/auslesen/felder.ts AUSLESEN_SPARTEN) und woher sie vorab stammt:
  // unterlage (Dateiname/Begleittext) | text (Textebene Seite 1, lokal) | vermittler
  sparte             String?
  sparteQuelle       String?
  // { feld: { w: Wert, s: ok | pruefen | korrigiert } }, nur Felder der Whitelist
  felder             Json?
  anbieter           String?
  modell             String?
  ausgelesenAt       DateTime?
  versuche           Int          @default(0)
  // Vermittler hat die Werte geprüft bzw. korrigiert
  geprueftAt         DateTime?
  geprueftVonId      String?
  // „In Bestand übernehmen“: ExistingContract.id (bleibt nach der Löschung dieser Zeile bestehen)
  uebernommenAt      DateTime?
  uebernommenVonId   String?
  existingContractId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([leadId])
  @@index([customerId])
}

// Bremse für das Auslesen (Ole, 18.11.2026): Aufrufe beim KI-Anbieter je Kalendertag (Europe/Berlin), unabhängig von
// späteren Löschungen; gemeldetAt = Admin-Hinweis „Tageslimit erreicht“ schon verschickt.
model PolicenAuslesenTag {
  tag        String    @id
  anzahl     Int       @default(0)
  gemeldetAt DateTime?
}

// Einstellungen zum Auslesen (eine Zeile, id „global“, Admin → Anbindungen): Nachweis „keine Speicherung“ beim
// KI-Anbieter (schaltet Kranken/BU/Leben frei, Rechtsprüfung K2), Pause nach 401 (Fingerabdruck des Schlüssels,
// ein neuer Schlüssel hebt sie auf) und wann Admins zuletzt benachrichtigt wurden.
model PolicenAuslesenEinstellung {
  id                    String    @id @default("global")
  zdrNachweisAm         DateTime?
  zdrReferenz           String?
  zdrVonId              String?
  schluesselUngueltigAt DateTime?
  schluesselFinger      String?
  ungueltigGemeldetAt   DateTime?
  ablaufGemeldetAt      DateTime?
  updatedAt             DateTime  @updatedAt
}

// Nachweise zu Policen per WhatsApp (Rechtsprüfung A3, Ole 18.11.2026): Einwilligung (mit bzw. ohne KI), Ablehnung,
// Widerruf, Opt-in für Erinnerungen aus der Buchung. Nur anhängen: Ein Datenbank-Trigger verbietet UPDATE und DELETE
// (DELETE nur bei Art. 17 bzw. Vertragsende mit SET LOCAL app.policen_nachweis_loeschen = 'ja', lib/erasure.ts).
// Bleibt nach dem Löschen der Policen als Nachweis, ohne Inhalte. Keine Fremdschlüssel (Lead-Löschung kaskadiert nicht).
model PolicenNachweis {
  id                 String   @id @default(cuid())
  customerId         String
  leadId             String?
  // WhatsApp-Nummer des Leads
  phone              String
  // einwilligung | abgelehnt | widerruf | erinnerung_optin | erinnerung_stopp | ohne_ki (Stichwort „ohne KI“, A9)
  art                String
  // KI-Auslesen erlaubt („Einverstanden“ = true; mit Stichwort „ohne KI“ vorher oder danach = false, A9); null bei
  // anderen Arten
  ki                 Boolean?
  // Wortlaut, wie gesendet (Einwilligungsnachricht mit Fußzeile und Knopftext bzw. Häkchentext der Buchung)
  wortlaut           String?
  textVersion        String?
  // Version und Adresse der Datenschutzhinweise, auf die der Text verweist
  datenschutzVersion String?
  datenschutzUrl     String?
  // WhatsApp-ID der Knopfantwort und der beantworteten Nachricht (context.id)
  waMessageId        String?
  frageWaMessageId   String?
  // Zuständiger Vermittler (Lead.assignedUserId) und Name im Text
  vermittlerUserId   String?
  vermittlerName     String?
  // whatsapp | buchung | vermittler | system
  quelle             String
  // SHA-256 (hex) des Wortlauts, dem zugestimmt wurde (Policen-Strecke v2, Formular „Zustimmen & senden“, A3)
  textHash           String?
  createdAt          DateTime @default(now())

  @@index([customerId, phone, createdAt])
  @@index([leadId, createdAt])
}

// Policen-Strecke v2 (Ole, 19.11.2026, lib/policen/flow): WhatsApp Flow „Policen senden“ je Kunde (WABA), angelegt und
// veröffentlicht über 360dialog, dazu die Vorlagen mit Flow-Knopf. Nur mit POLICEN_FLOW=1 angelegt und genutzt.
model PolicenFlow {
  id          String    @id @default(cuid())
  customerId  String    @unique
  // ID des Flows bei Meta (über 360dialog)
  flowId      String?
  // Name bei Meta (policen_senden_<hash>) und SHA-256 des veröffentlichten Flow JSON (Änderung = neuer Flow)
  name        String?
  jsonHash    String?
  // entwurf | veroeffentlicht | fehler
  status      String    @default("entwurf")
  fehler      String?
  // Vorlagen mit Flow-Knopf: { [name]: { status, category, grund } }
  vorlagen    Json?
  publishedAt DateTime?
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Verträge je Lead (Cross-Selling, Ole 14.11.2026): Sparte, Beitrag, Datum, optional Versicherer,
// Vertragsnummer und Police. Der erste Abschluss (Lead.closedAt/closeValue) hat primaryLeadId = leadId.
// Provision je Vertrag mit der Rate seiner Sparte (lib/provision.contractProvision).
model LeadContract {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId     String
  // = leadId beim ersten Abschluss des Leads (höchstens einer je Lead), sonst null
  primaryLeadId  String?   @unique
  // Sparte (lib/provision SPARTEN): katze | hund | pferd | privatschutz | unfall | hausrat | wohngebaeude |
  // rechtsschutz | kindersparplan | kfz | leben_bu | pkv | sonstiges
  sparte         String
  // Jahresbeitrag netto (Leben/BU/Kindersparplan: eingegebener Monatsbeitrag × 12); bei PKV der Monatsbeitrag,
  // bei der PKV-Tarifoptimierung die monatliche Ersparnis des Kunden. null = nicht eingetragen (Standard der Sparte)
  premium        Decimal?  @db.Decimal(12, 2)
  // Leben/BU/Rente/Kindersparplan (Rechenart beitragssumme): Laufzeit in Jahren oder Alter + Endalter,
  // optional die Beitragssumme direkt (geht vor Monatsbeitrag × 12 × Laufzeit)
  termYears      Int?
  customerAge    Int?
  endAge         Int?
  beitragssumme  Decimal?  @db.Decimal(14, 2)
  // Fester Provisionswert aus der Zeit vor den Verträgen (frei eingegebener Abschlusswert); gilt, solange kein Beitrag eingetragen ist
  provisionValue Decimal?  @db.Decimal(12, 2)
  // Sparte „Sonstiges“ mit eigenem Produkt (Ole, 14.11.2026): Name und Sätze am Vertrag (Anteile, 0,2 = 20 %).
  // rateBestand = Bestandsprovision pro Jahr ab dem 2. Jahr. Ohne Sätze rechnet „Sonstiges“ wie bisher.
  productName    String?
  rateAbschluss  Decimal?  @db.Decimal(7, 4)
  rateBestand    Decimal?  @db.Decimal(7, 4)
  signedAt       DateTime
  insurer        String?
  contractNo     String?
  // Police als Dokument am Lead
  fileId         String?
  file           LeadFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  // Herkunft des Beitrags (Abschluss mit einem Tipp, Ole 17.11.2026): angebot (aus der Terminvorbereitung) | vermittler
  // (eingetragen bzw. bestätigt) | standard (typischer Beitrag der Sparte, geschätzt, „≈“). null = Altbestand
  premiumSource  String?
  // Einheitlicher Jahresbeitrag netto (PKV und Kranken-Zusatz: Monatsbeitrag × 12; Tarifoptimierung: null)
  premiumYear    Decimal?  @db.Decimal(12, 2)
  // aktiv | storniert
  status         String    @default("aktiv")
  // Vertrag gekündigt bzw. storniert zum (ab hier kein Bestand mehr); Rückbelastung wird in diesem Monat gebucht
  cancelledAt    DateTime?
  // Grund (lib/provision CANCEL_REASONS): kunde | widerruf | nichtzahlung | versicherer | sonstiges.
  // null bei storniert = Altfall vor dem 14.11.2026, zählt wie bisher gar nicht
  cancelReason   String?
  // Rückbelastung der Abschlussprovision (€), mindert Provision und Gewinn im Monat von cancelledAt
  chargeback     Decimal?  @db.Decimal(12, 2)
  createdById    String?
  // Bestandsübertragung aus der Maklervollmacht (Ole, 18.11.2026, lib/maklervollmacht/uebertragung.ts): herkunft
  // „uebertragung“ (null = eigener Abschluss). Nur Bestandsprovision, keine Abschlussprovision; zählt in Umsatz und
  // Kennzahlen erst ab uebertragungBestaetigtAt (Gesellschaft hat auf den Makler umgeschlüsselt). Abgelehnt = storniert.
  herkunft                 String?
  uebertragungBestaetigtAt DateTime?
  vollmachtId              String?
  // „<vollmachtId>:<Index des Vertrags>“: je Vertrag der Vollmacht höchstens einmal angelegt
  uebertragungKey          String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  existingContract ExistingContract?

  @@index([customerId, signedAt])
  @@index([leadId])
  @@index([vollmachtId])
}

// Eigenes Postfach eines Logins (Ole, 13.11.2026): E-Mails an Leads aus der App, gesendet über
// Google (Gmail), Microsoft (Outlook/365) oder SMTP. Zugangsdaten verschlüsselt.
model MailConnection {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId          String
  // google | microsoft | smtp
  provider            String
  email               String
  fromName            String?
  accessTokenEnc      String?
  refreshTokenEnc     String?
  expiresAt           DateTime?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPassEnc         String?
  // ok | error
  status              String    @default("ok")
  lastError           String?
  // Bestandskampagnen per E-Mail: Drosselung (lib/bestand/mail-drossel.ts)
  campaignBackoff     Int       @default(0)
  campaignErrors      Int       @default(0)
  campaignPausedUntil DateTime?
  campaignNextAt      DateTime?
  campaignIssueAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([customerId])
}

// E-Mail-Vorlagen eines Kunden (Platzhalter {vorname}, {name}, {produkt}, {meinname}).
model MailTemplate {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  // Welche Standardvorlage (lib/mail/vorlagen.ts, z. B. „nicht_erreicht“); null = eigene Vorlage
  standardKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

// LinkedIn: persönliches Profil (Ole, 14.11.2026). KI-Entwürfe nach Reichweite,
// Freigabe per Klick, Veröffentlichen zur geplanten Uhrzeit (docs/linkedin.md).
model LinkedInConnection {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // urn:li:person:{sub}
  personUrn      String
  name           String?
  accessTokenEnc String
  expiresAt      DateTime
  // gewährte Berechtigungen (z. B. „openid profile w_member_social r_member_postAnalytics“)
  scopes         String    @default("")
  // ok | error
  status         String    @default("ok")
  lastError      String?
  // Erinnerung „neu verbinden“ (einmal je Ablauf)
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Einstellungen (eine Zeile, id „default“)
model LinkedInSettings {
  id              String    @id @default("default")
  postsPerDay     Int       @default(5)
  // Uhrzeiten (deutsche Zeit), kommagetrennt
  slots           String    @default("07:30,09:30,12:00,15:00,18:00")
  weekdays        Boolean   @default(true)
  // Über mich, Zielgruppe, Themen, Tonfall – Grundlage für die Entwürfe
  about           String    @default("")
  autoDrafts      Boolean   @default(true)
  // Zielgruppe (ICP): optimiert wird auf Reichweite in dieser Gruppe, nicht auf Reichweite insgesamt
  icp             String    @default("Versicherungsvermittler in Deutschland: Ausschließlichkeitsvertreter (z. B. Allianz-Agenturen), Mehrfachagenten und Makler, die mehr Neukunden wollen. Sie verkaufen z. B. Tierkrankenversicherung, Privatschutz und PKV. Wir verkaufen ihnen Leadgenerierung über Meta-Werbung plus unsere Software mit WhatsApp-Assistent, der Leads qualifiziert und Termine bucht.")
  // Produkt-Schwerpunkt der Posts (Ole, 14.11.2026: Hauptprodukt TKV, PKV nur als Optimierung nach §204 VVG)
  focus           String    @default("Hauptprodukt ist die Tierkrankenversicherung (Katze und Hund): Die meisten Posts drehen sich darum (Leads, Abschlüsse, Cross-Selling aus TKV-Kunden). PKV nur selten und dann ausschließlich als PKV-Optimierung nach §204 VVG (Tarifwechsel beim eigenen Versicherer), nie als PKV-Neugeschäft. Andere Sparten nur am Rand.")
  // Begriffe, an denen die Zielgruppe in den LinkedIn-Zuschauerdaten erkannt wird (Branche, Beruf)
  icpKeywords     String    @default("versicherung, insurance, makler, broker, vermittler, agentur, generalvertret, hauptvertret, finanzberat, financial advisor, allianz, ergo, axa, signal iduna, debeka, hallesche, gothaer")
  // Anteil der Zielgruppe an allen Zuschauern (aus dem Profil-Export), Ersatz, wenn je Post nichts vorliegt
  accountIcpShare Float?
  // Trust-Material von Ole (z. B. freigegebene Kundenstimmen, Erfolge) – nur das darf als Fakt/Zitat in Posts
  trustNotes      String    @default("")
  // Vorlauf: so viele Posting-Tage im Voraus hält die Automatik mit Entwürfen gefüllt (Ole, 14.11.2026)
  planDays        Int       @default(1)
  // Uhrzeit (deutsche Zeit), ab der die Entwürfe für den nächsten Tag geschrieben werden
  draftHour       Int       @default(17)
  lastImportAt    DateTime?
  // Sperre gegen doppeltes Schreiben (Cron alle 5 Minuten, ein Lauf dauert ca. 1–2 Minuten)
  draftingAt      DateTime?
  updatedAt       DateTime  @updatedAt
}

model LinkedInPost {
  id             String         @id @default(cuid())
  // entwurf | freigegeben | sendet | veroeffentlicht | verworfen | fehler | importiert
  status         String
  text           String         @default("")
  // Thema in wenigen Worten und was der Post testen soll
  idea           String?
  hypothesis     String?
  // Tag (YYYY-MM-DD, deutsche Zeit), für den der Entwurf geschrieben wurde
  draftDate      String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  // urn:li:share:… (aus der App) bzw. urn:li:activity:… (aus dem Export)
  postUrn        String?        @unique
  url            String?
  impressions    Int?
  membersReached Int?
  reactions      Int?
  comments       Int?
  reposts        Int?
  engagements    Int?
  metricsAt      DateTime?
  // Quelle der Zahlen: api | export | hand
  metricsSource  String?
  // Anteil der Zielgruppe an den Zuschauern dieses Posts (0–1, aus dem Post-Export)
  icpShare       Float?
  // Text-Grafik (Kernaussage groß auf Blau, ohne Illustration), wenn kein Foto/KI-Bild
  graphic        String?
  useGraphic     Boolean        @default(false)
  // Foto aus der Fotoablage oder KI-Bild (optional); bei Löschung bleibt der Post ohne Bild
  photoId        String?
  photo          LinkedInPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([draftDate])
}

// Fotos von Ole für seine Posts (Ole, 14.11.2026). Beschreibung schreibt die KI beim Hochladen.
model LinkedInPhoto {
  id          String         @id @default(cuid())
  fileName    String
  contentType String
  size        Int
  data        Bytes
  description String         @default("")
  // true = KI-Bild zu einem Entwurf (nicht in der Fotoablage gezeigt)
  generated   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  posts       LinkedInPost[]
}

// ─── Automatische Optimierung je Werbekonto (Ole, 18.11.2026; lib/optimierung) ───
// Ein Eintrag je optimiertem Werbekonto: eigenes Meta-Konto eines Kunden (kind „kunde“)
// oder ein Pay-per-Lead-Pool (kind „pool“: Kampagnen eines Produkts im Agenturkonto).
model OptimizationAccount {
  id                 String                @id @default(cuid())
  // kunde | pool
  kind               String
  customerId         String?               @unique
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Pool: Produkt wie Lead.source bzw. LeadSubscription.productKey (kanonisch)
  poolProduct        String?               @unique
  label              String
  // Meta-Werbekonto ohne „act_“ (Pool: leer = Agenturkonten aus META_AD_ACCOUNT_IDS)
  adAccountId        String?
  // null = globale Einstellung, true = Autopilot, false = Vorschlag
  autopilot          Boolean?
  // Ziel-Leadpreis (€); leer = Kunde: Rechner bzw. eigener Schnitt, Pool: Kampagnenschnitt
  targetCpl          Decimal?              @db.Decimal(10, 2)
  // Vereinbartes Tagesbudget gesamt (€) als Obergrenze; Kunde: zusätzlich Werbebudget aus dem Vertrag
  agreedDailyBudget  Decimal?              @db.Decimal(10, 2)
  // Nur Kampagnen, deren Name dieses Stichwort enthält (leer = Kunde: alle aktiven, Pool: Produktname)
  campaignKeyword    String?
  active             Boolean               @default(true)
  lastRunAt          DateTime?
  // Ergebnis bzw. Problem des letzten Laufs (z. B. kein Zugriff)
  lastRunNote        String?
  // Laufende Anzeigen beim letzten Lauf (0 = nichts aktiv, z. B. pausiert: keine Frühwarnung)
  lastRunAds         Int?
  activitiesSyncedAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  measures           OptimizationMeasure[]

  @@index([kind, active])
}

// Protokoll der Maßnahmen (automatisch geplant oder von Hand eingetragen). Quelle für den Monatsbericht.
model OptimizationMeasure {
  id            String               @id @default(cuid())
  accountId     String?
  account       OptimizationAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Kunde (bei Pool-Konten leer; dann über das Pool-Produkt zuordnen)
  customerId    String?
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // geplant | freigegeben | abgelehnt | ausgefuehrt | fehlgeschlagen
  status        String               @default("geplant")
  // motiv_erneuern | anzeige_pausieren | budget_umschichten | formular_vorschlag | zielgruppe_vorschlag | motiv_vorschlag | manuell
  kind          String
  // automatik | manuell
  source        String               @default("automatik")
  // ad | adset | campaign | account
  targetType    String               @default("account")
  targetId      String?
  targetName    String?
  title         String
  // Begründung mit Datenpunkten (intern, für Ole)
  reason        String
  // Kennzahlen zum Zeitpunkt der Planung
  data          Json?
  // Ausführungsparameter (z. B. Budgets vorher/nachher)
  params        Json?
  // größere Änderung (zählt für „höchstens 1 je Anzeigengruppe und Woche“)
  major         Boolean              @default(false)
  // Schutz vor Doppelplanung: Konto|Woche|Art|Ziel (manuell: leer)
  dedupeKey     String?              @unique
  plannedAt     DateTime             @default(now())
  decidedAt     DateTime?
  // wer freigegeben bzw. abgelehnt hat (E-Mail, „Autopilot“)
  decidedBy     String?
  executedAt    DateTime?
  // Ergebnis bzw. Fehler der Ausführung
  result        String?
  // Motiv-Erneuerung: Auffrischungs-Lauf der Kampagnen-Agenten
  campaignRunId String?
  createdBy     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([customerId, executedAt])
  @@index([accountId, status])
  @@index([status, executedAt])
}

// Meta-Änderungsprotokoll (Ad Account activities) je Werbekonto, Quelle für den Monatsbericht.
model MetaAdActivity {
  id                  String   @id @default(cuid())
  adAccountId         String
  // Kundenkonto: Kunde; Agenturkonto: leer
  customerId          String?
  eventTime           DateTime
  eventType           String
  translatedEventType String?
  objectId            String?
  objectName          String?
  objectType          String?
  actorName           String?
  applicationName     String?
  extraData           String?
  // Konto|Zeit|Art|Objekt
  dedupeKey           String   @unique
  createdAt           DateTime @default(now())

  @@index([customerId, eventTime])
  @@index([adAccountId, eventTime])
}

// Einstellungen der Optimierung (eine Zeile, id „default“).
model OptimizationSettings {
  id        String   @id @default("default")
  // Wöchentlicher Lauf an (plant Maßnahmen; ausgeführt wird nur nach Freigabe bzw. im Autopilot)
  enabled   Boolean  @default(true)
  // Globaler Modus: false = Vorschlag (Standard), true = Autopilot
  autopilot Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Postausgang „Rückmeldung an Meta“ (Conversions API für CRM, Ole 15.11.2026, lib/capi): je Lead und Stufe
// höchstens ein Ereignis mit dem frühesten Zeitpunkt. Gesendet werden nur Meta-Lead-ID, Stufe, Zeitpunkt und
// beim Abschluss der Jahresbeitrag (keine Kontaktdaten, kein Produkt). Wird nach 13 Monaten gelöscht.
model CapiEvent {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // lead | erreicht | termin | abschluss
  stage         String
  eventTime     DateTime
  // Nur Abschluss: Jahresbeitrag netto beim Senden (EUR); null = ohne Beitrag gesendet
  value         Decimal?  @db.Decimal(12, 2)
  // queued | sent | failed | skipped
  status        String    @default("queued")
  attempts      Int       @default(0)
  // Fehler (Tokens geschwärzt) bzw. Grund bei skipped (z. B. „zu alt“)
  error         String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([leadId, stage])
  @@index([customerId, status, createdAt])
  @@index([status, nextAttemptAt])
}

// Erstinformation des Vermittlers (§ 15/16 VersVermV, Ole 15.11.2026): der Assistent schickt den Link
// /erstinformation/<token> in der ersten Nachricht. PDF (in der Datenbank) oder Link auf die eigene Seite.
model Erstinformation {
  id             String    @id @default(cuid())
  customerId     String    @unique
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Öffentlicher Teil der Adresse (zufällig, ändert sich nicht)
  token          String    @unique
  // IHK-Vermittlerregister, Format D-XXXX-XXXXX-XX
  registerNummer String?
  // Status (Customer.vermittlerTyp) in der Einrichtung bestätigt
  statusAt       DateTime?
  // Pflichtangaben nach § 15 Abs. 1 VersVermV (Ole, 15.11.2026). null = Vorschlag aus Impressum/Angebot
  // (lib/erstinformation-shared.ts erstinfoDaten), gespeichert wird beim Bestätigen in der Einrichtung.
  name           String?
  // Anrede des Vermittlers (Herr | Frau | keine), für den Assistenten: „Herr Kannapinn zeigt Ihnen …“ (Ole, 17.11.2026).
  // Pflicht in der Einrichtung; „keine“ (bewusst ohne) bzw. null (nicht angegeben): Vor- und Nachname.
  anrede         String?
  firma          String?
  anschrift      String?
  telefon        String?
  /// Telefonsuche (lib/telefonsuche.ts): Ziffern ohne 0 bzw. +49 und umgekehrt, gepflegt per DB-Trigger (Migration 20261118706300)
  phoneDigits    String?
  phoneDigitsRev String?
  email          String?
  // Versicherer: Ausschließlichkeitsvertreter genau einer, Mehrfachvertreter mindestens einer
  versicherer    String[]  @default([])
  // Nur Mehrfachvertreter: "abs1" (eigene Erlaubnis) | "abs7" (gebunden, Produkte nicht in Konkurrenz)
  erlaubnis      String?
  beratung       Boolean   @default(true)
  // Beteiligungen über 10 % (Nr. 10/11); null = keine
  beteiligungen  String?
  // provision | courtage | honorar (mehrere = Verknüpfung); leer = Vorschlag nach Status
  verguetung     String[]  @default([])
  zuwendungen    Boolean   @default(false)
  // Zuständige IHK (Registrierungsstelle)
  ihk            String?
  // Angaben vom Vermittler geprüft und gespeichert (Pflicht für „vollständig“)
  bestaetigtAt   DateTime?
  // Eigener Link (alt): gilt nicht mehr als Erstinformation, § 16 VersVermV verlangt einen dauerhaften Datenträger
  url            String?
  fileName       String?
  contentType    String?
  size           Int?
  data           Bytes?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Anti-Churn (Ole, 15.11.2026): Kunde hat „Vertrag hier kündigen“ geöffnet und einen Grund angegeben.
/// outcome: offen | alternative (Pause, Budget, Module, Termin, Check, Rückruf gewählt) | gekuendigt
model ChurnIntent {
  id         String    @id @default(cuid())
  customerId String
  userId     String?
  reason     String?
  note       String?
  offer      String?
  outcome    String    @default("offen")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([outcome, createdAt])
}

/// Halteangebote beim Kündigen (Ole, 15.11.2026, lib/halteangebote.ts): angenommenes Angebot je Kunde mit Wirkung in
/// Stripe (applied = automatisch, manual = Aufgabe für uns, none = ohne Abrechnung), gerettetem Monatsbetrag und
/// späterer Kündigung trotz Angebot (Statistik in Admin → Zahlen → Kündigung & Rückkehr).
model RetentionOffer {
  id               String    @id @default(cuid())
  customerId       String
  intentId         String?
  userId           String?
  // Hauptgrund (ChurnReason) und Angebot (rabatt | neustart | neuausrichtung | produktwechsel | pause_gratis | einrichtung | nur_bestand)
  reason           String?
  kind             String
  // Zählt als Rabatt (höchstens einmal in 12 Monaten)
  discount         Boolean   @default(false)
  // applied | manual | none
  stripeStatus     String    @default("none")
  stripeCouponId   String?
  percentOff       Int?
  months           Int?
  // Mindestlaufzeit nach dem Rabatt (letzter Tag, Ende des Tags Berlin)
  commitUntil      DateTime?
  mrrBefore        Decimal?  @db.Decimal(12, 2)
  // Monatsbetrag, der nach dem Angebot weiterläuft (gerettet)
  mrrSaved         Decimal?  @db.Decimal(12, 2)
  details          Json?
  // Später trotzdem gekündigt
  cancelledLaterAt DateTime?
  createdAt        DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([intentId, kind])
  @@index([customerId, createdAt])
  @@index([kind, createdAt])
}

/// Einstellungen der Halteangebote (eine Zeile „default“): je Angebot an/aus, Prozente, Monate, Preis „Nur Bestand“.
/// Werte als JSON, Standard und Grenzen in lib/halteangebote.ts.
model RetentionOfferSettings {
  id        String   @id @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}

/// Kunde ändert seine Login-E-Mail selbst (Ole, 15.11.2026): Bestätigungslink an die neue Adresse
/// (lib/email-aendern.ts). Nur der Hash des Tokens wird gespeichert.
model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Lebenszyklus eines Kunden für Statistik und Kundenakte (Ole, 15.11.2026, lib/ruhend.ts): gekündigt, ruhend,
/// reaktiviert, gelöscht. mrr = wiederkehrender Monatsbetrag netto zum Zeitpunkt (Betreuung + Software + Zusätze).
/// Bleibt nach der endgültigen Löschung (keine Lead-Daten, nur Kunde und Beträge).
model CustomerLifecycleEvent {
  id          String   @id @default(cuid())
  customerId  String
  // cancelled | dormant | reactivated | deleted
  kind        String
  at          DateTime
  mrr         Decimal? @db.Decimal(12, 2)
  // Freitext der Kündigung (cancelReason) bzw. Grund der Löschung
  reason      String?
  // Hauptgrund aus dem Anti-Churn-Schritt (ChurnIntent.reason, lib/anti-churn.ts)
  churnReason String?
  details     Json?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, at])
  @@index([kind, at])
}

// Splittests der Lead-Reise (Ole, 19.11.2026: „konstant Splittests fahren“, lib/experimente.ts): Experiment mit
// Ziel-Kennzahl, feste Zuteilung je Einheit (Lead, sonst Chat, Termin bzw. Seitenaufruf) und Ziel-Ereignisse.
// Gewinner automatisch ab MIN je Fassung und p < 0,05 (Audit „experiment.gewinner“). Ohne Personendaten.
model Experiment {
  key       String    @id
  // Ziel-Kennzahl, z. B. termin_gebucht | komplettcheck_ja | erschienen
  ziel      String
  // false = angehalten: alle bekommen den Gewinner bzw. Fassung a
  aktiv     Boolean   @default(true)
  winner    String? // a | b
  decidedAt DateTime?
  // Kennzahlen zum Zeitpunkt der Entscheidung { a: { n, ziel }, b: …, p, z }
  stats     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ExperimentZuteilung {
  id         String   @id @default(cuid())
  experiment String
  // Lead-ID (bzw. Chat-, Termin- oder Seitenaufruf-ID), nie Name, Nummer oder Adresse
  einheit    String
  variante   String // a | b
  createdAt  DateTime @default(now())

  @@unique([experiment, einheit])
  @@index([experiment, variante])
}

model ExperimentEreignis {
  id         String   @id @default(cuid())
  experiment String
  einheit    String
  ziel       String
  createdAt  DateTime @default(now())

  @@unique([experiment, einheit, ziel])
  @@index([experiment, ziel])
}

// A/B-Test je WhatsApp-Vorlage (lib/whatsapp/ab-test.ts): zwei Fassungen (a, b), je Lead fest zugeteilt.
// Nach genug Volumen wird die bessere automatisch Standard (winner) und im Audit-Log vermerkt.
model TemplateAbTest {
  purpose   String    @id
  winner    String? // a | b
  decidedAt DateTime?
  // Kennzahlen zum Zeitpunkt der Entscheidung { a: { sent, replied }, b: …, p }
  stats     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Eigener Tarif eines Vermittlers (Terminvorbereitung, Ole 15.11.2026): für Sparten oder Gesellschaften, die der
/// Tarifkatalog nicht hat. Nur für diesen Kunden sichtbar; Ole kann ihn später in den Katalog übernehmen.
model EigenerTarif {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId       String?
  sparte       String
  gesellschaft String
  name         String
  kurz         String
  // { merkmalKey: Wert } nach dem Merkmal-Schema der Sparte
  werte        Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([customerId, sparte])
}

/// Tarifkatalog lernt aus Einträgen der Vermittler (Ole, 18.11.2026, lib/tarif-vorschlaege*.ts): Was ein Vermittler in
/// der Terminvorbereitung von Hand zu einem Katalogtarif einträgt (eigener Tarif mit Werten zu einem Katalogtarif,
/// fehlender Tarifname, „Anderer Tarif“ beim bisherigen Vertrag), wird als Vorschlag gesammelt. Nur Katalogbezug:
/// keine Lead-, Termin- oder Personendaten, keine Gesundheitsangaben. customerId = Vermittler-Konto (zählt
/// „verschiedene Vermittler“). tarifId = Katalog-ID („lvm/hausrat/komfort“) bzw. „<gesellschaft>/<sparte>/*“ für einen
/// Tarifnamen, der im Katalog fehlt (merkmal „__tarif“). Je Vermittler und Wert nur ein Eintrag.
model TarifVorschlag {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId        String?
  gesellschaft  String
  sparte        String
  /// Katalogdatei relativ zu data/tarifkatalog („lvm/hausrat.json“)
  datei         String
  tarifId       String
  merkmal       String
  /// Katalogwert beim Erfassen (NULL = im Katalog leer bzw. neuer Tarifname)
  alterWert     String?
  neuerWert     String
  /// Katalogtarif war beim Erfassen ungeprüft (Ungeprüfte zuerst in der Admin-Liste)
  ungeprueft    Boolean   @default(false)
  /// Neuer Tarifname: Merkmalwerte, die der Vermittler dazu eingetragen hat (Entwurf für den Katalog-Export)
  werte         Json?
  /// vorbereitung | bisheriger-vertrag
  quelle        String
  /// offen | uebernommen | abgelehnt
  status        String    @default("offen")
  entschiedenAm DateTime?
  createdAt     DateTime  @default(now())

  @@unique([customerId, tarifId, merkmal, neuerWert])
  @@index([status, tarifId, merkmal])
}

/// Übernommene Werte (Admin Einstellungen › Tarifkatalog): Laufzeit-Überlagerung über den Datei-Katalog
/// (lib/tarif-vorschlaege-server.ts ladeTarifkatalogAktuell). Wirkt sofort für alle Vermittler; das Merkmal gilt dann
/// als „von Vermittlern bestätigt“. Unabhängig von den Vorschlägen (bleibt, wenn ein Vermittler-Konto gelöscht wird).
/// Später per scripts/tarif-vorschlaege-export.mjs in die Katalogdateien schreiben. merkmal „__tarif“: neuer
/// Tarifname, nur für den Export (keine Laufzeitwirkung).
model TarifKatalogWert {
  id            String   @id @default(cuid())
  tarifId       String
  merkmal       String
  wert          String
  gesellschaft  String
  sparte        String
  datei         String
  /// Anzahl verschiedener Vermittler beim Übernehmen
  vermittler    Int      @default(0)
  uebernommenAm DateTime @default(now())
  uebernommenVon String?

  @@unique([tarifId, merkmal])
}

/// „Meine Merkmale“ (Terminvorbereitung, Ole 15.11.2026): zuletzt gewählte Merkmale und Bausteine je Sparte als
/// Vorauswahl für den nächsten Termin. userKey = Login-ID bzw. "" für den Inhaber ohne Login-Bezug.
model BeraterMerkmale {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userKey      String   @default("")
  sparte       String
  merkmalKeys  String[] @default([])
  bausteinKeys String[] @default([])
  updatedAt    DateTime @updatedAt

  @@unique([customerId, userKey, sparte])
}

// ─── HvK-Abrechnung (Ole, 16.11.2026) ──────────────────────────────────────
/// Wöchentliche Gutschrift von Lead-Production für Heinrich von Kleist (Mail „Neue Gutschrift“ mit PDF).
/// Je Rechnungsnummer genau einmal (idempotent). Nur im Admin-Bereich sichtbar (lib/ppl/hvk-abrechnung*.ts).
model HvkInvoice {
  id               String    @id @default(cuid())
  invoiceNo        String    @unique
  periodStart      DateTime  @db.Date
  periodEnd        DateTime  @db.Date
  invoiceDate      DateTime? @db.Date
  brokerId         String?
  // Beträge in Cent wie im PDF: gekaufte Leads negativ, Reklamationen positiv (Endsumme Netto z. B. -27000)
  netCents         Int
  vatCents         Int?
  grossCents       Int?
  boughtCount      Int
  reklamationCount Int
  // Zeilen aus dem PDF [{ kind, hvkLeadId, product, date?, plz, ort, cents }]
  lines            Json
  // Abgleich: geliefert/abgerechnet, Zuordnung der Reklamationen, Hinweise (HvkProcessResult)
  result           Json
  deliveredCount   Int       @default(0)
  stornoAuto       Int       @default(0)
  stornoReview     Int       @default(0)
  pdf              Bytes
  pdfName          String?
  // Graph-ID der Mail (Abruf), leer bei Upload
  mailMessageId    String?   @unique
  receivedAt       DateTime?
  // mail | backfill | upload
  source           String    @default("mail")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reklamationen HvkReklamation[]

  @@index([periodStart])
}

/// Reklamation aus einer HvK-Abrechnung. auto = genau ein Lead (Lieferdatum + PLZ), Storno eingetragen;
/// offen = kein oder mehrere Kandidaten → Admin → Pay-per-Lead → „Storno prüfen“; erledigt | verworfen = vom Admin entschieden.
model HvkReklamation {
  id           String     @id @default(cuid())
  invoiceId    String
  invoice      HvkInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hvkLeadId    String
  deliveryDate DateTime   @db.Date
  plz          String
  ort          String
  cents        Int
  status       String
  leadId       String?
  candidateIds String[]   @default([])
  // Weg der automatischen Zuordnung: id | datum_plz | ort | tag_versatz (null = von Hand oder offen)
  via          String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@unique([invoiceId, hvkLeadId])
  @@index([status])
}

/// Postfach eines Admin-Zwecks (Microsoft Graph bzw. Gmail), z. B. HvK-Abrechnung (nur lesen), PPL-Versand oder je Admin
/// das eigene Postfach für E-Mails aus der Kontaktakte (purpose „crm:<userId>“, Mail.Send). Eine Zeile je Zweck.
model AdminMailbox {
  id              String    @id @default(cuid())
  purpose         String    @unique
  provider        String    @default("microsoft")
  email           String
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  scope           String?
  // ok | error
  status          String    @default("ok")
  lastError       String?
  lastCheckAt     DateTime?
  connectedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Mahnwesen (Ole, 17.11.2026, lib/mahnwesen.ts) ─────────────────────
// Ein Fall je offener Stripe-Rechnung: Überweisung (send_invoice, Zahlungsziel) oder fehlgeschlagene
// Lastschrift/Karte. Stufen: 1 Erinnerung 3 Tage vor Fälligkeit (nur Überweisung), 2 Zahlungserinnerung am
// Fälligkeitstag (Mail + WhatsApp), 3 1. Mahnung (+7, PDF), 4 2. Mahnung (+14), 5 Aufgabe „Kunde anrufen“ (+21).
// status: offen | bezahlt | geschlossen (storniert, uneinbringlich, nicht mehr offen in Stripe)
model Mahnfall {
  id               String              @id @default(cuid())
  stripeInvoiceId  String              @unique
  stripeCustomerId String
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  offerId          String?
  invoiceNumber    String?
  // Rechnungsempfänger aus Stripe (Rückfall: Logins des Kunden)
  email            String?
  // offener Betrag in Cent
  amountDue        Int
  currency         String              @default("eur")
  // ueberweisung | lastschrift | karte | sonstige
  art              String
  // Fälligkeitstag (12:00 UTC des Berliner Tages); bei fehlgeschlagener Zahlung der Tag des Fehlschlags
  dueDate          DateTime
  status           String              @default("offen")
  // erreichte Stufe 0..5 (siehe oben), je Stufe höchstens einmal
  stufe            Int                 @default(0)
  letzteMailAt     DateTime?
  erinnertAt       DateTime?
  faelligAt        DateTime?
  mahnung1At       DateTime?
  mahnung2At       DateTime?
  anrufAufgabeAt   DateTime?
  anrufAufgabeId   String?
  bezahltAt        DateTime?
  // stripe | bank | manuell
  bezahltVia       String?
  hostedUrl        String?
  pdfUrl           String?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  vorschlaege      ZahlungsVorschlag[]

  @@index([status])
  @@index([customerId])
  @@index([stripeCustomerId])
}

// Bankabgleich (Enable Banking): Eingang auf dem Geschäftskonto, der zu einem offenen Mahnfall passen könnte,
// aber nicht eindeutig ist (Betrag ODER Rechnungsnummer). status: offen | bestaetigt | verworfen
model ZahlungsVorschlag {
  id                String          @id @default(cuid())
  mahnfallId        String
  mahnfall          Mahnfall        @relation(fields: [mahnfallId], references: [id], onDelete: Cascade)
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  grund             String
  status            String          @default("offen")
  entschiedenAt     DateTime?
  entschiedenVon    String?
  createdAt         DateTime        @default(now())

  @@unique([mahnfallId, bankTransactionId])
  @@index([status])
}

// Einstellungen Mahnwesen (eine Zeile „default“). Vorbereitete Schalter, Standard aus (Ole, 17.11.2026):
// Verzugspauschale (40 € nach § 288 Abs. 5 BGB) und Leads-Pause (Anzeigen pausieren) sind noch nicht eingebaut.
model MahnwesenSettings {
  id               String   @id @default("default")
  verzugspauschale Boolean  @default(false)
  leadsPause       Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// Mail-Strecke für Leads ohne WhatsApp (Ole, 18.11.2026, docs/plan-mailstrecke-dsgvo-investoren.md E0 bis E4, E7,
// lib/mail-strecke): Erstmail mit Öffnungsfrage und zwei Zeiten, Antwortseite /t/<token>, Strecke nach der Buchung.
// Token = HMAC über die ID (lib/mail-strecke/token.ts), nichts Geheimes in der Datenbank.
model LeadMailStrecke {
  id            String    @id @default(cuid())
  customerId    String
  leadId        String    @unique
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // kein_whatsapp | keine_nummer | festnetz | keine_einwilligung
  ausloeser     String
  // neu | erstmail | sms | gebucht | fertig | abgemeldet | gestoppt
  schritt       String    @default("neu")
  // Antworten auf der Seite: { oeffnung, komplettcheck, angaben, adresse, ... } (keine Gesundheitsangaben)
  antworten     Json?
  // In der letzten Mail angebotene Zeiten (ISO)
  zeiten        String[]  @default([])
  erstmailAt    DateTime?
  // Grund, wenn die Erstmail nicht raus konnte (keine_adresse, abgemeldet, …)
  erstmailGrund String?
  // Letzte Antwort auf der Seite (POST)
  antwortAt     DateTime?
  appointmentId String?
  gebuchtAt     DateTime?
  // Buchung läuft (Doppelklick-Sperre, wird nach Erfolg bzw. Fehler geleert)
  buchungAt     DateTime?
  // Takt nach Tag 1 (lib/mail-strecke/texte.ts TAKT): erledigte Schritte und wann zuletzt
  stufe         Int       @default(0)
  stufeAt       DateTime?
  // SMS über seven.io (Schalter MAIL_STRECKE_SMS): Anzahl (höchstens 2) und zuletzt
  smsZahl       Int       @default(0)
  smsAt         DateTime?
  // Nur SMS (Ole, 22.11.2026, lib/mail-strecke/nur-sms.ts): Kunde mit ausgeschalteten E-Mail-Funktionen, Lead ohne
  // WhatsApp mit Handynummer. Höchstens 2 SMS zu Geschäftszeiten, keine E-Mail; schritt dann „sms“ statt „erstmail“.
  nurSms        Boolean   @default(false)
  // Erste Reaktion (Seite im Browser geöffnet, Antwort, Buchung, Mail-Antwort, Anruf erreicht): stoppt das Nachfassen
  reaktionAt    DateTime?
  stopGrund     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId, schritt])
  @@index([schritt, erstmailAt])
}

// Betroffenenrechte (Ole, 18.11.2026, D0, lib/dsgvo): Anfragen von Leads bzw. Kunden des Vermittlers (Auskunft,
// Löschung, Widerspruch gegen Werbung …), erkannt ohne KI in Chat und Mail-Eingang. Frist ein Monat (Art. 12 Abs. 3).
// Ohne Fremdschlüssel auf Lead: Anfrage und Protokoll bleiben nach einer Löschung als Nachweis (3 Jahre).
model DsgvoAnfrage {
  id                String    @id @default(cuid())
  customerId        String
  leadId            String?
  // auskunft | loeschung | widerspruch_werbung | berichtigung | einschraenkung | uebertragbarkeit | widerruf | unklar
  art               String
  // whatsapp | email | formular
  kanal             String
  // offen | erledigt | abgelehnt
  status            String    @default("offen")
  eingangAt         DateTime
  fristBis          DateTime
  // Sofortbestätigung an den Absender (über den Eingangskanal, im Namen des Vermittlers)
  bestaetigtAt      DateTime?
  // Kurzer Auszug der Nachricht (höchstens 300 Zeichen, ohne Anhänge)
  auszug            String?
  // Quelle: Message-ID bzw. MailEingang-ID (Idempotenz je Nachricht)
  quelleId          String?   @unique
  erledigtAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  logs              DsgvoAnfrageLog[]

  @@index([customerId, status])
  @@index([leadId])
}

// Protokoll je Anfrage (Nachweis, Art. 5 Abs. 2), 3 Jahre aufbewahren (loeschenAb), ohne Inhalte.
model DsgvoAnfrageLog {
  id          String       @id @default(cuid())
  anfrageId   String
  anfrage     DsgvoAnfrage @relation(fields: [anfrageId], references: [id], onDelete: Cascade)
  customerId  String
  // eingang | bestaetigt | widerspruch_umgesetzt | erledigt | …
  aktion      String
  details     Json?
  at          DateTime     @default(now())
  loeschenAb  DateTime

  @@index([anfrageId])
  @@index([loeschenAb])
}

// Sperrliste nach Betroffenenrechten (D0): Hash von Telefon bzw. E-Mail je Vermittler. umfang „werbung“: keine
// werblichen Nachrichten (Abfolgen, Kampagnen, Nachfassen, Meta-Rückmeldung); „geloescht“: Daten gelöscht, Importe gesperrt.
model LeadSperre {
  id         String   @id @default(cuid())
  customerId String
  // email | phone
  kind       String
  hash       String
  // werbung | geloescht
  umfang     String
  anfrageId  String?
  createdAt  DateTime @default(now())

  @@unique([customerId, kind, hash, umfang])
  @@index([customerId])
}

/// Maklervollmacht digital mit Übernahme bestehender Verträge (Ole, 18.11.2026; nur Makler). Rechtstexte:
/// docs/rechtstexte/maklervollmacht-2026-11-18.md, Logik lib/maklervollmacht/*. Bestehende Verträge stehen hier (Json),
/// nicht als LeadContract (Provisionen bleiben unberührt).
model Maklervollmacht {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token        String    @unique
  // offen | unterschrieben | widerrufen | eigene (Makler hat schon eine eigene Vollmacht, die App schickt nichts)
  status       String    @default("offen")
  // sie | du (Ansprache auf der Seite und in der Mail)
  ansprache    String    @default("sie")
  // Angaben des Kunden {vorname, nachname, strasse, plz, ort, geburtsdatum, email}
  daten        Json?
  // Bestehende Verträge [{versicherer, sparte, vertragsnummer}]
  vertraege    Json?
  // Einwilligung/Schweigepflichtentbindung für Gesundheitsdaten erteilt (nur bei Kranken/Leben/BU)
  gesundheit   Boolean   @default(false)
  textVersion  String?
  // Unterschrift (PNG) und fertiges PDF, verschlüsselt (lib/encryption encryptBytes)
  signatur     Bytes?
  pdf          Bytes?
  signedAt     DateTime?
  signedIp     String?
  signedUa     String?
  sentAt       DateTime?
  widerrufenAt DateTime?
  // Kopie an den Kunden nach der Unterschrift: gesendet | fehlgeschlagen | keine_adresse (Karte und Protokoll)
  kopieStatus  String?
  kopieAt      DateTime?
  // Schreiben an die Versicherer gesendet (vom Makler abgehakt): {versichererKey: ISO-Zeitpunkt}
  uebertragung Json?
  // Per WhatsApp gesendet (Teil 2, 18.11.2026) und genau eine Erinnerung nach 2 Tagen ohne Unterschrift:
  // erinnerungStatus gesendet | gestoppt (Abmeldung, kein Weg), erinnerungAt Zeitpunkt
  waSentAt         DateTime?
  erinnerungAt     DateTime?
  erinnerungStatus String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([status, waSentAt])
  @@index([customerId])
}

// Löschprotokoll (Ole, 18.11.2026, lib/loeschprotokoll.ts): gelöschte IDs und technische Verweise, keine Inhalte.
// Datenbank-Sicherungen (Railway) lassen sich nicht einzeln bereinigen; nach einer Wiederherstellung wendet der Cron
// bzw. scripts/loeschprotokoll.mjs jede hier stehende Löschung erneut an. Kopie im privaten Policen-Bucket
// (loeschprotokoll/<id>.json), damit Löschungen nach dem Sicherungszeitpunkt nicht verloren gehen. Aufbewahrung
// 13 Monate (länger als jede Sicherung).
model Loeschprotokoll {
  id         String   @id @default(cuid())
  // lead | kunde | policen_dokument | vertriebskontakt
  art        String
  entityId   String
  customerId String?
  // Technischer Verweis ohne Inhalt, z. B. Objektname im Policen-Bucket
  ref        String?
  // Kurzer Grund ohne Inhalte, z. B. art17, widerruf, frist, vertragsende
  grund      String?
  createdAt  DateTime @default(now())

  @@unique([art, entityId])
  @@index([createdAt])
}

// Beratungsdokumentation nach dem Termin (Paket B, Ole 18.11.2026; lib/beratungsdoku-server.ts). Nur bei
// Customer.beratungsdokuAn. Je Fassung eine Zeile: abgelegt (nur PDF unter Dokumente), sendet (Versand läuft),
// gesendet (E-Mail mit PDF in Textform, Link /dokumentation/<token>), bestaetigt (Erhalt per Klick, nur POST),
// ersetzt (neuere Fassung gesendet). Das PDF liegt als LeadFile „beratungsdoku“ mit Aufbewahrungsfrist; beim Löschen
// des Leads fällt diese Zeile weg (lib/erasure.ts), das PDF bleibt bis aufbewahrenBis.
model Beratungsdoku {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  appointmentId     String?
  // {abschnitte: {wuensche, beratung, empfehlung, entscheidung, hinweise}, kopf: {kunde, produkt, berater, termin}}
  inhalt            Json
  // sie | du (Ansprache in PDF, Mail und auf der Seite)
  ansprache         String    @default("sie")
  // SHA-256 des Inhalts; je Termin und Inhalt eine Zeile (Doppelklick)
  inhaltHash        String
  status            String    @default("abgelegt")
  token             String?   @unique
  gesendetAt        DateTime?
  gesendetAn        String?
  dateiId           String?
  bestaetigtAt      DateTime?
  bestaetigtDateiId String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([appointmentId, inhaltHash])
  @@index([customerId, createdAt])
  @@index([leadId])
}

/// Messung der Beratungspräsentation (Ole, 19.11.2026, lib/praesentation-messung.ts): Folie erreicht und Zusage
/// („Ja, so machen wir es“) je Termin, Quelle (termin = Deck des Vermittlers, kundenlink = /beratung/<token>) und
/// Splittest-Variante (A | B | C, lib/praesentation-variante.ts). Kennzahl „Abschlussquote je Präsentation“ je Vermittler.
/// Keine neuen Personendaten: kein Name, keine IP, kein Gerät; je Termin, Quelle, Art und Folie höchstens ein Eintrag.
model PraesentationEreignis {
  id            String   @id @default(cuid())
  customerId    String
  appointmentId String
  quelle        String // termin | kundenlink
  art           String // folie | zusage
  folie         String   @default("")
  variante      String // A | B
  createdAt     DateTime @default(now())

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, quelle, art, folie])
  @@index([customerId, createdAt])
}

// Datenschutz und Recht im Vertrieb (Ole, 19.11.2026, lib/vertrieb/datenschutz-recht-server.ts): Nachweisprotokoll je
// Fall (Auskunft, Löschung, Widerspruch, Abmahnung aus der Kaltakquise). Nur anhängen: ein Datenbank-Trigger verbietet
// UPDATE und DELETE (Migration 20261119003100). Je Ereignis eine Zeile (eingang, antwort, loeschung); die Liste
// „Datenschutz und Recht“ fasst sie je Fall zusammen. Keine Mail-Inhalte, keine Namen oder Adressen des Kontakts: nur die
// Kontakt-ID (bzw. Hülle nach Art. 17). Kein Fremdschlüssel, damit das Protokoll das Löschen des Kontakts überdauert.
model DatenschutzFallEreignis {
  id         String   @id @default(cuid())
  /// gleiche ID für alle Ereignisse eines Falls
  fallId     String
  /// Vertriebskontakt bzw. Hülle (ohne Fremdschlüssel)
  contactId  String?
  /// eingang | antwort | loeschung
  ereignis   String
  /// auskunft | loeschung | widerspruch | abmahnung
  art        String
  /// Eingang der Anfrage (bei jedem Ereignis wiederholt)
  eingangAt  DateTime
  /// Frist (Abmahnung: Eingang = sofort)
  fristAt    DateTime
  /// Zeitpunkt des Ereignisses (Antwort gesendet, gelöscht)
  at         DateTime @default(now())
  /// „automatisch“ bzw. Admin (E-Mail-Adresse des Logins)
  wer        String
  /// bei antwort: gesendete Vorlage (widerspruch | loeschung | auskunft); bei eingang: Quelle (antwort | admin)
  detail     String?
  /// Antwortziel in Instantly (ID der eingegangenen Mail, eigenes Postfach), damit die Antwort auch nach einer Löschung
  /// im selben Thread rausgehen kann. Keine Inhalte.
  instantlyEmailId String?
  postfach   String?
  createdAt  DateTime @default(now())

  @@index([fallId])
  @@index([contactId])
  @@index([eingangAt])
}

// ─── Eigener PKV-Funnel (Ole, 20.11.2026, lib/funnel) ───────────────────────
/// Ein Besucher eines eigenen Funnels (z. B. beitrag.pkv-tarife.com). id = Besucher-ID aus dem Erstanbieter-Cookie
/// (zufällig, nie Name, Nummer oder Adresse). Personendaten liegen nur am PoolLead; hier nur Herkunft (UTM, Kampagne),
/// Verknüpfung zum Lead und Stand der Ziel-Kennzahlen (ppl_erreicht, ppl_termin, ppl_abschluss, ppl_umsatz).
model FunnelBesuch {
  id                   String    @id
  funnel               String
  // utm_source, utm_campaign, campaign_id, ad_id … (nur diese Schlüssel, keine Personendaten)
  quelle               Json?
  createdAt            DateTime  @default(now())
  // Nach dem Absenden: Lead im Pay-per-Lead-Eingang
  poolLeadId           String?   @unique
  leadAt               DateTime?
  // event_id für Pixel und Conversions API (Abgleich bei Meta)
  metaEventId          String?
  // Meta-Cookies nur mit Einwilligung (für das spätere Qualitäts-Ereignis), nach der Reifeprüfung geleert
  metaEinwilligung     Boolean   @default(false)
  metaFbc              String?
  metaFbp              String?
  // Reife (Cron, 14 Tage nach Eingang, lib/funnel/server.ts): geprüft; reif = verkauft und nicht storniert
  // (Neben-Kennzahl ppl_umsatz) mit Umsatz in Cent
  reifGeprueftAt       DateTime?
  reif                 Boolean?
  reifUmsatzCent       Int?
  // Rückmeldung des Abnehmers (Haupt-Kennzahl ppl_erreicht, Ole 20.11.2026): Lead an einen Abnehmer in der App
  // geliefert (sonst „unbekannt“), Rückmeldung vorhanden, erreicht, Termin, Abschluss. Termin und Abschluss werden
  // bis 60 Tage nach Eingang nachgeprüft.
  rueckmeldungMoeglich Boolean?
  rueckmeldung         Boolean?
  erreicht             Boolean?
  termin               Boolean?
  abschluss            Boolean?
  qualitaetGesendetAt  DateTime?

  @@index([funnel, createdAt])
  @@index([reifGeprueftAt, leadAt])
}

/// Ereignis je Besucher und Schritt (einmal je Art): angesehen | beantwortet | abbruch | abgeschickt. Ohne Antworten
/// (keine Personendaten); grund nur bei Abbruch (gesetzlich | unter_650), variante nur bei Schritten im A/B-Test.
model FunnelEreignis {
  id        String   @id @default(cuid())
  besuchId  String
  funnel    String
  schritt   String
  art       String
  variante  String?
  grund     String?
  createdAt DateTime @default(now())

  @@unique([besuchId, schritt, art])
  @@index([funnel, createdAt])
}

// Beleg aus GetMyInvoices (Ole, 22.11.2026: Buchhaltung automatisieren, möglichst lückenlos und ohne Handarbeit).
// Nächtlich abgerufen; bankTransactionId = automatisch (oder von Hand) zugeordneter Kontoumsatz. Netto/USt aus dem
// Beleg ersetzen in der BWA die Schätzung aus dem Bankbetrag.
model Beleg {
  id                String           @id @default(cuid())
  /// GetMyInvoices-Dokument (Übernahme); null bei eigenen Belegen (Mail-Eingang, Upload)
  gmiUid            Int?             @unique
  // gmi | mail | upload
  quelle            String           @default("gmi")
  /// Originaldatei (PDF/Bild), in der Datenbank, GoBD: unverändert aufbewahren
  datei             Bytes?
  mimeType          String?
  /// SHA-256 der Datei gegen doppelte Ablage
  hash              String?          @unique
  /// Absender der Mail bzw. Login beim Upload
  absender          String?
  // ki | gmi | fehler: woher Betrag, Datum usw. stammen
  ausgelesen        String?
  typ               String
  firma             String?
  nummer            String?
  datum             DateTime?        @db.Date
  netto             Decimal?         @db.Decimal(12, 2)
  ustSatz           Decimal?         @db.Decimal(5, 2)
  brutto            Decimal?         @db.Decimal(12, 2)
  waehrung          String           @default("EUR")
  dateiname         String?
  ocrFertig         Boolean          @default(false)
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation("BelegZahlung", fields: [bankTransactionId], references: [id], onDelete: SetNull)
  /// weitere Abbuchungen zu diesem Beleg (Teilzahlungen, nur von Hand)
  teilzahlungen     BankTransaction[] @relation("BelegTeilzahlungen")
  // auto | hand
  zuordnung         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([datum])
}

// Monatspaket an das Steuerbüro (Ole, 23.11.2026): Belege eines Monats als ZIP plus Liste und USt-Vorschau, gesendet
// erst auf Klick (lib/belege/monatspaket.ts).
model MonatsPaket {
  id          String    @id @default(cuid())
  monat       String    @unique // YYYY-MM
  gesendetAm  DateTime?
  empfaenger  String?
  anzahl      Int       @default(0)
  zahllast    Decimal?  @db.Decimal(12, 2)
  erinnertAm  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
