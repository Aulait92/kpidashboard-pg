// KPI Dashboard – Datenmodell
// Modelliert Leads, Kontaktversuche, Umsätze und Kosten pro Kunde.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  leads    Lead[]
  revenues Revenue[]
  costs    Cost[]
  users    User[]
}

model Lead {
  id              String    @id @default(cuid())
  airtableId      String?   @unique
  source          String?
  customerId      String
  createdAt       DateTime  @default(now())
  firstContactAt  DateTime?
  closedAt        DateTime?
  reached         Boolean   @default(false)
  contactAttempts Int       @default(0)
  status          String?
  acquisitionCost Decimal   @default(0) @db.Decimal(12, 2)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  revenues Revenue[]

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model Revenue {
  id         String   @id @default(cuid())
  customerId String
  leadId     String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([occurredAt])
}

// Kosten:
// kind = LEAD  → direkte Lead-/Akquisekosten (fließen in "Gewinn vor weiteren Kosten")
// kind = OTHER → weitere Betriebskosten (fließen in "Gewinn nach weiteren Kosten")
enum CostKind {
  LEAD
  OTHER
}

model Cost {
  id         String    @id @default(cuid())
  customerId String?
  kind       CostKind
  // Produkt-Zuordnung (z. B. "Wechsel", "Neugeschäft") für LEAD-Kosten aus Meta.
  // null für OTHER-Kosten oder LEAD-Kosten ohne erkennbares Produkt.
  product    String?
  amount     Decimal   @db.Decimal(12, 2)
  occurredAt DateTime  @default(now())
  note       String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([kind, occurredAt])
  @@index([kind, product, occurredAt])
}

// Web-Push-Subscriptions für PWA-Benachrichtigungen. Single-User-Setup:
// jede Subscription bekommt jede Benachrichtigung.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  BUYER
}

// Auth-Accounts. Admins sehen das ganze Dashboard, Buyer nur die eigene
// Customer-Sicht (customerId verknüpft, NULL für Admins).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  customerId   String?
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}
