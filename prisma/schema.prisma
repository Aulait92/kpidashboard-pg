// KPI Dashboard – Datenmodell
// Modelliert Leads, Kontaktversuche, Umsätze und Kosten pro Kunde.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Eigener Sales-Prozess von Performance Growth — separater Airtable-Base
// "Deal-Pipeline". Spiegel der Airtable-Records in der DB, damit Kanban /
// KPI / Activity-Timeline ohne Airtable-Round-Trip funktionieren.
model Deal {
  id         String    @id @default(cuid())
  airtableId String?   @unique
  name       String?
  company    String?
  email      String?
  phone      String?
  // Deal-Wert in EUR. Nullable, weil frische Leads den Wert oft noch
  // nicht hinterlegt haben.
  value      Decimal?  @db.Decimal(12, 2)
  // Aktueller Bearbeitungsstatus aus Airtable (Single-Select-Text). Wird
  // im Kanban als Spalten-Zuordnung verwendet (siehe SALES_PIPELINE_PHASES
  // in src/lib/sales.ts).
  status     String?
  // Sales-Rep / Owner (Text oder Email — flexibel, wie's aus Airtable kommt).
  owner      String?
  source     String?
  // Verkauftes Produkt / Paket. String aus Airtable-Spalte
  // (typischerweise Single-Select oder freier Text).
  product    String?
  // Erwartetes oder tatsächliches Abschluss-Datum.
  closeDate  DateTime?
  // Gesetzt sobald der Deal auf "Gewonnen" steht — für Win-Rate-Berechnung.
  wonAt      DateTime?
  // Gesetzt sobald der Deal auf "Verloren" steht.
  lostAt     DateTime?
  lostReason String?
  notes      String?
  // Frei editierbares Feld „Testcharge" (Detailansicht). Spiegelt das
  // gleichnamige Airtable-Feld; freier Text.
  testCharge String?
  // Vom Admin manuell „geschlossen" — verschwindet aus dem aktiven CRM-Kanban,
  // zählt aber weiter in die Sales-Statistiken (Win-Rate, Erreichbarkeit …).
  archived   Boolean   @default(false)
  // Voller Airtable-Record-Snapshot für die Detail-Ansicht. Erspart einen
  // zweiten Airtable-Call beim Öffnen des Modals.
  rawFields  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  activities DealActivity[]
  offers     Offer[]

  @@index([status])
  @@index([owner])
  @@index([wonAt])
  @@index([createdAt])
}

// Activity-Timeline: Notizen, Anrufe, Mails, Termine, automatische
// Status-Change-Einträge. Wohnt nur in der DB — Airtable kennt das
// Konzept (noch) nicht.
model DealActivity {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // "note" | "call" | "email" | "meeting" | "status_change"
  kind         String
  title        String
  body         String?
  // Optionaler Planungs-Zeitpunkt für zukünftige Aktivitäten
  // (Wiedervorlage, Termin, Folge-Anruf …). Wenn gesetzt, zeigt die
  // CRM-Kanban-Card die nächste anstehende Aktivität statt des letzten
  // Updates. createdAt bleibt der reine Anlage-Zeitpunkt.
  scheduledFor DateTime?
  // Abgehakt/erledigt am. Gesetzt = die Aktivität fällt aus „Heute"/„Kommende"
  // (nur noch in der Historie sichtbar).
  completedAt  DateTime?
  // Zusatzdaten je Kind (z. B. {fromStatus, toStatus} bei status_change).
  metadata     Json?
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@index([dealId, scheduledFor])
}

model Customer {
  id                  String    @id @default(cuid())
  name                String    @unique
  createdAt           DateTime  @default(now())
  // Stripe-Kunde für Abrechnung (Rechnungen, Zahlungsart, Abo)
  stripeCustomerId    String?   @unique
  // Paket: "software" = Betreuung + Software, "service" = nur Betreuung
  // (Leads per E-Mail, Kundenbereich nur mit Leads und Zahlen)
  plan                String    @default("software")
  // Kein aktueller Bezug mehr (aus Airtable) → in Listen ausgeblendet, Historie bleibt
  archived            Boolean   @default(false)
  // Jeder neue Lead zusätzlich per E-Mail an den Kunden (Kundenbereich → Konto)
  leadEmail           Boolean   @default(true)
  // Zahlungsverzug: seit wann eine Rechnung offen/fehlgeschlagen ist, Warnung verschickt
  paymentOverdueSince DateTime?
  paymentWarnedAt     DateTime?

  // ─── Media-Buyer-Daten (aus Airtable-Buyer-Tabelle) ─────────────────
  // Lead-Ziele, Preise und Startdaten je Produkt liegen seit dem Product-/
  // CustomerProduct-Refactor (Option B) NICHT mehr als hardcoded Spalten hier,
  // sondern produkt-agnostisch in CustomerProduct (eine Zeile pro Kunde ×
  // Produkt). So skalieren neue Produkte ohne Schema-Migration.
  //
  // Region des Kunden (z.B. "Berlin"). Bestimmt, in welchen regionsbasierten
  // Pool (z. B. Kinderwunsch) die Leads/Ziele dieses Kunden fallen, wenn die
  // CustomerProduct-Zeile selbst keine eigene Region trägt.
  region String?

  // ─── Retainer-Modell (aus Airtable „Kunden") ─────────────────────────
  // Gesetzt = Kunde zahlt Retainer + eigenes Werbebudget statt Lead-Preis.
  // Im Kunden-Dashboard: Lead-Kosten = Werbespend (eigenes Konto) + Retainer
  // (tagesanteilig ab retainerStart). Taucht NICHT als Agentur-Kosten auf.
  retainerMonthly Decimal?  @db.Decimal(12, 2)
  retainerStart   DateTime?
  // Eigenes Meta-Werbekonto des Kunden (nur Ziffern, ohne „act_").
  metaAdAccountId String?

  leads            Lead[]
  revenues         Revenue[]
  costs            Cost[]
  users            User[]
  customerProducts CustomerProduct[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  onboarding         Onboarding?
  feedback           CustomerFeedback[]
  pauses             CustomerPause[]
  whatsAppFees       WhatsAppFeeCharge[]
  leadSubscriptions  LeadSubscription[]
  // Modul „Bestandskunden-Kampagnen“ (Zusatzmodul; Testkunden kostenlos)
  existingCustomersEnabled Boolean @default(false)
  // Neue Oberfläche des Kundenbereichs (Vertreter-A); pro Kunde im Admin einschaltbar.
  newUi                    Boolean @default(false)
  existingCustomers  ExistingCustomer[]
  campaigns          CustomerCampaign[]
  leadSources        LeadSource[]
  salesContact       SalesContact?
  whatsAppAccount    WhatsAppAccount?
  calendarConnection CalendarConnection?
  agentConfig        AgentConfig?
  conversations      Conversation[]
  appointments       Appointment[]
  messageTemplates   MessageTemplate[]
  consentOptIns      ConsentOptIn[]
  adSpend            CustomerAdSpend[]
}

// Tagesspend aus dem EIGENEN Werbekonto eines Kunden (Retainer-Modell).
// Bewusst getrennt von Cost: das ist Geld des Kunden, keine Agentur-Kosten.
model CustomerAdSpend {
  id         String   @id @default(cuid())
  customerId String
  accountId  String
  date       DateTime // Tag, 12:00 UTC
  amount     Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, accountId, date])
  @@index([customerId, date])
}

// Produkt-Katalog. Gespiegelt aus der Airtable-"Produkte"-Tabelle —
// erlaubt beliebig viele Produkte ohne Code-Änderung. PRODUCTS in
// src/lib/products.ts liest dynamisch hieraus, sobald die UI auf den
// neuen Pfad umgestellt ist.
//
// poolKind bestimmt, wie der Media-Buyer Pools daraus baut:
//   "product"  → ein Pool je Produkt über alle Kunden
//                (Sterbegeld, Kindersparpläne, …)
//   "region"   → ein Pool je Region (Kinderwunsch)
model Product {
  id          String   @id @default(cuid())
  airtableId  String?  @unique
  name        String   @unique // canonical name, matched gegen Lead.source
  slug        String?  @unique // optional kürze form für URLs/IDs
  displayName String? // optional UI-Override (sonst = name)
  // Zusätzliche Keyword-Aliase für das Cost-Matching (kommagetrennt). Ein
  // Kampagnen-Name wird diesem Produkt zugeordnet, wenn er Name, Slug ODER
  // eines dieser Aliase als Teilstring enthält (case-insensitive, ≥3 Zeichen).
  // Gepflegt in Airtable (Produkte-Tabelle, Feld „Keywords"/„Aliase").
  keywords    String?
  poolKind    String   @default("product") // "product" | "region"
  // Sortierreihenfolge im Dashboard (asc); null = ans Ende.
  sortOrder   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerProducts CustomerProduct[]
}

// Kunden-Produkt-Bezug-Spiegel. Ein Eintrag pro (Kunde × Produkt) mit
// Ziel/Preis/Start. Löst die hardcoded leadGoalWechsel/etc.-Spalten
// auf Customer ab.
model CustomerProduct {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Lead-Ziel pro Monat. null = kein Ziel definiert.
  leadGoal         Int?
  // Preis pro Lead in EUR (Netto).
  leadPrice        Decimal?  @db.Decimal(12, 2)
  // Startdatum (Mid-Month-Onboarding-Pro-Rate).
  startDate        DateTime?
  // Test-Bezug: das volle Lead-Ziel wird über testDurationDays ausgeliefert und
  // NICHT anteilig auf den Restmonat gekürzt (Live-Bezüge schon). testMode true
  // ODER testDurationDays>0 ⇒ Testmodus.
  testMode         Boolean   @default(false)
  testDurationDays Int?
  // Region (nur für poolKind="region" relevant, z. B. Kinderwunsch-Stadt).
  region           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
}

// Ein Liefer-Pool = eine Meta-Kampagne, in die die Nachfrage mehrerer Kunden
// fließt. Zwei Arten:
//   kind = "product" → PKV, eine Kampagne pro Produkt (Wechsel/Neugeschäft),
//                       Pool-Ziel = Summe der Kunden-Ziele dieses Produkts.
//   kind = "region"  → Kinderwunsch, eine Kampagne pro Region,
//                       Pool-Ziel = Summe der KiWu-Ziele der Kunden der Region.
// Pools werden beim Lauf/Anzeigen automatisch aus den Kundendaten abgeleitet
// und hier per key upserted; gepflegt werden nur die Steuer-Einstellungen.
model DeliveryPool {
  id      String  @id @default(cuid())
  key     String  @unique // "product:Wechsel" | "product:Neugeschäft" | "region:Berlin"
  label   String
  kind    String // "product" | "region"
  // Produkt-Quelle (Lead.source) dieses Pools: "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  product String
  // Nur bei kind=region gesetzt.
  region  String?

  // Steuer-Einstellungen (admin-gepflegt):
  autopilot               Boolean  @default(false)
  maxDailyBudget          Decimal? @db.Decimal(12, 2)
  // Override für das Meta-Kampagnen-Matching. null = abgeleitet (Produkt bzw. Region).
  campaignKeyword         String?
  // Outbrain-Kampagnen-Match (analog zu campaignKeyword für Meta). null = kein
  // Outbrain-Channel in diesem Pool.
  outbrainCampaignKeyword String?
  // TikTok-Kampagnen-Match.
  tiktokCampaignKeyword   String?
  // Google-Ads-Kampagnen-Match.
  googleCampaignKeyword   String?
  // Per-Channel-Max-Budgets in EUR. maxDailyBudget gilt für Meta; ohne
  // outbrain-/tiktok-/googleMaxDailyBudget greift der Env-Default.
  outbrainMaxDailyBudget  Decimal? @db.Decimal(12, 2)
  tiktokMaxDailyBudget    Decimal? @db.Decimal(12, 2)
  googleMaxDailyBudget    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit-Log des automatischen Media Buyers. Ein Eintrag pro Pool und Lauf,
// auch wenn keine Änderung nötig war (action = "none") — so ist transparent,
// was der Bot wann gesehen und entschieden hat.
model MediaBuyerAction {
  id           String   @id @default(cuid())
  poolKey      String
  poolLabel    String
  // "increase" | "decrease" | "pause" | "activate" | "boost" | "none"
  action       String
  reason       String
  // Pacing-Kennzahlen zum Zeitpunkt der Entscheidung.
  leadsMtd     Int
  leadsGoal    Int
  projected    Int
  daysElapsed  Int
  daysTotal    Int
  // Budget in EUR (Summe über die gematchten Kampagnen). null wenn nicht
  // ermittelbar oder keine Budget-Änderung.
  prevBudget   Decimal? @db.Decimal(12, 2)
  newBudget    Decimal? @db.Decimal(12, 2)
  // Welche Meta-Kampagnen betroffen waren (Namen, kommagetrennt).
  campaigns    String?
  // true wenn der Lauf nur simuliert wurde (dryRun) und nichts an Meta ging.
  dryRun       Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([poolKey, createdAt])
  @@index([createdAt])
}

model Lead {
  id                   String    @id @default(cuid())
  airtableId           String?   @unique
  source               String?
  customerId           String
  name                 String?
  // Kontakt aus Airtable (Telefon normalisiert wie WhatsApp `from`, z. B.
  // 4915112345678) — für die Zuordnung WhatsApp-Konversation/Buchung ↔ Lead.
  phone                String?
  email                String?
  // Snapshot der produktspezifischen Formularangaben (Label/Wert-Liste aus
  // lib/lead-fields) — Kontext für den WhatsApp-Bot.
  formData             Json?
  // WhatsApp-Erstanschreiben (Outreach-Job): Zeitpunkt + Ergebnis
  // (sent | skipped_booked | skipped_contact | no_template | failed: …).
  outreachAt           DateTime?
  outreachStatus       String?
  // „Nur Betreuung“: Lead per E-Mail an den Kunden zugestellt
  emailedAt            DateTime?
  // Meta-Lead-ID (leadgen_id) bei direkt eingegangenen Leads – gegen Dubletten
  externalId           String?   @unique
  // Zuständiger Berater (Team-Kunden); leer = Inhaber/alle
  assignedUserId       String?
  assignedUser         User?     @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // Rückrufliste: „Nicht erreicht" geklickt → bis dahin ausgeblendet.
  callbackSnoozedUntil DateTime?
  // Wiedervorlage: „Ruf mich in 1 Woche an", Angebot nachfassen … erscheint
  // am Fälligkeitstag auf „Heute".
  followUpAt           DateTime?
  followUpNote         String?
  // Notizen des Beraters (bei Airtable-Leads zusätzlich dort gespiegelt)
  notes                String?
  // rec-ID des Kunden-Produkt-Bezug-Records, an dem dieser Lead in Airtable
  // hängt. Wird beim Storno gebraucht, um die zugelassenen Stornogründe
  // (Linked-Records vom Bezug zur Stornogründe-Tabelle) nachzuschlagen.
  bezugAirtableId      String?
  createdAt            DateTime  @default(now())
  firstContactAt       DateTime?
  closedAt             DateTime?
  reached              Boolean   @default(false)
  contactAttempts      Int       @default(0)
  status               String?
  // Letzte Statusänderung (DB-Trigger, greift für App, Bot und Sync) – „seit X Tagen in der Phase“
  statusChangedAt      DateTime  @default(now())
  // Werbekanal, der den Lead generiert hat (aus Airtable-Spalte „Source").
  // Werte: "Meta" | "Outbrain" | null (= unbekannt). Wird in Channel-KPIs
  // und im Media-Buyer-Steuerlauf verwendet, um CPL pro Kanal zu berechnen.
  adChannel            String?
  acquisitionCost      Decimal   @default(0) @db.Decimal(12, 2)
  // Abschlusswert in EUR — vom Buyer beim Drop auf "Abschluss" in der
  // Pipeline-Ansicht eingegeben (oder im Lead-Detail editierbar). Wird
  // optional nach Airtable in eine Abschlusswert-Spalte gespiegelt; getrennt
  // von Revenue.amount (das ist der Lead-Einkaufspreis).
  closeValue           Decimal?  @db.Decimal(12, 2)
  // ─── Pay-per-Lead (eigene Funnels, an Käufer verkauft) ─────────────────
  subscriptionId       String?
  subscription         LeadSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId              String?
  order                LeadOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deliveredAt          DateTime?
  // Storno beim Pay-per-Lead: requested → approved | rejected | review (Prüfung durch Admin)
  stornoState          String?
  stornoReason         String?
  stornoNote           String?
  stornoRequestedAt    DateTime?
  stornoDecidedAt      DateTime?
  // Gutschrift für genehmigten Storno (EUR) und wann sie auf eine Rechnung kam
  creditAmount         Decimal?          @db.Decimal(10, 2)
  creditedAt           DateTime?
  // DSGVO-Löschung (Art. 17): personenbezogene Felder geleert, Zeile bleibt
  // für Abrechnung und Statistik. Der Airtable-Sync überschreibt sie nicht mehr.
  erasedAt             DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  revenues Revenue[]

  // ─── WhatsApp-CRM (Phase 0) ─────────────────────────────────────────
  conversations Conversation[]
  appointments  Appointment[]
  sequences     LeadSequence[]

  @@index([customerId, createdAt])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([customerId, phone])
  @@index([subscriptionId, deliveredAt])
  @@index([stornoState])
}

model Revenue {
  id         String   @id @default(cuid())
  customerId String
  leadId     String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  // Storno-Flag: true wenn der Lead in Airtable den Status „Storniert" hat.
  // Stornierte Revenues bleiben mit Betrag erhalten (für die Storno-Kachel),
  // werden aber aus allen Umsatz-/Marge-Aggregationen ausgefiltert.
  cancelled  Boolean  @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([occurredAt])
}

// Kosten:
// kind = LEAD  → direkte Lead-/Akquisekosten (fließen in "Gewinn vor weiteren Kosten")
// kind = OTHER → weitere Betriebskosten (fließen in "Gewinn nach weiteren Kosten")
enum CostKind {
  LEAD
  OTHER
}

model Cost {
  id         String   @id @default(cuid())
  customerId String?
  kind       CostKind
  // Produkt-Zuordnung (z. B. "Wechsel", "Neugeschäft") für LEAD-Kosten aus Meta.
  // null für OTHER-Kosten oder LEAD-Kosten ohne erkennbares Produkt.
  product    String?
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  note       String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([kind, occurredAt])
  @@index([kind, product, occurredAt])
}

// Kampagnen, deren Spend KEINEM Produkt zugeordnet werden konnte (kein
// passendes Keyword/Slug/Alias). Wird beim Channel-Sync pro Channel komplett
// neu geschrieben (Aggregat über den Sync-Zeitraum, eine Zeile je Kampagne).
// Dient der Transparenz im Admin: zeigt, welcher Ad-Spend NICHT in die
// Berechnung einfließt — und damit, wo ein Keyword fehlt.
model UnmatchedCampaign {
  id       String   @id @default(cuid())
  // "Meta" | "Outbrain" | "TikTok" | "Google"
  channel  String
  campaign String
  spend    Decimal  @db.Decimal(12, 2)
  syncedAt DateTime @default(now())

  @@index([channel])
}

// Web-Push-Subscriptions für PWA-Benachrichtigungen. userId = null nur für
// Legacy-Subscriptions vor der Auth (werden behandelt als Admin).
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  ADMIN
  BUYER
}

// Auth-Accounts. Admins sehen das ganze Dashboard, Buyer nur die eigene
// Customer-Sicht (customerId verknüpft, NULL für Admins).
model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String
  role               UserRole
  customerId         String?
  createdAt          DateTime         @default(now())
  lastLoginAt        DateTime?
  // Zwei-Faktor-Login (TOTP), vor allem für Admins: Schlüssel verschlüsselt,
  // aktiv ab totpEnabledAt; Notfall-Codes nur als SHA-256-Hash.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  totpBackupCodes    String[]         @default([])
  // Team (Großkunden): owner = Inhaber (sieht alles), advisor = Berater (nur eigene Leads)
  teamRole           String           @default("owner")
  displayName        String?
  // Bekommt bei der Verteilung neue Leads
  receivesLeads      Boolean          @default(true)
  lastLeadAssignedAt DateTime?
  // Admins: neue Oberfläche (Admin-A) testen; Standard aus
  adminNewUi         Boolean          @default(false)
  assignedLeads      Lead[]           @relation("LeadAssignee")
  advisorCalendar    AdvisorCalendar?

  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resetTokens    PasswordResetToken[]
  dealActivities DealActivity[]

  // Konversationen, in denen dieser Agent das Gespräch übernommen hat.
  assignedConversations Conversation[]

  @@index([customerId])
}

// Einmalige Tokens für Passwort-Reset. Nur der SHA-256-Hash wird gespeichert
// — der eigentliche Token landet nur als URL-Parameter in der Reset-Email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Monatsziele für das Admin-Cockpit. Ein Eintrag pro Monat
// (monthKey = "YYYY-MM"). Alle Goal-Felder sind optional — wenn null,
// wird das Ziel im UI als "nicht gesetzt" angezeigt.
model MonthlyGoal {
  id             String   @id @default(cuid())
  monthKey       String // "YYYY-MM"
  // Produkt-Dimension: "" = Gesamt, sonst "Wechsel" | "Neugeschäft" | "Kinderwunsch".
  // Lead-Ziele kommen je Produkt aus Airtable (nicht hier); gespeichert werden
  // hier Abschluss-/Umsatz-/Marge-Ziele. Gesamt-Werte (Leads/Abschlüsse/Umsatz)
  // sind die Summe der Produkte; nur die Gesamt-Marge wird eigenständig gesetzt.
  product        String   @default("")
  leadsGoal      Int?
  // Abschlussquote-Ziel (Abschlüsse / Leads), 0..1. Qualitätskennzahl wie die
  // Marge — wird je Produkt und gesamt eigenständig gesetzt (nicht summiert).
  closedRateGoal Decimal? @db.Decimal(5, 4)
  revenueGoal    Decimal? @db.Decimal(12, 2)
  marginGoal     Decimal? @db.Decimal(5, 4) // 0..1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthKey, product])
}

// Eine Anfrage des Admins per Telegram, neue Meta-Ad-Creatives zu generieren.
// Bündelt mehrere Varianten (Headline + Body + Bild + CTA), die separat
// genehmigt werden können.
model CreativeRequest {
  id             String   @id @default(cuid())
  telegramChatId String // Telegram-Chat-ID des Anfragenden (kann negativ sein bei Gruppen)
  rawPrompt      String // Originaler Telegram-Text
  parsedIntent   Json // {count, campaign, tone, audience, …} von Claude
  status         String   @default("generating") // generating | partial | completed | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants CreativeVariant[]

  @@index([telegramChatId, createdAt])
}

// Eine konkrete Creative-Variante. Hat eigenen Approval-Status, weil der
// Admin pro Variante "Genehmigen" / "Ablehnen" / "Neu generieren" entscheidet.
model CreativeVariant {
  id             String    @id @default(cuid())
  requestId      String
  index          Int // 1..N innerhalb der Anfrage
  headline       String
  body           String
  cta            String // z.B. "Termin in 30 Sek"
  adText         String    @default("") // Facebook Primary-Text (über dem Bild), kann long-form sein
  fbHeadline     String    @default("") // Facebook Headline unter dem Bild (max ~40 Zeichen, unabhängig vom visuellen Hero)
  mechanic       String    @default("") // Konzept-Mechanic (z.B. UGC-Whiteboard, Comic-Illustration, Big-Number)
  imagePrompt    String // bei HTML-Pipeline: das volle HTML (Debug/Replay)
  imageUrl       String // public R2-URL
  // Video-Felder: gesetzt wenn kind="video". imageUrl kann dann ein
  // Standbild/Thumbnail enthalten (z. B. ersten Frame), videoUrl ist die R2-MP4.
  kind           String    @default("image") // "image" | "video"
  videoUrl       String?
  durationSec    Int?
  // Meta-Side: gesetzt wenn approved + zur Kampagne gepusht.
  metaCampaignId String?
  metaAdId       String?
  metaImageHash  String?
  status         String    @default("pending") // pending | approved | rejected | live | failed
  telegramMsgId  String? // Message-ID der Telegram-Nachricht mit dieser Variante
  errorMessage   String?
  createdAt      DateTime  @default(now())
  approvedAt     DateTime?

  request CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([telegramMsgId])
}

// ═══════════════════════════════════════════════════════════════════════
// WhatsApp-CRM (Phase 0) — eigene WhatsApp-Anbindung + KI-Vorqualifizierung
// + Terminierung, als Superchat-Ablösung. Multi-Tenant: alles hängt an
// Customer (customerId) und ist strikt pro Kunde isoliert. Token-/Key-Felder
// mit Suffix „Enc" werden VOR dem Persistieren app-seitig verschlüsselt
// (Envelope-Encryption/KMS) — nie Klartext in die DB. Siehe Projektplan
// „Sicherheit & DSGVO (Exit-Readiness)".
// ═══════════════════════════════════════════════════════════════════════

// WhatsApp-Business-Konto je Kunde (über 360dialog in der Überbrückungsphase).
model WhatsAppAccount {
  id            String   @id @default(cuid())
  customerId    String   @unique
  provider      String   @default("360dialog") // 360dialog | meta_cloud (später)
  wabaId        String?
  phoneNumberId String?
  phoneNumber   String?
  displayName   String?
  apiKeyEnc     String? // app-seitig verschlüsselter 360dialog-API-Key
  status        String   @default("pending") // pending | connected | disabled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([phoneNumberId])
}

// Google-Kalender-Anbindung je Kunde für die Terminbuchung (Telefon/Video).
// Kalender-Anbindung je Kunde: Google oder Microsoft (Outlook/Exchange).
// Tabellenname bleibt aus Kompatibilität „GoogleCalendarConnection".
model CalendarConnection {
  id              String    @id @default(cuid())
  customerId      String    @unique
  provider        String    @default("google") // google | microsoft
  accountEmail    String? // verbundenes Kalender-Konto (Anzeige)
  calendarId      String    @default("primary")
  accessTokenEnc  String? // app-seitig verschlüsselt
  refreshTokenEnc String? // app-seitig verschlüsselt
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending") // pending | connected | error
  // Öffentlicher, nicht erratbarer Slug für die Buchungsseite /book/<slug>
  // (z. B. als Custom-Scheduling-Link im Meta-Leadformular).
  bookingSlug     String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("GoogleCalendarConnection")
}

// Konfigurierbarer KI-Agent je Kunde (Aufgabe/Regeln, Wissen, Persönlichkeit).
model AgentConfig {
  id                    String   @id @default(cuid())
  customerId            String   @unique
  name                  String   @default("Assistent")
  systemPrompt          String   @default("")
  knowledge             String   @default("")
  personality           String   @default("")
  active                Boolean  @default(false)
  // Automatisches WhatsApp-Erstanschreiben neuer Leads ohne Termin. Erst
  // aktivieren, wenn Einwilligung im Leadformular + freigegebene Vorlage da sind.
  outreachEnabled       Boolean  @default(false)
  // 0 = sofort beim Eingang (Speed to Lead). Höher nur, wenn der Lead erst selbst buchen soll.
  outreachDelayMin      Int      @default(0)
  // Automatisch nachfassen: feste Abfolgen nach „Nicht erreicht“, „Angebot gesendet“,
  // „Nicht erschienen“ (lib/lead-sequences.ts). Standard aus.
  followUpSequencesEnabled Boolean @default(false)
  // Fester Video-Link für alle Video-Termine (z. B. persönlicher Webex-Raum).
  // Leer = Google Meet bzw. Microsoft Teams wird pro Termin erzeugt.
  videoRoomUrl          String?
  // Berater-Adresse (z. B. Allianz-Mail): bekommt jeden gebuchten Termin als
  // Kalendereinladung → landet direkt in seinem Firmenkalender (Outlook).
  advisorEmail          String?
  // Veröffentlichter Frei/Gebucht-Kalender (ICS-Link, verschlüsselt): belegte
  // Zeiten des Firmenkalenders fließen in die Terminvorschläge ein.
  availabilityIcsUrlEnc String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Ein Chat-Faden pro (Kunde × Kontakt-Telefonnummer). Hält den 24h-Fenster-
// Status und ob der KI-Bot aktiv ist oder ein Mensch übernommen hat.
model Conversation {
  id                   String    @id @default(cuid())
  customerId           String
  whatsAppAccountId    String?
  leadId               String?
  contactPhone         String
  contactName          String?
  contactEmail         String? // vom Lead im Chat genannt (für Kalender-Einladung)
  botActive            Boolean   @default(true)
  assignedUserId       String?
  // Vom KI-Bot gepflegte Qualifizierung (strukturiert, nicht nur als Notiz).
  qualified            Boolean   @default(false)
  qualificationSummary String?
  status               String    @default("open") // open | snoozed | done
  // „Braucht dich": Assistent hat übergeben (Frage, die er nicht klären kann,
  // Lead will den Berater sprechen) oder Lead schreibt in einem übernommenen
  // Chat. Wird beim Antworten des Beraters bzw. „Erledigt" zurückgesetzt.
  needsAttention       Boolean   @default(false)
  attentionReason      String?
  attentionAt          DateTime?
  windowExpiresAt      DateTime? // Ende des 24h-Service-Fensters
  lastMessageAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsAppAccount WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser    User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([customerId, contactPhone])
  @@index([customerId, status, lastMessageAt])
}

// Einzelne Nachricht in einer Konversation (ein- oder ausgehend).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String // inbound | outbound
  kind           String   @default("text") // text | template | image | audio | document
  body           String?
  waMessageId    String?  @unique // WhatsApp-Message-ID (Idempotenz)
  status         String? // sent | delivered | read | failed (nur outbound)
  sentBy         String? // bot | agent | system (null = inbound)
  sentByUserId   String?
  // Meta-Preis je Nachricht (aus dem Status-Webhook „pricing“): Kategorie
  // marketing | utility | authentication | service und ob sie berechnet wird.
  // Beim Senden einer Vorlage vorbelegt mit der Vorlagen-Kategorie.
  pricingCategory String?
  billable        Boolean?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([billable, createdAt])
}

// Gebuchter Termin aus dem Bot-Flow (Telefon oder Videocall).
model Appointment {
  id              String    @id @default(cuid())
  customerId      String
  leadId          String?
  conversationId  String?
  mode            String // phone | video
  startsAt        DateTime
  endsAt          DateTime?
  calendarEventId String?
  meetUrl         String?
  status          String    @default("booked") // booked | cancelled | completed | no_show
  reminderSentAt  DateTime? // gesetzt, sobald die WhatsApp-Erinnerung raus ist
  // Getrennte Einladung für den Berater (interne Infos), gleicher Termin.
  // calendarEventId = Einladung des Leads (kundenfreundlich, ohne Interna).
  advisorEventId  String?
  // In welchem Kalender der Termin liegt: Kunden-ID oder „user:<id>“ (Berater)
  calendarKey     String?
  // Geheimer Link für den Lead: /book/manage/<token> (absagen/verschieben).
  manageToken     String?   @unique
  cancelledAt     DateTime?
  // lead | advisor | team (Admin/Kunde im CRM) | system
  cancelledBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, startsAt])
}

// WhatsApp-Vorlage je Kunde (für Erstansprache / außerhalb des 24h-Fensters).
model MessageTemplate {
  id         String   @id @default(cuid())
  customerId String
  name       String
  language   String   @default("de")
  // Wofür die Vorlage genutzt wird: outreach | booking_confirmation | reminder.
  // Parameter-Reihenfolge je Zweck siehe lib/whatsapp/templates.ts.
  purpose    String   @default("")
  category   String // utility | marketing | authentication
  status     String   @default("pending") // pending | approved | rejected
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name, language])
}

// Dokumentierte WhatsApp-/DSGVO-Einwilligung je (Kunde × Kontakt).
model ConsentOptIn {
  id           String    @id @default(cuid())
  customerId   String
  contactPhone String
  grantedAt    DateTime
  source       String? // funnel | import | manual
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, contactPhone])
}

// Nutzungsmessung im Kunden-CRM (pseudonym, ohne Lead-Inhalte): Seitenaufrufe,
// Aktionen, Fehler, Feedback. Grundlage für UX-Verbesserungen. Löschung nach
// 180 Tagen (Cron).
model UsageEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  customerId String
  userId     String?
  /// true = Admin in „Als Kunde ansehen" (nicht mitzählen)
  preview    Boolean  @default(false)
  type       String // page | action | error | feedback
  name       String // z. B. „/buyer/leads", „callback.not_reached", „toast.error"
  path       String?
  meta       Json?

  @@index([customerId, at])
  @@index([type, at])
}

// Angebot / Auftragsbestätigung aus dem Cold-CRM. Konditionen werden beim
// Erstellen eingefroren (Snapshot), damit ein angenommenes Angebot sich nie
// nachträglich ändert. Änderungen = neue Version (altes wird „superseded").
model Offer {
  id                      String        @id @default(cuid())
  // Altes Airtable-Deal-Board (wird abgelöst) oder Vertriebskontakt.
  dealId                  String?
  deal                    Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  salesContactId          String?
  salesContact            SalesContact? @relation(fields: [salesContactId], references: [id], onDelete: Cascade)
  // Fortlaufende Nummer, z. B. PG-2026-0007
  number                  String        @unique
  version                 Int           @default(1)
  // draft | sent | accepted | declined | superseded
  status                  String        @default("draft")
  // Geheimer Link für die öffentliche Angebotsseite
  token                   String        @unique
  // Empfänger
  contactName             String
  company                 String?
  email                   String?
  street                  String?
  zip                     String?
  city                    String?
  // Konditionen (netto, EUR)
  // "software" = Betreuung + Software, "service" = nur Betreuung (ohne Software)
  package                 String        @default("software")
  term                    String // "none" | "12m"
  products                Json // [{ name, dailyBudget }]
  setupFee                Decimal       @db.Decimal(10, 2)
  monthlyFee              Decimal       @db.Decimal(10, 2)
  softwareFee             Decimal       @db.Decimal(10, 2)
  introMonthlyFee         Decimal?      @db.Decimal(10, 2)
  introMonths             Int?
  specialTerms            String?
  startDate               DateTime?
  validUntil              DateTime
  // Annahme (Protokoll)
  sentAt                  DateTime?
  viewedAt                DateTime?
  acceptedAt              DateTime?
  acceptedName            String?
  acceptedIp              String?
  acceptedAgent           String?
  termsUrl                String?
  dpaUrl                  String?
  // Zahlung (Stripe)
  stripeCustomerId        String?
  stripeCheckoutSessionId String?
  stripeSubscriptionId    String?       @unique
  // Abo-Zeitplan: Monatsgebühr startet erst am Startdatum (Setup sofort)
  stripeScheduleId        String?       @unique
  // none | pending | processing | paid | failed
  paymentStatus           String        @default("none")
  // Status des Stripe-Abos (active, past_due, canceled …)
  subscriptionStatus      String?
  paidAt                  DateTime?
  createdById             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([salesContactId])
  @@index([dealId])
  @@index([status])
}

// Verarbeitete Stripe-Webhook-Ereignisse (Idempotenz: jedes Ereignis nur einmal).
model StripeEvent {
  id         String   @id // evt_…
  type       String
  receivedAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════
// Vertrieb (ehemals „Cold CRM“): Akquise von Versicherungsagenturen –
// Kontakte, Aufgaben, Aktivitäten, Cold-Mail (Instantly), Termine (Calendly),
// Inbound-Leads. Übernommen aus dem separaten Cold-CRM (Nov. 2026).
// ════════════════════════════════════════════════════════════════════════

enum SalesStage {
  NEU
  NICHT_ERREICHT
  WIEDERVORLAGE
  INTERESSE
  TERMIN
  GEWONNEN
  SPAETER
  VERLOREN
  UNGUELTIG
}

// Kunden-Pipeline: alles nach der Zusage
enum SalesCustomerStage {
  VERTRAG // Zusage, Vertrag versendet
  ONBOARDING // unterschrieben, Setup (Produkte, Gebiet, Kampagnen)
  TEST // Testpaket / erste Leads
  AKTIV // laufender Kunde
  PAUSIERT
  GEKUENDIGT
}

enum SalesLossReason {
  KEIN_BEDARF // ausgelastet, braucht keine Kunden
  HAT_ANBIETER // kauft schon Leads / arbeitet mit Agentur
  UEBER_ALLIANZ // macht das über die Allianz
  ZU_TEUER // Budget / Preis
  KEIN_INTERESSE
  SONSTIGES
}

enum SalesActivityType {
  ANRUF
  EMAIL
  NOTIZ
  STATUS
  COLD_MAIL
  LINKEDIN
  TERMIN
  IMPORT
}

enum SalesTaskType {
  ANRUF
  NACHFASSEN
  UNTERLAGEN
  TERMIN
  SONSTIGES
}

model SalesContact {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  fax          String?
  street       String?
  zip          String?
  city         String?
  ratingValue  Float?
  ratingCount  Int?
  openingHours String?
  url          String?
  description  String?

  // Ansprechpartner & Zusatzinfos (aus der Instantly-Mailingliste)
  salutation     String?
  firstName      String?
  lastName       String?
  leaderNames    String? // alle Inhaber/Geschäftsführer, kommagetrennt
  agencyType     String? // GENERAL / HAUPT
  teamSize       Int?
  potentialScore Int?
  facebookUrl    String?
  instagramUrl   String?
  xingUrl        String?
  linkedinUrl    String?

  // LinkedIn-Outreach (Waalaxy)
  linkedinStatus      String? // ANFRAGE_GESENDET, VERNETZT, NACHRICHT_GESENDET, GEANTWORTET
  linkedinRequestAt   DateTime?
  linkedinConnectedAt DateTime?
  linkedinMessageAt   DateTime?
  linkedinReplyAt     DateTime?
  linkedinList        String? // Waalaxy-Liste / Kampagne
  linkedinTags        String?

  stage         SalesStage       @default(NEU)
  lossReason    SalesLossReason?
  competitor    String? // z.B. LEAD.NOW, Terminadler, Alkaio
  callAttempts  Int              @default(0)
  lastContactAt DateTime?
  legacyStatus  String? // Original-Status aus der Cold-Calling-Liste

  // Kunde (gesetzt ab Stufe Gewonnen)
  customerStage      SalesCustomerStage?
  products           String? // z.B. "PKV, TKV, Leben"
  monthlyValue       Int? // € pro Monat
  contractStart      DateTime?
  customerSince      DateTime?
  customerSource     String? // Akquise-Kanal: COLD_CALL, COLD_MAIL, LINKEDIN, META_ADS, EMPFEHLUNG, INBOUND, NETZWERK, SONSTIGES
  customerSourceNote String? // z.B. "Kampagne Allianz Okt" oder "Empfehlung von Hr. Müller"
  // Kundenkonto in der Plattform (ab Onboarding)
  customerId         String?             @unique
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers         Offer[]
  activities     SalesActivity[]
  tasks          SalesTask[]
  campaigns      SalesCampaignLead[]
  emails         SalesEmail[]
  linkedinEvents SalesLinkedInEvent[]
  meetings       SalesMeeting[]
  inboundLeads   SalesInboundLead[]

  @@index([stage])
  @@index([customerStage])
  @@index([linkedinStatus])
  @@index([zip])
  @@index([city])
}

model SalesActivity {
  id         String            @id @default(cuid())
  contactId  String
  contact    SalesContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       SalesActivityType
  outcome    String?
  note       String?
  occurredAt DateTime          @default(now())

  @@index([contactId, occurredAt])
}

model SalesTask {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  type      SalesTaskType @default(SONSTIGES)
  note      String?
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([doneAt, dueAt])
  @@index([contactId])
}

model SalesCampaign {
  id          String              @id @default(cuid())
  instantlyId String?             @unique
  name        String              @unique
  createdAt   DateTime            @default(now())
  leads       SalesCampaignLead[]
}

// Ein Kontakt in einer Instantly-Kampagne.
model SalesCampaignLead {
  id           String        @id @default(cuid())
  contactId    String
  contact      SalesContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       String? // Aktiv, Pausiert, Abgeschlossen, Bounced, Abgemeldet, Übersprungen, Noch nicht kontaktiert
  sentAt       DateTime? // erste/letzte bekannte Mail
  openCount    Int           @default(0)
  replyCount   Int           @default(0)
  clickCount   Int           @default(0)
  lastOpenAt   DateTime?
  lastReplyAt  DateTime?
  bounced      Boolean       @default(false)
  unsubscribed Boolean       @default(false)
  interest     String? // Instantly-Interessenstatus
  updatedAt    DateTime      @updatedAt

  @@unique([contactId, campaignId])
  @@index([campaignId])
}

// E-Mails aus Instantly (v.a. Antworten auf Cold Mails)
model SalesEmail {
  id          String       @id @default(cuid())
  instantlyId String?      @unique
  contactId   String
  contact     SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign    String?
  direction   String       @default("IN") // IN = Antwort vom Kontakt, OUT = von uns
  subject     String?
  text        String?
  html        String?
  fromEmail   String?
  threadId    String?
  isAutoReply Boolean      @default(false)
  sentiment   String? // POSITIV, NEGATIV, NEUTRAL
  sentAt      DateTime
  createdAt   DateTime     @default(now())

  @@index([contactId, sentAt])
}

// Rohdaten aus Waalaxy (Webhook), auch nicht zugeordnete – zum Nachvollziehen
model SalesLinkedInEvent {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // webhook | csv
  name      String?
  company   String?
  url       String?
  status    String?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// Termine aus Calendly (gebucht über Calendly → Google Calendar)
model SalesMeeting {
  id            String       @id @default(cuid())
  contactId     String
  contact       SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calendlyUri   String?      @unique // Invitee-URI
  eventUri      String?
  title         String
  startAt       DateTime
  endAt         DateTime?
  location      String?
  joinUrl       String?
  status        String       @default("GEPLANT") // GEPLANT, ABGESAGT, VERSCHOBEN
  cancelReason  String?
  canceledBy    String?
  rescheduleUrl String?
  cancelUrl     String?
  answers       String? // Fragen & Antworten aus dem Buchungsformular
  utmSource     String?
  inviteeName   String?
  inviteeEmail  String?
  taskId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contactId])
  @@index([startAt])
}

// Eingehende Leads (Meta Lead Ads über Zapier/Make, Landingpage-Formulare …)
model SalesInboundLead {
  id        String        @id @default(cuid())
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String // META_ADS, INBOUND, …
  name      String?
  email     String?
  phone     String?
  campaign  String?
  ad        String?
  form      String?
  answers   String?
  created   Boolean       @default(false) // neuer Kontakt angelegt?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([contactId])
}

// ─── Onboarding (ab Vertragsannahme) ───────────────────────────────────
// Ein Datensatz je Kunde. Die Checkliste ergibt sich aus diesen Zeitstempeln
// plus Kalender-/WhatsApp-Verbindung und erstem Login des Kunden.
model Onboarding {
  id               String    @id @default(cuid())
  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId          String?   @unique
  salesContactId   String?
  // "software" | "service"
  package          String    @default("software")
  // running | live | cancelled
  status           String    @default("running")
  startDate        DateTime?
  welcomeSentAt    DateTime?
  // Kickoff-Termin (über das eigene Buchungstool)
  kickoffAt        DateTime?
  // Fragebogen im Kundenbereich
  questionnaire    Json?
  questionnaireAt  DateTime?
  // Partnerzugriff auf Meta-Werbekonto und Seite erteilt
  metaAccessAt     DateTime?
  // Pflichtangaben (Impressum) von der Agentur-Website
  websiteInfo      Json?
  websiteCheckedAt DateTime?
  campaignReadyAt  DateTime?
  testLeadAt       DateTime?
  liveAt           DateTime?
  lastReminderAt   DateTime?
  // Push an Admin, wenn der Kunde lange nichts erledigt
  staleNotifiedAt  DateTime?
  // Aufgabe „Jahresvertrag anbieten“ (Tag 90) angelegt
  upsellTaskAt     DateTime?
  // 15-Minuten-Hilfetermin (Google-Kalender des Teams)
  helpCallAt       DateTime?
  helpCallEventId  String?
  helpCallUrl      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

// Kurzes Kunden-Feedback per Mail (Tag 7: Start, Tag 30: Monatsbericht).
// Antwort per Klick ohne Login über den geheimen Token.
model CustomerFeedback {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // day7 | day30
  kind       String
  token      String    @unique
  // 1–5 (Smileys)
  score      Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?

  @@unique([customerId, kind])
}

// Pause / Urlaub eines Kunden: Anzeigen stoppen, Abrechnung auf die
// Software-Gebühr reduzieren (bei „Nur Betreuung“ 0 €), danach automatisch
// wieder starten. Geplant vom Kunden selbst oder vom Admin.
model CustomerPause {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  // leer = bis auf Widerruf
  endsAt            DateTime?
  // planned | active | ended | cancelled
  status            String    @default("planned")
  reason            String?
  // customer | admin
  createdBy         String    @default("customer")
  // customer = Pause/Urlaub (mit Abrechnung), dunning = Zahlungsverzug (nur Anzeigen)
  kind              String    @default("customer")
  // Von uns pausierte Meta-Kampagnen (werden beim Fortsetzen reaktiviert)
  pausedCampaignIds Json?
  adsNote           String?
  billingNote       String?
  appliedAt         DateTime?
  resumedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
  @@index([status, startsAt])
}

// Direkter Lead-Eingang (Meta-Webhook oder Zapier-Webhook): welches
// Meta-Leadformular gehört zu welchem Kunden und Produkt.
model LeadSource {
  id              String    @id @default(cuid())
  formId          String    @unique
  pageId          String?
  formName        String?
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt-Key wie Lead.source (z. B. „Privatschutz“, „Wechsel“)
  productKey      String
  // Pay-per-Lead: Preis je Lead (netto) → Umsatz in der App; sonst leer
  leadPrice       Decimal?  @db.Decimal(12, 2)
  // Optional: Airtable-Bezug für die erlaubten Stornogründe
  bezugAirtableId String?
  // Fragen des Formulars (key → Beschriftung) für lesbare Formularangaben
  questionLabels  Json?
  active          Boolean   @default(true)
  lastLeadAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// Leads aus Formularen ohne Zuordnung: warten hier, bis das Formular einem
// Kunden zugeordnet wird – nichts geht verloren.
model UnassignedLead {
  id         String    @id @default(cuid())
  externalId String?   @unique
  formId     String?
  pageId     String?
  via        String // meta | zapier
  payload    Json
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([formId, resolvedAt])
}

// Eigener Kalender eines Beraters (Team-Kunden). Kunden-Kalender des Inhabers
// bleibt CalendarConnection; die Kalender-Funktionen unterscheiden über den
// Schlüssel „user:<userId>“.
model AdvisorCalendar {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  provider        String    @default("google")
  accountEmail    String?
  calendarId      String    @default("primary")
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scope           String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// Lebenszeichen der Hintergrund-Jobs (Cron, Sync) für die Überwachung (/api/status).
model SystemHeartbeat {
  key  String   @id // "cron" | "sync"
  at   DateTime
  ok   Boolean  @default(true)
  note String?
}

// Änderungsprotokoll: wer hat wann was Wichtiges geändert (Logins, Zugänge,
// Team, Pausen, Angebote, Exporte, Einstellungen). Aufbewahrung 1 Jahr.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  actorRole  String? // ADMIN | BUYER | system | lead
  action     String // z. B. "login", "team.invite", "pause.plan"
  entity     String? // z. B. "User", "Lead", "Customer"
  entityId   String?
  customerId String?
  details    Json?

  @@index([at])
  @@index([customerId, at])
  @@index([action, at])
}

// WhatsApp-Gebühren von Meta, monatlich an den Kunden weiterberechnet
// (AGB: nach tatsächlichem Verbrauch). Ein Eintrag je Kunde und Monat.
model WhatsAppFeeCharge {
  id                  String   @id @default(cuid())
  customerId          String
  month               String // "2026-11"
  // { marketing: 12, utility: 3, authentication: 0 }
  counts              Json
  amount              Decimal  @db.Decimal(10, 2)
  // Stripe-Rechnungsposten (hängt an der nächsten Abo-Rechnung); leer = von Hand abrechnen
  stripeInvoiceItemId String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, month])
}

// ─── Pay-per-Lead ────────────────────────────────────────────────────────
// Bezug: ein Käufer kauft Leads eines Produkts (Pool) zu einem Preis, mit
// Filtern. Ersetzt den Airtable-„Kunden-Produkt-Bezug“.
model LeadSubscription {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Produkt/Pool wie Lead.source, z. B. „PKV-Tarifoptimierung“
  productKey   String
  label        String?
  active       Boolean   @default(true)
  // live | test (Test: Vorrang bis testQuantity, verteilt über testDays)
  status       String    @default("live")
  testQuantity Int?
  testDays     Int?
  // Kontingent ohne Bestellung (von Hand gepflegt): month | once; week = Bestellungen im Kundenbereich
  period       String    @default("week")
  goal         Int?
  startDate    DateTime?
  price        Decimal   @db.Decimal(10, 2)
  // Filter
  plzRanges    String? // "80000-85999|67300-67499|12345"
  acceptWeak   Boolean   @default(true)
  // Beitragsgrenze für „schwach“ (Standard 700 €), Beamte sind immer schwach
  weakThreshold Int?
  acceptCivilServants Boolean @default(true)
  onlyWeak     Boolean   @default(false)
  scoreFloor   Int?
  insurerInclude String[] @default([])
  insurerExclude String[] @default([])
  // weitere Regeln: "feld=Wert1,Wert2|feld2=…" (Lead wird ausgeschlossen, wenn ein Wert passt)
  excludeRules String?
  // Storno
  stornoDays   Int?
  stornoReasons String[] @default([])
  // Auslieferung: app (Kundenbereich, Push, E-Mail) | email (nur E-Mail) | webhook
  delivery     String    @default("app")
  deliveryEmail String?
  // E-Mail-Vorlage für Systeme, die die Mail auslesen (z. B. „Feld: Wert“ je
  // Zeile). Platzhalter {vorname}, {nachname}, {plz} … siehe lib/ppl/delivery.
  emailSubject String?
  emailTemplate String?
  webhookUrl   String?
  // standard (JSON mit lead/answers, Secret im Header) | convexa (FirstName, LastName …)
  webhookFormat String   @default("standard")
  webhookSecretEnc String?
  airtableId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders LeadOrder[]
  leads  Lead[]

  @@index([productKey, active])
  @@index([customerId])
}

// Bestellung für einen Zeitraum (meist Woche Mo–So), im Voraus bezahlt.
model LeadOrder {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   LeadSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  quantity       Int
  amount         Decimal          @db.Decimal(10, 2)
  // open (Rechnung offen) | paid | processing (Lastschrift läuft) | failed | cancelled
  status         String           @default("open")
  // Folgewoche automatisch gleich bestellen
  autoRenew      Boolean          @default(true)
  stripeInvoiceId String?         @unique
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  leads Lead[]

  @@unique([subscriptionId, periodStart])
  @@index([status, periodStart])
}

// Eingang eines Pool-Leads (vor der Verteilung): Dubletten-Historie,
// geparkte Leads (kein freies Kontingent) und Prüfergebnis.
model PoolLead {
  id          String    @id @default(cuid())
  externalId  String?   @unique
  productKey  String
  via         String // perspective | meta | webhook
  name        String?
  phone       String?
  email       String?
  plz         String?
  insurer     String?
  contribution Int?
  civilServant Boolean  @default(false)
  weak        Boolean   @default(false)
  smsVerified Boolean   @default(false)
  score       Int?
  answers     Json?
  // delivered | duplicate | invalid | parked
  status      String
  reason      String?
  leadId      String?   @unique
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@index([status, productKey])
}

// ─── Bestandskunden (Import aus dem Versicherer-System) + Kampagnen ─────────
// Gesundheitsangaben werden nie importiert. Einwilligung für WhatsApp/E-Mail
// liegt laut Versicherer (Allianz) vor; dokumentiert mit Importdatum.
model ExistingCustomer {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalNo  String? // Kundennummer im Versicherer-System
  firstName   String?
  lastName    String?
  phone       String? // normalisiert wie WhatsApp (4915…)
  email       String?
  birthday    DateTime?
  street      String?
  zip         String?
  city        String?
  // Sparten, z. B. ["KFZ", "Haftpflicht"] – für Segmente und den Assistenten
  lines       String[]  @default([])
  // nächster Ablauf/Hauptfälligkeit (z. B. KFZ) für Anlass „Wechsel/Ablauf“
  nextRenewal DateTime?
  consentAt   DateTime? // „Einwilligung laut Versicherer“ (Importdatum)
  consentNote String?
  optOutAt    DateTime? // „Stopp“ → keine Kampagnen mehr
  lastCampaignAt DateTime?
  importId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contracts  ExistingContract[]
  recipients CampaignRecipient[]

  @@unique([customerId, externalNo])
  @@index([customerId, phone])
  @@index([customerId, email])
}

model ExistingContract {
  id                 String           @id @default(cuid())
  existingCustomerId String
  existingCustomer   ExistingCustomer @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  line               String // normalisierte Sparte (KFZ, Hausrat, …)
  product            String? // Originalbezeichnung
  startDate          DateTime?
  renewalDate        DateTime?

  @@index([existingCustomerId])
}

model CustomerCampaign {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  // cross_sell | review | birthday | renewal
  occasion    String
  // Segment, z. B. { has: ["KFZ"], lacks: ["Hausrat"] } oder { birthdayDays: 30 }
  segment     Json
  // Thema für die Vorlage (z. B. „Hausrat“), Parameter {{2}}
  topic       String?
  dailyLimit  Int      @default(150)
  // draft | running | paused | done
  status      String   @default("draft")
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([customerId, status])
}

model CampaignRecipient {
  id                 String           @id @default(cuid())
  campaignId         String
  campaign           CustomerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  existingCustomerId String
  existingCustomer   ExistingCustomer @relation(fields: [existingCustomerId], references: [id], onDelete: Cascade)
  // queued | sent | replied | failed | skipped
  status             String           @default("queued")
  reason             String?
  sentAt             DateTime?
  repliedAt          DateTime?
  conversationId     String?
  leadId             String?

  @@unique([campaignId, existingCustomerId])
  @@index([campaignId, status])
}

// Nachfass-Abfolge je Lead (lib/lead-sequences.ts): feste Schritte (WhatsApp /
// Anruf-Aufgabe) mit Tagesabstand, vom 5-Minuten-Cron abgearbeitet. Stoppt bei
// Antwort, Termin, Abschluss/Kein Interesse, Reklamation, Löschung, „Stopp“.
model LeadSequence {
  id         String    @id @default(cuid())
  leadId     String
  customerId String
  // not_reached | offer | no_show
  kind       String
  // Index des nächsten Schritts
  step       Int       @default(0)
  nextAt     DateTime?
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  stopReason String?
  // Verlauf ohne Inhalte: [{ at, step, action, result, detail }]
  log        Json      @default("[]")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([stoppedAt, nextAt])
  @@index([leadId])
}
